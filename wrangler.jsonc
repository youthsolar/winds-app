{
	"compatibility_date": "2026-04-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "winds-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// 根路徑先進 worker 讓 middleware 跑：shop.winds.tw/ 要 301 到 winds.tw/shop/（靜態 index.html 否則會直接被回掉）
		"run_worker_first": ["/"]
	},
	"observability": {
		"enabled": true
	}
}