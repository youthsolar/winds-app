---
import '../styles/global.css';
import ConciergeWidget from '../components/ConciergeWidget.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fullOgImage = new URL(ogImage, Astro.site).toString();

// Google OAuth Client ID (placeholder until Jeffery provides it)
const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline src="/assets/theme-init.js"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <!-- SEO: Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- AGO: Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="找風問幸福" />
  <meta property="og:locale" content="zh_TW" />

  <!-- AGO: Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- GEO: JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Brand Font（占卜站設計：Serif 標題/內文含 weight 300、Sans UI/數字/標籤）-->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Phosphor icons（DS 元件用）-->
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/thin/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />

  <!-- Google Identity Services (One Tap + Sign In) -->
  {GOOGLE_CLIENT_ID && (
    <script src="https://accounts.google.com/gsi/client" async defer />
  )}

  <!-- Nav auth button (shared with public/index.html) -->
  <script src="/assets/nav-auth.js?v=4" defer></script>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Google One Tap prompt (if logged out) -->
  {GOOGLE_CLIENT_ID && (
    <div
      id="g_id_onload"
      data-client_id={GOOGLE_CLIENT_ID}
      data-callback="handleGoogleCredentialResponse"
      data-auto_prompt="false"
      data-context="signin"
    />
  )}

  <nav class="zf-nav">
    <div class="zf-nav-row">
      <a href="/" aria-label="找風問幸福 · 回首頁" class="zf-logo"><img src="/assets/logo.png" alt="找風問幸福" /></a>
      <div class="zf-nav-links">
        <a href="/">首頁</a>
        <a href="/divination">問一件事</a>
        <a href="/blog">案例專欄</a>
        <a href="/booking">老師介紹</a>
        <a href="/shop">法器選物</a>
        <a href="/divination" class="zf-btn ghost sm">占卜</a>
        <button class="zf-theme-btn" id="zfThemeBtn" aria-label="切換深淺色"><i class="ph-thin ph-moon"></i></button>
        <div id="auth-button" class="zf-account"></div>
      </div>
      <button class="zf-burger" id="zfBurger" aria-label="選單"><i class="ph-thin ph-list"></i></button>
    </div>
    <div class="zf-drawer" id="zfDrawer" hidden>
      <a href="/">首頁</a>
      <a href="/divination">問一件事</a>
      <a href="/blog">案例專欄</a>
      <a href="/booking">老師介紹</a>
      <a href="/shop">法器選物</a>
      <a href="/divination" class="zf-btn primary md full">占卜</a>
      <button class="zf-theme-btn m" id="zfThemeBtnM" aria-label="切換深淺色"><i class="ph-thin ph-moon"></i><span>深色模式</span></button>
      <div id="auth-button-m" class="zf-account-m"></div>
    </div>
  </nav>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="zf-footer">
    <div class="zf-footer-in">
      <div class="zf-footer-top">
        <div class="zf-footer-brand">
          <a href="/" aria-label="找風問幸福 · 回首頁" class="zf-logo"><img src="/assets/logo.png" alt="找風問幸福" /></a>
          <p>選擇比努力更重要，命理是對自己的溫柔。</p>
        </div>
        <div class="zf-footer-cols">
          <div class="zf-fcol"><div class="zf-fh">命理項目</div><a href="/divination">易經</a><a href="/divination">塔羅</a><a href="/ziwei">紫微</a><a href="/spirit">分靈體</a></div>
          <div class="zf-fcol"><div class="zf-fh">探索</div><a href="/blog">案例專欄</a><a href="/services">預約項目</a><a href="/booking">老師介紹</a><a href="/shop">法器選物</a><a href="/course">靈修課程</a></div>
          <div class="zf-fcol"><div class="zf-fh">關於</div><a href="/about">品牌故事</a><a href="/account">會員中心</a><a href="/faq">常見問題</a></div>
        </div>
      </div>
      <div class="zf-footer-legal">
        <span>&copy; {new Date().getFullYear()} 找風問幸福</span>
        <span>靈學的溫柔陪伴 · 不涉及醫療或投資建議</span>
      </div>
    </div>
  </footer>

  <style>
    /* ===== DS Nav（site-nav-footer.jsx Nav，桌機/手機逐值對齊；ThemeToggle 暫不上＝暗黑版定稿後）===== */
    .zf-nav{position:sticky;top:0;z-index:40;background:var(--bar-translucent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border-soft);}
    .zf-nav-row{max-width:var(--container);margin:0 auto;padding:0 32px;height:76px;display:flex;align-items:center;justify-content:space-between;}
    .zf-logo{display:block;}
    .zf-nav .zf-logo img{height:54px;width:auto;display:block;}
    .zf-nav-links{display:flex;align-items:center;gap:26px;}
    .zf-nav-links > a:not(.zf-btn){font-family:var(--font-sans);font-size:14px;color:var(--ink-700);letter-spacing:0.03em;text-decoration:none;}
    .zf-nav-links > a:not(.zf-btn):hover{color:var(--accent-press);text-decoration:none;}
    .zf-burger{display:none;align-items:center;justify-content:center;width:44px;height:44px;border:none;background:transparent;color:var(--ink-700);cursor:pointer;}
    .zf-theme-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:36px;height:36px;border:1px solid var(--border-soft);border-radius:var(--radius-pill);background:transparent;color:var(--ink-700);cursor:pointer;transition:background var(--dur-fast) var(--ease-soft);}
    .zf-theme-btn:hover{background:var(--surface-sunken);}
    .zf-theme-btn i{display:inline-flex;align-items:center;justify-content:center;font-size:18px;line-height:1;}
    .zf-theme-btn:not(.m) i{display:flex;width:100%;height:100%;}
    .zf-theme-btn.m{width:100%;min-height:44px;margin-top:12px;padding:0 22px;box-sizing:border-box;border:1px solid var(--border-strong);border-radius:var(--radius-pill);background:var(--surface-card);justify-content:center;white-space:nowrap;font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900);}
    .zf-theme-btn.m span{white-space:nowrap;}
    .zf-burger i{font-size:24px;line-height:1;}
    .zf-drawer{display:none;border-top:1px solid var(--border-soft);background:var(--surface-page);padding:8px 20px 18px;}
    .zf-drawer > a:not(.zf-btn){font-family:var(--font-serif);font-size:17px;color:var(--ink-900);padding:12px 4px;border-bottom:1px solid var(--border-soft);text-decoration:none;}

    /* ===== DS Btn（ui-kit.jsx Btn）===== */
    .zf-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-serif);font-weight:var(--w-medium);letter-spacing:0.04em;line-height:1;border-radius:var(--radius-pill);white-space:nowrap;cursor:pointer;transition:background var(--dur-fast) var(--ease-soft);text-decoration:none;}
    .zf-btn.sm{padding:8px 16px;font-size:var(--t-body-sm);min-height:36px;}
    .zf-btn.md{padding:11px 22px;font-size:var(--t-body);min-height:44px;}
    .zf-btn.full{display:flex;width:100%;margin-top:12px;}
    .zf-btn.ghost{background:transparent;color:var(--accent-press);border:1px solid var(--border-accent);box-shadow:none;}
    .zf-btn.ghost:hover{background:var(--accent-quiet);text-decoration:none;}
    .zf-btn.primary{background:var(--accent);color:var(--text-on-accent);border:1px solid transparent;box-shadow:var(--shadow-sm);}
    .zf-btn.primary:hover{background:var(--accent-hover);text-decoration:none;}

    /* auth 連結由 nav-auth.js innerHTML 注入 → 需 :global（Astro scoped 不套 JS 注入元素）*/
    .zf-account{display:flex;align-items:center;}            /* 頭像與占卜鈕同列垂直置中 */
    .zf-account :global(.nav-acct){display:flex;align-items:center;}  /* 內層也 flex：消掉繼承行高的基線位移，頭像不再略高 */
    .zf-account :global(a){display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:14px;color:var(--ink-700);letter-spacing:0.03em;text-decoration:none;}
    .zf-account :global(a:hover){color:var(--accent-press);text-decoration:none;}
    .zf-account-m{margin-top:8px;padding-top:10px;border-top:1px solid var(--border-soft);}
    .zf-account-m :global(a){display:block;font-family:var(--font-serif);font-size:16px;color:var(--ink-900);padding:10px 4px;text-decoration:none;}

    @media (max-width:980px){
      .zf-nav-row{padding:0 20px;height:64px;}
      .zf-nav .zf-logo img{height:42px;}
      .zf-nav-links{display:none;}
      .zf-burger{display:flex;}
      .zf-drawer:not([hidden]){display:flex;flex-direction:column;gap:2px;}
    }

    /* ===== DS Footer（site-nav-footer.jsx Footer，break 760）===== */
    .zf-footer{margin-top:88px;border-top:1px solid var(--border-soft);}
    .zf-footer-in{max-width:var(--container);margin:0 auto;padding:52px 32px 60px;}
    .zf-footer-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:28px;}
    .zf-footer-brand .zf-logo img{height:54px;width:auto;display:block;}
    .zf-footer-brand p{font-family:var(--font-serif);font-weight:300;font-size:13.5px;color:var(--text-muted);margin:14px 0 0;max-width:22em;}
    .zf-footer-cols{display:flex;gap:56px;}
    .zf-fh{font-family:var(--font-sans);font-size:12.5px;letter-spacing:0.02em;color:var(--text-muted);margin-bottom:14px;}
    .zf-fcol a{display:block;font-family:var(--font-serif);font-size:14.5px;color:var(--ink-700);margin-bottom:9px;text-decoration:none;}
    .zf-fcol a:hover{color:var(--accent-press);text-decoration:none;}
    .zf-footer-legal{border-top:1px solid var(--border-soft);margin-top:36px;padding-top:18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-family:var(--font-sans);font-size:12px;color:var(--text-muted);}

    @media (max-width:760px){
      .zf-footer{margin-top:56px;}
      .zf-footer-in{padding:40px 20px 48px;}
      .zf-footer-brand .zf-logo img{height:42px;}
      .zf-footer-cols{gap:36px;}
    }
  </style>

  <!-- 全站常駐風小編（concierge 浮動鈕 + 頁內滑出面板，對話式預約機器人 #7）-->
  <ConciergeWidget />

  <!-- DS Nav hamburger toggle（無框架、純 attribute）-->
  <script is:inline>
    (function () {
      var b = document.getElementById('zfBurger'), d = document.getElementById('zfDrawer');
      if (b && d) b.addEventListener('click', function () {
        var icon = b.querySelector('i');
        if (d.hasAttribute('hidden')) { d.removeAttribute('hidden'); if (icon) icon.className = 'ph-thin ph-x'; }
        else { d.setAttribute('hidden', ''); if (icon) icon.className = 'ph-thin ph-list'; }
      });
      /* 深淺色切換鈕（theme-init.js 提供 ZFTheme） */
      function paint() {
        var dark = window.ZFTheme && ZFTheme.isDark();
        ['zfThemeBtn', 'zfThemeBtnM'].forEach(function (id) {
          var el = document.getElementById(id); if (!el) return;
          var i = el.querySelector('i'); if (i) i.className = dark ? 'ph-thin ph-sun' : 'ph-thin ph-moon';
          var s = el.querySelector('span'); if (s) s.textContent = dark ? '淺色模式' : '深色模式';
        });
      }
      ['zfThemeBtn', 'zfThemeBtnM'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('click', function () { if (window.ZFTheme) ZFTheme.toggle(); });
      });
      window.addEventListener('zf-theme-change', paint);
      paint();
    })();
  </script>

  <!-- 帶 utm 進站記點（社群量測閉環第二層）：sendBeacon → api.winds.tw/hit → D1 link_hits -->
  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search);
      var c = q.get('utm_content');
      if (!c) return;
      try {
        navigator.sendBeacon('https://api.winds.tw/hit', JSON.stringify({
          path: location.pathname,
          utm_source: q.get('utm_source') || '',
          utm_content: c,
        }));
      } catch (e) {}
    })();
  </script>

  <!-- Google SSO callback handler (placeholder) -->
  {GOOGLE_CLIENT_ID && (
    <script is:inline>
      function handleGoogleCredentialResponse(response) {
        // Send ID token to Worker for verification
        fetch('/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential }),
        })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            window.location.reload();
          }
        })
        .catch(console.error);
      }
    </script>
  )}
</body>
</html>
