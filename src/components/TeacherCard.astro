---
import type { Teacher } from '../data/booking-teachers';
interface Props { t: Teacher; bookHref: string; }
const { t, bookHref } = Astro.props;
const SKILL_TONE: Record<string, string> = { '感情': 'rose', '事業': 'clay', '身心': 'sage' };
---
<div class="tc" data-id={t.id} data-persona={t.persona}>
  <div class="tc-top">
    <div class:list={['tc-av', `tc-av-${t.tone}`]}>{t.name.slice(0, 1)}</div>
    <div class="tc-id">
      <div class="tc-namerow"><span class="tc-name">{t.name}</span><span class="tc-years">執業 {t.years} 年</span></div>
      <div class="tc-stars"><i class="ph-fill ph-star"></i><span class="tc-rating">{t.rating.toFixed(1)}</span><span class="tc-reviews">· {t.reviews} 則評價</span></div>
      <div class="tc-tags">
        {t.skills.map((s) => <span class:list={['tc-tag', 'soft', SKILL_TONE[s]]}>{s}</span>)}
        <span class="tc-tag outline">{t.style}</span>
      </div>
    </div>
  </div>
  <p class="tc-blurb">{t.blurb}</p>
  <div class="tc-quote"><i class="ph-fill ph-quotes"></i><span>{t.quote}</span></div>
  <div class="tc-foot">
    <span class="tc-price"><span class="tc-price-unit">單次 60 分鐘</span><span class="tc-price-val">NT$ {t.price.toLocaleString()} 起</span></span>
    <a class="zfbtn secondary md" href={bookHref}>選這位老師<i class="ph ph-arrow-right"></i></a>
  </div>
</div>
