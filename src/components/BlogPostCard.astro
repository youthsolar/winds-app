---
// 部落格列表卡片（11/22 Jeffery 選 DS 樣稿 C：每類第一篇大圖、其餘小圖）
// 樣稿：https://claude.ai/artifact/CZieAbo9ggn7NRREHCGsSC
// 圖比例照 DS 文章封面 3:2；沒圖用 DS 缺圖樣式（surface-sunken 底＋細線蓮花，不放字）
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; variant: 'feat' | 'small'; eager?: boolean; }
const { post, variant, eager = false } = Astro.props;
const hero = post.data.heroImage;
// 小卡用 600 寬縮小版（11/22 起 cdn.winds.tw/blog-v2/ 的封面都有對應 -sm.jpg）
const img = hero && variant === 'small' && hero.includes('cdn.winds.tw/blog-v2/') ? hero.replace(/\.jpg$/, '-sm.jpg') : hero;
const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a class={`bpc ${variant}`} href={`/blog/${post.id}/`}>
  <div class="bpc-media">
    {img
      ? <img src={img} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="1536" height="1024" />
      : <span class="bpc-fallback" aria-hidden="true"><svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"><path d="M128 208c-36 0-88-16-104-64 24-8 52-4 72 8"/><path d="M128 208c36 0 88-16 104-64-24-8-52-4-72 8"/><path d="M128 208c-24-16-40-44-40-76 0-28 16-56 40-80 24 24 40 52 40 80 0 32-16 60-40 76z"/></svg></span>}
  </div>
  <div class="bpc-body">
    <h3 class="bpc-title cjk-title">{post.data.title}</h3>
    {variant === 'feat' && post.data.description?.trim() && <p class="bpc-desc">{post.data.description}</p>}
    <div class="bpc-meta">
      <time>{fmtDate(post.data.pubDate)}</time>
      {post.data.tags.slice(0, variant === 'feat' ? 3 : 1).map((tag: string) => (<span class="tag">#{tag}</span>))}
    </div>
  </div>
</a>

<style>
  .bpc { display: flex; overflow: hidden; height: 100%; background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; transition: transform var(--dur-base) var(--ease-soft), box-shadow var(--dur-base) var(--ease-soft); }
  .bpc:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); text-decoration: none; }
  .bpc-media { flex: none; aspect-ratio: 3 / 2; background: var(--surface-sunken); }
  .bpc-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bpc-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--border-accent); }
  .bpc-fallback svg { width: 22%; max-width: 48px; }
  .bpc-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .bpc-title { font-family: var(--font-serif); font-weight: 500; line-height: 1.45; color: var(--ink-900); margin: 0; }
  .bpc:hover .bpc-title { color: var(--accent-press); }
  .bpc-desc { font-family: var(--font-serif); font-weight: 300; line-height: 1.85; color: var(--text-secondary); margin: 10px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bpc-meta { margin-top: auto; padding-top: 12px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .bpc-meta time { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
  .bpc-meta .tag { font-family: var(--font-sans); font-size: 12.5px; color: var(--rose-500); white-space: nowrap; }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* 大卡：電腦左圖右字，手機圖在上 */
  .feat { flex-direction: row; }
  .feat .bpc-media { width: 48%; }
  .feat .bpc-body { justify-content: center; padding: 32px 36px; }
  .feat .bpc-title { font-size: 24px; }
  .feat .bpc-desc { font-size: 15.5px; }
  /* 小卡：電腦圖在上（三欄），手機圖在左 */
  .small { flex-direction: column; }
  .small .bpc-media { width: 100%; }
  .small .bpc-body { padding: 16px 18px 18px; }
  .small .bpc-title { font-size: 17px; }
  @media (max-width: 760px) {
    .feat { flex-direction: column; }
    .feat .bpc-media { width: 100%; }
    .feat .bpc-body { padding: 16px 18px 18px; }
    .feat .bpc-title { font-size: 18px; }
    .feat .bpc-desc { font-size: 14px; -webkit-line-clamp: 2; }
    .small { flex-direction: row; align-items: center; gap: 14px; padding: 14px; }
    .small .bpc-media { width: 96px; border-radius: 10px; overflow: hidden; }
    .small .bpc-body { padding: 0; }
    .small .bpc-title { font-size: 16px; }
    .small .bpc-meta { padding-top: 8px; }
  }
</style>
