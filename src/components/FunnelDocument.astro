/* 稱呼拆姓名：中文 2～4 字＝首字（複姓兩字）為姓；其餘整串當名 */
function splitName(s){s=String(s||"").trim();if(!s)return{surname:"",given:""};var dbl=["歐陽","司馬","諸葛","上官","司徒","東方","皇甫","尉遲","公孫","慕容","端木","夏侯","令狐"];
  if(/^[一-鿿]{2,4}$/.test(s)){for(var i=0;i<dbl.length;i++)if(s.indexOf(dbl[i])===0&&s.length>2)return{surname:dbl[i],given:s.slice(2)};return{surname:s.charAt(0),given:s.slice(1)};}
  var sp=s.split(/\s+/);if(sp.length>=2)return{surname:sp[0],given:sp.slice(1).join(" ")};return{surname:"",given:s};}

