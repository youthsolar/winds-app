    .fi-body strong{font-weight:500;color:var(--ink-900)}
    .fi-h1{font-family:var(--font-serif);font-weight:500;font-size:20px;color:var(--ink-900);margin:26px 0 12px}
    .fi-h2{font-family:var(--font-serif);font-weight:500;font-size:16px;color:var(--rose-600);margin:20px 0 10px}
    .fi-hr{border:0;border-top:1px solid var(--rose-100);margin:22px 0}
    .fu-wait{font-family:var(--font-sans);font-size:12px;color:var(--ink-700);background:var(--paper);border:1px solid var(--rose-200);border-radius:var(--radius-pill);padding:3px 10px}
    .paid-card .topbar{height:4px;background:linear-gradient(90deg,var(--rose-300),var(--clay-400))}
    .paid-card .body{padding:30px 34px}
    .paid-card .body p{font-family:var(--font-serif);font-weight:300;font-size:16px;line-height:2;color:var(--ink-700);margin:0 0 16px}

    /* recs */
    .recs{margin-top:60px}
    .recs .head{text-align:center;margin-bottom:34px}
    .recs .head h2{font-family:var(--font-serif);font-size:30px;font-weight:500;line-height:1.18;letter-spacing:.02em;color:var(--ink-900);margin:0 0 8px}
    .recs .head p{font-family:var(--font-serif);font-weight:300;font-size:16px;color:var(--text-secondary)}
    .recs .head p{line-height:1.8;max-width:30em;margin:0 auto}.recs .head p+p{margin-top:10px}
    .rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    @media(max-width:760px){.recs{margin-top:44px}.rec-grid{grid-template-columns:1fr;gap:14px}}
    .rec{display:flex;flex-direction:column;height:100%;background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;text-decoration:none;transition:all var(--dur-fast) var(--ease-soft)}
    .rec:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
    .rec .top{padding:24px 24px 0;display:flex;align-items:center;justify-content:space-between}
    .rec-ic{width:42px;height:42px;border-radius:999px;display:flex;align-items:center;justify-content:center}
    .rec-ic.book{background:var(--rose-100);color:var(--rose-500)}
    .rec-ic.tal{background:var(--clay-200);color:var(--clay-500)}
    .rec .b{padding:16px 24px 26px;flex:1;display:flex;flex-direction:column}
    .rec h4{font-family:var(--font-serif);font-size:18px;font-weight:500;color:var(--ink-900);margin:0 0 8px}
    .rec .reason{display:flex;gap:7px;margin-bottom:16px}
    .rec-kicker{font-family:var(--font-sans);font-size:12px;letter-spacing:.12em;color:var(--rose-600);margin-bottom:8px}
    .rec .reason p{font-family:var(--font-serif);font-weight:300;font-size:14px;line-height:1.7;color:var(--text-secondary)}
    .rec .foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between}
    .rec .price{font-family:var(--font-sans);font-size:13px;color:var(--ink-700)}
    .rec .cta{display:inline-flex;align-items:center;gap:5px;font-family:var(--font-serif);font-size:14px;color:var(--accent-press);font-weight:500}

    /* banner */
    .banner{position:relative;border-radius:var(--radius-xl);overflow:hidden;margin:30px 0;box-shadow:var(--shadow-sm);border:1px solid var(--rose-100)}
    .banner .bimg{height:188px;background-position:center;background-size:cover;background-repeat:no-repeat}
    .banner.tall .bimg{height:250px}
    .banner .cap{position:absolute;left:0;right:0;bottom:0;padding:34px 26px 20px;background:linear-gradient(transparent,var(--photo-scrim));pointer-events:none}
    .banner .cap span{font-family:var(--font-serif);font-size:20px;color:var(--ink-on-photo);text-shadow:0 1px 8px var(--photo-scrim-shadow,rgba(46,40,35,.3))}
    @media(max-width:760px){.banner .bimg{height:132px}.banner.tall .bimg{height:170px}.banner .cap span{font-size:16px}}

    /* cooldown */
    .cool{min-height:calc(100vh - 72px);display:flex;align-items:center;justify-content:center;padding:60px 32px;position:relative;overflow:hidden}
    .cool .glow{position:absolute;inset:0;background:radial-gradient(620px 460px at 50% 20%,var(--rose-100),transparent 62%)}
    .cool .zf-card{position:relative;max-width:560px;text-align:center;padding:44px 48px}
    @media(max-width:760px){.cool .zf-card{padding:30px 24px}}
    .cool .moon{width:56px;height:56px;border-radius:999px;background:var(--rose-100);display:inline-flex;align-items:center;justify-content:center;margin-bottom:20px;color:var(--rose-500)}
    .cool h1{font-family:var(--font-serif);font-size:30px;font-weight:500;line-height:1.45;color:var(--ink-900);margin:0 0 16px}
    @media(max-width:760px){.cool h1{font-size:24px}}
    .cool .when{background:var(--surface-sunken);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:16px 20px;margin:24px 0;display:flex;align-items:center;justify-content:center;gap:10px;color:var(--rose-500)}
    .cool .when span{font-family:var(--font-serif);font-size:16px;color:var(--ink-900)}
    .cool .when b{font-weight:500;color:var(--accent-press)}
    .cool-btns{display:flex;gap:12px;justify-content:center}
    @media(max-width:760px){.cool-btns{flex-direction:column}}

    .sum-body{font-family:var(--font-serif);font-weight:300;font-size:16px;line-height:1.85;color:var(--ink-700);margin:18px 0 0}
    @media(max-width:760px){.sum-body{font-size:16px}}

    /* 社群追蹤 CTA（結果頁尾；把看完占卜的人接進社群陪伴）*/
    .social-cta{margin-top:56px;background:linear-gradient(160deg,var(--surface-tint),var(--surface-card) 62%);border:1px solid var(--border-accent);border-radius:var(--radius-xl);padding:44px 34px 40px;box-shadow:var(--shadow-md);text-align:center}
    .social-cta .sc-eyebrow{display:inline-flex;align-items:center;gap:7px;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:.14em;color:var(--rose-500);margin-bottom:16px}
    .social-cta .sc-eyebrow i{font-size:15px}
    .social-cta h3{font-family:var(--font-serif);font-weight:500;font-size:24px;line-height:1.4;color:var(--ink-900);margin:0 0 14px}
    .social-cta .sc-lead{font-family:var(--font-serif);font-weight:300;font-size:16px;line-height:1.9;color:var(--ink-700);max-width:24em;margin:0 auto 30px}
    .social-cta .sc-lead em{font-style:normal;color:var(--rose-600);font-weight:400}
    .sc-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .sc-link{display:flex;flex-direction:column;align-items:center;gap:9px;width:150px;padding:20px 12px 16px;background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);text-decoration:none;color:inherit;transition:all var(--dur-fast) var(--ease-soft)}
    .sc-link:hover{transform:translateY(-3px);border-color:var(--border-accent);box-shadow:var(--shadow-sm)}
    /* 半透明圓形＝對齊 IG 輪播卡第 5 頁追蹤 CTA（render-carousel.ts）；暗版 rgba 逐值同輪播卡 */
    .sc-ic{width:46px;height:46px;border-radius:999px;background:rgba(46,40,35,0.06);border:1px solid rgba(46,40,35,0.18);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--ink-900)}
    [data-theme="dark"] .sc-ic{background:rgba(240,231,219,0.08);border-color:rgba(240,231,219,0.20)}
    .sc-name{font-family:var(--font-serif);font-weight:500;font-size:16px;color:var(--ink-900);line-height:1.3}
    .sc-sub{font-family:var(--font-sans);font-size:12px;color:var(--text-muted);letter-spacing:.02em}
    .sc-handle{font-family:var(--font-sans);font-size:12px;color:var(--rose-500);letter-spacing:.03em}
    @media(max-width:560px){.sc-link{width:calc(50% - 7px)}.social-cta{padding:36px 20px 32px}.social-cta h3{font-size:20px}}

    .hidden{display:none!important}
    a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important}
    /* 風小編只在結果頁現身（含回看模式）；漏斗填單過程不打擾 */
    body:not(.show-concierge) .wc-root{display:none!important}

    /* ===== 去表單化（2026-09-10）：水鏡起卦／老師逐題問／回訪一行——DS ui_kits/free-flow 逐值 ===== */
    .ff .ff-h{font-size:24px;line-height:1.35;font-weight:500;margin:8px 0 6px;text-wrap:balance}
    .ff .lede{font-size:14px;line-height:1.8}
    .ff-p{font-family:var(--font-serif);font-weight:300;font-size:14px;line-height:1.8;color:var(--text-secondary);margin:0 0 12px}
    .ff-clock{text-align:center;font-family:var(--font-sans);font-size:12px;color:var(--text-muted);letter-spacing:.08em;font-variant-numeric:tabular-nums;min-height:18px}
    .ff-err{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:90;max-width:88vw;background:var(--surface-card);border:1px solid var(--border-accent);color:var(--text-primary);border-radius:var(--radius-pill);padding:10px 18px;font-family:var(--font-serif);font-size:14px;box-shadow:var(--shadow-md);display:none}
    /* 水鏡：純 CSS 鏡身——黑漆鏡緣（--mirror-rim）＋細金邊（--mirror-gold）＋五行水色鏡面（--water-*）；token 兩主題不翻 */
    .ff-mirrorwrap{display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:8px}
    .ff-mirror{position:relative;border-radius:var(--radius-pill);box-sizing:border-box;border:10px solid var(--mirror-rim);overflow:hidden;
      background:radial-gradient(circle at 36% 28%,var(--water-hi) 0%,var(--water-mid) 52%,var(--water-deep) 100%);
      box-shadow:0 0 0 2px var(--mirror-gold),inset 0 0 0 1px var(--mirror-rim-hi),inset 0 0 30px color-mix(in srgb,var(--ink-900) 34%,transparent),var(--shadow-md);
      user-select:none;-webkit-user-select:none;touch-action:none;cursor:default}
    .ff-mirror.cast{cursor:pointer}
    .ff-mirror.dial{cursor:ew-resize}
    .ff-stars{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
    .ff-stars circle{fill:var(--water-glint)}
    .ff-sheen{position:absolute;left:14%;top:10%;width:42%;height:26%;border-radius:50%;background:radial-gradient(ellipse at center,var(--water-glint) 0%,transparent 70%);filter:blur(6px);pointer-events:none;animation:ffSheen 9s ease-in-out infinite alternate}
    .ff-rips{position:absolute;inset:0;pointer-events:none}
    .ff-rips span{position:absolute;left:50%;top:50%;width:20px;height:20px;border-radius:var(--radius-pill);border:1.2px solid var(--water-glint);opacity:.85;transform:translate(-50%,-50%);animation:ffRip 3.2s cubic-bezier(.16,.6,.3,1) forwards}
    @keyframes ffRip{to{width:110%;height:110%;opacity:0}}
    @keyframes ffSheen{to{transform:translate(6%,4%);opacity:.75}}
    @keyframes ffTwinkle{to{opacity:.08}}
    .ff-hexc{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%)}
    .ff-yaos{display:flex;flex-direction:column;gap:9px;width:86px}
    .ff-mirror[style*="216"] .ff-yaos{width:78px}
    .ff-yao{display:flex;gap:12px;height:8px;opacity:0;transform:translateY(14px);filter:blur(6px);transition:opacity .9s var(--ease-soft),transform .9s var(--ease-soft),filter .9s var(--ease-soft)}
    .ff-yao.yang{gap:0}
    .ff-yao.on{opacity:1;transform:none;filter:blur(0)}
    .ff-yao i{flex:1;display:block;background:var(--mirror-ink);border-radius:2px;box-shadow:0 0 10px var(--disc-frost-hair)}
    .ff-hexname{min-height:30px;text-align:center;font-family:var(--font-serif);font-size:20px;font-weight:600;letter-spacing:.12em;color:var(--text-primary);white-space:nowrap;opacity:0;transform:translateY(-6px);transition:opacity .9s var(--ease-soft) .3s,transform .9s var(--ease-soft) .3s}
    .ff-hexname.on{opacity:1;transform:none}
    /* 轉輪鏡（年份） */
    .ff-ticks{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
    .ff-ticks line{stroke:var(--mirror-ink)}
    .ff-dialtxt{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;font-family:var(--font-serif);color:var(--mirror-ink);text-shadow:0 1px 0 var(--water-glint);font-variant-numeric:tabular-nums;pointer-events:none}
    .ff-dial-k{font-size:11px;letter-spacing:.2em;opacity:.8;font-family:var(--font-sans)}
    .ff-dial-y{font-size:42px;font-weight:600;line-height:1.1}
    .ff-dial-m{font-size:11px;letter-spacing:.12em;opacity:.75;font-family:var(--font-sans);margin-top:2px}
    /* 老師逐題問 */
    .ff-prog{display:flex;gap:4px;margin:0 0 10px}
    .ff-prog i{flex:1;height:3px;border-radius:999px;background:var(--border-soft)}
    .ff-prog i.on{background:var(--accent)}
    .ff-chat{display:grid;gap:12px}
    .ff-who{display:flex;align-items:center;gap:8px;font-family:var(--font-sans);font-size:12px;color:var(--text-muted)}
    .ff-av{flex:none;width:26px;height:26px;border-radius:var(--radius-md);background:var(--paper,var(--surface-card));border:1px solid var(--rose-100);display:flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:12px;color:var(--accent-press)}
    .ff-bub{max-width:88%;padding:11px 14px;border-radius:18px;font-family:var(--font-serif);font-size:14px;line-height:1.7;background:var(--surface-card);border:1px solid var(--border-soft);border-top-left-radius:6px;color:var(--text-primary);font-weight:300;animation:ffIn .38s var(--ease-soft)}
    .ff-bub.me{background:var(--accent);color:var(--text-on-accent);justify-self:end;width:fit-content;white-space:nowrap;border-top-right-radius:6px;border-top-left-radius:18px;border-color:transparent;font-weight:500}
    @keyframes ffIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
    .ff-ctl{margin-top:4px}
    .ff-next{display:flex;justify-content:flex-end;gap:8px;margin-top:6px}
    .ff-petals{position:relative;width:200px;height:200px;margin:6px auto}
    .ff-petals button{position:absolute;width:40px;height:40px;border-radius:999px;transform:translate(-50%,-50%);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-secondary);font-family:var(--font-serif);font-size:13px;cursor:pointer}
    .ff-petals button.on{background:var(--accent);color:var(--text-on-accent);border-color:transparent}
    .ff-petals .c{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-family:var(--font-serif);font-size:16px;color:var(--text-primary);text-align:center;line-height:1.3}
    .ff-petals .c small{display:block;font-size:12px;color:var(--text-muted);letter-spacing:.08em;font-family:var(--font-sans)}
    .ff-days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
    .ff-days button{height:34px;border-radius:var(--radius-sm);border:1px solid var(--border-soft);background:var(--surface-card);color:var(--text-secondary);font-family:var(--font-serif);font-size:13px;cursor:pointer;font-variant-numeric:tabular-nums}
    .ff-days button.on{background:var(--accent);color:var(--text-on-accent);border-color:transparent}
    .ff-arc svg{width:100%;height:150px;overflow:visible}
    .ff-arc .horizon{stroke:var(--border-strong);stroke-dasharray:3 4}
    .ff-arc .path{fill:none;stroke:var(--border-accent);stroke-width:1.2;stroke-dasharray:2 5}
    .ff-arc .dot{cursor:pointer}
    .ff-arc .dot circle{fill:var(--surface-card);stroke:var(--border-strong);stroke-width:1.2}
    .ff-arc .dot .halo{fill:var(--gold-300);opacity:.35;stroke:none}
    .ff-arc .dot.on circle:not(.halo){fill:var(--gold-400);stroke:var(--gold-500)}
    .ff-arc .dot text{font-family:var(--font-serif);font-size:9.5px;fill:var(--text-muted);text-anchor:middle;pointer-events:none}
    .ff-arc .dot.on text{fill:var(--ink-900);font-weight:600}
    .ff-shilabel{font-family:var(--font-serif);font-size:14px;text-align:center;color:var(--text-primary);margin-top:2px}
    .ff-shilabel small{color:var(--text-muted);font-size:12px;margin-left:6px}
    .ff-seals{display:flex;gap:10px;justify-content:center}
    .ff-seals button{width:64px;height:64px;border-radius:14px;border:1.5px solid var(--border-strong);background:var(--surface-card);color:var(--text-secondary);font-family:var(--font-serif);font-size:20px;cursor:pointer;transition:all .15s}
    .ff-seals button.on{background:var(--rose-600);color:var(--text-on-accent);border-color:transparent;transform:rotate(-3deg)}
    /* 家的情形四選一（home 模式，看到卦那一頁）：DS chip 膠囊，兩行置中 */
    .paywall .veil .ns-line{font-family:var(--font-serif);font-weight:300;font-size:16px;line-height:1.8;color:var(--text-secondary);margin:0 0 10px;text-align:left}
    .paywall .veil .ns-line b{font-weight:500;color:var(--ink-900)}
    .hg-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:14px 0 6px}
    .hg-chips .chip{font-size:16px;padding:11px 18px}
    /* ── 活動頁「家裡的符」落地（home 模式）── */
    .hg-top{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:680px;margin:0 auto;padding:14px 20px 0}
    .hg-logo img{height:34px;width:auto;display:block}
    /* 2026-09-25 Jeffery：八卦圖從 Nav 中間移到 Nav 下第一行，置中放大 */
    .hg-bagua-row{display:flex;justify-content:center;margin:18px 0 28px}
    .hg-bagua{height:48px;width:48px;opacity:.9}
    .hg .hg-hero{display:flex;flex-direction:column;gap:12px;margin:6px 0 30px}
    .hg .hg-h1{font-size:30px;font-weight:500;line-height:1.3;color:var(--ink-900);letter-spacing:.01em;margin:0;text-wrap:balance}
    @media(max-width:760px){.hg .hg-h1{font-size:24px}}
    .hg .hg-hero .lede{font-size:18px}
    .hg-cols{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:26px}
    .hg-card h3{font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900);margin:0 0 8px}
    .hg-card p{font-family:var(--font-serif);font-weight:300;font-size:16px;line-height:1.85;color:var(--ink-700);margin:0}
    .hg-card p+p{margin-top:8px}
    .hg-guide+.hg-guide{margin-top:4px}
    .hg-guide.hg-q{margin-top:18px}
    .hg-list{list-style:none;padding:0;margin:8px 0 0;font-family:var(--font-serif);font-size:16px;line-height:1.9;color:var(--ink-700)}
    .hg-teacher{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--border-soft);border-radius:var(--radius-lg,16px);margin-bottom:30px}
    .hg-teacher .ff-av{margin:0}
    .hg-teacher b{display:block;font-family:var(--font-serif);font-weight:500;font-size:14px;color:var(--ink-900)}
    .hg-teacher span:last-child{font-family:var(--font-sans);font-size:12px;color:var(--text-muted)}
    .hg-cast{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;padding-top:6px}
    .hg-guide{font-family:var(--font-serif);font-size:16px;line-height:1.7;color:var(--text-secondary);margin:0}
    .hg-situ{font-family:var(--font-sans);font-size:12px;color:var(--text-muted);line-height:1.8;margin:8px 0 0}
    .hg-foot{margin-top:56px;padding-top:22px;border-top:1px solid var(--border-soft);text-align:center}
    .hg-foot p{font-family:var(--font-serif);font-weight:300;font-size:14px;line-height:1.8;color:var(--text-secondary);margin:0 0 12px}
    .hg-links{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;font-family:var(--font-sans);font-size:13px}
    .hg-links a{color:var(--ink-700);text-decoration:none;border-bottom:1px solid var(--border-strong);padding-bottom:2px}
    .hg-legal{font-size:12px!important;color:var(--text-muted)!important;margin-top:16px!important}
    .ff-inp{width:100%;box-sizing:border-box;padding:12px 16px;font-family:var(--font-serif);font-size:16px;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-md);box-shadow:var(--shadow-xs);outline:none;transition:border-color .15s,box-shadow .15s}
    .ff-inp:focus{border-color:var(--rose-300);box-shadow:0 0 0 4px var(--focus-ring,var(--accent-quiet))}
    .ff-inp.bad{border-color:var(--critical)}
    .ff-hint{margin-top:7px;font-family:var(--font-sans);font-size:12px;color:var(--critical);min-height:1em}
