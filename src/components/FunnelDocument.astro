/* ===== SVG charts ===== */
function radarSVG(size){
  var data=(STATE.result&&STATE.result.wuxing)||[];if(data.length<3)return"";
  var cx=size/2,cy=size/2,R=size/2-26,n=data.length;
  function pt(i,r){var a=-Math.PI/2+i*2*Math.PI/n;return[cx+r*Math.cos(a),cy+r*Math.sin(a)]}
  function poly(r){return data.map(function(_,i){return pt(i,R*r).join(",")}).join(" ")}
  var val=data.map(function(d,i){return pt(i,R*d.v/100).join(",")}).join(" ");
  var s='<svg width="'+size+'" height="'+size+'" viewBox="0 0 '+size+' '+size+'">';
  [0.33,0.66,1].forEach(function(r){s+='<polygon points="'+poly(r)+'" fill="none" stroke="var(--rice-300)" stroke-width="1" opacity="0.7"/>'});
  data.forEach(function(_,i){var p=pt(i,R);s+='<line x1="'+cx+'" y1="'+cy+'" x2="'+p[0]+'" y2="'+p[1]+'" stroke="var(--rice-300)" stroke-width="1" opacity="0.6"/>'});
  s+='<polygon points="'+val+'" fill="var(--rose-300)" fill-opacity="0.34" stroke="var(--rose-500)" stroke-width="1.5" stroke-linejoin="round"/>';
  data.forEach(function(d,i){var p=pt(i,R*d.v/100);s+='<circle cx="'+p[0]+'" cy="'+p[1]+'" r="2.6" fill="var(--rose-500)"/>'});
  data.forEach(function(d,i){var p=pt(i,R+15);s+='<text x="'+p[0]+'" y="'+p[1]+'" text-anchor="middle" dominant-baseline="middle" style="font-family:var(--font-serif);font-size:14px;fill:var(--ink-700)">'+d.k+'</text>'});
  return s+'</svg>';
}
function seasonSVG(paid){
  var fl=(STATE.result&&STATE.result.fortuneLine)||[];if(fl.length<2)return"";
  var data=fl.map(function(p){return (Number(p.score)+100)/2}),w=520,h=150,pad=8,max=100,min=0,n=data.length,cut=paid?n:Math.ceil(n/2);
  function X(i){return pad+i*(w-pad*2)/(n-1)}function Y(v){return h-pad-(v-min)/(max-min)*(h-pad*2)}
  var line=data.map(function(v,i){return(i?"L":"M")+X(i).toFixed(1)+","+Y(v).toFixed(1)}).join(" ");
  var area=line+" L"+X(n-1).toFixed(1)+","+h+" L"+X(0).toFixed(1)+","+h+" Z";
  var cutX=paid?w:X(cut);
  var s='<svg width="100%" height="'+h+'" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">'+
   '<defs><linearGradient id="sf" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--rose-300)" stop-opacity="0.34"/><stop offset="100%" stop-color="var(--rose-300)" stop-opacity="0.02"/></linearGradient>'+
   '<clipPath id="fc"><rect x="0" y="0" width="'+cutX+'" height="'+h+'"/></clipPath><clipPath id="lc"><rect x="'+cutX+'" y="0" width="'+(w-cutX)+'" height="'+h+'"/></clipPath></defs>'+
   '<line x1="0" y1="'+h*0.5+'" x2="'+w+'" y2="'+h*0.5+'" stroke="var(--rice-200)" stroke-width="1"/>'+
   '<g clip-path="'+(paid?'':'url(#fc)')+'"><path d="'+area+'" fill="url(#sf)"/><path d="'+line+'" fill="none" stroke="var(--rose-500)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></g>';
  if(!paid)s+='<g clip-path="url(#lc)" style="filter:blur(4px);opacity:0.5"><path d="'+area+'" fill="url(#sf)"/><path d="'+line+'" fill="none" stroke="var(--rose-400)" stroke-width="2"/></g>'+
   '<line x1="'+cutX+'" y1="0" x2="'+cutX+'" y2="'+h+'" stroke="var(--rose-200)" stroke-width="1" stroke-dasharray="3 4"/>';
  return s+'</svg>';
}

