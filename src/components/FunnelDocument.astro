/* ===== 開機（Google SSO）===== */
function adoptGoogleToken(tok){
  try{
    var p=JSON.parse(atob(tok.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
    if(p.exp&&p.exp*1000<Date.now())return false;
    googleIdToken=tok;STATE.userId=p.sub||"";
    STATE.gEmail=p.email||"";
    return !!STATE.userId;
  }catch(e){return false;}
}
function handleGoogleCredential(resp){
  if(!resp||!resp.credential)return;
  var firstLogin=false;try{firstLogin=!localStorage.getItem("winds_google_token");}catch(e){}
  if(!adoptGoogleToken(resp.credential))return;
  try{localStorage.setItem("winds_google_token",resp.credential);}catch(e){}
  /* 量測：Lead＝此瀏覽器第一次登入/綁定（重複登入不重送） */
  if(firstLogin){try{if(window.fbq)fbq('track','Lead');if(window.gtag)gtag('event','sign_up',{method:'google'});}catch(e){}}
  doPrefill();
  if(STATE.step==="info")render();
}
function initGoogleGIS(){
  if(typeof google==="undefined"||!google.accounts){setTimeout(initGoogleGIS,250);return;}
  google.accounts.id.initialize({client_id:GOOGLE_CLIENT_ID,callback:handleGoogleCredential,auto_select:true,context:"signin"});
  if(!STATE.userId)google.accounts.id.prompt();
  mountGisButton();
}
function mountGisButton(){
  if(STATE.userId)return;
  var el=document.getElementById("googleSignInBtn");
  if(!el)return;if(el.childNodes.length&&!mountGisButton._redo&&!el.getAttribute("data-fb"))return;mountGisButton._redo=false;
  if(typeof google==="undefined"||!google.accounts)return;
  el.innerHTML="";
  el.removeAttribute("data-fb");
  google.accounts.id.renderButton(el,{theme:(window.ZFTheme&&ZFTheme.isDark())?"filled_black":"outline",size:"large",text:"signin_with",shape:"pill",width:280,locale:"zh-TW"});
}
/* GSI 在 App 內建瀏覽器（Threads/IG/FB）常常一顆按鈕都渲染不出來，而 mountGisButton 是靜靜地
   return、initGoogleGIS 是無限重試，畫面就停在空卡片、使用者無從得知。這裡不猜根因，只看結果。 */
function gsiFallback(force){
  if(STATE.userId)return;
  var el=document.getElementById("googleSignInBtn");
  if(!el)return;
  if(!force&&el.childNodes.length)return;   /* 逾時路徑：只在掛載點還空的時候接手 */
  var bs='display:inline-block;margin:0 4px;padding:11px 20px;cursor:pointer;font-family:var(--font-serif);font-size:14px;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-pill);text-decoration:none';
  el.setAttribute("data-fb","1");
  /* 藏掉同卡片裡的「先用 Google 登入」標題與副標，否則會跟提示自相矛盾 */
  for(var s=el.previousElementSibling;s;s=s.previousElementSibling){s.style.display="none";}
  el.innerHTML='<div style="text-align:center">'+
    '<div style="font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900)">這個瀏覽器不支援 Google 登入</div>'+
    '<div style="margin:8px auto 14px;max-width:22em;font-family:var(--font-serif);font-weight:300;font-size:13px;line-height:1.75;color:var(--text-secondary)">請點右上角「⋯」選「在瀏覽器開啟」，用 Safari 或 Chrome 進來就可以登入了。</div>'+
    '<button type="button" style="'+bs+'" onclick="gsiCopyUrl(this)">複製網址</button>'+
    (/Android/i.test(navigator.userAgent)?'<a style="'+bs+'" href="intent://'+location.host+location.pathname+location.search+'#Intent;scheme=https;package=com.android.chrome;end">用 Chrome 開啟</a>':'')+
  '</div>';
}
function gsiCopyUrl(btn){
  var u=location.href;
  function done(){btn.textContent='已複製 ✓';}
  function legacy(){try{var t=document.createElement('textarea');t.value=u;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);done();}catch(e){}}
  try{if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(u).then(done,legacy);return;}}catch(e){}
  legacy();
}
window.addEventListener('zf-theme-change',function(){var d=window.ZFTheme&&ZFTheme.isDark();document.querySelectorAll('.zf-theme-ico').forEach(function(i){i.className='zf-theme-ico ph-thin ph-'+(d?'sun':'moon');});document.querySelectorAll('.zf-theme-lbl').forEach(function(s){s.textContent=d?'淺色模式':'深色模式';});});
window.addEventListener('zf-theme-change',function(){mountGisButton._redo=true;mountGisButton();});
function boot(){
  /* 量測：ViewContent＝進到占卜漏斗（/divination） */
  try{var cn=HOME?'home-gua':'divination';if(window.fbq)fbq('track','ViewContent',{content_name:cn});if(window.gtag)gtag('event','view_item',{item_name:cn});}catch(e){}
  var params=new URLSearchParams(location.search);
  var edmT=params.get("t");if(edmT){try{localStorage.setItem("winds_edm_token",edmT);}catch(e){}}
  /* 媒體專屬 token（?pt=）：認持有、單次核銷——存起來，解鎖時帶給後端 */
  var pressT=params.get("pt");if(pressT){try{localStorage.setItem("winds_press_token",pressT);}catch(e){}}
  var saved="";try{saved=localStorage.getItem("winds_google_token")||"";}catch(e){}
  if(saved&&!adoptGoogleToken(saved)){try{localStorage.removeItem("winds_google_token");}catch(e){}}
  var rid=params.get("log_id"),kk=params.get("k")||"",ret=params.get("ret")||"",ref=params.get("ref")||"",pending="";try{pending=sessionStorage.getItem("winds_pending_log_id")||"";}catch(e){}
  if(ref)STATE.ref=ref;   /* 從別人的卦符卡收卡頁「我也起一卦」進來 */
  /* 去表單化：?log_id=&k= 用 log token 看結果，零登入（提醒信、付完款回跳都走這條） */
  if(rid&&kk){STATE.k=kk;STATE.reportMode=true;STATE.step="interpreting";render();pollStatus(rid);return;}
  if(!kk&&rid){try{var sk=localStorage.getItem("winds_ff_log")||"",skk=localStorage.getItem("winds_ff_k")||"";if(sk===String(rid)&&skk)STATE.k=skk;}catch(e){}}
  if(rid||pending){
    if(pending){try{pending_k=localStorage.getItem("winds_ff_log")===pending?(localStorage.getItem("winds_ff_k")||""):"";if(pending_k)STATE.k=pending_k;}catch(e){}try{sessionStorage.removeItem("winds_pending_log_id");}catch(e){}}
    STATE.reportMode=true;   // 完整報告：回訪既有占卜 → 結果頁套站台 Nav/Footer
    STATE.step="interpreting";render();pollStatus(rid||pending);
    if(!STATE.userId&&!STATE.k)initGoogleGIS();
    return;
  }
  /* 回訪一行：提醒信 ?ret=<卦>&k=<token>，或同一支手機上次留過（localStorage；FB 內建瀏覽器可能關了就清，清了就照常問） */
  var rl=ret,rk=kk;if(!(rl&&rk)){try{rl=localStorage.getItem("winds_ff_log")||"";rk=localStorage.getItem("winds_ff_k")||"";}catch(e){}}
  if(rl&&rk){STATE.retLog=rl;STATE.retToken=rk;
    fetch(API.prefill+"?ret="+encodeURIComponent(rl)+"&k="+encodeURIComponent(rk)).then(function(r){return r.json();}).then(function(d){
      if(d&&d.found){STATE.retInfo=d;STATE.ret=true;if(STATE.step==="hex")render();}
    }).catch(function(){});}
  else if(STATE.userId)doPrefill();
  render();
}
var pending_k="";

/* 對外（onclick handlers 需 global）*/
window.pickDir=pickDir;window.pickSub=pickSub;window.pickQ=pickQ;
window.go=go;window.back=back;window.exitFlow=exitFlow;window.openOA=openOA;window.askAnother=askAnother;
window.submitFree=submitFree;window.ffSet=ffSet;window.ffNext=ffNext;window.ffPrev=ffPrev;window.ffNextState=ffNextState;window.ffEditRet=ffEditRet;window.shareCard=shareCard;window.createOrder=createOrder;window.shareResult=shareResult;window.loadFullContent=loadFullContent;window.genSpirit=genSpirit;
window.STATE=STATE;

boot();
</script>
<!-- 帶 utm 進站記點（2026-09-06 補）：占卜頁沒用 BaseLayout，之前從活動頁／社群帶 utm 進來的人 D1 一列都沒有，
     漏斗第四站是瞎的。與 BaseLayout 那段逐字相同：sendBeacon → api.winds.tw/hit → D1 link_hits。 -->
<script is:inline>
  (function () {
    var q = new URLSearchParams(location.search);
    var c = q.get('utm_content');
    var s = q.get('utm_source');
    if (!c && !s) return;
    try {
      navigator.sendBeacon('https://api.winds.tw/hit', JSON.stringify({
        path: location.pathname,
        utm_source: s || '',
        utm_content: c || '',
      }));
    } catch (e) {}
  })();
</script>
