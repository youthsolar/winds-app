/* ── 4 老師開口問（一次一題，每題一個可以玩的控制項）── */
function ffWho(){return '<div class="ff-who"><span class="ff-av">風</span>風易揚老師</div>';}
function ffBub(t,me){return '<div class="ff-bub'+(me?' me':'')+'">'+t+'</div>';}
function shiName(i){return SHI[i][0]+"時";}
function viewAsk(){
  var k=ASK[STATE.ask],d=STATE.data;
  /* 問句照 ASK 順序長出來；home 模式多了第一題「家的情形」，年份那題的開場跟著改口 */
  var QS={year:HOME?"好。要配符給你，得先看你的命盤。你哪一年出生的？":"這一卦我看到了。要配符給你，得先看你的命盤。你哪一年出生的？",
    month:"幾月？",day:"幾號？",shi:"那天你是什麼時候出生的？不確定就放在中午。",gender:"命盤要分陰陽。你是？",name:"我要怎麼稱呼你？",
    email:"留個信箱。這張卦符七天內有效，到期前我提醒你回來。"};
  function ansOf(key){switch(key){case "year":return d.year+" 年";case "month":return d.month+" 月";case "day":return d.month+" 月 "+d.day+" 日";case "shi":return shiName(d.shi);case "gender":return esc(d.gender);case "name":return esc(d.name||"—");}return "";}
  var all=[];
  for(var qi=0;qi<=STATE.ask;qi++){if(qi>0)all.push(ffBub(ansOf(ASK[qi-1]),1));all.push(ffBub(QS[ASK[qi]]));}
  var bubbles=all.slice(-3).join("");
