/* ===== progress header ===== */
function header(){
  var sk={hex:"cast",ret:"ask",landing:"cast"}[STATE.step]||STATE.step;
  var idx=Math.max(0,STEPS.findIndex(function(s){return s.k===sk}));
  var pct=((idx+(STATE.step==="result"?1:0.5))/STEPS.length)*100;
  var steps=STEPS.map(function(s,i){
    var cls=i<idx?"done":(i===idx?"cur":"");
    var num=i<idx?ic("check","bold"):(i+1);
    return '<span class="ph-step '+cls+'"><span class="ph-num">'+num+'</span><span class="ph-lbl">'+s.l+'</span></span>'+(i<STEPS.length-1?'<span class="ph-sep"></span>':'');
  }).join("");
  return '<header class="ph-hdr"><div class="row">'+
    '<button class="ph-back" onclick="back()">'+ic("arrow-left")+'<span>上一步</span></button>'+
    '<div class="ph-steps">'+steps+'</div>'+
    '<span class="ph-mob"><b>'+(idx+1)+'</b> / '+STEPS.length+' · '+STEPS[idx].l+'</span>'+
    '<div style="display:flex;align-items:center;gap:10px"><button class="ph-exit" onclick="window.ZFTheme&&ZFTheme.toggle()" aria-label="切換深淺色"><i class="zf-theme-ico ph-thin ph-'+(window.ZFTheme&&ZFTheme.isDark()?'sun':'moon')+'"></i></button>'+
    '<button class="ph-exit" onclick="exitFlow()">'+ic("x")+'</button></div>'+
    '</div><div class="ph-bar"><span style="width:'+pct+'%"></span></div></header>';
}

/* ===== Step 1 topic ===== */
function viewTopic(){
  var dir=TOPICS.find(function(t){return t.key===STATE.dir});
  var sub=dir&&dir.subs.find(function(s){return s.key===STATE.sub});
  var h='';
  var intro = dir
    ? {e:"想問一件事",t:"好，我們繼續往下看。",l:"先選一個最接近你的問題。"}
    : {e:"想問一件事",t:"今天，想讓哪件事安心？",l:"先選一個大方向，我再陪你找出那個不安的點"};
  h+='<div class="step-intro"><span class="eyebrow"><span class="dot"></span>'+intro.e+'</span><h1>'+intro.t+'</h1><p class="lede">'+intro.l+'</p></div>';
  if(dir){
    h+='<div class="crumbs"><button class="crumb" onclick="pickDir(null)">'+esc(dir.title)+ic("pencil-simple")+'</button>';
    if(sub)h+='<button class="crumb" onclick="pickSub(null)">'+esc(sub.name)+ic("pencil-simple")+'</button>';
    h+='</div>';
  }
  if(!dir){
    h+='<div class="dir-grid">'+TOPICS.map(function(t){
      return '<button class="dir-card" onclick="pickDir(\''+t.key+'\')"><span class="dir-mark '+t.tone+'">'+t.mark+'</span>'+
        '<span><span class="dir-title">'+esc(t.title)+'</span><br><span class="dir-sub">'+esc(t.sub)+'</span></span></button>';
    }).join("")+'</div>';
  } else if(!sub){
    h+='<div class="fade"><p class="section-q">關於「'+esc(dir.title)+'」，比較接近哪一種？</p><div style="display:flex;flex-wrap:wrap;gap:10px">'+
      dir.subs.map(function(s){return '<button class="chip" onclick="pickSub(\''+s.key+'\')">'+esc(s.name)+'</button>'}).join("")+'</div></div>';
  } else {
    h+='<div class="fade"><p class="section-q">哪個狀況最接近你現在想問的問題？</p><div class="q-list">'+
      sub.qs.map(function(q){var on=STATE.q===q.q;
        return '<button class="q-item'+(on?' on':'')+'" style="align-items:flex-start" onclick="pickQ(this,\''+esc(q.q).replace(/'/g,"\\'")+'\')"><span class="q-radio" style="margin-top:5px"></span><span><span style="display:block">'+esc(q.q)+'</span><span style="display:block;font-family:var(--font-sans);font-size:13px;color:var(--text-muted);margin-top:3px">'+esc(q.desc||'')+'</span></span></button>';
      }).join("")+'</div>';
    if(STATE.q){
      h+='<div class="fade"><div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px">'+
        '<span style="font-family:var(--font-sans);font-size:14px;font-weight:500;color:var(--ink-700)">接著補上實際情況，愈具體愈準。</span>'+
        '<span style="font-family:var(--font-sans);font-size:12px;color:var(--text-muted)">'+STATE.text.length+' / 300</span></div>'+
        '<textarea class="f-textarea" maxlength="300" rows="'+Math.max(4,Math.min(10,Math.ceil(STATE.text.length/22)+1))+'" oninput="STATE.text=this.value;this.style.height=\'auto\';this.style.height=this.scrollHeight+\'px\'" style="font-size:18px">'+esc(STATE.text)+'</textarea>'+
        '<p class="hint" style="margin-top:8px">'+ic("sparkle")+'占卜前，靜心默想一位神尊或天使做主。</p>'+
        '<p class="hint" style="margin-top:4px">'+ic("heart")+'一次問一件事，解讀會更清楚也更貼近你。</p>'+
        '<div style="margin-top:28px"><button class="zf-btn primary lg" onclick="go(\'cast\')">就問這個 '+ic("arrow-right")+'</button></div></div>';
    }
    h+='</div>';
  }
  // 選方向那一步是三欄卡片，塞進 680px narrow 只剩每行 9 個中文字（實測 137px／15px），
  // 「那個人」「收入」「壓力」都被拆行、末行還空掉 78% 的寬度。只有這一步放寬到 1120px
  // （每行 ~19 字）；後面的問題清單與補述框仍走 narrow——那是閱讀／填寫欄，680px 才對。
  return '<main class="shell'+(dir?' narrow':'')+'">'+h+'</main>';
}
function pickDir(k){STATE.dir=k;STATE.sub=null;STATE.q=null;STATE.text="";render()}
function pickSub(k){STATE.sub=k;STATE.q=null;STATE.text="";render()}
function pickQ(el,qt){
  STATE.q=qt;
  var d=TOPICS.find(function(t){return t.key===STATE.dir})||{};
  var s=(d.subs||[]).find(function(x){return x.key===STATE.sub})||{};
  var qo=(s.qs||[]).find(function(x){return x.q===qt})||{};
  STATE.service=qo.service||"";
  STATE.text="我目前最想處理的問題是「"+(d.title||"")+" - "+(s.name||"")+"」，狀況比較接近「"+qt+"」："+(qo.desc||"")+"　實際情況是：";
  render();
}

