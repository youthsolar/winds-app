var SHI=[["子","23–01","00:00"],["丑","01–03","02:00"],["寅","03–05","04:00"],["卯","05–07","06:00"],["辰","07–09","08:00"],["巳","09–11","10:00"],["午","11–13","12:00"],["未","13–15","14:00"],["申","15–17","16:00"],["酉","17–19","18:00"],["戌","19–21","20:00"],["亥","21–23","22:00"]];
var ASK=["year","month","day","shi","gender","name","email"];   /* home 模式的「家的情形」放在看到卦那一頁，不進逐題問 */
var FF_STARS=(function(){var s=7;function rnd(){s=(s*9301+49297)%233280;return s/233280;}var pts=[];for(var i=0;i<26;i++){var a=rnd()*Math.PI*2,r=0.18+Math.sqrt(rnd())*0.72;pts.push({x:0.5+r*0.5*Math.cos(a),y:0.5+r*0.5*Math.sin(a),r:0.6+rnd()*1.3,o:0.22+rnd()*0.5,d:rnd()*6});}return pts;})();
var FF_REDUCE=!!(window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches);
function ffStars(size){return '<svg class="ff-stars" viewBox="0 0 '+size+' '+size+'">'+FF_STARS.map(function(p,i){return '<circle cx="'+(p.x*size).toFixed(1)+'" cy="'+(p.y*size).toFixed(1)+'" r="'+p.r.toFixed(2)+'" opacity="'+p.o.toFixed(2)+'"'+(FF_REDUCE?'':' style="animation:ffTwinkle '+(5+(i%4))+'s ease-in-out '+p.d.toFixed(2)+'s infinite alternate"')+'/>'}).join("")+'</svg>';}
function ffYaos(code,rising){return '<div class="ff-yaos">'+String(code||"000000").split("").map(function(c,i){var shown=(6-i)<=rising;return '<div class="ff-yao'+(c==="1"?' yang':'')+(shown?' on':'')+'">'+(c==="1"?'<i></i>':'<i></i><i></i>')+'</div>'}).join("")+'</div>';}
function ffDialTicks(size,year){var c=size/2,off=year%10,t='';for(var i=0;i<60;i++){var a=((i*6-off*6)*Math.PI)/180,big=i%10===0,r1=big?c*0.80:c*0.86,r2=c*0.93;t+='<line x1="'+(c+r1*Math.cos(a)).toFixed(1)+'" y1="'+(c+r1*Math.sin(a)).toFixed(1)+'" x2="'+(c+r2*Math.cos(a)).toFixed(1)+'" y2="'+(c+r2*Math.sin(a)).toFixed(1)+'" stroke-width="'+(big?2:1)+'" opacity="'+(big?0.85:0.45)+'"/>';}return '<svg class="ff-ticks" viewBox="0 0 '+size+' '+size+'">'+t+'</svg>';}
/* 水鏡：mode cast|reveal|dial；純 CSS 鏡身（黑漆鏡緣＋細金邊＋五行水色），token 兩主題不翻 */
function ffMirror(mode,o){
  o=o||{};var size=o.size||236,inner=size-20;
  var body=mode==="dial"
    ? ffDialTicks(inner,o.year)+'<div class="ff-dialtxt"><div class="ff-dial-k">轉輪鏡</div><div class="ff-dial-y" id="ffDialY">'+o.year+'</div><div class="ff-dial-m" id="ffDialM">民國 '+(o.year-1911)+'</div></div>'
    : '<div class="ff-hexc" id="ffYaos">'+ffYaos(o.code,o.rising||0)+'</div>';
  return '<div class="ff-mirrorwrap">'+
    '<div class="ff-mirror'+(mode==="dial"?' dial':mode==="cast"?' cast':'')+'" id="ffMirror" style="width:'+size+'px;height:'+size+'px" role="'+(mode==="dial"?'slider':'button')+'" aria-label="'+(mode==="dial"?'轉輪鏡選年份':'按住水面')+'">'+
    ffStars(inner)+'<span class="ff-sheen"></span><div class="ff-rips" id="ffRips"></div>'+body+'</div>'+
    (mode!=="dial"?'<div class="ff-hexname'+((o.rising||0)>=6&&o.name?' on':'')+'" id="ffHexName">'+esc(o.name||'')+'</div>':'')+
    '</div>';
}
/* 漣漪：一組 3～4 圈依序往外散（3.2s）；閒置每 5.2s 一組，按住 1.6s 一組 */
var FF_RIP={timer:null,busy:false};
function ffRipBurst(){var box=document.getElementById("ffRips");if(!box||FF_REDUCE)return;var n=3+Math.round(Math.random());for(var k=0;k<n;k++){setTimeout(function(){var b=document.getElementById("ffRips");if(!b)return;var s=document.createElement("span");b.appendChild(s);setTimeout(function(){if(s.parentNode)s.parentNode.removeChild(s);},3400);},k*380);}}
function ffRipStart(busy){ffRipStop();FF_RIP.busy=!!busy;ffRipBurst();FF_RIP.timer=setInterval(ffRipBurst,busy?1600:5200);}
function ffRipStop(){if(FF_RIP.timer){clearInterval(FF_RIP.timer);FF_RIP.timer=null;}}

