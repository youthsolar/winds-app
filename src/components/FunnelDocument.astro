/* ===== 中文照詞組斷行（2026-09-26 Jeffery：「一張／符令」「最需要／留意」在詞中間被切）=====
   瀏覽器對中文預設逐字換行；用 BudouX（Google 的中文斷詞，assets/budoux-zh-hant.min.js 自託管）把文字包進
   <budoux-zh-hant>，它在詞組邊界插看不見的斷點並套 word-break:keep-all，只准在詞組之間換行。每次 render 後跑一次。 */
var CJK_SEL='.summary .q,.res-h3,.res-note,.res-note-tag .zf-tag,.sum-body,.ff-p,.paywall .veil h3,.paywall .veil p,.gets-t,.get b,.get span,.recs .head h2,.recs .head p,.rec h4,.rec .reason p,.rec-kicker,.hg-h1,.hg-card p,.hg-guide,.lede,.ff-h,.ff-main,.ff-bub,.season-tip .t,.tal-caption,.dir-title,.dir-sub,.section-q,.interp .line,.cool h1,.cool p,.fi-h1,.fi-h2,.fi-body,.tline,.hex-read,.tal5 .ln,.hg-situ,.step-intro h1,.step-intro p';
var cjkParser=null;
function cjkWrap(root){
  if(!root||!window.customElements||!customElements.get('budoux-zh-hant'))return;
  /* 不用 <budoux-zh-hant> 元件（它有 MutationObserver，我們一改文字它就重插），直接借它的 parser 自己切 */
  if(!cjkParser){try{cjkParser=document.createElement('budoux-zh-hant').parser;}catch(e){return;}}
  if(!cjkParser||typeof cjkParser.parse!=='function')return;
  var re=new RegExp(CJK_KEEP.map(function(w){return w.split('').join('\u200b?');}).join('|'),'g');
  var els=root.querySelectorAll(CJK_SEL);
  for(var i=0;i<els.length;i++){
    var el=els[i];if(el.getAttribute('data-cjk'))continue;if(!/[\u3400-\u9fff]/.test(el.textContent))continue;
    el.setAttribute('data-cjk','1');el.classList.add('cjk');
    var walker=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),n,nodes=[];
    while((n=walker.nextNode()))nodes.push(n);
    for(var j=0;j<nodes.length;j++){
      var v=nodes[j].nodeValue;if(!/[\u3400-\u9fff]/.test(v)||v.indexOf('\u200b')>=0)continue;
      var seg=cjkParser.parse(v).join('\u200b').replace(re,function(m){return m.replace(/\u200b/g,'');})
        /* 2026-09-26：BudouX 按 UTF-16 切，會把 emoji（🌙 等四位元組字）切成兩半再插 \u200b → 手機顯示兩個方框。把落在代理對／ZWJ／變體選擇子旁的斷點拿掉 */
        .replace(/([\uD800-\uDBFF\u200D])\u200b|\u200b(?=[\uDC00-\uDFFF\u200D\uFE0E\uFE0F\u20E3])/g,'$1');
      if(seg!==v)nodes[j].nodeValue=seg;
    }
  }
}
var CJK_KEEP=['風易揚老師','風易揚','老師','找風問幸福','通靈水鏡法','元辰宮代觀','元辰宮','水鏡','分靈體','符令','靈符','卦符','解方','命盤','節氣','起卦','卦象','一張','五張','就能','不是','而是','可以','需要','留意','隨機','親手','繪製','書寫','開光','桌布','手機','家裡','新家','入住','房子','狀況','完整解讀','陪伴','七天','7 天'];
/* 第一次 render 可能早於 defer 的 budoux 載完：載完再補跑一次 */
window.addEventListener('load',function(){cjkWrap(document.getElementById('root'));});
function render(){
  if(interpTimer){interpTimer();interpTimer=null;}
  document.body.classList.toggle("show-concierge",STATE.step==="result"||STATE.step==="cooldown");
  var root=document.getElementById("root");
  // 完整報告模式：以 log_id 回訪、已渲染結果頁 → 套站台 Nav/Footer（取代 funnel 進度條）。
  if(STATE.reportMode&&STATE.step==="result"){
    root.innerHTML=siteHeader()+viewResult()+siteFooter();
    cjkWrap(root);
    wireSiteChrome();
    window.scrollTo(0,0);
    updateFabCta();
    return;
  }
  var showHdr=STATE.step!=="landing"&&STATE.step!=="cooldown"&&STATE.step!=="interpreting"&&STATE.step!=="repeatwall";
  var fn={landing:viewLanding,topic:viewTopic,cast:viewCast,hex:viewHex,ask:viewAsk,ret:viewRet,interpreting:viewInterp,result:viewResult,cooldown:viewCooldown,repeatwall:viewRepeatWall}[STATE.step]||(HOME?viewLanding:viewTopic);
  root.innerHTML=(showHdr?header():"")+fn();
  cjkWrap(root);
  if(HOME&&STATE.step==="landing")wireSiteChrome();
  /* 水鏡：起卦頁掛按住／放開；看到卦頁只呼吸；轉輪鏡掛拖曳；離開就停漣漪計時器 */
  ffRipStop();
  if(STATE.step==="cast"||STATE.step==="landing")ffCastWire();
  else if(STATE.step==="hex")ffRipStart(false);
  else if(STATE.step==="ask"&&ASK[STATE.ask]==="year")ffDialWire();
  window.scrollTo(0,0);
  if(STATE.step==="interpreting")startInterp();
  updateFabCta();
}
/* ===== 浮動付款 CTA（2026-07-20 拍板：點擊捲至付費牆／捲過第一屏浮出／付費牆可見隱藏）===== */
var fabObs=null,fabPwVisible=false;
function fabScroll(){
  var b=document.getElementById("fabCta");if(!b)return;
  b.classList.toggle("show",window.scrollY>window.innerHeight*0.7&&!fabPwVisible);
}
function updateFabCta(){
  var old=document.getElementById("fabCta");
  if(fabObs){try{fabObs.disconnect();}catch(e){}fabObs=null;}
  window.removeEventListener("scroll",fabScroll);
  var paid=STATE.paid||(STATE.result&&STATE.result.purchased);
  var pw=document.querySelector(".paywall");
  if(STATE.step!=="result"||paid||!pw){if(old)old.remove();return;}
  if(!old){
    var b=document.createElement("button");b.id="fabCta";b.className="zf-btn primary fab-cta";
    b.innerHTML=ic("sparkle")+'拿到靈符解方';
    b.onclick=function(){var p=document.querySelector(".paywall");if(p)p.scrollIntoView({behavior:"smooth",block:"center"});};
    document.body.appendChild(b);
  }
  fabPwVisible=false;
  fabObs=new IntersectionObserver(function(es){fabPwVisible=es[0].isIntersecting;fabScroll();},{threshold:.15});
  fabObs.observe(pw);
  window.addEventListener("scroll",fabScroll,{passive:true});
  fabScroll();
}
function go(s){STATE.step=s;render()}
function back(){var map=HOME?{cast:"landing",hex:"landing",ask:"hex",ret:"hex",result:"landing"}:{cast:"topic",hex:"topic",ask:"hex",ret:"hex",result:"topic"};if(map[STATE.step])go(map[STATE.step])}
function exitFlow(){location.href="/";}
function openOA(){window.open(LINE_OA_URL,"_blank");}
function askAnother(){STATE.cast=null;STATE.ask=0;STATE.k="";STATE.shareUrl="";STATE.dir=null;STATE.sub=null;STATE.q=null;STATE.text="";STATE.result=null;STATE.paid=false;STATE.full=null;STATE.fullError=false;STATE.logId="";STATE.repeatWall=null;if(HOME){STATE.data.home="";STATE.dir="home";STATE.q="家裡先留一張符";STATE.text="我想替現在住的地方求一張符，先看看這個家目前的狀況。";}go(HOME?"landing":"topic");}
function showInfoErr(msg){var e=document.getElementById("infoErr");if(e){e.textContent=msg;e.classList.remove("hidden");e.scrollIntoView({behavior:"smooth",block:"center"});}else{alert(msg);}}

/* ===== Google SSO auth ===== */
var googleIdToken="";
function getIdToken(){return googleIdToken||"";}
function authHeaders(extra){var h={"X-Google-Id-Token":getIdToken()};if(extra)for(var k in extra)h[k]=extra[k];return h;}

/* ===== validators ===== */
function validGmail(e){return /^[^\s@]+@gmail\.com$/i.test(e||"");}
/* Email 無感驗證（worker /verify-email → MillionVerifier）：blur 觸發；只有 bad（查無此信箱/拋棄式）才擋 */
var EMAILV={email:"",verdict:""};
function checkEmailLive(email){
  if(!validGmail(email)||EMAILV.email===email)return;
  EMAILV={email:email,verdict:""};
  fetch(WORKER_API+"/verify-email",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:email})})
    .then(function(r){return r.json();}).then(function(d){
      if(EMAILV.email!==email)return;
      EMAILV.verdict=d.verdict||"";
      if(d.verdict==="bad")showInfoErr("這個 Email 好像有誤（查無此信箱），請再確認一次。");
    }).catch(function(){});
}
document.addEventListener("focusout",function(ev){var t=ev.target;if(t&&t.id==="ffEmail")checkEmailLive(t.value.trim());});
function validPhoneTW(p){return /^09\d{8}$/.test((p||"").replace(/[\s-]/g,""));}
function phoneE164(p){p=(p||"").replace(/[\s-]/g,"");return p.indexOf("0")===0?"+886"+p.slice(1):p;}

/* ===== 送出（去表單化：零登入，靠 log token 看結果）→ interpreting → 輪詢 ===== */
function submitFree(){
  if(STATE.submitting)return;
  if(!STATE.cast||!STATE.cast.code){showFfErr("先回到水鏡起一卦。");go("cast");return;}
  if(!STATE.text){showFfErr("請先回到上一步，選一句想問的話。");go("topic");return;}
  var d=STATE.data,payload;
  if(STATE.ret&&STATE.retInfo){
    if(HOME&&!d.home){showFfErr("先說一聲這張符要守哪裡。");go("hex");return;}
    var r=STATE.retInfo;
    payload={date_of_birth:r.date_of_birth||"",last_name:r.last_name||"",first_name:r.first_name||"",gender:r.gender||"",email:r.email||""};
    STATE.userName={surname:r.last_name||"",given:r.first_name||""};
  }else{
    if(HOME&&!d.home){showFfErr("先說一聲這張符要守哪裡。");go("hex");return;}
    if(!d.month||!d.day||!d.gender||!validGmail(d.email)){showFfErr("老師還有幾題沒問完。");go("ask");return;}
    var nm=splitName(d.name);
    payload={date_of_birth:d.year+"-"+pad2(d.month)+"-"+pad2(d.day)+" "+SHI[d.shi][2],last_name:nm.surname,first_name:nm.given,gender:d.gender,email:d.email};
    STATE.userName={surname:nm.surname,given:nm.given};
  }
  payload.free_flow=true;payload.question=STATE.text;payload.divination_method="雙占卜";
  if(HOME){var hs=homeSitu(STATE.data.home);if(hs){payload.question=STATE.text+"　家的情形："+hs.l+"。";payload.home_situation=hs.k;}}
  payload.cast_code=STATE.cast.code;payload.cast_at=STATE.cast.castAt;
  if(STATE.retLog&&STATE.retToken){payload.k_log_id=Number(STATE.retLog);payload.k=STATE.retToken;}
  if(STATE.ref)payload.ref_log_id=Number(STATE.ref)||undefined;
  var edmTok="";try{edmTok=localStorage.getItem("winds_edm_token")||"";}catch(e){}
  if(edmTok)payload.edm_token=edmTok;
  STATE.submitting=true;STATE.logId="";STATE.k="";STATE.result=null;STATE.paid=false;STATE.full=null;STATE.fullError=false;
  go("interpreting");
  fetch(API.submit,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)})
   .then(function(resp){
     if(!resp.ok){return resp.json().catch(function(){return{};}).then(function(d){
       if(d.recast){STATE.submitting=false;STATE.cast=null;go("cast");setTimeout(function(){showFfErr(d.message||"回到水鏡重新按一次。");},60);return null;}
       if(d.repeat_wall){STATE.repeatWall=d;STATE.logId=d.last_log_id||"";STATE.submitting=false;go("repeatwall");return null;}
       if(resp.status===429||d.blocked){STATE.cooldown={message:d.message,available_at:d.available_at,last_log_id:d.last_log_id||null};STATE.submitting=false;go("cooldown");return null;}
       if(d.error==="email_duplicate"){STATE.submitting=false;STATE.ret=false;STATE.ask=ASK.length-1;go("ask");setTimeout(function(){showFfErr(d.message||"這個信箱已被其他帳號使用。");},60);return null;}
       throw new Error(d.message||d.error||("HTTP "+resp.status));
     });}
     return resp.json();
   })
   .then(function(data){
     if(!data)return;
     if(data.blocked){STATE.cooldown={message:data.message,available_at:data.available_at,last_log_id:data.last_log_id||null};STATE.submitting=false;go("cooldown");return;}
     if(data.success===false){STATE.submitting=false;go(STATE.ret?"ret":"ask");setTimeout(function(){showFfErr(data.message||"發生錯誤，請再試一次。");},60);return;}
     if(data.k){STATE.k=data.k;STATE.logId=String(data.log_id||"");try{localStorage.setItem("winds_ff_log",STATE.logId);localStorage.setItem("winds_ff_k",STATE.k);}catch(e){}}
     if(data.pending){if(data.warm_urls&&data.warm_urls.length){warmCards(data.warm_urls.slice());}pollStatus(data.log_id||"",true);return;}
     finishResult(data);
   })
   .catch(function(e){STATE.submitting=false;go(STATE.ret?"ret":"ask");setTimeout(function(){showFfErr("送出失敗："+e.message);},60);});
}

/* 預抓要一張接一張（同時抓＝多開無頭瀏覽器互搶，反而更慢還會 404）：卦符卡先，再第 1 張模糊卡（後端會五張一起出），其餘直接命中 */
function warmCards(list){if(!list.length)return;var im=new Image();im.onload=im.onerror=function(){warmCards(list);};im.src=list.shift();}
function pollStatus(logId,alreadyWarm){
  var attempts=0,max=23,warmed=!!alreadyWarm; /* 2026-09-25：等解卦時先把卦符卡＋五張模糊卡抓一次，結果頁一開圖就在 */
  var ident=STATE.k?("&k="+encodeURIComponent(STATE.k)):("&google_sub="+encodeURIComponent(STATE.userId||""));
  var timer=setInterval(function(){
    attempts++;
    fetch(API.status+"?log_id="+encodeURIComponent(logId)+ident,{headers:authHeaders()})
     .then(function(r){return r.json();}).then(function(d){
       if(d.warm_urls&&d.warm_urls.length&&!warmed){warmed=true;warmCards(d.warm_urls.slice());}
       if(d.ready&&d.summary){clearInterval(timer);finishResult(d,logId);}
       else if(attempts>=max){clearInterval(timer);STATE.submitting=false;go(STATE.k?"hex":"info");setTimeout(function(){showFfErr("老師還在寫，稍後再回來這一頁看。");},60);}
     }).catch(function(){if(attempts>=max){clearInterval(timer);STATE.submitting=false;go(STATE.k?"hex":"info");setTimeout(function(){showFfErr("連線中斷，稍後再回來這一頁看。");},60);}});
  },4000);
}

function finishResult(d,logId){
  STATE.submitting=false;
  STATE.logId=d.log_id||d.reading_id||logId||"";
  STATE.shareUrl=d.share_url||"";
  if(d.next_action)STATE.talismanName=d.next_action.talisman_name||STATE.talismanName;
  STATE.result=buildResult(d);
  STATE.paid=!!d.purchased;
  /* 回看模式（會員中心 ?log_id=）沒走表單，userName 用後端回的真名補上，姓名學才有得算 */
  if(!STATE.userName&&d.client_last_name)STATE.userName={surname:d.client_last_name,given:d.client_first_name||""};
  if(!STATE.userName&&d.client_first_name)STATE.userName={surname:"",given:d.client_first_name||""};
  go("result");
  if(STATE.paid)loadFullContent();
  if(STATE.logId)loadRecs(STATE.logId);
  loadNaming();
}

/* 把這一卦傳給那個該看到的人：連結＝收卡頁（零登入、縮圖＝同一張卦符卡） */
function shareCard(btn){
  var url=STATE.shareUrl;if(!url)return;
  var R=STATE.result||{};var text="有人替你起了一卦——"+(R.hexName||"")+"。找風問幸福 · 風易揚老師親繪";
  function ok(){if(btn){var o=btn.innerHTML;btn.innerHTML=ic("check","bold")+'已複製連結';setTimeout(function(){btn.innerHTML=o;},2200);}}
  function manual(){prompt("複製這個連結傳給對方：",url);}
  function copy(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(url).then(ok,manual);}else manual();}
  if(navigator.share){navigator.share({title:"有人替你起了一卦",text:text,url:url}).catch(function(e){if(!e||e.name!=="AbortError")copy();});return;}
  copy();
}

