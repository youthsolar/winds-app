/* ── 2 起卦 ── */
var FF_CAST={t:null,rising:0,busy:false};
function viewCast(){
  return '<main class="shell narrow ff"><div class="step-intro"><span class="eyebrow"><span class="dot"></span>起卦</span><h1 class="ff-h">'+esc(STATE.q||"")+'</h1>'+
    '<p class="lede">把心裡的事想一遍，按住鏡面讓漣漪靜下來，卦象就出來了。</p></div>'+
    ffMirror("cast",{code:(STATE.cast&&STATE.cast.code)||"000000",rising:0,name:(STATE.cast&&STATE.cast.name)||""})+
    '<div class="ff-clock" id="ffClock"></div></main>';
}
function ffCastWire(){
  var m=document.getElementById("ffMirror");if(!m)return;
  FF_CAST={t:null,rising:0,busy:false};ffRipStart(false);
  function draw(){var y=document.getElementById("ffYaos");if(y&&STATE.cast)y.innerHTML=ffYaos(STATE.cast.code,FF_CAST.rising);var n=document.getElementById("ffHexName");if(n&&STATE.cast){n.textContent=STATE.cast.name;n.classList.toggle("on",FF_CAST.rising>=6);}}
  function stop(){if(FF_CAST.t&&FF_CAST.t!=="done"){clearInterval(FF_CAST.t);FF_CAST.t=null;FF_CAST.rising=0;FF_CAST.busy=false;STATE.cast=null;draw();ffRipStart(false);var c=document.getElementById("ffClock");if(c)c.textContent="";m.classList.remove("busy");}}
  function start(e){
    if(FF_CAST.t)return;e.preventDefault();try{m.setPointerCapture(e.pointerId);}catch(x){}
    /* 2026-09-25：家裡的符要先選狀況才能起卦 */
    if(HOME&&!STATE.data.home){var ch=document.getElementById("hgChips");if(ch)ch.scrollIntoView({behavior:"smooth",block:"center"});showFfErr("先選一個，再按水鏡。");return;}
    FF_CAST.busy=true;m.classList.add("busy");ffRipStart(true);
    FF_CAST.t="pending";
    /* 按下去那一刻起卦：後端用此刻的時間起卦（同 /gua），零資料 */
    fetch(WORKER_API+"/free-cast",{method:"POST"}).then(function(r){return r.json();}).then(function(d){
      if(FF_CAST.t!=="pending")return;               /* 已放開 */
      if(!d||!d.success){FF_CAST.t=null;stop();showFfErr("起卦沒成功，再按一次。");return;}
      STATE.cast={code:d.code,name:d.name,line:d.line,castAt:d.cast_at,castLabel:d.cast_label||""};
      var c=document.getElementById("ffClock");if(c)c.textContent=STATE.cast.castLabel+" 起卦";
      FF_CAST.t=setInterval(function(){
        FF_CAST.rising++;draw();
        if(FF_CAST.rising>=6){clearInterval(FF_CAST.t);FF_CAST.t="done";FF_CAST.busy=false;ffRipStart(false);setTimeout(function(){if(STATE.step==="cast"||STATE.step==="landing")go("hex");},1700);}
      },520);
    }).catch(function(){FF_CAST.t=null;stop();showFfErr("連線不穩，再按一次。");});
  }
  function release(){if(FF_CAST.t==="pending"){FF_CAST.t=null;stop();return;}stop();}
  m.addEventListener("pointerdown",start);m.addEventListener("pointerup",release);m.addEventListener("pointercancel",release);
}
function showFfErr(msg){var e=document.getElementById("ffErr");if(!e){e=document.createElement("div");e.id="ffErr";e.className="ff-err";var r=document.getElementById("root");if(r)r.appendChild(e);}e.textContent=msg;e.style.display="block";setTimeout(function(){e.style.display="none";},4000);}

