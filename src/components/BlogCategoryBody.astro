---
// 分類頁 body — 值逐項對齊 handoff mockup（blog-service-pages.jsx BlogCategory）
// 由 [cat].astro（page1）與 [cat]/[page].astro（page2+）共用
import type { CollectionEntry } from 'astro:content';

interface CatMeta { name: string; count: number; }
interface Props {
  cat: string;
  posts: CollectionEntry<'blog'>[];   // 本頁的文章（已切片）
  allCats: CatMeta[];                  // 全分類（膠囊用）
  page: number;
  totalPages: number;
}
const { cat, posts, allCats, page, totalPages } = Astro.props;
const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const total = allCats.find(c => c.name === cat)?.count ?? posts.length;

// 分頁連結：page1 = /blog/category/{cat}/，page n>=2 = /blog/category/{cat}/{n}/
const pageHref = (n: number) => n <= 1 ? `/blog/category/${cat}/` : `/blog/category/${cat}/${n}/`;
// 頁碼序列（含省略號）
function pageItems(cur: number, tot: number): (number | '…')[] {
  if (tot <= 7) return Array.from({ length: tot }, (_, i) => i + 1);
  const out: (number | '…')[] = [1];
  const lo = Math.max(2, cur - 1), hi = Math.min(tot - 1, cur + 1);
  if (lo > 2) out.push('…');
  for (let i = lo; i <= hi; i++) out.push(i);
  if (hi < tot - 1) out.push('…');
  out.push(tot);
  return out;
}
const items = pageItems(page, totalPages);
---

<main class="cat-page">
  <nav class="breadcrumb" aria-label="麵包屑">
    <a href="/">首頁</a>
    <i class="ph ph-caret-right"></i>
    <a href="/blog/">案例專欄</a>
    <i class="ph ph-caret-right"></i>
    <span class="current">{cat}</span>
  </nav>

  <header class="cat-header">
    <div class="title-row">
      <h1 class="cjk-title">{cat}</h1>
      <span class="count">{total} 篇文章</span>
    </div>
    <p class="intro cjk-title">關於{cat}的真實個案與靈性陪伴。慢慢看，總有一篇，說中你正在經歷的事。</p>
  </header>

  <nav class="cat-nav" aria-label="文章分類">
    {allCats.map(c => (
      <a href={`/blog/category/${c.name}/`} class={`cat-pill${c.name === cat ? ' active' : ''}`}>
        {c.name}<span class="cat-count">{c.count}</span>
      </a>
    ))}
  </nav>

  <ul class="post-grid">
    {posts.map(post => (
      <li>
        <a class="zf-card interactive art-card" href={`/blog/${post.id}/`}>
          <h3 class="art-title cjk-title">{post.data.title}</h3>
          <p class="art-desc">{post.data.description}</p>
          <div class="art-meta">
            <time>{fmtDate(post.data.pubDate)}</time>
            {post.data.tags.slice(0, 3).map((tag: string) => (<span class="tag">#{tag}</span>))}
          </div>
        </a>
      </li>
    ))}
  </ul>

  {totalPages > 1 && (
    <nav class="pager" aria-label="分頁">
      {items.map(it => (
        it === '…'
          ? <span class="pg gap">…</span>
          : <a class={`pg${it === page ? ' current' : ''}`} href={pageHref(it)} aria-current={it === page ? 'page' : undefined}>{it}</a>
      ))}
      {page < totalPages && <a class="pg" href={pageHref(page + 1)} aria-label="下一頁"><i class="ph ph-caret-right"></i></a>}
    </nav>
  )}

  <div class="reading-cta-wrap">
    <section class="reading-cta">
      <p class="rc-line cjk-title">想知道你現在的量能狀態？</p>
      <a class="zf-btn primary lg" href="/" style="font-size:17px">立即占卜</a>
    </section>
  </div>
</main>

<style>
  .cat-page { max-width: var(--container); margin: 0 auto; padding: 44px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .cat-page { padding: 28px 20px 48px; } }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* breadcrumb */
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
  @media (max-width: 760px) { .breadcrumb { margin-bottom: 18px; } }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-press); }
  .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }
  .breadcrumb .current { color: var(--accent-press); }

  /* header */
  .cat-header { padding-bottom: 30px; border-bottom: 1px solid var(--border-soft); }
  @media (max-width: 760px) { .cat-header { padding-bottom: 22px; } }
  .title-row { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .cat-header h1 { font-family: var(--font-serif); font-size: 40px; font-weight: 500; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .cat-header h1 { font-size: 30px; } }
  .cat-header .count { font-family: var(--font-sans); font-size: 15px; color: var(--text-muted); }
  .cat-header .intro { font-family: var(--font-serif); font-weight: 300; font-size: 17px; line-height: 1.8; color: var(--text-secondary); margin: 12px 0 0; max-width: none; }
  @media (max-width: 760px) { .cat-header .intro { font-size: 15.5px; } }

  /* category pills（active 實心，無外卡） */
  .cat-nav { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 30px; }
  @media (max-width: 760px) { .cat-nav { margin-top: 22px; } }
  .cat-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: var(--radius-pill); background: var(--rose-50); border: 1px solid var(--rose-100); color: var(--ink-700); font-family: var(--font-serif); font-size: 15.5px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: all var(--dur-fast) var(--ease-soft); }
  .cat-pill:hover { background: var(--accent); border-color: transparent; color: var(--text-on-accent); text-decoration: none; }
  .cat-pill .cat-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--surface-card); font-family: var(--font-sans); font-size: 11.5px; font-weight: 600; color: var(--ink-500); }
  .cat-pill.active { background: var(--accent); border-color: transparent; color: var(--text-on-accent); }
  .cat-pill.active .cat-count { background: var(--frost-on-accent, rgba(255,253,248,0.22)); color: var(--text-on-accent); }

  /* article cards（同首頁） */
  .post-grid { list-style: none; padding: 0; margin: 44px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: stretch; }
  @media (max-width: 760px) { .post-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 32px; } }
  /* art-card = DS zf-card interactive（去重；保留 layout + 標題 hover 變色）*/
  .art-card { display: flex; flex-direction: column; height: 100%; padding: 24px 26px; text-decoration: none; color: inherit; }
  @media (max-width: 760px) { .art-card { padding: 20px; } }
  .art-title { font-family: var(--font-serif); font-size: 19.5px; font-weight: 500; line-height: 1.45; letter-spacing: 0.01em; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .art-title { font-size: 18px; } }
  .art-card:hover .art-title { color: var(--accent-press); }
  .art-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14.5px; line-height: 1.85; color: var(--text-secondary); margin: 11px 0 0; max-width: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .art-meta { margin-top: auto; padding-top: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .art-meta time { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
  .art-meta .tag { font-family: var(--font-sans); font-size: 12.5px; color: var(--rose-500); white-space: nowrap; }

  /* pagination */
  .pager { margin-top: 48px; display: flex; align-items: center; justify-content: center; gap: 8px; }
  @media (max-width: 760px) { .pager { margin-top: 36px; } }
  .pg { min-width: 44px; height: 44px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-size: 14px; border-radius: var(--radius-md); background: var(--surface-card); border: 1px solid var(--border-soft); color: var(--ink-700); text-decoration: none; }
  .pg:hover { border-color: var(--rose-300); color: var(--accent-press); text-decoration: none; }
  .pg.current { background: var(--accent); border-color: transparent; color: var(--text-on-accent); }
  .pg.gap { border: none; background: transparent; color: var(--text-muted); }
  .pg .ph { font-size: 15px; }

  /* CTA */
  .reading-cta-wrap { margin-top: 84px; }
  @media (max-width: 760px) { .reading-cta-wrap { margin-top: 56px; } }
  .reading-cta { padding: 38px 32px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  @media (max-width: 760px) { .reading-cta { padding: 30px 22px; } }
  .rc-line { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); margin: 0 0 20px; }
  @media (max-width: 760px) { .rc-line { font-size: 19px; } }
</style>
