---
import BaseLayout from '../layouts/BaseLayout.astro';
// 常見問題頁 — 值對齊 handoff faq-page.jsx；原生 <details name> 排他手風琴（免 JS、答案在 HTML 可爬）
const FAQ_GROUPS = [
  { g: '占', title: '關於占卜', items: [
    { q: '我沒接觸過命理，也可以來嗎？', a: '當然可以。你不需要懂任何命理術語，也不必先把問題想清楚。把心裡的事說出來，剩下的我們一起看。' },
    { q: '占卜和預約老師對談，差在哪裡？', a: '占卜是輕鬆的入口——抽一張牌，看看現在的心境與方向，適合心裡有個小問題的時候。老師對談是更深入的陪伴，約 60 分鐘，適合想把一件事好好談透。' },
    { q: '結果準不準？', a: '命理不是預言，不會告訴你「一定會怎樣」。它更像一面鏡子，幫你看清現在的狀態與選擇。要不要走、怎麼走，決定權一直在你手上。' },
    { q: '易經、塔羅、紫微，我該選哪一個？', a: '問一件具體的事，適合易經；想看當下的心境，塔羅最直接；想了解一生的格局與流年，選紫微。不確定的話，先抽一張牌，過程中我們也會幫你判斷。' },
  ]},
  { g: '約', title: '預約與費用', items: [
    { q: '怎麼預約老師？', a: '在「老師介紹」選一位你有感覺的老師，挑好日期與時段，填好你想聊的事，完成付款就預約成功。確認信會寄到你的信箱。' },
    { q: '費用怎麼算？', a: '占卜結果的完整解讀為 NT$ 360，包含你的命盤摘要、靈符與分靈體對話。老師對談則依老師與時長計費，每位老師的價格會清楚標在介紹頁。' },
    { q: '可以改時間或取消嗎？', a: '可以。請在預約時段的 24 小時前，到會員中心調整或取消，系統會協助你改期。臨時有事也別擔心，先跟我們說。' },
    { q: '是線上還是實體？', a: '目前以線上對談為主，視訊或語音都可以，在家就能進行。若有實體場次，會另外在預約頁標示。' },
  ]},
  { g: '私', title: '隱私與資料', items: [
    { q: '我說的事會被保密嗎？', a: '會。對談內容只在你與老師之間，我們不會外流。你可以放心把真正在意的事說出來。' },
    { q: '為什麼要填出生年月日時辰？', a: '紫微、八字這類命盤需要準確的出生時間才能排出。這些資料只用於排盤與解讀，存放在你的會員資料中，你隨時可以查看或刪除。' },
    { q: '可以刪除我的資料嗎？', a: '可以。到會員中心就能管理你的個人資料，也能要求我們完全刪除你的紀錄。' },
  ]},
  { g: '師', title: '老師與對談', items: [
    { q: '老師是怎麼挑選的？', a: '每位老師都有各自擅長的領域與風格。你可以在介紹頁看到他們的專長、引言與評價，挑一位語氣讓你安心的。占卜後，我們也會依你的問題幫你推薦適合的老師。' },
    { q: '對談前要準備什麼嗎？', a: '什麼都不用準備。帶著你想聊的那件事就好。如果方便，找一個安靜、不被打擾的空間，會更容易放鬆。' },
    { q: '分靈體對話是什麼？', a: '分靈體是依你的命盤生成、最懂你的一個對話對象。完整解讀後即可解鎖，陪你在日常裡隨時聊聊，也能感應你在意的對象的頻率。' },
  ]},
];

const pageDesc = '找風問幸福常見問題：占卜怎麼開始、預約與費用、隱私與資料、老師與對談。沒接觸過命理也可以來，把心裡的事說出來，我們陪你一起看。';
// FAQPage 結構化資料（GEO/AI Overviews 實體解析）
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ_GROUPS.flatMap(g => g.items).map(it => ({
    '@type': 'Question', name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
let gi = 0;
---
<BaseLayout title="常見問題｜找風問幸福" description={pageDesc} ogType="website" jsonLd={faqLd}>
  <main class="faq">
    <div class="zf-section-heading">
      <span class="zf-sh-eyebrow">常見問題</span>
      <h1 class="zf-sh-title cjk">想問的，這裡先說清楚。</h1>
      <p class="zf-sh-lede">還是不確定的話，隨時可以從一張牌開始，或直接預約老師聊聊。</p>
    </div>

    {FAQ_GROUPS.map((group) => (
      <section class="faq-group">
        <div class="group-head">
          <span class="glyph-disc">{group.g}</span>
          <h2 class="zf-sh-title cjk">{group.title}</h2>
        </div>
        <div class="faq-list">
          {group.items.map((it) => {
            const open = gi++ === 0;
            return (
              <details class="faq-item" name="faq" open={open}>
                <summary>
                  <span class="q cjk">{it.q}</span>
                  <span class="toggle"><i class="ph-bold ph-plus plus"></i><i class="ph-bold ph-minus minus"></i></span>
                </summary>
                <p class="a cjk">{it.a}</p>
              </details>
            );
          })}
        </div>
      </section>
    ))}

    <section class="faq-cta">
      <span class="icon-disc"><i class="ph-thin ph-chat-circle-dots"></i></span>
      <h2 class="cjk">還有想問的嗎？</h2>
      <p class="cta-lede">把你心裡的事說出來，我們陪你一起看。</p>
      <div class="cta-btns">
        <a class="zf-btn lg primary" href="/" style="font-size:17px">抽一張牌</a>
        <a class="zf-btn lg secondary" href="/services/"><i class="ph-thin ph-calendar-heart" style="font-size:16px"></i>預約老師</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .faq { max-width: 760px; margin: 0 auto; padding: 84px 32px 72px; background: var(--surface-page); }
  @media (max-width: 820px) { .faq { padding: 48px 20px 48px; } }
  .cjk { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* SectionHeading → DS .zf-section-heading / .zf-sh-eyebrow / .zf-sh-title / .zf-sh-lede（值相同）*/

  /* group head */
  .faq-group { margin-top: 52px; }
  @media (max-width: 820px) { .faq-group { margin-top: 36px; } }
  .group-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  @media (max-width: 820px) { .group-head { margin-bottom: 4px; } }
  .glyph-disc { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: var(--radius-md); background: var(--surface-card); border: 1px solid var(--rose-100); font-family: var(--font-serif); font-size: 21px; line-height: 1; color: var(--accent-press); }

  /* accordion item（原生 details）*/
  .faq-item { border-bottom: 1px solid var(--border-soft); }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 4px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item .q { font-family: var(--font-serif); font-size: 18px; font-weight: var(--w-medium); color: var(--ink-900); line-height: 1.5; }
  .faq-item .toggle { flex: none; width: 30px; height: 30px; border-radius: 999px; background: var(--surface-tint); display: inline-flex; align-items: center; justify-content: center; transition: background var(--dur-fast) var(--ease-soft); }
  .faq-item .toggle i { font-size: 15px; color: var(--rose-500); }
  .faq-item .toggle .minus { display: none; }
  .faq-item[open] .toggle { background: var(--rose-100); }
  .faq-item[open] .toggle .plus { display: none; }
  .faq-item[open] .toggle .minus { display: inline; }
  .faq-item .a { font-family: var(--font-serif); font-weight: var(--w-light); font-size: 15.5px; line-height: 1.9; color: var(--text-secondary); margin: 0; padding: 0 44px 22px 4px; }
  @media (max-width: 820px) {
    .faq-item summary { padding: 18px 2px; }
    .faq-item .q { font-size: 16.5px; }
    .faq-item .a { font-size: 15px; padding: 0 2px 20px; }
  }

  /* bottom CTA */
  .faq-cta { margin-top: 64px; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); padding: 40px 32px; text-align: center; }
  @media (max-width: 820px) { .faq-cta { margin-top: 44px; padding: 30px 22px; } }
  .faq-cta .icon-disc { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 999px; background: var(--rose-100); margin: 0 auto 14px; }
  .faq-cta .icon-disc i { font-size: 24px; color: var(--rose-500); }
  .faq-cta h2 { font-family: var(--font-serif); font-size: var(--t-h2); font-weight: var(--w-medium); color: var(--ink-900); margin: 0; }
  .cta-lede { font-family: var(--font-serif); font-weight: var(--w-light); font-size: var(--t-body-lg); line-height: 1.7; color: var(--text-secondary); margin: 12px auto 0; max-width: 32rem; text-wrap: pretty; }
  .cta-btns { margin-top: 20px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
