---
// 舊篇存檔：/love-week/<id>/，內容不刪，當搜尋資產；找不到就退回當期。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeekPage from '../../components/WeekPage.astro';
import { WEEK_TOPICS, fetchWeek } from '../../data/week-topics';
const topic = WEEK_TOPICS['love'];
const id = String(Astro.params.week || '').replace(/[^0-9]/g, '');
if (!id) return Astro.redirect(`/${topic.path}/`, 302);
const { data, isCurrent } = await fetchWeek('love', id);
if (!data) return Astro.redirect(`/${topic.path}/`, 302);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<BaseLayout
  title={`${data.range} 的${topic.label}卦・${data.hex.name} · 找風問幸福`}
  description={`${data.range_long}，那一週的${topic.label}走「${data.hex.char}」。${data.line} 風易揚老師的解卦。`}
>
  <WeekPage data={data} topic={topic} isCurrent={isCurrent} />
</BaseLayout>
