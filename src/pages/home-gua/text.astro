---
/* /home-gua/text — 「家裡的符」落地文案純文字版（2026-09-24）。零 script，給不跑 JavaScript 的讀取端（ChatGPT 讀 /home-gua 一直說開不了）。
   noindex＋canonical 指回 /home-gua/，不搶正式頁的索引。文案本體在 components/HomeGuaStatic.astro，兩處共用。 */
import HomeGuaStatic from '../../components/HomeGuaStatic.astro';
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>家裡的符（文字版）· 找風問幸福</title>
  <meta name="description" content="按住水鏡起一卦，風易揚老師照卦給一張卦符，先守住家裡七天，存成手機桌布。" />
  <meta name="robots" content="noindex,follow" />
  <link rel="canonical" href="https://winds.tw/home-gua/" />
  <style>
    body{margin:0;background:#FBF8F3;color:#2B2622;font-family:"Noto Serif TC","Songti TC",serif;line-height:1.85}
    main{max-width:640px;margin:0 auto;padding:32px 20px 56px}
    h1{font-size:28px;font-weight:500;line-height:1.3;margin:6px 0 8px}
    h3{font-size:16px;font-weight:500;margin:18px 0 6px}
    p{margin:0 0 10px;font-size:15.5px}
    .eyebrow{font-size:12.5px;letter-spacing:.06em;color:#8A7F76}
    .dot{display:none}
    .ff-av{display:inline-block;width:34px;height:34px;line-height:34px;text-align:center;border-radius:50%;background:#EAD9D3;margin-right:10px}
    .hg-teacher{display:flex;align-items:center;margin:22px 0}
    .hg-teacher b{display:block}.hg-teacher span:last-child{font-size:12.5px;color:#8A7F76}
    .hg-foot{margin-top:40px;padding-top:18px;border-top:1px solid #E6DED6;font-size:14px;color:#6B625B}
    a{color:#B4746A}
    .note{font-size:13px;color:#8A7F76;margin-top:24px}
  </style>
</head>
<body>
  <HomeGuaStatic />
  <main><p class="note">這一頁是 <a href="https://winds.tw/home-gua/">winds.tw/home-gua/</a> 的文字版，只有文案、沒有起卦功能。要按水鏡起卦請開正式頁。</p></main>
</body>
</html>
