  .share-block h4 { margin: 0 0 8px; font-family: var(--font-serif); font-size: 14.5px; font-weight: 500; color: var(--ink-900); }
  .share-block input { width: 100%; padding: 8px 10px; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 11px; font-family: var(--font-sans); background: var(--surface-page); color: var(--ink-700); margin-bottom: 8px; box-sizing: border-box; }
