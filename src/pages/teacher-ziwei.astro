---
// 紫微斗數 — 老師專用排盤工具（內部）
// 入口：/teacher-ziwei
// 流程：輸密碼 → 填客人生日 → 呼叫 api.winds.tw/admin/teacher-ziwei（不落庫、可連算）
//        → 逐宮解讀走 /admin/teacher-ziwei-interpret
// 視覺：複用正式紫微頁（/ziwei）的命盤/走勢/四化/解讀 render + CSS，對齊 DS ziwei-page.jsx，零手刻。

import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = '老師排盤工具 — 紫微斗數｜找風問幸福（內部）';
const pageDesc = '老師專用紫微排盤工具';

// 生日下拉選項（對齊正式占卜流程 divination.astro：年/月/日 三選單，不用原生 date input）
const years = Array.from({ length: 2026 - 1940 + 1 }, (_, i) => 2026 - i);
const months = Array.from({ length: 12 }, (_, i) => i + 1);
const days = Array.from({ length: 31 }, (_, i) => i + 1);
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="website" noindex={true}>
  <main class="ziwei-main">
    <header class="page-header">
      <span class="eyebrow"><span class="dot"></span>老師專用 · 內部工具</span>
      <h1>紫微排盤工具</h1>
      <p class="lede">輸入客人西元生日與時辰，即時排出 12 宮命盤與深度解讀</p>
    </header>

    <!-- 密碼閘（未輸入密碼時顯示）-->
    <section class="auth-gate" id="auth-gate" hidden>
      <div class="auth-card">
        <h2>請輸入老師密碼</h2>
        <p class="auth-desc">此為老師專用排盤工具，需要密碼才能使用。<br/>密碼由負責人提供，請勿外流。</p>
        <form id="pwd-form" style="display:flex;flex-direction:column;gap:12px;margin-top:6px">
          <!-- 2026-09-30（廣告前全站掃描）：inline 15px 小於 16px，iPhone Safari 點進去會整頁自動放大、進表單後不縮回 → 改 16px（同頁 .ziwei-form input） -->
          <input type="password" id="pwd-input" autocomplete="off" placeholder="老師密碼" style="padding:11px 14px;border:1px solid var(--border-soft);border-radius:var(--radius-md);font-family:var(--font-serif);font-size:16px;text-align:center" />
          <button type="submit" class="submit-btn" style="margin:0">進入排盤工具</button>
          <p id="pwd-error" class="auth-note" style="color:var(--critical);min-height:1.2em" hidden>密碼錯誤，請再試一次</p>
        </form>
      </div>
    </section>

    <!-- 偵測中／排盤中 -->
    <section class="loading-section" id="loading-section" hidden>
      <span class="zf-spinner" style="width:80px;height:80px;border-width:4px"></span>
      <p>正在排出你的命盤…</p>
    </section>

    <section class="form-section" id="form-section" hidden>
      <p class="form-warning">輸入客人的西元生日、時辰、性別即可排盤。此工具不留存資料、可重複為不同客人排盤。</p>
      <form id="ziwei-form" class="ziwei-form">
        <div class="row">
          <label for="name">姓名（選填）</label>
          <input type="text" id="name" name="name" maxlength="20" autocomplete="name" placeholder="顯示在命盤上，可留空" />
        </div>

        <div class="row">
          <label>西元生日</label>
          <div class="date-row">
            <div class="select-wrap" style="flex:1.5">
              <select id="birthYear" name="birthYear" required aria-label="出生年">
                <option value="" disabled selected>年</option>
                {years.map((y) => <option value={y}>{y} 年</option>)}
              </select>
              <i class="ph-bold ph-caret-down caret"></i>
            </div>
            <div class="select-wrap">
              <select id="birthMonth" name="birthMonth" required aria-label="出生月">
                <option value="" disabled selected>月</option>
                {months.map((m) => <option value={m}>{m} 月</option>)}
              </select>
              <i class="ph-bold ph-caret-down caret"></i>
            </div>
            <div class="select-wrap">
              <select id="birthDay" name="birthDay" required aria-label="出生日">
                <option value="" disabled selected>日</option>
                {days.map((d) => <option value={d}>{d} 日</option>)}
              </select>
              <i class="ph-bold ph-caret-down caret"></i>
            </div>
          </div>
        </div>

        <div class="row two-col">
          <div>
            <label for="hour">出生時辰</label>
            <div class="select-wrap">
              <select id="hour" name="hour">
              <option value="">— 不確定（用午時 12:00）—</option>
              <option value="0">早子時（23-00 / 00-01）</option>
              <option value="1">丑時（01-03）</option>
              <option value="3">寅時（03-05）</option>
              <option value="5">卯時（05-07）</option>
              <option value="7">辰時（07-09）</option>
              <option value="9">巳時（09-11）</option>
              <option value="11">午時（11-13）</option>
              <option value="13">未時（13-15）</option>
              <option value="15">申時（15-17）</option>
              <option value="17">酉時（17-19）</option>
              <option value="19">戌時（19-21）</option>
              <option value="21">亥時（21-23）</option>
              </select>
              <i class="ph-bold ph-caret-down caret"></i>
            </div>
          </div>
          <div>
            <label for="gender">性別</label>
            <div class="select-wrap">
              <select id="gender" name="gender" required>
              <option value="女">女</option>
              <option value="男">男</option>
              </select>
              <i class="ph-bold ph-caret-down caret"></i>
            </div>
          </div>
        </div>

        <div class="row">
          <label for="longitude">出生地經度（選填，海外華人建議填）</label>
          <div class="select-wrap">
            <select id="longitude" name="longitude">
            <option value="">— 不校正（適合台灣出生）—</option>
            <option value="121.5">台北 121.5°E</option>
            <option value="116.4">北京 116.4°E（-14 min）</option>
            <option value="114.1">香港 114.1°E（-24 min）</option>
            <option value="139.7">東京 139.7°E（+19 min）</option>
            <!-- 2026-10-01（廣告前全站掃描）：拿掉「新加坡」：後端以經度就近取整推時區（UTC+7），新加坡實際用 UTC+8，校正差一小時會跨時辰；LINE 內頁本來就沒有這個選項 -->
            <option value="-122.4">舊金山 -122.4°E（-10 min）</option>
            <option value="-123.1">溫哥華 -123.1°E（-12 min）</option>
            <option value="-118.2">洛杉磯 -118.2°E（+7 min）</option>
            <option value="-73.9">紐約 -73.9°E（+4 min）</option>
            <option value="-0.1">倫敦 -0.1°E（-0.4 min）</option>
            </select>
            <i class="ph-bold ph-caret-down caret"></i>
          </div>
        </div>

        <!-- 2026-09-28 Jeffery 拍板：選了經度（要做真太陽時校正）就要填實際幾點幾分。
             只選時辰時拿時辰起點去校正，可能校正到前一個時辰、整張盤排錯。 -->
        <div class="row" id="birth-time-row" hidden>
          <label for="birthTime">實際出生時間（幾點幾分）</label>
          <input type="time" id="birthTime" name="birthTime" />
        </div>

        <button type="submit" class="submit-btn">
          <span class="btn-default">排出命盤</span>
          <span class="btn-loading" hidden>計算中…</span>
        </button>

        <p class="form-note">
          老師版為完整解讀（全 12 宮逐宮 + 走勢總述 + 四化飛星），不收費、不留存。
        </p>
      </form>
    </section>

    <section id="result-section" hidden>
      <div class="result-meta">
        <span id="tst-badge" class="tst-badge" hidden></span>
        <button id="again-btn" type="button" class="again-btn">← 再算一位客人</button>
      </div>
      <div id="chart-toggle" class="chart-toggle" hidden>
        <button class="toggle-btn is-active" data-mode="natal">本命盤</button>
        <button class="toggle-btn" data-mode="yearly">流年盤 (今年)</button>
      </div>
      <div id="chart-mount"></div>
      <div id="trend-mount"></div>
      <div id="sihua-mount"></div>
      <div id="interpretation-mount"></div>
    </section>

    <section id="error-section" class="error-section" hidden>
      <p id="error-msg"></p>
    </section>
  </main>
</BaseLayout>

<script>
  import { FOCUS_PALACES, PALACE_LABEL, MUTAGEN_COLOR, MUT_VAL, MUT_COLOR, MUT_ORDER, ICON_ARROW_RIGHT, ICON_SELF_LOOP, ICON_SELF_LOOP_SM, ICON_INFO, ICON_LOCK_OPEN, TOUGH, FLOWER, starColor, BRANCH_POS, calcVirtualAge, renderChart, openZiweiSheet, renderInterpretationSkeleton, buildYearlyContextForApi, renderPalaceText, trendSvg, sihuaFlyStar, sihuaPalaceFlight, sihuaLegend } from '../lib/ziwei-shared';
  import type { Star, AdjStar, Palace, Chart, HoroscopeItem, TrendDecadal, TrendYearly, ZiweiTrend, SihuaTransform, SihuaPalaceFly, ZiweiSihua, Horoscope } from '../lib/ziwei-shared';
  const WORKER_API = 'https://api.winds.tw';

  const form = document.getElementById('ziwei-form') as HTMLFormElement;
  // 選了經度才顯示「實際出生時間」並設為必填（真太陽時校正要用實際時間）
  // disabled 才能讓隱藏時只填一半的時間欄退出表單驗證（hidden／不必填擋不住 badInput）；form.reset() 後也要再同步一次
  function syncBt() {
    const on = !!(document.getElementById('longitude') as HTMLSelectElement | null)?.value;
    const btRow = document.getElementById('birth-time-row') as HTMLElement | null;
    const btIn = document.getElementById('birthTime') as HTMLInputElement | null;
    if (btRow) btRow.hidden = !on;
    if (btIn) { btIn.required = on; btIn.disabled = !on; }
  }
  document.getElementById('longitude')?.addEventListener('change', syncBt); syncBt();
  const authGate = document.getElementById('auth-gate') as HTMLElement;
  const loadingSection = document.getElementById('loading-section') as HTMLElement;
  const formSection = document.getElementById('form-section') as HTMLElement;
  const resultSection = document.getElementById('result-section') as HTMLElement;
  const errorSection = document.getElementById('error-section') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const submitBtn = form?.querySelector('.submit-btn') as HTMLButtonElement;
  const btnDefault = submitBtn?.querySelector('.btn-default') as HTMLElement;
  const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement;

  // === 認證：老師共用密碼（存 localStorage，每次請求帶 X-Teacher-Secret）===
  function getTeacherSecret(): string {
    try { return localStorage.getItem('winds_teacher_secret') || ''; } catch (e) { return ''; }
  }
  function setTeacherSecret(s: string) {
    try { localStorage.setItem('winds_teacher_secret', s); } catch (e) {}
  }
  function clearTeacherSecret() {
    try { localStorage.removeItem('winds_teacher_secret'); } catch (e) {}
  }

  function authHeaders(): Record<string, string> {
    const s = getTeacherSecret();
    return s ? { 'X-Teacher-Secret': s } : {};
  }

  // 目前結果的走勢資料（供 fetchPalace 的 trend 解讀帶入 body）
  let teacherTrend: any = null;
  /* 2026-09-26（Codex 複審抓到）：13 段逐宮解讀是併發打的，老師若在上一位客人還沒跑完就按
     「再算一位客人」，舊請求不會取消。interpStarted 與 cache 雖然在 showResult() 裡宣告、換客人
     會拿到新閉包，但 interpretation-mount 是同一個 DOM 元素，舊回應照樣寫進新客人正在看的畫面，
     於是兩位客人的解讀混在一起。原本那道 currentMode === mode 只擋本命／流年切換，擋不了換人。
     加批次序號：只有最新那一批的回應可以渲染。 */
  let resultGen = 0;
  /* 同一個問題的第二半：下面那個重試用的 click 監聽器原本每算一位客人就往同一個 interpMount 疊一個，
     監聽器不會被移除。算過三位客人之後按一次「重試」會同時打三個不同客人的請求（每個監聽器抓著
     自己那位客人的 chartData 閉包），畫面顯示誰取決於誰先回來。改成只留最新那一個。 */
  let retryHandler: ((ev: Event) => void) | null = null;

  function setLoading(on: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = on;
    btnDefault.hidden = on;
    btnLoading.hidden = !on;
  }

  function hideAllSections() {
    authGate.hidden = true;
    loadingSection.hidden = true;
    formSection.hidden = true;
    resultSection.hidden = true;
    errorSection.hidden = true;
  }

  function showError(msg: string) {
    errorMsg.textContent = msg;
    hideAllSections();
    errorSection.hidden = false;
    // 2026-09-28（Codex 體檢）：原本只剩錯誤文字、表單被收掉，要重新整理才能改或重試 → 表單與輸入留著
    formSection.hidden = false;
    setLoading(false);
    errorSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function resetUI() {
    hideAllSections();
    formSection.hidden = false;
    setLoading(false);
  }

  // 老師版逐宮解讀：吃 inline chart（+ trend），走 /admin/teacher-ziwei-interpret
  async function fetchPalace(chart: Chart, palace: string, mode: 'natal' | 'yearly' = 'natal', yearly?: ReturnType<typeof buildYearlyContextForApi>) {
    const body: Record<string, unknown> = { chart, palace, mode, yearly };
    if (palace === 'trend' && teacherTrend) body.trend = teacherTrend;
    /* 2026-09-26（Codex 複審抓到）：這支原本完全沒有 try/catch。連線失敗或回非 JSON（502 之類）時
       例外會往上冒進逐宮解讀的 while 迴圈，把那個併發 worker 打死；worker 是 Array.from({length:4})
       建的、沒有 .catch()，所以它不再從佇列拿宮位。四個都死掉時剩下的宮位永遠不會被請求，區塊卡在
       「解讀生成中…」而且連重試鈕都不會出現（重試鈕是 renderPalaceText 收到 null 才畫的）。
       改成整支包起來、例外轉成 null：失敗走既有的重試路徑，worker 也繼續跑。 */
    try {
      const r = await fetch(`${WORKER_API}/admin/teacher-ziwei-interpret`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...authHeaders() },
        body: JSON.stringify(body),
      });
      const data = await r.json() as { ok?: boolean; text?: string; paid?: boolean; error?: string };
      return data.ok ? (data.text || '') : null;
    } catch {
      return null;
    }
  }

  // === Design ZiweiTrend（SectionHeading + toggle + paper Card + info reminder + 走勢總述 paywall）===
  function renderTrendSection(mount: HTMLElement | null, chart: Chart, trend?: ZiweiTrend | null, paid?: boolean) {
    if (!mount) return;
    if (!trend || !trend.decadal || !trend.decadal.length) { mount.innerHTML = ''; return; }
    mount.innerHTML = `<section class="ds-trend" style="margin-top:34px;max-width:760px;margin-left:auto;margin-right:auto">`
      + `<div class="ds-heading" style="margin-bottom:18px"><span style="display:inline-flex;align-items:center;gap:8px;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-press)"><span style="width:6px;height:6px;border-radius:999px;background:var(--accent);flex:none"></span>紫微斗數 · 進階盤法</span>`
      + `<h2 style="font-family:var(--font-serif);font-size:24px;font-weight:500;color:var(--ink-900);margin:10px 0 0;line-height:1.3">運勢走勢</h2>`
      + `<p style="font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.8;color:var(--text-secondary);margin:8px 0 0;max-width:34em">大限為十年一運、流年為單一年。走勢分數由星曜廟旺與該運四化推算，僅作輔助參考——實際吉凶以星曜四化的命理邏輯為主。</p></div>`
      + `<div class="ds-trend-toggle" style="display:flex;gap:8px;justify-content:center;margin:18px 0 12px"><button class="ds-tog is-active" data-t="decadal">大限 · 一生</button><button class="ds-tog" data-t="yearly">流年 · 本大限</button></div>`
      + `<div style="background:var(--paper);border:1px solid var(--rose-100);border-radius:var(--radius-md);padding:16px 10px 8px"><div id="trend-chart"></div></div>`
      + `<div style="display:flex;align-items:flex-start;gap:8px;margin:12px 2px 0"><span style="flex:none;margin-top:2px;display:inline-flex;color:var(--rose-300)">${ICON_INFO}</span><span style="font-family:var(--font-sans);font-size:12.5px;line-height:1.7;color:var(--text-muted)">分數僅為走勢的輔助呈現，幫你看出起伏的節奏；實際的吉凶與建議，以星曜四化的命理邏輯為主。</span></div>`
      + `<div style="margin-top:14px;background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-xs);padding:22px 18px"><h3 style="font-family:var(--font-serif);font-size:18px;font-weight:500;color:var(--ink-900);margin:0 0 14px">走勢總述</h3><div style="position:relative"><div class="interp-text loading" data-palace="trend" style="font-family:var(--font-serif);font-weight:300;font-size:15.5px;line-height:1.95;color:var(--ink-800);white-space:pre-wrap;margin:0">走勢總述生成中…</div>${paid ? '' : '<div style="position:absolute;bottom:0;left:0;right:0;height:64px;background:linear-gradient(transparent,var(--surface-card));pointer-events:none"></div>'}</div>${paid ? '' : `<div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding:13px 16px;background:var(--surface-tint);border:1px solid var(--rose-100);border-radius:var(--radius-md);flex-wrap:wrap;gap:12px"><div style="font-family:var(--font-serif);font-weight:300;font-size:14px;color:var(--text-secondary)">完整走勢總述隨占卜完整解讀一併解鎖。</div><button class="ds-unlock-btn" data-unlock style="cursor:pointer;background:var(--accent);color:var(--text-on-accent);border:1px solid transparent;padding:11px 22px;border-radius:var(--radius-pill);font-family:var(--font-serif);font-weight:500;display:inline-flex;align-items:center;gap:8px;box-shadow:var(--shadow-sm)">${ICON_LOCK_OPEN}<span>隨完整解讀解鎖 · <span data-zf-price="num">NT$199</span></span></button></div>`}</div>`
      + `</section>`;
    const box = mount.querySelector('#trend-chart') as HTMLElement;
    const draw = (which: string) => {
      const pts = which === 'yearly'
        ? trend.yearly.years.map((v) => ({ label: String(v.year), sub: v.age + '歲', score: v.score, cur: v.isCurrent }))
        : trend.decadal.map((v) => ({ label: v.ageStart + '-' + v.ageEnd, sub: v.palaceName, score: v.score, cur: v.isCurrent }));
      box.innerHTML = trendSvg(pts, which);
    };
    draw('decadal');
    mount.querySelectorAll('.ds-tog').forEach((b) => b.addEventListener('click', () => {
      mount.querySelectorAll('.ds-tog').forEach((x) => x.classList.toggle('is-active', x === b));
      draw((b as HTMLElement).dataset.t || 'decadal');
    }));
    // 2026-09-28（Codex 體檢）：mount 跨客人共用——addEventListener 每位客人多掛一個（重試會替歷史客人送請求），
    // 前一位的慢回應也會蓋掉這一位。改成 onclick 覆蓋＋回應核對是不是同一批。
    const gen = resultGen;
    const loadNarr = () => fetchPalace(chart, 'trend', 'natal').then((t) => { if (gen === resultGen) renderPalaceText('trend', t, mount); });
    loadNarr();
    mount.onclick = (ev) => {
      if ((ev.target as HTMLElement).closest('[data-unlock]')) { window.location.href = '/divination'; return; }
      if (!(ev.target as HTMLElement).closest('.retry-palace')) return;
      const blk = mount.querySelector('[data-palace="trend"]');
      if (blk) { blk.className = 'interp-text loading'; (blk as HTMLElement).style.cssText = 'font-family:var(--font-serif);font-weight:300;font-size:15.5px;line-height:1.95;color:var(--ink-800);white-space:pre-wrap;margin:0'; blk.setAttribute('data-palace', 'trend'); blk.textContent = '走勢總述生成中…'; }
      loadNarr();
    };
  }

  // === Design ZiweiSihua（SectionHeading + legend + per-palace flight cards + info reminder + 四化飛星解讀 paywall）===
  function renderSihuaSection(mount: HTMLElement | null, chart: Chart, sihua?: ZiweiSihua | null, paid?: boolean) {
    if (!mount) return;
    if (!sihua || !sihua.flies || !sihua.flies.length) { mount.innerHTML = ''; return; }
    const flies = [...sihua.flies].sort((a, b) =>
      (a.fromPalace === '命宮' ? -1 : a.fromIndex) - (b.fromPalace === '命宮' ? -1 : b.fromIndex));
    // worker → Design shape
    const shaped = flies.map((f) => ({
      from: f.fromPalace, stem: f.stem, ming: f.fromPalace === '命宮',
      t: f.transforms.map((x) => ({ ty: x.type, star: x.star, to: x.toPalace, self: x.isSelf })),
    }));
    const cards = shaped.map(sihuaPalaceFlight).join('');
    mount.innerHTML = `<section class="ds-sihua" style="margin-top:34px;max-width:760px;margin-left:auto;margin-right:auto">`
      + `<div class="ds-heading" style="margin-bottom:18px"><span style="display:inline-flex;align-items:center;gap:8px;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-press)"><span style="width:6px;height:6px;border-radius:999px;background:var(--accent);flex:none"></span>紫微斗數 · 進階盤法</span>`
      + `<h2 style="font-family:var(--font-serif);font-size:24px;font-weight:500;color:var(--ink-900);margin:10px 0 0;line-height:1.3">四化飛星</h2>`
      + `<p style="font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.8;color:var(--text-secondary);margin:8px 0 0;max-width:34em">每一宮的天干各自引動祿、權、科、忌，飛入被引動星所在的宮位——呈現宮與宮之間主動的能量牽引；化星落回本宮即為「自化」。</p></div>`
      + sihuaLegend()
      + `<div class="ds-flight-list" style="margin-top:14px;display:flex;flex-direction:column;gap:10px">${cards}</div>`
      + `<div style="display:flex;align-items:flex-start;gap:8px;margin:12px 2px 0"><span style="flex:none;margin-top:2px;display:inline-flex;color:var(--rose-300)">${ICON_INFO}</span><span style="font-family:var(--font-sans);font-size:12.5px;line-height:1.7;color:var(--text-muted)">完整 12 宮飛星依你的命盤帶入（十干四化表與盤面生年四化同源）。</span></div>`
      + `<div style="margin-top:14px;background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-xs);padding:22px 18px"><h3 style="font-family:var(--font-serif);font-size:18px;font-weight:500;color:var(--ink-900);margin:0 0 14px">四化飛星解讀</h3><div style="position:relative"><div class="interp-text loading" data-palace="sihua" style="font-family:var(--font-serif);font-weight:300;font-size:15.5px;line-height:1.95;color:var(--ink-800);white-space:pre-wrap;margin:0">四化飛星解讀生成中…</div>${paid ? '' : '<div style="position:absolute;bottom:0;left:0;right:0;height:64px;background:linear-gradient(transparent,var(--surface-card));pointer-events:none"></div>'}</div>${paid ? '' : `<div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding:13px 16px;background:var(--surface-tint);border:1px solid var(--rose-100);border-radius:var(--radius-md);flex-wrap:wrap;gap:12px"><div style="font-family:var(--font-serif);font-weight:300;font-size:14px;color:var(--text-secondary)">完整四化飛星解讀隨占卜完整解讀一併解鎖。</div><button class="ds-unlock-btn" data-unlock style="cursor:pointer;background:var(--accent);color:var(--text-on-accent);border:1px solid transparent;padding:11px 22px;border-radius:var(--radius-pill);font-family:var(--font-serif);font-weight:500;display:inline-flex;align-items:center;gap:8px;box-shadow:var(--shadow-sm)">${ICON_LOCK_OPEN}<span>隨完整解讀解鎖 · <span data-zf-price="num">NT$199</span></span></button></div>`}</div>`
      + `</section>`;
    // 2026-09-28（Codex 體檢）：mount 跨客人共用——addEventListener 每位客人多掛一個（重試會替歷史客人送請求），
    // 前一位的慢回應也會蓋掉這一位。改成 onclick 覆蓋＋回應核對是不是同一批。
    const gen = resultGen;
    const loadNarr = () => fetchPalace(chart, 'sihua', 'natal').then((t) => { if (gen === resultGen) renderPalaceText('sihua', t, mount); });
    loadNarr();
    mount.onclick = (ev) => {
      if ((ev.target as HTMLElement).closest('[data-unlock]')) { window.location.href = '/divination'; return; }
      if (!(ev.target as HTMLElement).closest('.retry-palace')) return;
      const blk = mount.querySelector('[data-palace="sihua"]');
      if (blk) { blk.className = 'interp-text loading'; (blk as HTMLElement).style.cssText = 'font-family:var(--font-serif);font-weight:300;font-size:15.5px;line-height:1.95;color:var(--ink-800);white-space:pre-wrap;margin:0'; blk.setAttribute('data-palace', 'sihua'); blk.textContent = '四化飛星解讀生成中…'; }
      loadNarr();
    };
  }

  function showResult(chartData: any) {
    const myGen = ++resultGen;   // 這一位客人的批次序號（見 resultGen 註解）
    hideAllSections();
    resultSection.hidden = false;

    // 供 fetchPalace 的 trend 解讀帶入
    teacherTrend = chartData.horoscope?.trend || null;

    const tstBadge = document.getElementById('tst-badge') as HTMLElement;
    if (chartData.tst?.applied) {
      tstBadge.hidden = false;
      const sign = chartData.tst.correctionMinutes >= 0 ? '+' : '';
      tstBadge.textContent = `已套用真太陽時校正（${sign}${chartData.tst.correctionMinutes} 分鐘）`;
    } else {
      tstBadge.hidden = true;
    }

    // toggle 顯示（只在有 horoscope 時）
    const chartToggle = document.getElementById('chart-toggle') as HTMLElement;
    chartToggle.hidden = !chartData.horoscope;

    const horoscope = chartData.horoscope as Horoscope | null;
    const yearlyApiCtx = horoscope ? buildYearlyContextForApi(horoscope) : null;
    const currentYear = yearlyApiCtx?.year;

    // 流年盤的 toggle button label 帶當前年份
    if (currentYear) {
      const yBtn = chartToggle.querySelector<HTMLButtonElement>('.toggle-btn[data-mode="yearly"]');
      if (yBtn) yBtn.textContent = `流年盤 (${currentYear})`;
    }

    const chartMount = document.getElementById('chart-mount') as HTMLElement;
    const interpMount = document.getElementById('interpretation-mount') as HTMLElement;
    let currentMode: 'natal' | 'yearly' = 'natal';
    // 2026-09-28（Codex 體檢）：換下一位客人時畫面回到本命盤，按鈕也要跟著回到「本命盤」
    chartToggle?.querySelectorAll('.toggle-btn').forEach((b) => b.classList.toggle('is-active', (b as HTMLElement).dataset.mode === 'natal'));

    // client-side 解讀 cache：避免來回切換重複 fetch
    const interpCache: { natal: Record<string, string | null>; yearly: Record<string, string | null> } = {
      natal: {},
      yearly: {},
    };
    const interpStarted: { natal: boolean; yearly: boolean } = { natal: false, yearly: false };

    const renderChartCurrent = () => renderChart(chartData.chart as Chart, chartMount, horoscope, currentMode);

    // 載入指定 mode 的 7 段解讀（首次才打 API，已 cached 直接渲染）
    const loadInterpretations = (mode: 'natal' | 'yearly') => {
      renderInterpretationSkeleton(interpMount, mode, currentYear);
      const cache = interpCache[mode];
      // 已有的 cache 立刻渲染
      for (const palace of FOCUS_PALACES) {
        if (cache[palace] !== undefined) {
          renderPalaceText(palace, cache[palace], interpMount);
        }
      }
      // 沒打過就打
      if (!interpStarted[mode]) {
        interpStarted[mode] = true;
        // 13 段（摘要 + 12 宮）分批並發，cap 4，避免一次打爆 Anthropic 速率限制
        const queue = [...FOCUS_PALACES];
        const CONCURRENCY = 4;
        Array.from({ length: CONCURRENCY }, async () => {
          while (queue.length) {
            const palace = queue.shift()!;
            const text = await fetchPalace(chartData.chart as Chart, palace, mode, mode === 'yearly' ? yearlyApiCtx ?? undefined : undefined);
            cache[palace] = text;
            // 只在當前 mode 還是這個時渲染（避免快速切換 race condition）
            if (currentMode === mode && myGen === resultGen) renderPalaceText(palace, text, interpMount);
          }
        });
      }
    };

    renderChartCurrent();
    loadInterpretations('natal');
    renderTrendSection(document.getElementById('trend-mount'), chartData.chart as Chart, horoscope?.trend, chartData.paid);
    renderSihuaSection(document.getElementById('sihua-mount'), chartData.chart as Chart, horoscope?.sihua, chartData.paid);

    chartToggle.querySelectorAll<HTMLButtonElement>('.toggle-btn').forEach((btn) => {
      btn.onclick = () => {
        const mode = btn.dataset.mode as 'natal' | 'yearly';
        if (mode === currentMode) return;
        currentMode = mode;
        chartToggle.querySelectorAll('.toggle-btn').forEach((b) => b.classList.toggle('is-active', b === btn));
        renderChartCurrent();
        loadInterpretations(mode);
      };
    });

    // Retry handler (delegated)。換客人時先拆掉上一位的監聽器，只留最新這一個（見 retryHandler 註解）
    if (retryHandler) interpMount.removeEventListener('click', retryHandler);
    retryHandler = async (ev: Event) => {
      const target = ev.target as HTMLElement;
      if (target.classList.contains('retry-palace')) {
        const palace = target.dataset.palace;
        if (!palace) return;
        const block = interpMount.querySelector(`[data-palace="${palace}"] .interp-text`);
        if (!block) return;
        block.className = 'interp-text loading';
        block.textContent = '重試中…';
        // 2026-09-28（Codex 體檢）：送出時就固定模式——等待期間切到流年，本命的回應不能存進流年、也不能畫上去
        const reqMode = currentMode;
        const text = await fetchPalace(chartData.chart as Chart, palace, reqMode, reqMode === 'yearly' ? yearlyApiCtx ?? undefined : undefined);
        if (myGen !== resultGen) return;   // 等待期間老師已經換客人了，這份不要畫上去
        interpCache[reqMode][palace] = text;
        if (currentMode === reqMode) renderPalaceText(palace, text, interpMount);
      }
    };
    interpMount.addEventListener('click', retryHandler);

    // 老師版永遠全文，無 paywall / 分享連結（已移除對應區塊）
  }

  // === Form submit：新使用者算盤 ===
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(true);
    errorSection.hidden = true;

    const fd = new FormData(form);
    // 年/月/日 三選單組成 YYYY-MM-DD
    const y = fd.get('birthYear'), mo = fd.get('birthMonth'), da = fd.get('birthDay');
    if (!y || !mo || !da) {
      showError('請選擇完整的西元生日（年／月／日）');
      setLoading(false);
      return;
    }
    const pad = (v: FormDataEntryValue) => String(v).padStart(2, '0');
    const payload: Record<string, unknown> = {
      name: String(fd.get('name') || '').trim(),
      solarDate: `${y}-${pad(mo)}-${pad(da)}`,
      gender: fd.get('gender'),
      withHoroscope: true,
    };
    const hour = fd.get('hour');
    if (hour) payload.hour = Number(hour);
    const lon = fd.get('longitude');
    if (lon) payload.longitude = Number(lon);
    // 校正要用實際時間；只有時辰就不能冒充精確時間
    const bt = String(fd.get('birthTime') || '');
    if (lon) {
      const m = bt.match(/^(\d{1,2}):(\d{2})/);
      if (!m) { showError('選了出生地經度（真太陽時校正）就要填實際出生時間；只知道時辰的話，經度請選「不校正」。'); return; }
      payload.hour = Number(m[1]);
      payload.minute = Number(m[2]);
    }

    let chartData: any;
    try {
      const r = await fetch(`${WORKER_API}/admin/teacher-ziwei`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...authHeaders() },
        body: JSON.stringify(payload),
      });
      if (r.status === 401) {
        // 密碼失效 → 清掉、回密碼閘
        clearTeacherSecret();
        setLoading(false);
        bootstrap();
        return;
      }
      chartData = await r.json();
      if (!chartData.ok) {
        throw new Error(chartData.error || chartData.message || '命盤生成失敗');
      }
    } catch (err: any) {
      showError(err.message || '無法連線到伺服器');
      setLoading(false);
      return;
    }

    setLoading(false);
    showResult(chartData);
  });

  // === 密碼閘：送出密碼 → 驗證（打 chart 端點探 401）→ 過了存 localStorage 進表單 ===
  const pwdForm = document.getElementById('pwd-form') as HTMLFormElement;
  const pwdInput = document.getElementById('pwd-input') as HTMLInputElement;
  const pwdError = document.getElementById('pwd-error') as HTMLElement;
  const PWD_ERROR_DEFAULT = pwdError?.textContent || '密碼錯誤，請再試一次';   // 其他分支改過文字後要還原，不然下次輸錯會顯示上一次的錯誤
  if (pwdForm) {
    pwdForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = pwdInput.value.trim();
      if (!val) return;
      pwdError.hidden = true;
      const btn = pwdForm.querySelector('button') as HTMLButtonElement;
      btn.disabled = true;
      // 用一個極小的驗證請求（缺生日 → 密碼對會回 400、密碼錯回 401）
      try {
        const r = await fetch(`${WORKER_API}/admin/teacher-ziwei`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Teacher-Secret': val },
          body: JSON.stringify({}),
        });
        if (r.status === 401) {
          pwdError.textContent = PWD_ERROR_DEFAULT;
          pwdError.hidden = false;
          btn.disabled = false;
          return;
        }
        /* 2026-09-27：原本「任何非 401 都代表密碼正確」，403／404／429／500 或中間層的錯誤頁
           也會被當成通過、密碼還寫進 localStorage，老師填完客人資料才在排盤那一步失敗，
           而且錯誤頁沒有回密碼閘的路。改成只有 400（缺生日＝密碼是對的）或 200 才算過。 */
        if (r.status !== 400 && !r.ok) {
          pwdError.textContent = `現在沒辦法驗密碼（伺服器回 ${r.status}），請稍後再試`;
          pwdError.hidden = false;
          btn.disabled = false;
          return;
        }
        setTeacherSecret(val);
        btn.disabled = false;   // 2026-09-28（Codex 體檢）：成功也要恢復，否則之後被 401 送回密碼閘時按鈕按不下去
        hideAllSections();
        formSection.hidden = false;
      } catch {
        pwdError.textContent = '無法連線，請稍後再試';
        pwdError.hidden = false;
        btn.disabled = false;
      }
    });
  }

  // 再算一位：回到空白表單
  const againBtn = document.getElementById('again-btn');
  if (againBtn) {
    againBtn.addEventListener('click', () => {
      form.reset(); syncBt();
      teacherTrend = null;
      hideAllSections();
      formSection.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // === 進站偵測：有密碼 → 直接進表單；沒有 → 密碼閘 ===
  function bootstrap() {
    hideAllSections();
    if (getTeacherSecret()) {
      formSection.hidden = false;
    } else {
      authGate.hidden = false;
      if (pwdInput) pwdInput.focus();
    }
  }
  bootstrap();
</script>

