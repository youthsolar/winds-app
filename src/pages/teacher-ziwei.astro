  .auth-note { color: var(--ink-500); font-size: 11px; margin: 16px 0 0; }
  .auth-note a { color: var(--rose-600); text-decoration: underline; }
  #g_id_signin_ziwei { display: flex; justify-content: center; }

  .loading-section { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding: 72px 16px; color: var(--text-muted); font-family: var(--font-serif); font-size: 15px; }

  .form-warning { max-width: 480px; margin: 0 auto 16px; padding: 12px 16px; background: rgba(192, 57, 43, 0.06); border-left: 3px solid var(--critical); border-radius: 4px; color: var(--ink-900); font-size: 13px; line-height: 1.6; }

  .paid-badge { background: rgba(45, 134, 89, 0.1); color: #2d8659; font-size: 12px; padding: 4px 10px; border-radius: 12px; font-weight: 600; }

  .unlock-cta { background: linear-gradient(168deg, var(--surface-tint), var(--paper) 78%); border: 1px solid var(--rose-200); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); padding: 24px 22px; text-align: center; margin: 34px auto 12px; max-width: 760px; }
  .unlock-cta h3 { font-family: var(--font-serif); font-weight: 500; color: var(--ink-900); margin: 0 0 8px; font-size: 19px; }
  .unlock-cta p { font-family: var(--font-serif); font-weight: 300; color: var(--text-secondary); margin: 0 0 10px; font-size: 13.5px; }
  .unlock-cta ul { text-align: left; max-width: 22em; margin: 0 auto 16px; padding-left: 18px; color: var(--ink-700); font-family: var(--font-serif); font-weight: 300; font-size: 13.5px; line-height: 1.9; }
  .unlock-btn { display: inline-block; background: var(--accent); color: var(--text-on-accent); border: none; padding: 12px 28px; border-radius: var(--radius-pill); font-family: var(--font-serif); font-size: 15.5px; font-weight: 500; letter-spacing: 0.04em; text-decoration: none; cursor: pointer; box-shadow: var(--shadow-md); }
