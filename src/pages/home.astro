---
import BaseLayout from '../layouts/BaseLayout.astro';
// 首頁輕入口 — 值對齊 handoff home-page.jsx + home-free-draw.jsx + site-nav-footer.jsx
// 暫放 /home（不動現有 root=/ 占卜流程）；之後翻 root 再一步處理
const SCENARIOS = [
  { key: '已讀不回', q: '他已讀不回的這幾天，\n你是不是也一直在看手機？', sub: '先別急著想他怎麼了，\n先看看自己現在是什麼狀態？' },
  { key: '曖昧不明', q: '這段曖昧，是有機會，\n還是在等一個無緣的人？', sub: '說不清楚的，先不用說清楚。\n抽一張牌，看看現在的你該怎麼做？' },
  { key: '有沒有未來', q: '你們之間，\n是否還走得下去？', sub: '現在不用決定，\n先把方向看清楚再說。' },
  { key: '最近心不安', q: '最近心裡總是不太安穩，\n又說不上來為什麼？', sub: '說不出口的，不代表不重要。\n從一張牌開始。' },
];
const DECK = [
  { name: '月亮', line: '你感覺到的不安，是真的。先承認它，再慢慢走。' },
  { name: '星星', line: '再撐一下下。你以為過不去的，其實快過去了。' },
  { name: '戀人', line: '你心裡其實已經有答案，只是還不敢說出口。' },
  { name: '節制', line: '不用急著要一個結果。給彼此，也給自己一點時間。' },
  { name: '力量', line: '你以為快撐不住了，其實還沒到那裡。' },
  { name: '太陽', line: '今天不用想太多。做一件小事，對自己好一點就夠了。' },
];
const DEFAULT = 2;
const DAILY_QUOTE = '這不是算命，而是跟自己的靈魂對話。';
const FIELDS = ['姓', '名', '國曆生日', '出生時間', '手機', '電子郵件'];
const FEATURED = { glyph: '宮', kind: '主力靈性診斷', name: '元辰宮代觀：知運勢', line: '由老師代你進入靈界，親見元辰宮（靈魂居所），看清現況與失衡的根源。', price: 'NT$ 7,600', duration: '120 分鐘' };
const SVC = [
  { glyph: '鏡', name: '通靈水鏡法：查因果', line: '看清關係的真相與潛藏的因果。', price: 'NT$ 3,600', duration: '60 分鐘' },
  { glyph: '籤', name: '命書籤詩問事：問事件', line: '只需姓名，從命書摘籤、直接解惑。', price: 'NT$ 1,200', duration: '30 分鐘' },
];
const TALIS = [
  { glyph: '安', name: '安神隨身符', line: '睡不好、心緒亂時，放在枕邊。', price: '480' },
  { glyph: '緣', name: '結緣紅線手環', line: '為一段關係，繫上一點溫柔的祝福。', price: '680' },
  { glyph: '淨', name: '淨化香氛．艾草', line: '回到家，先讓空間靜下來。', price: '560' },
  { glyph: '晶', name: '安定粉晶原礦', line: '放在桌上，提醒自己對自己好一點。', price: '880' },
];
const FLOW = '/';            // 深度占卜（現有 root 流程）
const BOOK = '/services/';   // 預約老師（現有 services）
const SHOP = '/services/';   // 法器選物（暫指 services，待 winds.tw shop 頁）
const pageDesc = '先聽聽現在的自己。輕輕抽一張牌，看看今天的提醒；或只用 6 個基本資料、30 秒得到完整占卜解讀。找風問幸福，陪你把心裡的事慢慢說完。';
const br = (s) => s.split('\n');
---
<BaseLayout title="找風問幸福｜先聽聽現在的自己" description={pageDesc} ogType="website">
  <main class="home" data-scenarios={JSON.stringify(SCENARIOS)} data-deck={JSON.stringify(DECK)} data-default={DEFAULT}>
    <!-- Hero -->
    <header class="hero">
      <div class="hero-glow"></div>
      <div class="hero-wrap">
        <div class="hero-card">
          <span class="eyebrow"><span class="dot"></span>先聽聽現在的自己</span>
          <h2 class="lead">現在的你，比較像——</h2>
          <div class="chips" id="chips">
            {SCENARIOS.map((m, i) => (
              <button class={`chip${i === DEFAULT ? ' on' : ''}`} data-i={i}>{m.key}</button>
            ))}
          </div>
          <div class="qzone" id="qzone">
            <h1 class="big-q cjk" id="bigQ">{br(SCENARIOS[DEFAULT].q).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h1>
            <p class="sub-q" id="subQ">{br(SCENARIOS[DEFAULT].sub).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
          </div>
          <!-- CTA / draw zone -->
          <div class="cta-zone" id="ctaZone">
            <button class="btn primary lg draw-btn" id="drawBtn"><i class="ph-thin ph-cards"></i>占卜</button>
            <div class="social" id="social1"></div>
            <a class="quiet-link" id="scrollDeepen" href="#deepen">或預約老師慢慢聊 →</a>
          </div>
          <div class="draw-zone hidden" id="drawZone">
            <div class="cards" id="cards">
              {[0, 1, 2].map(i => (
                <div class="card-slot" data-slot={i}>
                  <button class="card" data-i={i}>
                    <div class="card-inner">
                      <div class="card-back"><span class="back-frame">風</span></div>
                      <div class="card-front"><span class="cf-name"></span><span class="cf-rule"></span><span class="cf-line"></span></div>
                    </div>
                  </button>
                </div>
              ))}
            </div>
            <span class="draw-hint" id="drawHint">輕輕點一張，看看今天的提醒</span>
            <div class="draw-actions hidden" id="drawActions">
              <button class="btn quiet sm" id="redraw"><i class="ph ph-arrow-counter-clockwise"></i>再抽一張</button>
              <a class="btn primary sm" href={FLOW}>深入占卜<i class="ph ph-arrow-right"></i></a>
            </div>
            <div class="social" id="social2"></div>
          </div>
        </div>

        <div class="daily">
          <i class="ph-thin ph-quotes"></i>
          <span class="daily-text">{'「' + DAILY_QUOTE + '」'}</span>
        </div>
      </div>
    </header>

    <!-- Selling point -->
    <section class="selling">
      <div class="wrap selling-row">
        <div class="selling-claim">
          <span>只要 <em>6 個</em> 基本資料</span><span class="plus">＋</span><span><em>30 秒</em> 得到幸福</span>
        </div>
        <div class="fields">
          {FIELDS.map((f, i) => (<span class="field"><span class="fn">{String(i + 1).padStart(2, '0')}</span>{f}</span>))}
        </div>
      </div>
    </section>

    <!-- 預約項目 -->
    <section class="wrap block">
      <div class="sh"><h2 class="sh-title cjk">預約項目</h2><p class="sh-lede">老師親自諮詢與進行法事。</p></div>
      <div class="svc-grid">
        <a class="svc-featured" href={BOOK}>
          <div class="sf-head">
            <span class="disc lg">{FEATURED.glyph}</span>
            <div><span class="badge">{FEATURED.kind}</span><h3>{FEATURED.name}</h3></div>
          </div>
          <p class="sf-line">{FEATURED.line}</p>
          <div class="sf-foot">
            <span><span class="meta">{FEATURED.duration} · 一對一</span><span class="price">{FEATURED.price}</span></span>
            <span class="go">看介紹 <i class="ph ph-arrow-right"></i></span>
          </div>
        </a>
        <div class="svc-small">
          {SVC.map(it => (
            <a class="svc-card" href={BOOK}>
              <span class="disc">{it.glyph}</span>
              <div class="sc-body">
                <h4>{it.name}</h4><p>{it.line}</p>
                <div class="sc-foot"><span class="price">{it.price}</span><span class="meta">{it.duration}</span></div>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="svc-all"><a href={BOOK}>看全部預約項目 <i class="ph ph-arrow-right"></i></a></div>
    </section>

    <!-- 預約對談 + 法器 -->
    <section id="deepen" class="wrap block">
      <div class="sh"><h2 class="sh-title cjk">想了解得更深？</h2><p class="sh-lede">想看完整命盤、找老師當面聊或帶一件小東西回家——慢慢來。</p></div>
      <div class="deepen-grid">
        <div class="talk-card">
          <div class="talk-banner"><img src="/assets/talk-space-banner.png" alt="預約對談的空間" /><span class="badge on-img">預約對談</span></div>
          <div class="talk-body">
            <h3>選一位老師慢慢聊</h3>
            <p>預約實體或線上對談，說說一直卡住的心怎麼了。</p>
            <div class="readers"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span><span class="rd-note">3 位老師．今晚還有名額</span></div>
            <div class="talk-foot">
              <span><span class="meta">單次 60 分鐘</span><span class="price">NT$ 2,000 起</span></span>
              <a class="btn primary md" href={BOOK}>預約老師 <i class="ph ph-arrow-right"></i></a>
            </div>
          </div>
        </div>
        <div class="shop-card">
          <div class="shop-head"><h3>帶一件靈性的小物回家</h3><span class="badge">法器選物</span></div>
          <div class="shop-list">
            {TALIS.map(t => (
              <div class="shop-item">
                <span class="disc sm">{t.glyph}</span>
                <div class="si-body"><div class="si-name">{t.name}</div><div class="si-line">{t.line}</div></div>
                <span class="si-price">NT$ {t.price}</span>
              </div>
            ))}
          </div>
          <a class="btn secondary md full" href={SHOP}>逛逛全部選物 <i class="ph ph-arrow-right"></i></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
(function () {
  const root = document.querySelector('.home');
  if (!root) return;
  const SC = JSON.parse(root.dataset.scenarios);
  const DECK = JSON.parse(root.dataset.deck);
  let sel = parseInt(root.dataset.default, 10);

  const brHtml = (s) => s.split('\n').map((l, i) => (i ? '<br>' : '') + l).join('');
  const socialHtml = '<div class="av-stack"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span></div>' +
    '<span class="social-line">已陪 <b>2,700+</b> 人，把心裡的事慢慢說完</span>';
  document.getElementById('social1').innerHTML = socialHtml;
  document.getElementById('social2').innerHTML = socialHtml;

  // 情緒選擇器
  const qzone = document.getElementById('qzone');
  const bigQ = document.getElementById('bigQ');
  const subQ = document.getElementById('subQ');
  document.getElementById('chips').addEventListener('click', (e) => {
    const b = e.target.closest('.chip'); if (!b) return;
    const i = parseInt(b.dataset.i, 10); if (i === sel) return;
    qzone.classList.add('fade-out');
    [...document.querySelectorAll('.chip')].forEach((c, ci) => c.classList.toggle('on', ci === i));
    setTimeout(() => {
      sel = i;
      bigQ.innerHTML = brHtml(SC[i].q);
      subQ.innerHTML = brHtml(SC[i].sub);
      resetDraw();
      document.getElementById('ctaZone').classList.remove('hidden');
      document.getElementById('drawZone').classList.add('hidden');
      qzone.classList.remove('fade-out');
    }, 280);
  });

  // 占卜 → 顯示抽牌
  document.getElementById('drawBtn').addEventListener('click', () => {
    document.getElementById('ctaZone').classList.add('hidden');
    document.getElementById('drawZone').classList.remove('hidden');
  });

  // 抽牌
  let picked = null;
  const cardsEl = document.getElementById('cards');
  function resetDraw() {
    picked = null;
    cardsEl.classList.remove('picked');
    [...cardsEl.querySelectorAll('.card-slot')].forEach(s => {
      s.classList.remove('flipped', 'dim');
      s.querySelector('.cf-name').textContent = '';
      s.querySelector('.cf-line').textContent = '';
    });
    document.getElementById('drawHint').classList.remove('hidden');
    document.getElementById('drawActions').classList.add('hidden');
  }
  cardsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.card'); if (!btn || picked !== null) return;
    picked = parseInt(btn.dataset.i, 10);
    const c = DECK[Math.floor(Math.random() * DECK.length)];
    const slots = [...cardsEl.querySelectorAll('.card-slot')];
    cardsEl.classList.add('picked');
    slots.forEach((s, i) => {
      if (i === picked) {
        s.classList.add('flipped');
        s.querySelector('.cf-name').textContent = c.name;
        s.querySelector('.cf-line').textContent = c.line;
      } else s.classList.add('dim');
    });
    document.getElementById('drawHint').classList.add('hidden');
    document.getElementById('drawActions').classList.remove('hidden');
  });
  document.getElementById('redraw').addEventListener('click', resetDraw);

  // 平滑捲動
  document.getElementById('scrollDeepen').addEventListener('click', (e) => {
    e.preventDefault();
    const el = document.getElementById('deepen');
    if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 16, behavior: 'smooth' });
  });
})();
</script>

<style>
  .home { background: var(--surface-page); }
  .wrap { max-width: var(--container); margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  @media (max-width: 760px) { .wrap { padding-left: 20px; padding-right: 20px; } }
  .cjk { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  .hidden { display: none !important; }

  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(680px 480px at 80% 0%, var(--rose-100), transparent 62%), radial-gradient(520px 420px at 6% 70%, var(--tint-glow), transparent 58%); }
  .hero-wrap { position: relative; max-width: 920px; margin: 0 auto; padding: 56px 32px 76px; }
  @media (max-width: 760px) { .hero-wrap { padding: 32px 18px 48px; } }
  .hero-card { background: linear-gradient(168deg, var(--surface-tint), var(--paper) 78%); border: 1px solid var(--rose-100); border-radius: var(--radius-2xl); box-shadow: var(--shadow-lg); padding: 50px 56px 44px; text-align: center; }
  @media (max-width: 760px) { .hero-card { border-radius: var(--radius-xl); padding: 30px 22px 32px; } }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.02em; color: var(--accent-press); }
  .eyebrow .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent); flex: none; }
  .lead { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--text-secondary); margin: 16px 0 0; letter-spacing: 0.02em; }
  @media (max-width: 760px) { .lead { font-size: 18px; } }

  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 18px; }
  .chip { all: unset; cursor: pointer; font-family: var(--font-serif); font-size: 16px; font-weight: 500; letter-spacing: 0.02em; padding: 10px 22px; border-radius: var(--radius-pill); white-space: nowrap; color: var(--accent-press); background: var(--paper); border: 1px solid var(--rose-200); transition: all var(--dur-fast) var(--ease-soft); }
  .chip.on { color: var(--text-on-accent); background: var(--accent); border-color: transparent; box-shadow: var(--shadow-sm); }
  @media (max-width: 760px) { .chip { font-size: 15px; padding: 9px 16px; } }

  .qzone { min-height: 140px; display: flex; flex-direction: column; justify-content: center; margin-top: 22px; transition: opacity 320ms var(--ease-soft), transform 320ms var(--ease-soft); }
  .qzone.fade-out { opacity: 0; transform: translateY(6px); }
  @media (max-width: 760px) { .qzone { min-height: 96px; } }
  .big-q { font-family: var(--font-serif); font-size: 44px; font-weight: 500; line-height: 1.32; letter-spacing: 0.01em; margin: 0; color: var(--ink-900); }
  @media (max-width: 760px) { .big-q { font-size: 27px; } }
  .sub-q { font-family: var(--font-serif); font-weight: 300; font-size: 18px; line-height: 1.8; color: var(--text-secondary); margin: 14px auto 0; max-width: 26em; }
  @media (max-width: 760px) { .sub-q { font-size: 15.5px; } }

  .cta-zone { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-top: 28px; }
  @media (max-width: 760px) { .cta-zone { margin-top: 22px; } }
  .quiet-link { cursor: pointer; font-family: var(--font-sans); font-size: 13.5px; color: var(--text-muted); border-bottom: 1px solid var(--border-strong); padding-bottom: 2px; margin-top: 2px; text-decoration: none; }

  /* social proof */
  .social { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .av-stack { display: flex; }
  .av { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; font-family: var(--font-serif); font-size: 15px; color: var(--text-on-accent); box-shadow: 0 0 0 2px var(--surface-card); }
  .av-stack .av + .av { margin-left: -10px; }
  .av.rose { background: var(--rose-400); } .av.clay { background: var(--clay-400); } .av.sage { background: var(--sage-400); }
  .social-line { font-family: var(--font-sans); font-size: 13.5px; color: var(--text-secondary); white-space: nowrap; }
  .social-line b { font-weight: 600; color: var(--ink-900); }

  /* card draw */
  .draw-zone { margin-top: 30px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  @media (max-width: 760px) { .draw-zone { gap: 26px; } }
  .cards { display: flex; gap: 18px; align-items: center; }
  @media (max-width: 760px) { .cards { gap: 12px; } }
  .card-slot { transition: transform var(--dur-slow) var(--ease-soft), opacity var(--dur-base) var(--ease-soft); }
  .card-slot[data-slot="0"] { transform: rotate(-5deg) translateY(8px); }
  .card-slot[data-slot="2"] { transform: rotate(5deg) translateY(8px); }
  .cards.picked .card-slot { transform: none; }
  .card-slot.dim { opacity: 0.45; }
  .card { all: unset; cursor: pointer; perspective: 900px; width: 116px; height: 178px; display: block; }
  .cards.picked .card { cursor: default; }
  @media (max-width: 760px) { .card { width: 104px; height: 168px; } }
  .card-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 520ms var(--ease-soft); }
  .card-slot.flipped .card-inner { transform: rotateY(180deg); }
  .card-back, .card-front { position: absolute; inset: 0; backface-visibility: hidden; border-radius: var(--radius-md); border: 1px solid var(--rose-200); }
  .card-back { background: linear-gradient(160deg, var(--rose-300), var(--clay-400)); box-shadow: var(--shadow-md); display: flex; align-items: center; justify-content: center; }
  .back-frame { width: 78%; height: 82%; border-radius: var(--radius-sm); border: 1px solid rgba(255,253,248,0.5); display: flex; align-items: center; justify-content: center; color: rgba(255,253,248,0.92); font-family: var(--font-serif); font-size: 30px; }
  .card-front { transform: rotateY(180deg); background: var(--paper); box-shadow: var(--shadow-lg); padding: 14px 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .cf-name { font-family: var(--font-serif); font-size: 26px; font-weight: 500; color: var(--accent-press); margin: 0 0 6px; }
  .cf-rule { width: 22px; height: 1px; background: var(--rose-200); margin: 2px 0 8px; }
  .cf-line { font-family: var(--font-serif); font-size: 11.5px; line-height: 1.7; color: var(--text-secondary); }
  .draw-hint { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); letter-spacing: 0.04em; }
  .draw-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }

  /* buttons */
  .btn { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--font-serif); font-weight: 500; letter-spacing: 0.04em; border-radius: var(--radius-pill); text-decoration: none; transition: background var(--dur-fast) var(--ease-soft); }
  .btn.primary { color: var(--text-on-accent); background: var(--accent); box-shadow: var(--shadow-sm); }
  .btn.primary:hover { background: var(--accent-hover); }
  .btn.secondary { color: var(--ink-900); background: var(--surface-card); border: 1px solid var(--border-strong); }
  .btn.secondary:hover { background: var(--rice-100); }
  .btn.quiet { color: var(--accent-press); background: transparent; }
  .btn.quiet:hover { color: var(--rose-500); }
  .btn.lg { font-size: 20px; padding: 18px 48px; }
  @media (max-width: 760px) { .btn.lg { font-size: 18px; padding: 16px 36px; } }
  .btn.md { font-size: 15px; padding: 11px 22px; }
  .btn.sm { font-size: 14px; padding: 9px 18px; }
  .btn.full { width: 100%; }

  /* daily quote band */
  .daily { margin-top: 28px; background: linear-gradient(120deg, var(--rose-100), var(--clay-200) 120%); border-radius: var(--radius-xl); padding: 26px 34px; display: flex; align-items: flex-start; gap: 14px; justify-content: center; box-shadow: var(--shadow-xs); }
  @media (max-width: 760px) { .daily { margin-top: 22px; padding: 22px; } }
  .daily > i { font-size: 26px; color: var(--rose-400); flex: none; margin-top: 4px; }
  .daily-text { font-family: var(--font-serif); font-size: 19px; font-weight: 400; line-height: 1.7; color: var(--ink-700); text-align: center; }
  @media (max-width: 760px) { .daily-text { font-size: 16px; } .daily > i { margin-top: 2px; } }

