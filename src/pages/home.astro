---
import BaseLayout from '../layouts/BaseLayout.astro';
import servicesData from '../data/services.json';
// 首頁輕入口 — 值對齊 handoff home-page.jsx + home-free-draw.jsx + site-nav-footer.jsx
// 暫放 /home（不動現有 root=/ 占卜流程）；之後翻 root 再一步處理
const SCENARIOS = [
  { key: '已讀不回', q: '他已讀不回的這幾天，\n你是不是也一直在看手機？', sub: '先別急著想他怎麼了，\n先看看自己現在是什麼狀態？' },
  { key: '曖昧不明', q: '這段曖昧，是有機會，\n還是在等一個無緣的人？', sub: '說不清楚的，先不用說清楚。\n抽一張牌，看看現在的你該怎麼做？' },
  { key: '有沒有未來', q: '你們之間，\n是否還走得下去？', sub: '現在不用決定，\n先把方向看清楚再說。' },
  { key: '最近心不安', q: '最近心裡總是不太安穩，\n又說不上來為什麼？', sub: '說不出口的，不代表不重要。\n從一張牌開始。' },
];
const DECK = [
  { name: '月亮', line: '你感覺到的不安，是真的。先承認它，再慢慢走。' },
  { name: '星星', line: '再撐一下下。你以為過不去的，其實快過去了。' },
  { name: '戀人', line: '你心裡其實已經有答案，只是還不敢說出口。' },
  { name: '節制', line: '不用急著要一個結果。給彼此，也給自己一點時間。' },
  { name: '力量', line: '你以為快撐不住了，其實還沒到那裡。' },
  { name: '太陽', line: '今天不用想太多。做一件小事，對自己好一點就夠了。' },
];
const DEFAULT = 2;
const DAILY_QUOTE = '這不是算命，而是跟自己的靈魂對話。';
const FIELDS = ['姓', '名', '國曆生日', '出生時間', '手機', '電子郵件'];
// 預約項目：接真實 SB 服務（services.json = D1，source==='simplybook'），連到真項目頁
const sbServices = (servicesData as any[]).filter((s) => s.source === 'simplybook' && (s.price ?? 0) > 0);
const glyphOf = (name: string) => {
  const m = String(name || '').replace(/[【\[\(（][^】\]\)）]*[】\]\)）]/g, '').match(/[一-鿿]/);
  return m ? m[0] : '占';
};
const cleanName = (name: string) => String(name || '').replace(/^[【\[]/, '').replace(/[】\]][\s\S]*$/, '').trim() || name;
const lineOf = (s: any) => String(s.llm_description || (s.description || '').replace(/<[^>]+>/g, '') || '').replace(/\s+/g, ' ').trim();
const durOf = (s: any) => (s.duration_minutes ? `${s.duration_minutes} 分鐘` : '一對一');
const ntd = (p: number) => `NT$ ${Number(p).toLocaleString()}`;
const featuredSvc = sbServices.find((s) => /元辰宮|知運勢/.test(s.name)) || sbServices[0];
const FEATURED = featuredSvc && {
  id: featuredSvc.id, glyph: glyphOf(featuredSvc.name), kind: '主力靈性診斷',
  name: cleanName(featuredSvc.name), line: lineOf(featuredSvc).slice(0, 64),
  price: ntd(featuredSvc.price), duration: durOf(featuredSvc),
};
const smallPicks: any[] = [];
for (const re of [/水鏡|查因果|通靈/, /命書|籤詩|問事/]) {
  const f = sbServices.find((s) => re.test(s.name) && s.id !== featuredSvc?.id && !smallPicks.includes(s));
  if (f) smallPicks.push(f);
}
for (const s of sbServices) { if (smallPicks.length >= 2) break; if (s.id !== featuredSvc?.id && !smallPicks.includes(s)) smallPicks.push(s); }
const SVC = smallPicks.slice(0, 2).map((s) => ({
  id: s.id, glyph: glyphOf(s.name), name: cleanName(s.name),
  line: lineOf(s).slice(0, 40), price: ntd(s.price), duration: durOf(s),
}));
const TALIS = [
  { glyph: '安', name: '安神隨身符', line: '睡不好、心緒亂時，放在枕邊。', price: '480' },
  { glyph: '緣', name: '結緣紅線手環', line: '為一段關係，繫上一點溫柔的祝福。', price: '680' },
  { glyph: '淨', name: '淨化香氛．艾草', line: '回到家，先讓空間靜下來。', price: '560' },
  { glyph: '晶', name: '安定粉晶原礦', line: '放在桌上，提醒自己對自己好一點。', price: '880' },
];
const FLOW = '/divination';  // 深度占卜漏斗（DS 重建）
const BOOK = '/booking';     // 預約老師（真 SB 老師 + 預約精靈）
const SHOP = '/shop';        // 法器選物（真 ES 商品）
const pageDesc = '先聽聽現在的自己。輕輕抽一張牌，看看今天的提醒；或只用 6 個基本資料、30 秒得到完整占卜解讀。找風問幸福，陪你把心裡的事慢慢說完。';
const br = (s) => s.split('\n');
---
<BaseLayout title="找風問幸福｜先聽聽現在的自己" description={pageDesc} ogType="website">
  <main class="home" data-scenarios={JSON.stringify(SCENARIOS)} data-deck={JSON.stringify(DECK)} data-default={DEFAULT}>
    <!-- Hero -->
    <header class="hero">
      <div class="hero-glow"></div>
      <div class="hero-wrap">
        <div class="hero-card">
          <span class="eyebrow"><span class="dot"></span>先聽聽現在的自己</span>
          <h2 class="lead">現在的你，比較像——</h2>
          <div class="chips" id="chips">
            {SCENARIOS.map((m, i) => (
              <button class={`chip${i === DEFAULT ? ' on' : ''}`} data-i={i}>{m.key}</button>
            ))}
          </div>
          <div class="qzone" id="qzone">
            <h1 class="big-q cjk" id="bigQ">{br(SCENARIOS[DEFAULT].q).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h1>
            <p class="sub-q" id="subQ">{br(SCENARIOS[DEFAULT].sub).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
          </div>
          <!-- CTA / draw zone -->
          <div class="cta-zone" id="ctaZone">
            <button class="btn primary lg draw-btn" id="drawBtn"><i class="ph-thin ph-cards"></i>占卜</button>
            <div class="social"><div class="av-stack"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span></div><span class="social-line">已陪 <b>2,700+</b> 人，把心裡的事慢慢說完</span></div>
            <a class="quiet-link" id="scrollDeepen" href="#deepen">或預約老師慢慢聊 →</a>
          </div>
          <div class="draw-zone hidden" id="drawZone">
            <div class="cards" id="cards">
              {[0, 1, 2].map(i => (
                <div class="card-slot" data-slot={i}>
                  <button class="card" data-i={i}>
                    <div class="card-inner">
                      <div class="card-back"><span class="back-frame">風</span></div>
                      <div class="card-front"><span class="cf-name"></span><span class="cf-rule"></span><span class="cf-line"></span></div>
                    </div>
                  </button>
                </div>
              ))}
            </div>
            <span class="draw-hint" id="drawHint">輕輕點一張，看看今天的提醒</span>
            <div class="draw-actions hidden" id="drawActions">
              <button class="btn quiet sm" id="redraw"><i class="ph ph-arrow-counter-clockwise"></i>再抽一張</button>
              <a class="btn primary sm" href={FLOW}>深入占卜<i class="ph ph-arrow-right"></i></a>
            </div>
            <div class="social"><div class="av-stack"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span></div><span class="social-line">已陪 <b>2,700+</b> 人，把心裡的事慢慢說完</span></div>
          </div>
        </div>

        <div class="daily">
          <i class="ph-thin ph-quotes"></i>
          <span class="daily-text">{'「' + DAILY_QUOTE + '」'}</span>
        </div>
      </div>
    </header>

    <!-- Selling point -->
    <section class="selling">
      <div class="wrap selling-row">
        <div class="selling-claim">
          <span>只要 <em>6 個</em> 基本資料</span><span class="plus">＋</span><span><em>30 秒</em> 得到幸福</span>
        </div>
        <div class="fields">
          {FIELDS.map((f, i) => (<span class="field"><span class="fn">{String(i + 1).padStart(2, '0')}</span>{f}</span>))}
        </div>
      </div>
    </section>

    <!-- 預約項目 -->
    <section class="wrap block">
      <div class="sh"><h2 class="sh-title cjk">預約項目</h2><p class="sh-lede">老師親自諮詢與進行法事。</p></div>
      <div class="svc-grid">
        {FEATURED && (
        <a class="svc-featured" href={`/services?id=sb-${FEATURED.id}`} id="homeSvcFeatured">
          <div class="sf-head">
            <span class="disc lg">{FEATURED.glyph}</span>
            <div><span class="badge">{FEATURED.kind}</span><h3>{FEATURED.name}</h3></div>
          </div>
          <p class="sf-line">{FEATURED.line}</p>
          <div class="sf-foot">
            <span><span class="meta">{FEATURED.duration} · 一對一</span><span class="price">{FEATURED.price}</span></span>
            <span class="go">看介紹 <i class="ph ph-arrow-right"></i></span>
          </div>
        </a>
        )}
        <div class="svc-small" id="homeSvcSmall">
          {SVC.map(it => (
            <a class="svc-card" href={`/services?id=sb-${it.id}`}>
              <span class="disc">{it.glyph}</span>
              <div class="sc-body">
                <h4>{it.name}</h4><p>{it.line}</p>
                <div class="sc-foot"><span class="price">{it.price}</span><span class="meta">{it.duration}</span></div>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="svc-all"><a href="/services">看全部預約項目 <i class="ph ph-arrow-right"></i></a></div>
    </section>

    <!-- 預約對談 + 法器 -->
    <section id="deepen" class="wrap block">
      <div class="sh"><h2 class="sh-title cjk">想了解得更深？</h2><p class="sh-lede">想看完整命盤、找老師當面聊或帶一件小東西回家——慢慢來。</p></div>
      <div class="deepen-grid">
        <div class="talk-card">
          <div class="talk-banner"><img src="/assets/talk-space-banner.png" alt="預約對談的空間" /><span class="badge on-img">預約對談</span></div>
          <div class="talk-body">
            <h3>選一位老師慢慢聊</h3>
            <p>預約實體或線上對談，說說一直卡住的心怎麼了。</p>
            <div class="readers" id="homeReaders"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span><span class="rd-note">資深老師線上預約</span></div>
            <div class="talk-foot">
              <span><span class="meta">單次 60 分鐘</span><span class="price">NT$ 2,000 起</span></span>
              <a class="btn primary md" href={BOOK}>預約老師 <i class="ph ph-arrow-right"></i></a>
            </div>
          </div>
        </div>
        <div class="shop-card">
          <div class="shop-head"><h3>帶一件靈性的小物回家</h3><span class="badge">法器選物</span></div>
          <div class="shop-list" id="homeShopList">
            {TALIS.map(t => (
              <div class="shop-item">
                <span class="disc sm">{t.glyph}</span>
                <div class="si-body"><div class="si-name">{t.name}</div><div class="si-line">{t.line}</div></div>
                <span class="si-price">NT$ {t.price}</span>
              </div>
            ))}
          </div>
          <a class="btn secondary md full" href={SHOP}>逛逛全部選物 <i class="ph ph-arrow-right"></i></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
(function () {
  const root = document.querySelector('.home');
  if (!root) return;
  const SC = JSON.parse(root.dataset.scenarios);
  const DECK = JSON.parse(root.dataset.deck);
  let sel = parseInt(root.dataset.default, 10);

  const brHtml = (s) => s.split('\n').map((l, i) => (i ? '<br>' : '') + l).join('');

  // 情緒選擇器
  const qzone = document.getElementById('qzone');
  const bigQ = document.getElementById('bigQ');
  const subQ = document.getElementById('subQ');
  document.getElementById('chips').addEventListener('click', (e) => {
    const b = e.target.closest('.chip'); if (!b) return;
    const i = parseInt(b.dataset.i, 10); if (i === sel) return;
    qzone.classList.add('fade-out');
    [...document.querySelectorAll('.chip')].forEach((c, ci) => c.classList.toggle('on', ci === i));
    setTimeout(() => {
      sel = i;
      bigQ.innerHTML = brHtml(SC[i].q);
      subQ.innerHTML = brHtml(SC[i].sub);
      resetDraw();
      document.getElementById('ctaZone').classList.remove('hidden');
      document.getElementById('drawZone').classList.add('hidden');
      qzone.classList.remove('fade-out');
    }, 280);
  });

  // 占卜 → 顯示抽牌
  document.getElementById('drawBtn').addEventListener('click', () => {
    document.getElementById('ctaZone').classList.add('hidden');
    document.getElementById('drawZone').classList.remove('hidden');
  });

  // 抽牌
  let picked = null;
  const cardsEl = document.getElementById('cards');
  function resetDraw() {
    picked = null;
    cardsEl.classList.remove('picked');
    [...cardsEl.querySelectorAll('.card-slot')].forEach(s => {
      s.classList.remove('flipped', 'dim');
      s.querySelector('.cf-name').textContent = '';
      s.querySelector('.cf-line').textContent = '';
    });
    document.getElementById('drawHint').classList.remove('hidden');
    document.getElementById('drawActions').classList.add('hidden');
  }
  cardsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.card'); if (!btn || picked !== null) return;
    picked = parseInt(btn.dataset.i, 10);
    const c = DECK[Math.floor(Math.random() * DECK.length)];
    const slots = [...cardsEl.querySelectorAll('.card-slot')];
    cardsEl.classList.add('picked');
    slots.forEach((s, i) => {
      if (i === picked) {
        s.classList.add('flipped');
        s.querySelector('.cf-name').textContent = c.name;
        s.querySelector('.cf-line').textContent = c.line;
      } else s.classList.add('dim');
    });
    document.getElementById('drawHint').classList.add('hidden');
    document.getElementById('drawActions').classList.remove('hidden');
  });
  document.getElementById('redraw').addEventListener('click', resetDraw);

  // 平滑捲動
  document.getElementById('scrollDeepen').addEventListener('click', (e) => {
    e.preventDefault();
    const el = document.getElementById('deepen');
    if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 16, behavior: 'smooth' });
  });

  /* JS 注入元素無 Astro scope → 樣式一律 inline（gotcha：scoped <style> 不套用到 innerHTML 元素）*/
  function escH(s){return String(s||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}

  /* 預約對談卡：接真 SB 老師（圓形彩色頭像 + 真人數）*/
  (function(){
    var box = document.getElementById('homeReaders'); if(!box) return;
    var TONE_BG = ['var(--rose-100)','var(--clay-200)','var(--sage-200)'];
    var TONE_FG = ['var(--rose-600)','var(--clay-500)','var(--sage-500)'];
    var TONE_RING = ['var(--rose-300)','var(--clay-300)','var(--sage-300)'];
    fetch('https://api.winds.tw/sb-providers').then(function(r){return r.json();}).then(function(d){
      var ts = (d && d.providers) || []; if(!ts.length) return;
      var avs = ts.slice(0,3).map(function(t,i){
        var nm = (t.name||'').replace(/老師$/,'');
        var ring = t.color || TONE_RING[i%3];
        var st = 'display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;font-family:var(--font-serif);font-size:17px;font-weight:500;overflow:hidden;flex:none;background:'+TONE_BG[i%3]+';color:'+TONE_FG[i%3]+';box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px '+ring+';margin-left:'+(i?-10:0)+'px;position:relative;z-index:'+(9-i);
        return '<span style="'+st+'">'+escH(nm.slice(0,1)||'師')+'</span>';
      }).join('');
      box.innerHTML = avs + '<span style="font-family:var(--font-sans);font-size:12.5px;color:var(--text-muted);margin-left:12px;white-space:nowrap">'+ts.length+' 位資深老師．線上預約</span>';
    }).catch(function(){});
  })();

  /* 法器選物：接真實 ES 商品（/shop-products），覆蓋 SSR 佔位 */
  (function(){
    var box = document.getElementById('homeShopList'); if(!box) return;
    fetch('https://api.winds.tw/shop-products').then(function(r){return r.json();}).then(function(d){
      var ps = (d && d.products) || []; if(!ps.length) return;
      box.innerHTML = ps.slice(0,4).map(function(p,idx){
        var nm = (p.name||'').replace(/^[【\[]/,'').replace(/[】\]][\s\S]*$/,'').trim() || p.name;
        var pm = (p.desc||'').match(/<p[^>]*>([\s\S]*?)<\/p>/i);
        var line = pm ? pm[1].replace(/<[^>]+>/g,'').replace(/\s+/g,' ').trim().slice(0,20) : '';
        var thumb = p.image
          ? '<span style="flex:none;width:46px;height:46px;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--rose-100);background:var(--paper);display:block"><img src="'+escH(p.image)+'" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></span>'
          : '<span style="flex:none;width:46px;height:46px;border-radius:var(--radius-md);background:var(--paper);border:1px solid var(--rose-100);display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:22px;color:var(--accent-press)">符</span>';
        return '<div style="display:flex;align-items:center;gap:14px;padding:12px 0;'+(idx?'border-top:1px solid var(--rose-100);':'')+'">'+thumb+
          '<div style="flex:1;min-width:0"><div style="font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900)">'+escH(nm)+'</div>'+
          (line?'<div style="font-family:var(--font-serif);font-weight:300;font-size:13px;line-height:1.6;color:var(--text-secondary)">'+escH(line)+'</div>':'')+'</div>'+
          '<span style="font-family:var(--font-sans);font-size:13.5px;color:var(--ink-700);white-space:nowrap">NT$ '+escH(p.price)+'</span></div>';
      }).join('');
    }).catch(function(){});
  })();

  /* 預約項目：接真實 SB 服務（/sb-services），覆蓋 SSR 佔位 */
  (function(){
    var featBox = document.getElementById('homeSvcFeatured');
    var smallBox = document.getElementById('homeSvcSmall');
    if(!featBox && !smallBox) return;
    function cleanNm(n){ return String(n||'').replace(/^[【\[]/,'').replace(/[】\]][\s\S]*$/,'').trim() || n; }
    function glyph(n){ var m = String(n||'').replace(/[【\[\(（][^】\]\)）]*[】\]\)）]/g,'').match(/[一-鿿]/); return m ? m[0] : '占'; }
    function ntd(p){ return 'NT$ ' + (Number(p)||0).toLocaleString('en-US'); }
    fetch('https://api.winds.tw/sb-services').then(function(r){return r.json();}).then(function(d){
      var all = ((d && d.services) || []).filter(function(s){ return (Number(s.price)||0) > 0; });
      if(!all.length) return;
      var featured = all.find(function(s){ return /知運勢|代觀/.test(s.name); }) || all.find(function(s){ return /元辰宮/.test(s.name); }) || all[0];
      // featured 卡
      if(featBox && featured){
        featBox.setAttribute('href', '/services?id=sb-' + featured.id);
        var fLine = String(featured.llm || (featured.desc||'').replace(/<[^>]+>/g,'') || '').replace(/\s+/g,' ').trim().slice(0,64);
        var fDur = featured.duration ? (featured.duration + ' 分鐘 · 一對一') : '一對一';
        featBox.innerHTML =
          '<div class="sf-head"><span class="disc lg">'+escH(glyph(featured.name))+'</span>' +
            '<div><span class="badge">主力靈性診斷</span><h3>'+escH(cleanNm(featured.name))+'</h3></div></div>' +
          '<p class="sf-line">'+escH(fLine)+'</p>' +
          '<div class="sf-foot"><span><span class="meta">'+escH(fDur)+'</span>' +
            '<span class="price">'+escH(ntd(featured.price))+'</span></span>' +
            '<span class="go">看介紹 <i class="ph ph-arrow-right"></i></span></div>';
      }
      // 2 張小卡：依品牌主題挑，去重排除 featured
      if(smallBox){
        var picks = [], used = {};
        used[featured && featured.id] = true;
        [/水鏡|查因果|通靈/, /命書|籤詩|問事/].forEach(function(re){
          var f = all.find(function(s){ return re.test(s.name) && !used[s.id]; });
          if(f){ picks.push(f); used[f.id] = true; }
        });
        for(var i=0;i<all.length && picks.length<2;i++){ if(!used[all[i].id]){ picks.push(all[i]); used[all[i].id]=true; } }
        if(picks.length){
          smallBox.innerHTML = picks.slice(0,2).map(function(s){
            var line = String(s.llm || (s.desc||'').replace(/<[^>]+>/g,'') || '').replace(/\s+/g,' ').trim().slice(0,40);
            var dur = s.duration ? (s.duration + ' 分鐘') : '一對一';
            return '<a class="svc-card" href="/services?id=sb-'+escH(s.id)+'">' +
              '<span class="disc">'+escH(glyph(s.name))+'</span>' +
