---
// 活動頁主題家族（wealth）：固定網址永遠顯示最新一週。status draft＝noindex，過字後改 published。
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeekPage from '../../components/WeekPage.astro';
import { WEEK_TOPICS, weeksOf } from '../../data/week-topics';
const topic = WEEK_TOPICS['wealth'];
const data = weeksOf('wealth')[0];
const draft = data.status !== 'published';
---
<BaseLayout
  title={`這週的${topic.label}卦・${data.hex.name} · 找風問幸福`}
  description={`${data.range_long}，這週的${topic.label}走「${data.hex.char}」。${data.line} ${topic.descTail}`}
  noindex={draft}
>
  <WeekPage data={data} topic={topic} isCurrent={true} />
</BaseLayout>
