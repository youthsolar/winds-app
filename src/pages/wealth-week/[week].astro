---
// 舊週存檔：/wealth-week/2026-w37/ 這種路徑，內容不刪，當搜尋資產。
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeekPage from '../../components/WeekPage.astro';
import { WEEK_TOPICS, weeksOf, type WeekData } from '../../data/week-topics';
export function getStaticPaths() {
  return weeksOf('wealth').map((data, i) => ({ params: { week: data.week }, props: { data, isCurrent: i === 0 } }));
}
const topic = WEEK_TOPICS['wealth'];
const { data, isCurrent } = Astro.props as { data: WeekData; isCurrent: boolean };
const draft = data.status !== 'published';
---
<BaseLayout
  title={`${data.range} 的${topic.label}卦・${data.hex.name} · 找風問幸福`}
  description={`${data.range_long}，那一週的${topic.label}走「${data.hex.char}」。${data.line} 風易揚老師的解卦。`}
  noindex={draft}
>
  <WeekPage data={data} topic={topic} isCurrent={isCurrent} />
</BaseLayout>
