---
// 活動頁主題卦（fortune）：固定網址永遠顯示老師最新的一卦，即時讀 worker（核准那一刻就換，不用重 build）。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicGua from '../../components/TopicGua.astro';
import { TOPICS, fetchTopicGua } from '../../data/topics';
const topic = TOPICS['fortune'];
const { data, failed } = await fetchTopicGua('fortune');
Astro.response.headers.set('Cache-Control', failed ? 'no-store' : 'public, max-age=60');   // 故障時的空狀態不能被快取
// 2026-10-18 Jeffery 拍板：社群當期一卦頁先不讓 Google 收錄（原本 noindex={!data}），要恢復發當期卦時再打開
---
<BaseLayout
  title={data ? `${topic.label}卦・${data.hex.name} · 找風問幸福` : `${topic.label}卦 · 找風問幸福`}
  description={data ? `回看 ${String(data.posted_long).replace(/^\d+\s*年\s*/,'').replace(/\s*月\s*/,'/').replace(/\s*日.*$/,'')} 的${topic.label}卦『${data.hex.name}』，讀讀風易揚老師的提醒，也可以不用登入，起一卦問問自己的事。` : `${topic.shareTitle}，${topic.descTail}`}
  ogImage={data?.og_url || undefined}
  noindex={true}
>
  <TopicGua data={data} topic={topic} isCurrent={true} />
</BaseLayout>
