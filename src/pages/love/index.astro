---
// 活動頁主題卦（love）：固定網址永遠顯示老師最新的一卦，即時讀 worker（核准那一刻就換，不用重 build）。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicGua from '../../components/TopicGua.astro';
import { TOPICS, fetchTopicGua } from '../../data/topics';
// 2026-10-14：好愛起卦頁搬到 /love-gua；舊的好愛結果連結（/love/?log_id=…，含付款前記下的回跳頁）照原參數轉過去
if (Astro.url.searchParams.has('log_id')) return Astro.redirect('/love-gua/' + Astro.url.search, 302);
const topic = TOPICS['love'];
const { data, failed } = await fetchTopicGua('love');
Astro.response.headers.set('Cache-Control', failed ? 'no-store' : 'public, max-age=60');   // 故障時的空狀態不能被快取
// 2026-10-18 Jeffery 拍板：社群當期一卦頁先不讓 Google 收錄（原本 noindex={!data}），要恢復發當期卦時再打開
---
<BaseLayout
  title={data ? `${topic.label}卦・${data.hex.name} · 找風問幸福` : `${topic.label}卦 · 找風問幸福`}
  description={data ? `${data.posted_long}起的${topic.label}卦，走「${data.hex.char}」。${data.line} ${topic.descTail}` : topic.descTail}
  ogImage={data ? (data.og_url || undefined) : "https://winds.tw/og/og-love.jpg"}
  noindex={true}
>
  <TopicGua data={data} topic={topic} isCurrent={true} />
</BaseLayout>
