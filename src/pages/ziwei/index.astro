  .unlock-cta p { font-family: var(--font-serif); font-weight: 300; color: var(--text-secondary); margin: 0 0 12px; font-size: 14.5px; line-height: 1.8; }
  .unlock-cta ul { text-align: left; max-width: 400px; margin: 0 auto 18px; padding-left: 20px; color: var(--ink-700); font-family: var(--font-serif); font-size: 14px; line-height: 1.9; }
  .unlock-btn { display: inline-block; background: var(--accent); color: var(--text-on-accent); border: none; padding: 14px 32px; border-radius: var(--radius-pill); font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; text-decoration: none; cursor: pointer; }
  .unlock-btn:hover { background: var(--accent-hover); }

  .share-block { max-width: 520px; margin: 16px auto 0; padding: 16px 20px; background: var(--winds-bg-card, #fff); border: 1px solid var(--winds-border); border-radius: 6px; }
  .share-block h4 { margin: 0 0 8px; color: var(--winds-text-dark); font-size: 14px; }
  .share-block input { width: 100%; padding: 8px 10px; border: 1px solid var(--winds-border); border-radius: 4px; font-size: 12px; font-family: inherit; background: var(--winds-bg); color: var(--winds-text); margin-bottom: 8px; box-sizing: border-box; }
  .share-block button { background: transparent; border: 1px solid var(--winds-gold-dark); color: var(--winds-gold-dark); padding: 6px 16px; border-radius: 4px; font-family: inherit; font-size: 12px; cursor: pointer; }
  .share-block button:hover { background: var(--winds-gold-dark); color: white; }

  .ziwei-form {
    max-width: 480px;
    margin: 0 auto;
    background: var(--surface-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: var(--shadow-sm);
  }

  .ziwei-form .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ziwei-form .row.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .ziwei-form .row.two-col > div { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .ziwei-form label {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: .02em;
    color: var(--ink-700);
    font-weight: 500;
  }
  .ziwei-form input,
  .ziwei-form select {
    width: 100%;
    box-sizing: border-box;
    max-width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--ink-900);
    text-overflow: ellipsis;
  }
  .ziwei-form input:focus,
  .ziwei-form select:focus {
    outline: none;
    border-color: var(--rose-300);
    box-shadow: 0 0 0 4px var(--focus-ring);
  }

  .submit-btn {
    background: var(--accent);
    color: var(--text-on-accent);
    border: none;
    padding: 15px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s;
  }
  .submit-btn:hover { background: var(--accent-hover); }
  .submit-btn:disabled { background: var(--rose-100); color: var(--rose-300); cursor: not-allowed; }

  .form-note {
    font-size: 12px;
    color: var(--winds-text-muted);
    text-align: center;
    margin: 0;
  }

  .result-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .back-btn {
    background: transparent;
    border: 1px solid var(--winds-border);
    color: var(--winds-text-sub);
    padding: 6px 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .back-btn:hover {
    background: var(--winds-bg);
    color: var(--winds-text-dark);
  }

  .tst-badge {
    background: rgba(139, 105, 20, 0.1);
    color: var(--winds-gold-dark);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .chart-toggle {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 16px;
  }
  .toggle-btn {
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    color: var(--ink-500);
    padding: 9px 20px;
    font-family: var(--font-serif);
    font-size: 14.5px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .toggle-btn:first-child { border-radius: var(--radius-pill) 0 0 var(--radius-pill); }
  .toggle-btn:last-child { border-radius: 0 var(--radius-pill) var(--radius-pill) 0; border-left: none; }
  .toggle-btn:hover { background: var(--rice-100); color: var(--ink-900); }
  .toggle-btn.is-active {
    background: var(--accent);
    color: var(--text-on-accent);
    border-color: var(--accent);
  }

  /* 流年宮名 — 取代 footer 的大限資訊（不增加 cell 高度）*/
  :global(.yearly-footer) {
    color: var(--rose-600);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* 流化星標（與本命化星區分：邊框樣式 + 「流」字頭）*/
  :global(.star-mutagen.yearly-mutagen) {
    background: transparent !important;
    border: 1px solid currentColor;
    padding: 0 4px;
  }
  :global(.star-mutagen.yearly-mutagen.mutagen-lu) { color: var(--sage-500); }
  :global(.star-mutagen.yearly-mutagen.mutagen-quan) { color: var(--gold-500); }
  :global(.star-mutagen.yearly-mutagen.mutagen-ke) { color: var(--rose-600); }
  :global(.star-mutagen.yearly-mutagen.mutagen-ji) { color: var(--critical); }

  /* 流年命宮 — 金圈光暈 */
  :global(.palace-cell.is-yearly-soul) {
    border-color: var(--rose-300);
    background: linear-gradient(155deg, var(--rose-50) 0%, var(--paper) 100%);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  :global(.yearly-soul-badge) {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 0 4px 0 6px;
    font-weight: 600;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  /* === ZiweiChart 樣式（複製自 component，因 client renders）=== */
  :global(.ziwei-chart) {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    background: var(--paper);
    border: 1px solid var(--border-soft);
    border-radius: 20px;
    padding: 10px;
    box-shadow: var(--shadow-md);
  }
  :global(.ziwei-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 4px;
    width: 100%;
    height: 100%;
  }
  :global(.palace-cell) {
    background: var(--surface-card);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 9px 10px 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4px;
    min-height: 0;
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s;
  }
  :global(.palace-cell.is-body) { border-color: var(--border-accent); }
  :global(.palace-cell.is-origin) { background: var(--rose-50); border-color: var(--rose-300); box-shadow: var(--shadow-sm); }
  :global(.palace-cell.is-current-decadal) {
    border-color: var(--rose-300);
    background: linear-gradient(155deg, var(--rose-50) 0%, var(--paper) 100%);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  :global(.current-decadal-badge) {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 0 4px 0 6px;
    font-weight: 600;
    letter-spacing: 0.05em;
    z-index: 2;
  }
  :global(.palace-cell.empty) { background: transparent; border: 1px dashed var(--winds-border); opacity: 0.3; }
  :global(.palace-cell.trine-highlight) { background: var(--rose-50); border-color: var(--rose-200); }
  :global(.palace-cell.trine-focus) { background: var(--accent-quiet); border-color: var(--rose-300); box-shadow: 0 0 0 1px var(--rose-300) inset; }

  :global(.cell-header) { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; color: var(--text-muted); padding-bottom: 3px; }
  :global(.palace-name) { font-family: var(--font-serif); font-weight: 600; color: var(--ink-700); font-size: 14px; letter-spacing: 0.03em; }
  :global(.palace-cell.is-origin .palace-name), :global(.palace-cell.is-yearly-soul .palace-name) { color: var(--rose-600); }
  :global(.body-tag) { background: var(--rose-100); color: var(--rose-600); font-style: normal; font-size: 9.5px; font-weight: 500; padding: 1px 7px; border-radius: 999px; margin-left: 6px; }
  :global(.cell-stem-branch) { color: var(--text-muted); font-size: 10.5px; }

  :global(.cell-stars) { flex: 1; display: flex; flex-direction: column; gap: 2px; overflow: hidden; font-size: 12px; line-height: 1.4; }
  :global(.star) { display: flex; align-items: baseline; gap: 3px; flex-wrap: wrap; }
  :global(.star .star-name) { font-family: var(--font-serif); letter-spacing: 0.02em; }
  :global(.star.major .star-name) { color: var(--ink-900); font-weight: 600; font-size: 16.5px; }
  :global(.star.minor .star-name) { color: var(--sage-500); font-weight: 500; font-size: 15.5px; }
  :global(.star-brightness) { color: var(--text-muted); font-size: 9px; padding: 0 2px; }
  :global(.star-mutagen) { font-family: var(--font-sans); font-size: 9px; font-weight: 700; padding: 0 3px; border-radius: 4px; }
  :global(.mutagen-lu) { background: var(--sage-200); color: var(--sage-500); }
  :global(.mutagen-quan) { background: var(--gold-300); color: var(--gold-500); }
  :global(.mutagen-ke) { background: var(--rose-100); color: var(--rose-600); }
  :global(.mutagen-ji) { background: var(--tint-rose-soft); color: var(--critical); }

  :global(.empty-palace) { color: var(--winds-text-muted); font-size: 11px; font-style: italic; }
  :global(.adjective-row) { display: flex; flex-wrap: wrap; gap: 2px 4px; margin-top: 2px; padding-top: 2px; border-top: 1px dotted rgba(139, 105, 20, 0.15); }
  :global(.adj-star) { color: var(--winds-text-muted); font-size: 10.5px; line-height: 1.5; }

  /* 雜曜：桌機全列、手機(≤480)摺成徽章 popover */
  :global(.adj-row) { display: flex; flex-wrap: wrap; gap: 1px 8px; margin-top: auto; padding-top: 4px; }
  :global(.adj-row .adj) { font-size: 10px; line-height: 1.3; }
  /* 手機雜曜：桃花 inline + +N雜 計數徽章（預設隱藏，≤480 顯示）*/
  :global(.adj-mobile) { display: none; flex-wrap: wrap; gap: 2px 6px; margin-top: 4px; }
  :global(.adj-mobile .adj-fl) { font-size: 10px; line-height: 1.3; color: var(--rose-500); }
  :global(.adj-mobile .adj-more) { font-family: var(--font-sans); font-size: 9.5px; color: var(--text-muted); background: var(--surface-sunken); border-radius: 999px; padding: 0 6px; line-height: 1.6; }
  /* 底部詳情卡（對齊 DS ZiweiSheet；全寬出血 + 過高捲動不破格）*/
  :global(#zw-sheet-host .zw-scrim) { position: fixed; inset: 0; background: rgba(46,40,35,.4); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); z-index: 60; }
  :global(.zw-sheet) { position: fixed; left: 0; right: 0; bottom: 0; box-sizing: border-box; max-height: 82vh; overflow-y: auto; background: var(--surface-card); border-radius: 22px 22px 0 0; padding: 10px 22px calc(34px + env(safe-area-inset-bottom)); z-index: 61; box-shadow: 0 -8px 32px rgba(46,40,35,.18); animation: zwUp .26s var(--ease-soft); }
  @keyframes zwUp { from { transform: translateY(101%); } to { transform: none; } }
  :global(.zw-handle) { width: 38px; height: 4px; border-radius: 999px; background: var(--rice-300); margin: 0 auto 14px; }
  :global(.zw-title) { font-family: var(--font-serif); font-size: 19px; font-weight: 600; color: var(--ink-900); margin-bottom: 14px; }
  :global(.zw-title .zw-sub) { font-size: 13px; font-weight: 400; color: var(--text-muted); margin-left: 8px; }
  :global(.zw-stars) { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
  :global(.zs-star) { display: inline-flex; align-items: flex-start; line-height: 1.15; }
  :global(.zs-star .zs-name) { font-family: var(--font-serif); font-size: 23px; font-weight: 600; letter-spacing: .02em; }
  :global(.zs-star.minor .zs-name) { font-size: 21px; font-weight: 500; }
  :global(.zs-br) { font-family: var(--font-sans); font-size: 11px; color: var(--text-muted); margin-left: 1px; margin-top: 2px; }
  :global(.zs-mut) { font-family: var(--font-sans); font-size: 10px; font-weight: 700; border-radius: 4px; padding: 0 3px; margin-left: 2px; margin-top: 1px; line-height: 1.5; }
  :global(.zw-adjs) { display: flex; flex-wrap: wrap; gap: 7px 13px; margin-bottom: 16px; }
  :global(.zs-adj) { font-size: 14.5px; }
  :global(.zs-empty) { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); }
  :global(.zw-foot) { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); border-top: 1px solid var(--border-soft); padding-top: 13px; }
  /* 雜星收摺徽章（手機用） */
  :global(.adj-toggle) {
    display: none;
    align-items: center;
    gap: 2px;
    background: rgba(139, 105, 20, 0.08);
    border: 1px dashed rgba(139, 105, 20, 0.3);
    color: var(--winds-text-muted);
    font-family: inherit;
    font-size: 9.5px;
    padding: 1px 6px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 3px;
    align-self: flex-start;
    transition: all 0.15s;
  }
  :global(.adj-toggle:hover) { background: rgba(139, 105, 20, 0.15); border-style: solid; color: var(--winds-gold-dark); }
  :global(.adj-count) { font-weight: 700; }
  :global(.adj-tag) { letter-spacing: 0.05em; }

  /* 雜星 popover — absolute 浮在 cell 上方 */
  :global(.palace-cell) { position: relative; }  /* 確保 popover anchor */
  :global(.adj-popover) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--winds-bg-card, #fff);
    border: 1px solid var(--winds-gold-dark);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(139, 105, 20, 0.25);
    padding: 8px 10px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    min-width: 120px;
    max-width: 200px;
    white-space: nowrap;
  }
  :global(.adj-popover[hidden]) { display: none; }
  :global(.adj-popover .adj-star) { font-size: 11px; color: var(--winds-text-dark); }
  :global(.adj-popover::after) {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--winds-gold-dark);
  }
  :global(.cell-footer) { font-size: 9px; color: var(--winds-text-muted); border-top: 1px dotted var(--winds-border); padding-top: 2px; display: flex; justify-content: space-between; align-items: center; gap: 4px; }
  :global(.cell-footer .cs) { color: var(--winds-text-muted); white-space: nowrap; }

  :global(.center-meta) { background: linear-gradient(155deg, var(--rose-50) 0%, var(--paper) 100%); border: 1px solid var(--rose-100); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; justify-content: center; gap: 5px; font-family: var(--font-sans); font-size: 12px; box-sizing: border-box; }
  :global(.meta-row) { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; line-height: 1.5; color: var(--ink-700); }
  :global(.meta-row-inline) { justify-content: center; }
  :global(.meta-line-center) { justify-content: center; font-family: var(--font-serif); color: var(--rose-600); font-weight: 500; letter-spacing: 0.04em; }
  :global(.meta-label) { color: var(--text-muted); font-size: 10.5px; }
  :global(.meta-value) { color: var(--ink-900); font-weight: 500; }
  :global(.meta-emphasize) { font-family: var(--font-serif); color: var(--ink-900); font-weight: 500; }
  :global(.meta-sep) { color: var(--rose-200); padding: 0 2px; }
  :global(.meta-pill) { background: var(--rose-100); color: var(--rose-600); padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 500; }
  :global(.meta-divider) { height: 1px; background: var(--rose-100); margin: 6px 0; }

  /* 解讀區 */
  :global(.interpretation-section) {
    max-width: 720px;
    margin: 40px auto 0;
    padding: 24px 16px;
  }
  :global(.interpretation-section h2) {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--ink-900);
    margin: 0 0 4px;
  }
  :global(.ai-note) {
    font-family: var(--font-sans);
    color: var(--text-muted);
    font-size: 12px;
    margin: 0 0 24px;
  }
  :global(.trend-section), :global(.sihua-section) { margin: 26px 0 0; }
  :global(.trend-section h2), :global(.sihua-section h2) { font-family: var(--font-serif); font-size: 20px; font-weight: 500; color: var(--ink-900); margin: 0 0 4px; }
  /* 四化飛星（沿用 trend 區版式 + MUT chip 詞彙，對齊 DS token；與 LIFF 雙生同款）*/
  :global(.sihua-map) { background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 12px; }
  :global(.sihua-row) { display: flex; align-items: baseline; gap: 8px; padding: 5px 0; border-bottom: 1px dotted var(--border-soft); font-family: var(--font-sans); font-size: 12.5px; line-height: 1.6; }
  :global(.sihua-row:last-child) { border-bottom: none; }
  :global(.sihua-row.is-ming) { background: linear-gradient(90deg, var(--rose-50), transparent); margin: 0 -8px; padding-left: 8px; padding-right: 8px; border-radius: var(--radius-sm); }
  :global(.sihua-from) { flex: 0 0 auto; color: var(--rose-600); font-weight: 600; white-space: nowrap; }
  :global(.sihua-from .stem) { color: var(--text-muted); font-weight: 400; font-size: 11px; }
  :global(.sihua-flows) { display: flex; flex-wrap: wrap; gap: 4px 8px; }
  :global(.sihua-flow) { white-space: nowrap; color: var(--ink-700); }
  :global(.sihua-tag) { font-size: 9px; padding: 0 4px; border-radius: 2px; color: #fff; font-weight: 600; margin-right: 2px; }
  :global(.sihua-flow .to) { color: var(--accent-press); }
  :global(.sihua-flow.self .to) { color: var(--critical); font-weight: 600; }
  :global(.sihua-self-sum) { font-family: var(--font-sans); font-size: 11.5px; color: var(--text-muted); margin: 8px 0 0; line-height: 1.7; }
  :global(.cell-self-chip) { font-size: 7.5px; line-height: 1; padding: 1px 3px; border-radius: 2px; color: #fff; font-weight: 700; margin-left: 3px; vertical-align: middle; }
  :global(.trend-toggle) { display: flex; gap: 8px; justify-content: center; margin: 12px 0; }
  :global(.ttog) { font-family: var(--font-sans); font-size: 13px; padding: 6px 14px; border-radius: var(--radius-pill); border: 1px solid var(--rose-200); background: var(--paper); color: var(--accent-press); cursor: pointer; }
  :global(.ttog.is-active) { background: var(--accent); color: var(--text-on-accent); border-color: transparent; }
  :global(#trend-chart) { background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); padding: 10px 6px 4px; }
  :global(.trend-svg) { width: 100%; height: auto; display: block; }
  :global(.interp-block) {
    background: var(--surface-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    margin-bottom: 14px;
    box-shadow: var(--shadow-sm);
  }
  :global(.interp-block h3) {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--ink-900);
    margin: 0 0 12px;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 12px;
  }
  :global(.interp-text) {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.95;
    color: var(--ink-800);
    white-space: pre-wrap;
  }
  :global(.interp-text.loading) {
    color: var(--winds-text-muted);
    font-style: italic;
  }
  :global(.interp-text.error) {
    color: var(--winds-danger);
    font-size: 13px;
  }
  :global(.retry-palace) {
    background: transparent;
