  .loading-section { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding: 72px 16px; color: var(--text-muted); font-family: var(--font-serif); font-size: 15px; }

  .form-warning { max-width: 480px; margin: 0 auto 16px; padding: 12px 16px; background: rgba(192, 57, 43, 0.06); border-left: 3px solid var(--winds-danger); border-radius: 4px; color: var(--winds-text-dark); font-size: 13px; line-height: 1.6; }

  .paid-badge { background: rgba(45, 134, 89, 0.1); color: #2d8659; font-size: 12px; padding: 4px 10px; border-radius: 12px; font-weight: 600; }

  .unlock-cta { background: var(--surface-tint); border: 1px solid var(--rose-100); border-radius: var(--radius-lg); padding: 24px 28px; text-align: center; margin: 32px auto 16px; max-width: 520px; }
