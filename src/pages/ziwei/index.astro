  function showResult(chartData: any) {
    hideAllSections();
    resultSection.hidden = false;

    const tstBadge = document.getElementById('tst-badge') as HTMLElement;
    if (chartData.tst?.applied) {
      tstBadge.hidden = false;
      const sign = chartData.tst.correctionMinutes >= 0 ? '+' : '';
      tstBadge.textContent = `已套用真太陽時校正（${sign}${chartData.tst.correctionMinutes} 分鐘）`;
    } else {
      tstBadge.hidden = true;
    }

    // toggle 顯示（只在有 horoscope 時）
    const chartToggle = document.getElementById('chart-toggle') as HTMLElement;
    chartToggle.hidden = !chartData.horoscope;

    const horoscope = chartData.horoscope as Horoscope | null;
    const yearlyApiCtx = horoscope ? buildYearlyContextForApi(horoscope) : null;
    const currentYear = yearlyApiCtx?.year;

    // 流年盤的 toggle button label 帶當前年份
    if (currentYear) {
      const yBtn = chartToggle.querySelector<HTMLButtonElement>('.toggle-btn[data-mode="yearly"]');
      if (yBtn) yBtn.textContent = `流年盤 (${currentYear})`;
    }

    const chartMount = document.getElementById('chart-mount') as HTMLElement;
    const interpMount = document.getElementById('interpretation-mount') as HTMLElement;
    let currentMode: 'natal' | 'yearly' = 'natal';

    // client-side 解讀 cache：避免來回切換重複 fetch
    const interpCache: { natal: Record<string, string | null>; yearly: Record<string, string | null> } = {
      natal: {},
      yearly: {},
    };
    const interpStarted: { natal: boolean; yearly: boolean } = { natal: false, yearly: false };

    const renderChartCurrent = () => renderChart(chartData.chart as Chart, chartMount, horoscope, currentMode);

    // 載入指定 mode 的 7 段解讀（首次才打 API，已 cached 直接渲染）
    const loadInterpretations = (mode: 'natal' | 'yearly') => {
      renderInterpretationSkeleton(interpMount, mode, currentYear);
      const cache = interpCache[mode];
      // 已有的 cache 立刻渲染
      for (const palace of FOCUS_PALACES) {
        if (cache[palace] !== undefined) {
          renderPalaceText(palace, cache[palace], interpMount);
        }
      }
      // 沒打過就打
      if (!interpStarted[mode]) {
        interpStarted[mode] = true;
        // 13 段（摘要 + 12 宮）分批並發，cap 4，避免一次打爆 Anthropic 速率限制
        const queue = [...FOCUS_PALACES];
        const CONCURRENCY = 4;
        Array.from({ length: CONCURRENCY }, async () => {
          while (queue.length) {
            const palace = queue.shift()!;
            const text = await fetchPalace(chartData.chart as Chart, palace, mode, mode === 'yearly' ? yearlyApiCtx ?? undefined : undefined);
            cache[palace] = text;
            // 只在當前 mode 還是這個時渲染（避免快速切換 race condition）
            if (currentMode === mode) renderPalaceText(palace, text, interpMount);
          }
        });
      }
    };

    renderChartCurrent();
    if (EDM_TOKEN) {
      // 命盤到此為止：解讀／流年走勢／四化都要打 Anthropic，成本高且正是付費品
      interpMount.hidden = true;
      const trendMount = document.getElementById('trend-mount');
      const sihuaMount = document.getElementById('sihua-mount');
      if (trendMount) trendMount.hidden = true;
      if (sihuaMount) sihuaMount.hidden = true;
    } else {
      loadInterpretations('natal');
      renderTrendSection(document.getElementById('trend-mount'), chartData.chart as Chart, horoscope?.trend, chartData.paid);
      renderSihuaSection(document.getElementById('sihua-mount'), chartData.chart as Chart, horoscope?.sihua, chartData.paid);
    }

    chartToggle.querySelectorAll<HTMLButtonElement>('.toggle-btn').forEach((btn) => {
      btn.onclick = () => {
        const mode = btn.dataset.mode as 'natal' | 'yearly';
        if (mode === currentMode) return;
        currentMode = mode;
        chartToggle.querySelectorAll('.toggle-btn').forEach((b) => b.classList.toggle('is-active', b === btn));
        renderChartCurrent();
        if (!EDM_TOKEN) loadInterpretations(mode);
      };
    });

    // Retry handler (delegated)
    interpMount.addEventListener('click', async (ev) => {
      const target = ev.target as HTMLElement;
      if (target.classList.contains('retry-palace')) {
        const palace = target.dataset.palace;
        if (!palace) return;
        const block = interpMount.querySelector(`[data-palace="${palace}"] .interp-text`);
        if (!block) return;
        block.className = 'interp-text loading';
        block.textContent = '重試中…';
        // 2026-09-28（Codex 體檢）：送出時就固定模式——等待期間切到流年，本命的回應不能存進流年、也不能畫上去
        const reqMode = currentMode;
        const text = await fetchPalace(chartData.chart as Chart, palace, reqMode, reqMode === 'yearly' ? yearlyApiCtx ?? undefined : undefined);
        interpCache[reqMode][palace] = text;
        if (currentMode === reqMode) renderPalaceText(palace, text, interpMount);
      }
    });

    // 解鎖按鈕（未付費才顯示）
    const unlockCta = document.getElementById('unlock-cta') as HTMLElement;
    const paidBadge = document.getElementById('paid-badge') as HTMLElement;
    if (chartData.paid) {
      unlockCta.hidden = true;
      paidBadge.hidden = false;
    } else {
      unlockCta.hidden = false;
      paidBadge.hidden = true;
    }
    // 金流併單：紫微解鎖併入 NT$360 全解（unlock-btn 為 <a href="/divination">，無需單買 handler）

    // 分享連結
    const shareBlock = document.getElementById('share-block') as HTMLElement;
    const shareUrlInput = document.getElementById('share-url') as HTMLInputElement;
    const shareCopyBtn = document.getElementById('share-copy') as HTMLButtonElement;
    if (chartData.share_token) {
      shareBlock.hidden = false;
      shareUrlInput.value = `https://winds.tw/ziwei/share/${chartData.share_token}`;
      shareCopyBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(shareUrlInput.value);
          shareCopyBtn.textContent = '已複製';
          setTimeout(() => { shareCopyBtn.textContent = '複製連結'; }, 2000);
        } catch {
          shareUrlInput.select();
        }
      };
    } else {
      shareBlock.hidden = true;
    }
  }

  // === Form submit：新使用者算盤 ===
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(true);
    errorSection.hidden = true;

    const fd = new FormData(form);
    // 生日三欄組回 YYYY-MM-DD（API 介面不變）
    const pad2 = (v: string) => v.padStart(2, '0');
    const solarDate = `${fd.get('solarYear')}-${pad2(String(fd.get('solarMonth')))}-${pad2(String(fd.get('solarDay')))}`;
    const payload: Record<string, unknown> = {
      name: String(fd.get('name') || '').trim(),
      solarDate,
      gender: fd.get('gender'),
      withHoroscope: true,
    };
    const hour = fd.get('hour');
    if (hour) payload.hour = Number(hour);
    const lon = fd.get('longitude');
    if (lon) payload.longitude = Number(lon);
    // 校正要用實際時間；只有時辰就不能冒充精確時間
    const bt = String(fd.get('birthTime') || '');
    if (lon) {
      const m = bt.match(/^(\d{1,2}):(\d{2})/);
      if (!m) { showError('選了出生地經度（真太陽時校正）就要填實際出生時間；只知道時辰的話，經度請選「不校正」。'); return; }
      payload.hour = Number(m[1]);
      payload.minute = Number(m[2]);
    }

    let chartData: any;
    try {
      if (EDM_TOKEN) payload.t = EDM_TOKEN;
      const r = await fetch(`${WORKER_API}${EDM_TOKEN ? '/edm/ziwei-chart' : '/ziwei-chart'}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...(EDM_TOKEN ? {} : authHeaders()) },
        body: JSON.stringify(payload),
      });
      chartData = await r.json();
      // 已存在情況也走 showResult（worker 會回 already_exists + chart）
      if (!chartData.ok && !chartData.already_exists) {
        throw new Error(chartData.error || chartData.message || '命盤生成失敗');
      }
      if (chartData.already_exists) {
        // 此使用者已有命盤，補拿 horoscope（worker 已存的 my-chart）
        const my = await fetch(`${WORKER_API}/ziwei-my-chart`, { headers: authHeaders() }).then((x) => x.json());
        // 2026-09-30（廣告前全站掃描）：補拿失敗（401／tokeninfo 暫時錯誤）原本照樣 showResult，chart 是 undefined → 結果區整片空白
        // → 沒拿到命盤就丟進下面的 catch → showError（表單留著）
        if (!my.ok || !my.exists || !my.chart) throw new Error(my.error || '無法讀取命盤');
        chartData = my;
      }
    } catch (err: any) {
      showError(err.message || '無法連線到伺服器');
      setLoading(false);
      return;
    }

    setLoading(false);
    showResult(chartData);
  });

  // === Google Sign-In button render（在 auth-gate 內） ===
  function renderGoogleSignIn() {
    // 2026-09-30（廣告前全站掃描）：原本找不到 BaseLayout 的 [data-client_id] 就 return（線上建置從沒輸出過），連 3.5 秒外開引導都排不到
    // → 退回全站同一顆公開 client id（login／gift／FunnelDocument 同款），按鈕與外開引導都會出來
    const clientId = (document.querySelector('[data-client_id]') as HTMLElement | null)?.dataset.client_id
      || '35219881811-2rnl87e0qmb9vsuhuqnfooo0a0af5ggd.apps.googleusercontent.com';
    // 2026-10-10：載入時 Google 先出暫代鈕、約 0.2 秒後才換成真按鈕，切亮暗又是先清空再重畫 → 會閃
    // → 同 2pr.ai 登入頁：新按鈕畫在看不見的那層，框載入完、暫代字消失、再過兩幀才換上；舊的留到那一刻
    let inited = false, activeKey = '', pendingKey = '', gen = 0;
    let cancelPending: (() => void) | null = null;
    const renderBtn = () => {
      const target = document.getElementById('g_id_signin_ziwei');
      const g = (window as any).google?.accounts?.id;
      if (!target || !g) return;
      const key = ((window as any).ZFTheme && (window as any).ZFTheme.isDark()) ? 'filled_black' : 'outline';
      if (key === pendingKey) return;
      if (cancelPending) cancelPending();
      if (key === activeKey) return;
      const my = ++gen; pendingKey = key;
      const slot = document.createElement('div');
      slot.className = 'gsi-slot gsi-slot--pending'; slot.setAttribute('aria-hidden', 'true'); (slot as any).inert = true;
      slot.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:inherit;opacity:0;pointer-events:none;';
      target.appendChild(slot);
      let timer = 0, frameEl: HTMLIFrameElement | null = null, loaded = false;
      const watch = new MutationObserver(() => check());
      const done = () => { watch.disconnect(); clearTimeout(timer); if (cancelPending === cancel) cancelPending = null; };
      const cancel = () => { done(); slot.remove(); if (my === gen && pendingKey === key) pendingKey = ''; };
      const swap = () => {
        if (my !== gen || pendingKey !== key) return;
        done();
        Array.from(target.children).forEach((n) => { if (n !== slot) n.remove(); });   // 舊按鈕、外開引導一起換掉
        slot.className = 'gsi-slot'; slot.removeAttribute('aria-hidden'); (slot as any).inert = false;
        slot.style.opacity = ''; slot.style.pointerEvents = '';
        activeKey = key; pendingKey = '';
      };
      const check = () => {
        const f = slot.querySelector('iframe');
        if (f && f !== frameEl) {
          frameEl = f; loaded = false;
          f.addEventListener('load', () => { if (f === frameEl) { loaded = true; check(); } }, { once: true });
        }
        if (f && loaded && !(slot.textContent || '').trim()) requestAnimationFrame(() => requestAnimationFrame(swap));
      };
      cancelPending = cancel;
      watch.observe(slot, { childList: true, subtree: true });
      // 6 秒還沒好：已有按鈕就留舊的；第一次載入就先把暫代鈕露出來（照舊可按）
      timer = window.setTimeout(() => { if (target.querySelector('.gsi-slot:not(.gsi-slot--pending)')) cancel(); else swap(); }, 6000);
      g.renderButton(slot, { theme: key, size: 'large', shape: 'pill', text: 'signin_with', logo_alignment: 'left', width: 280, locale: 'zh-TW' });
    };
    // 等 GIS script 載入
    const tryRender = () => {
      const g = (window as any).google?.accounts?.id;
      if (!g) { setTimeout(tryRender, 200); return; }
      if (!inited) {
        g.initialize({
          client_id: clientId,
          callback: (resp: { credential: string }) => {
            /* 2026-10-29 SSO：比照 /login 走 WindsLine.afterLogin。這頁登入閘在填表之前、登入完只是重新整理，沒有進行中的資料 →
               WP 還是別人就照 /login 繞 WP 登出頁（繞完落首頁＝§11 拍板代價，再點紫微回來就是登入狀態） */
            const WL = (window as any).WindsLine;
            let dest = '';
            try { if (WL && WL.afterLogin) dest = WL.afterLogin('google', resp.credential, location.pathname + location.search, false); } catch {}
            if (!dest) { try { localStorage.setItem('winds_google_token', resp.credential); } catch {} }
            if (WL && dest === WL.WP_LOGOUT) { WL.goWpLogout(); return; }
            location.reload();
          },
        });
        inited = true;
      }
      const target = document.getElementById('g_id_signin_ziwei');
      if (target) {
        target.removeAttribute('data-fb');   // GSI 晚到就把外開引導換回真按鈕
        renderBtn();
      }
    };
    // App 內嵌瀏覽器：Google 直接封鎖 OAuth，按鈕就算渲染出來也登不進去 → 不掛 GSI，直接出引導。
    // 其餘環境照舊掛 GSI，3.5 秒後掛載點還空的才接手（tryRender 是無限重試、沒有逾時）。
    const inApp = !!((window as any).ZFInApp && (window as any).ZFInApp());
    if (!inApp) tryRender();
    // 切換亮暗時重畫，按鈕跟著換色（同 login／gift）
    window.addEventListener('zf-theme-change', () => {
      const target = document.getElementById('g_id_signin_ziwei');
      if (inApp || !inited || !target || target.hasAttribute('data-fb')) return;
      renderBtn();
    });
    const showFb = (force: boolean) => {
      const target = document.getElementById('g_id_signin_ziwei');
      if (!target) return;
      if (!force && target.childNodes.length) return;
      target.setAttribute('data-fb', '1');
      target.innerHTML =
        '<div class="auth-fb">' +
          '<p class="auth-fb-t">這個瀏覽器不支援 Google 登入</p>' +
          '<p class="auth-fb-d">請點右上角「⋯」選「在瀏覽器開啟」，用 Safari 或 Chrome 進來就可以登入了。</p>' +
          '<button type="button" class="auth-fb-btn" id="ziweiCopy">複製網址</button>' +
          (/Android/i.test(navigator.userAgent)
            ? '<a class="auth-fb-btn" href="intent://' + location.host + location.pathname + location.search + '#Intent;scheme=https;package=com.android.chrome;end">用 Chrome 開啟</a>'
            : '') +
        '</div>';
      const b = document.getElementById('ziweiCopy');
      if (b) b.addEventListener('click', () => {
        const u = location.href;
        const done = () => { b.textContent = '已複製'; };
        const legacy = () => {
          try {
            const t = document.createElement('textarea');
            t.value = u; t.style.position = 'fixed'; t.style.opacity = '0';
            document.body.appendChild(t); t.select(); document.execCommand('copy');
            document.body.removeChild(t); done();
          } catch {}
        };
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(u).then(done, legacy); return;
          }
        } catch {}
        legacy();
      });
    };
    if (inApp) showFb(true);
    else setTimeout(() => showFb(false), 3500);
  }

  // === 進站偵測：有 token + 有命盤 → 直接顯示結果 ===
  async function bootstrap() {
    if (EDM_TOKEN) {                 // eDM 旁路：直接給表單，不查既有命盤、不要求登入
      hideAllSections();
      formSection.hidden = false;
      return;
    }
    const token = getGoogleToken();
    if (!token) {
      hideAllSections();
      authGate.hidden = false;
      renderGoogleSignIn();
      return;
    }
    hideAllSections();
    loadingSection.hidden = false;
    try {
      const r = await fetch(`${WORKER_API}/ziwei-my-chart`, { headers: authHeaders() });
      const data = await r.json();
      if (!data.ok) throw new Error(data.error || '無法讀取命盤');
      if (data.exists) {
        showResult(data);
      } else {
        hideAllSections();
        formSection.hidden = false;
        prefillName();
      }
    } catch (err: any) {
      showError(err.message || '無法連線');
    }
  }
  bootstrap();
</script>

