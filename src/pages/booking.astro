---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSONAS } from '../data/booking-teachers';

// 老師卡＝真實 SimplyBook 老師（/sb-providers）+ LLM 生成 persona/介紹/引言（teacher_meta）。
// 站內預約精靈：[地點(實體/遠端，多地點老師才有)]→項目→時間→資料→確認→付訂金。
// 吃真實 SB 時段（/sb-slots）+ 地點（/sb-providers locations）+ 自家 ECPay 收訂金（/sb-book）。
// 地點＝SB 兩地（台北實體 12 / 遠端Zoom 15），決定老師可選範圍+SB 落單地點+客戶指示。
---
<BaseLayout
  title="預約老師 · 找風問幸福｜塔羅・紫微・八字・通靈一對一對談"
  description="找一位老師，好好說說話。風易揚老師與同門老師，各有自己的專長和說話方式。可以線上談，也可以約現場。"
  ogType="website"
>
  <div class="booking-root">
    <main class="bk-main">
      <div class="bk-intro">
        <span class="bk-eyebrow"><span class="bk-eyebrow-dot"></span>預約老師</span>
        <h1 class="bk-title">找一位，好好說說話。</h1>
      </div>

      <!-- 風格篩選 -->
      <div class="bk-filter">
        <div class="bk-chips" id="bkChips">
          <button class="bk-chip on" data-persona="all" type="button">全部</button>
          {PERSONAS.map((p) => (
            <button class="bk-chip" data-persona={p.key} type="button">{p.name}</button>
          ))}
        </div>
        <p class="bk-persona-desc" id="bkPersonaDesc" hidden></p>
      </div>

      <div class="bk-grid" id="bkGrid">
        <div class="bk-skel"></div><div class="bk-skel"></div><div class="bk-skel"></div>
      </div>
      <p class="bk-empty" id="bkEmpty" hidden>這個風格目前還沒有老師，換個風格看看？</p>
    </main>
    <div class="bk-wiz-mount" id="bkWiz"></div>
  </div>

  <script type="application/json" id="bkPersonas" set:html={JSON.stringify(PERSONAS)} />

  <style is:global>
    /* ====== 預約老師（namespaced under .booking-root）====== */
    .booking-root .zfbtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-serif);font-weight:var(--w-medium);letter-spacing:0.04em;line-height:1;border-radius:var(--radius-pill);white-space:nowrap;cursor:pointer;transition:background var(--dur-fast) var(--ease-soft);border:1px solid transparent;text-decoration:none;}
    .booking-root .zfbtn.md{padding:11px 22px;font-size:var(--t-body);min-height:44px;}
    .booking-root .zfbtn.secondary{background:var(--surface-card);color:var(--ink-900);border-color:var(--border-strong);box-shadow:var(--shadow-xs);}
    .booking-root .zfbtn.secondary:hover{background:var(--rice-100);text-decoration:none;}
    .booking-root .zfbtn i{font-size:16px;line-height:1;}

    .bk-main{max-width:var(--container);margin:0 auto;width:100%;box-sizing:border-box;padding:44px 28px 64px;}
    /* StepIntro */
    .bk-intro{display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin-bottom:34px;}
    .bk-eyebrow{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:0.02em;color:var(--accent-press);}
    .bk-eyebrow-dot{width:6px;height:6px;border-radius:999px;background:var(--accent);flex:none;}
    .bk-title{font-family:var(--font-serif);font-size:38px;font-weight:500;line-height:1.3;letter-spacing:0.01em;margin:0;color:var(--ink-900);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}

    /* persona filter */
    .bk-filter{margin-bottom:28px;}
    .bk-chips{display:flex;flex-wrap:wrap;gap:10px;}
    .bk-chip{all:unset;cursor:pointer;white-space:nowrap;flex:none;font-family:var(--font-serif);font-size:14.5px;font-weight:500;letter-spacing:0.01em;line-height:1;color:var(--accent-press);background:var(--surface-card);border:1px solid var(--rose-200);border-radius:var(--radius-pill);padding:8px 16px;transition:all var(--dur-fast) var(--ease-soft);}
    .bk-chip.on{color:var(--text-on-accent);background:var(--accent);border-color:transparent;box-shadow:var(--shadow-sm);}
    .bk-persona-desc{font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.7;color:var(--text-secondary);margin:12px 0 0;}

    /* recommended */
    .bk-rec{margin-bottom:34px;}
    .bk-rec-label{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .bk-rec-label i{font-size:16px;color:var(--rose-400);}
    .bk-rec-label span{font-family:var(--font-sans);font-size:13px;font-weight:600;letter-spacing:0.04em;color:var(--accent-press);}
    .bk-rec-frame{position:relative;border-radius:var(--radius-xl);padding:4px;background:linear-gradient(135deg, var(--rose-200), var(--clay-300));}
    .bk-rec-inner{background:var(--surface-page);border-radius:calc(var(--radius-xl) - 4px);padding:22px;}
    .bk-rec-reason{display:flex;align-items:flex-start;gap:10px;margin-bottom:16px;padding:12px 16px;background:var(--surface-tint);border-radius:var(--radius-md);}
    .bk-rec-reason i{font-size:18px;color:var(--rose-500);flex:none;margin-top:2px;}
    .bk-rec-reason span{font-family:var(--font-serif);font-size:16px;line-height:1.75;color:var(--ink-700);}

    .bk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;}
    @media (max-width:1024px){.bk-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
    .bk-empty{font-family:var(--font-serif);font-weight:300;font-size:16px;color:var(--text-muted);text-align:center;padding:32px 0;}
    .bk-skel{height:320px;border-radius:var(--radius-lg);background:linear-gradient(90deg,var(--rice-100),var(--rice-50),var(--rice-100));background-size:200% 100%;animation:bkShim 1.4s linear infinite;}
    @keyframes bkShim{to{background-position:-200% 0;}}

    /* ===== 預約精靈 ===== */
    .booking-root .bw-scrim{position:fixed;inset:0;z-index:90;background:var(--scrim);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);}
    .booking-root .bw-panel{position:fixed;z-index:91;left:50%;top:50%;transform:translate(-50%,-50%);width:min(520px,calc(100vw - 32px));max-height:88vh;display:flex;flex-direction:column;background:var(--surface-page);border-radius:var(--radius-2xl);box-shadow:var(--shadow-xl);overflow:hidden;}
    .booking-root .bw-head{position:relative;padding:22px 24px 16px;border-bottom:1px solid var(--border-soft);}
    .booking-root .bw-x{position:absolute;top:16px;right:16px;border:none;background:transparent;cursor:pointer;color:var(--ink-500);padding:4px;display:flex;}
    .booking-root .bw-x i{font-size:20px;}
    .booking-root .bw-prog{display:flex;gap:6px;margin-bottom:14px;}
    .booking-root .bw-dot{width:26px;height:4px;border-radius:999px;background:var(--rice-300);}
    .booking-root .bw-dot.on{background:var(--accent);}
    .booking-root .bw-title{font-family:var(--font-serif);font-size:22px;font-weight:500;color:var(--ink-900);}
    .booking-root .bw-sub{font-family:var(--font-sans);font-size:13px;color:var(--text-muted);margin-top:3px;}
    .booking-root .bw-sub + .bw-sub{margin-top:0;line-height:1.5;}   /* 第二行＝項目名（10/08），貼緊老師名字 */
    .booking-root .bw-body{padding:20px 24px;overflow:auto;flex:1;}
    .booking-root .bw-foot{display:flex;gap:12px;padding:16px 24px;border-top:1px solid var(--border-soft);}
    .booking-root .bw-foot .zfbtn{flex:1;}
    .booking-root .zfbtn.primary{background:var(--accent);color:var(--text-on-accent);box-shadow:var(--shadow-sm);}
    .booking-root .zfbtn.primary:hover{background:var(--accent-hover);}
    .booking-root .zfbtn.disabled{opacity:.45;pointer-events:none;}
    .booking-root .bw-list{display:flex;flex-direction:column;gap:10px;}
    .booking-root .bw-opt{all:unset;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border:1px solid var(--border-strong);border-radius:var(--radius-md);background:var(--surface-card);transition:all var(--dur-fast);}
    .booking-root .bw-opt:hover{border-color:var(--rose-300);background:var(--rose-50);}
    .booking-root .bw-opt-nm{font-family:var(--font-serif);font-size:16px;color:var(--ink-900);display:block;}
    .booking-root .bw-opt-meta{font-family:var(--font-sans);font-size:12px;color:var(--text-muted);}
    .booking-root .bw-opt-price{font-family:var(--font-serif);font-size:15px;color:var(--ink-900);text-align:right;white-space:nowrap;}
    .booking-root .bw-opt-dep{display:block;font-family:var(--font-sans);font-size:11px;color:var(--rose-600);}
    /* 2026-10-08 Jeffery：選時間照 LINE 預約（liff/booking.html .lbl-row／.date-cell）——日期卡＝週幾＋日＋幾個時段 */
    .booking-root .bw-lbl{display:flex;align-items:center;gap:8px;margin-bottom:14px;}
    .booking-root .bw-lbl .t{font-family:var(--font-serif);font-size:17px;font-weight:500;color:var(--ink-900);}
    .booking-root .bw-lbl i{color:var(--rose-500);}
    .booking-root .bw-lbl.second{margin-top:24px;}
    .booking-root .bw-dates{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;}
    .booking-root .bw-date{all:unset;cursor:pointer;flex:none;width:62px;text-align:center;padding:11px 0;border-radius:var(--radius-md);background:var(--surface-card);border:1px solid var(--border-soft);transition:all var(--dur-fast) var(--ease-soft);}
    .booking-root .bw-date.on{background:var(--accent);border-color:transparent;}
    .booking-root .bw-date .w{display:block;font-family:var(--font-sans);font-size:12px;color:var(--text-muted);}
    .booking-root .bw-date.on .w{color:var(--bar-translucent);}
    .booking-root .bw-date .d{display:block;font-family:var(--font-serif);font-size:20px;font-weight:500;color:var(--ink-900);margin:2px 0;}
    .booking-root .bw-date.on .d{color:var(--text-on-accent);}
    .booking-root .bw-date .n{display:block;font-family:var(--font-sans);font-size:10.5px;color:var(--sage-500);}
    .booking-root .bw-date.on .n{color:var(--bar-translucent);}
    .booking-root .bw-times{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
    .booking-root .bw-time{all:unset;cursor:pointer;text-align:center;font-family:var(--font-serif);font-size:16.5px;font-weight:500;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--rose-200);border-radius:var(--radius-md);padding:14px 0;transition:all var(--dur-fast) var(--ease-soft);}
    .booking-root .bw-time.on{background:var(--accent);color:var(--text-on-accent);border-color:transparent;box-shadow:var(--shadow-sm);}
    .booking-root .bw-none,.booking-root .bw-loading{font-family:var(--font-serif);font-weight:300;color:var(--text-secondary);text-align:center;padding:28px 0;}
    .booking-root .bw-spin{display:inline-block;width:18px;height:18px;border-radius:999px;border:2px solid var(--rose-100);border-top-color:var(--rose-400);animation:bwSpin 1.1s linear infinite;vertical-align:middle;margin-right:8px;}
    @keyframes bwSpin{to{transform:rotate(360deg);}}
    .booking-root .bw-form{display:flex;flex-direction:column;gap:14px;}
    .booking-root .bw-namerow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;}   /* 10/06 iPhone 實測：1fr＋輸入框預設寬度把整頁撐寬，改 minmax(0,1fr)＋輸入框滿寬 */
    .booking-root .bw-topics{display:flex;gap:8px;flex-wrap:wrap;}
    .booking-root .bw-fld{display:flex;flex-direction:column;gap:7px;}
    .booking-root .bw-fld span{font-family:var(--font-sans);font-size:13.5px;font-weight:500;color:var(--ink-700);}
    .booking-root .bw-fld input,.booking-root .bw-fld textarea{width:100%;min-width:0;box-sizing:border-box;font-family:var(--font-serif);font-size:16px;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:12px 14px;box-shadow:var(--shadow-xs);outline:none;resize:vertical;transition:border-color var(--dur-fast),box-shadow var(--dur-fast);}
    .booking-root .bw-fld textarea{line-height:1.7;}
    .booking-root .bw-fld input:focus,.booking-root .bw-fld textarea:focus{border-color:var(--rose-300);box-shadow:0 0 0 4px var(--focus-ring);}
    .booking-root .bw-err{font-family:var(--font-sans);font-size:13px;color:var(--critical);margin:4px 0 0;}
    .booking-root .bw-confirm{display:flex;flex-direction:column;gap:0;}
    .booking-root .bw-row{display:flex;gap:14px;padding:11px 0;border-bottom:1px solid var(--border-soft);}
    .booking-root .bw-k{font-family:var(--font-sans);font-size:13px;color:var(--text-muted);flex:none;width:54px;}
    .booking-root .bw-v{font-family:var(--font-serif);font-size:15.5px;color:var(--ink-900);}
    .booking-root .bw-dep{display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding:14px 16px;background:var(--surface-tint);border-radius:var(--radius-md);font-family:var(--font-serif);}
    .booking-root .bw-dep span{font-size:15px;color:var(--ink-700);}
    .booking-root .bw-dep b{font-size:20px;color:var(--ink-900);}
    .booking-root .bw-note{font-family:var(--font-serif);font-weight:300;font-size:13px;line-height:1.7;color:var(--text-muted);margin:12px 0 0;}
    @media(max-width:760px){.booking-root .bw-times{grid-template-columns:repeat(3,1fr);}.booking-root .bw-time{padding:13px 0;}}

    /* ===== TeacherCard ===== */
    .booking-root .tc{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:24px 24px;height:100%;display:flex;flex-direction:column;transition:box-shadow var(--dur-base) var(--ease-soft),transform var(--dur-base) var(--ease-soft);}
    .booking-root .tc:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
    .booking-root .tc-top{display:flex;gap:14px;align-items:flex-start;}
    .booking-root .tc-av{flex:none;width:60px;height:60px;border-radius:999px;display:flex;align-items:center;justify-content:center;overflow:hidden;font-family:var(--font-serif);font-size:25px;font-weight:500;}
    .booking-root .tc-av-rose{background:var(--rose-100);color:var(--rose-600);box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px var(--rose-300);}
    .booking-root .tc-av-clay{background:var(--clay-200);color:var(--clay-500);box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px var(--clay-300);}
    .booking-root .tc-av-sage{background:var(--sage-200);color:var(--sage-500);box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px var(--sage-300);}
    .booking-root .tc-id{flex:1;min-width:0;}
    .booking-root .tc-namerow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    .booking-root .tc-name{font-family:var(--font-serif);font-size:21px;font-weight:500;color:var(--ink-900);}
    .booking-root .tc-years{font-family:var(--font-sans);font-size:12px;color:var(--text-muted);white-space:nowrap;}
    .booking-root .tc-stars{display:inline-flex;align-items:center;gap:6px;margin-top:6px;}
    .booking-root .tc-stars > i{font-size:14px;color:var(--gold-500);}
    .booking-root .tc-rating{font-family:var(--font-sans);font-size:13px;color:var(--ink-700);font-weight:500;}
    .booking-root .tc-reviews{font-family:var(--font-sans);font-size:12.5px;color:var(--text-muted);}
    .booking-root .tc-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
    .booking-root .tc-tag{display:inline-flex;align-items:center;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:0.02em;line-height:1.4;border-radius:var(--radius-pill);padding:5px 13px;white-space:nowrap;border:1px solid transparent;}
    .booking-root .tc-tag.soft.rose{background:var(--rose-50);color:var(--rose-600);}
    .booking-root .tc-tag.soft.clay{background:var(--tint-clay-hi);color:var(--clay-500);}
    .booking-root .tc-tag.soft.sage{background:var(--tint-sage-hi);color:var(--sage-500);}
    .booking-root .tc-tag.outline{background:transparent;color:var(--ink-500);border-color:var(--rice-300);white-space:normal;}
    .booking-root .tc-blurb{font-family:var(--font-serif);font-weight:300;font-size:15.5px;line-height:1.8;color:var(--text-secondary);margin:16px 0 0;}
    .booking-root .tc-quote{display:flex;align-items:flex-start;gap:8px;margin:14px 0 0;padding:12px 14px;background:var(--surface-sunken);border-radius:var(--radius-md);}
    .booking-root .tc-quote i{font-size:14px;color:var(--rose-300);flex:none;margin-top:3px;}
    .booking-root .tc-quote span{font-family:var(--font-serif);font-size:14.5px;line-height:1.7;color:var(--ink-700);}
    .booking-root .tc-foot{margin-top:auto;padding-top:18px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
    .booking-root .tc-price-unit{font-family:var(--font-sans);font-size:11.5px;color:var(--text-muted);}
    .booking-root .tc-price-val{display:block;font-family:var(--font-serif);font-size:19px;font-weight:500;color:var(--ink-900);}

    @media (max-width:760px){
      .bk-main{padding:28px 18px 40px;}
      .bk-intro{margin-bottom:24px;}
      .bk-title{font-size:26px;}
      .bk-filter{margin-bottom:22px;}
      .bk-chips{gap:8px;}
      .bk-persona-desc{font-size:14px;}
      .bk-rec{margin-bottom:26px;}
      .bk-rec-frame{padding:3px;}
      .bk-rec-inner{padding:18px 16px;}
      .bk-rec-reason{padding:10px 12px;}
      .bk-rec-reason span{font-size:14.5px;}
      .bk-grid{grid-template-columns:1fr;gap:16px;}
      .booking-root .tc{padding:20px 18px;}
      .booking-root .tc-av{width:54px;height:54px;font-size:23px;}
      .booking-root .tc-name{font-size:19px;}
      .booking-root .tc-blurb{font-size:14.5px;}
    }
  </style>

  <script is:inline>
    (function () {
      var WORKER_API = 'https://api.winds.tw';
      var PERSONAS = JSON.parse(document.getElementById('bkPersonas').textContent);
      var descMap = {}; PERSONAS.forEach(function (p) { descMap[p.key] = p.desc; });
      var TONE = { gentle: 'rose', rational: 'clay', energy: 'sage', direct: 'clay' };
      var active = 'all';
      var teachers = [], LOCATIONS = [];
      var grid = document.getElementById('bkGrid');
      var descEl = document.getElementById('bkPersonaDesc');
      var empty = document.getElementById('bkEmpty');

      function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

      function priceOf(t){
        var ps = (t.services||[]).map(function(s){return Number(s.price)||0;}).filter(function(n){return n>0;});
        return ps.length ? Math.min.apply(null, ps) : 0;
      }
      function card(t){
        var tone = TONE[t.persona] || 'rose';
        var skills = (t.skills||[]).slice(0,3);
        var price = priceOf(t);
        var av = t.photo
          ? '<span class="tc-av tc-av-'+tone+'"><img src="'+esc(t.photo)+'" alt="'+esc(t.name)+'" style="width:100%;height:100%;object-fit:cover"></span>'
          : '<span class="tc-av tc-av-'+tone+'">'+esc((t.name||'').slice(0,1))+'</span>';
        return '<article class="tc" data-persona="'+esc(t.persona||'')+'">'+
          '<div class="tc-top">'+av+
            '<div class="tc-id"><div class="tc-namerow"><span class="tc-name">'+esc(t.name)+'</span></div>'+
            (t.skill_main?'<div class="tc-stars"><span class="tc-rating">'+esc(t.skill_main)+'</span></div>':'')+
            '<div class="tc-tags">'+skills.map(function(s){return '<span class="tc-tag soft '+tone+'">'+esc(s)+'</span>';}).join('')+
            (t.style?'<span class="tc-tag outline">'+esc(t.style)+'</span>':'')+'</div></div>'+
          '</div>'+
          (t.blurb?'<p class="tc-blurb">'+esc(t.blurb)+'</p>':'')+
          (t.quote?'<div class="tc-quote"><i class="ph-fill ph-quotes"></i><span>'+esc(t.quote)+'</span></div>':'')+
          '<div class="tc-foot">'+
            (price?'<div><span class="tc-price-unit">單次對談</span><span class="tc-price-val">NT$ '+price.toLocaleString('en-US')+' 起</span></div>':'<span></span>')+
            '<button class="zfbtn md secondary" data-book="'+esc(t.id)+'" type="button">預約 <i class="ph-bold ph-arrow-right"></i></button>'+
          '</div></article>';
      }
      var SVC_Q = new URLSearchParams(location.search).get('svc') || '';
      function apply(){
        if (active==='all'){descEl.hidden=true;descEl.textContent='';}
        else {descEl.hidden=false;descEl.textContent=descMap[active]||'';}
        var list = active==='all' ? teachers : teachers.filter(function(t){return t.persona===active;});
        /* 2026-10-08：從項目頁進來（?svc=項目）只列會做這一項的老師 */
        if (SVC_Q) list = list.filter(function(t){return (t.services||[]).some(function(x){return String(x.id)===SVC_Q;});});
        grid.innerHTML = list.map(card).join('');
        empty.hidden = list.length !== 0;
      }
      document.getElementById('bkChips').addEventListener('click', function (e) {
        var b = e.target.closest('.bk-chip'); if (!b) return;
        active = (b.dataset.persona === active && active !== 'all') ? 'all' : b.dataset.persona;
        document.querySelectorAll('.bk-chip').forEach(function (c) { c.classList.toggle('on', c.dataset.persona === active); });
        apply();
      });

      /* ===== 預約精靈（項目→時段→資料→確認→付訂金）===== */
      var GMAIL = /^[^\s@]+@gmail\.com$/i;
      var mount = document.getElementById('bkWiz');
      var W = {};
      function sn(base){return W.multiLoc?base+1:base;}   // 有地點步驟時各步 +1
      function wizClose(){if(W&&W.creating)return;   /* 2026-09-28（gpt-6-astra 體檢）：建單中不准關，否則舊回應會把新流程導去舊老師／項目的付款頁 */
        mount.innerHTML='';document.body.style.overflow='';W=null;}   /* 2026-09-27：也要清掉 W，否則慢回來的時段請求會把精靈自己彈回來 */
      function shell(step, title, inner, footer){
        /* 2026-10-08：同一步重畫（選日期／時段）保留視窗內捲動位置，換步才回最上面 */
        var ob=mount.querySelector('.bw-body'),keep=(ob&&W.step===step)?ob.scrollTop:0;
        W.step=step;   /* 記住目前在第幾步：時段請求回來時已經不在「選時間」就丟掉（gpt-6-astra 複核） */
        var nn=W.nSteps||4, arr=[]; for(var i=1;i<=nn;i++)arr.push(i);
        var dots=arr.map(function(n){return '<span class="bw-dot'+(n<=step?' on':'')+'"></span>';}).join('');
        mount.innerHTML='<div class="bw-scrim" data-wclose></div><div class="bw-panel"><div class="bw-head">'+
          '<button class="bw-x" data-wclose type="button"><i class="ph ph-x"></i></button>'+
          '<div class="bw-prog">'+dots+'</div>'+
          '<div class="bw-title">'+esc(title)+'</div>'+
          '<div class="bw-sub">'+esc(W.prov?W.prov.name:'')+'</div>'+
          /* 2026-10-08 Jeffery：選時間、填資料也要看得到項目，樣式同老師名字 */
          (W.svc&&step>=sn(2)&&step<sn(4)?'<div class="bw-sub">'+esc(W.svc.name)+'</div>':'')+'</div>'+
          '<div class="bw-body">'+inner+'</div>'+(footer?'<div class="bw-foot">'+footer+'</div>':'')+'</div>';
        document.body.style.overflow='hidden';
        if(keep){var nb=mount.querySelector('.bw-body');if(nb)nb.scrollTop=keep;}
        mount.querySelectorAll('[data-wclose]').forEach(function(el){el.addEventListener('click',wizClose);});
      }
      function openWiz(id, svcId){
        if(W&&W.creating)return;
        W = { prov: teachers.filter(function(t){return String(t.id)===String(id);})[0] };
        if(!W.prov) return;
        /* 2026-10-08：從項目頁進來（?book=老師&svc=項目）直接定好項目，地點只列這個項目能約的；項目對不上就照一般流程 */
        W.fixSvc = svcId ? (W.prov.services||[]).filter(function(s){return String(s.id)===String(svcId);})[0] : null;
        var locIds = (W.fixSvc && W.fixSvc.locations) ? (W.prov.locations||[]).filter(function(l){return W.fixSvc.locations.indexOf(l)>=0;}) : (W.prov.locations || []);
        W.locOpts = LOCATIONS.filter(function(l){return locIds.indexOf(l.id)>=0;});
        W.multiLoc = W.locOpts.length>1;
        W.nSteps = W.multiLoc ? 5 : 4;
        if(W.multiLoc){ stepLocation(); }
        else { W.loc = W.locOpts[0] || null; stepService(); }
      }
      function stepLocation(){
        var inner = '<div class="bw-list">'+W.locOpts.map(function(l,i){
          var ic = l.type==='online' ? 'video-camera' : 'map-pin';
          return '<button class="bw-opt" data-loc="'+i+'" type="button"><span class="bw-opt-main">'+
            '<span class="bw-opt-nm"><i class="ph ph-'+ic+'" style="margin-right:7px;color:var(--rose-400)"></i>'+esc(l.name)+'</span>'+
            (l.note?'<span class="bw-opt-meta">'+esc(l.note)+'</span>':'')+'</span></button>';
        }).join('')+'</div>';
        shell(1,'想怎麼見面？',inner);
        mount.querySelectorAll('[data-loc]').forEach(function(b){b.addEventListener('click',function(){W.loc=W.locOpts[+b.dataset.loc];stepService();});});
      }
      function stepService(){
        /* 2026-10-07：項目可限定地點（例：命書籤詩問事只能遠端）。只列在選好的地點能約的項目；s.locations 是後端算好的
           「這位老師做這一項時可選的地點」，沒有這欄（舊快取）就不篩，送單時後端照樣會擋 */
        var svcs = (W.prov.services||[]).filter(function(s){return !W.loc||!s.locations||s.locations.indexOf(W.loc.id)>=0;});
        if(W.fixSvc&&svcs.indexOf(W.fixSvc)>=0){W.svc=W.fixSvc;stepTime();return;}
        var inner = !svcs.length ? '<p class="bw-note">這個見面方式目前沒有可預約的項目，請回上一步換一個。</p>' : '<div class="bw-list">'+svcs.map(function(s,i){
          return '<button class="bw-opt" data-svc="'+i+'" type="button"><span class="bw-opt-main"><span class="bw-opt-nm">'+esc(s.name)+'</span>'+
            (s.duration?'<span class="bw-opt-meta">'+s.duration+' 分鐘</span>':'')+'</span>'+
            '<span class="bw-opt-price">NT$ '+(Number(s.price)||0).toLocaleString('en-US')+(s.deposit?'<span class="bw-opt-dep">訂金 NT$ '+Number(s.deposit).toLocaleString('en-US')+'</span>':'')+'</span></button>';
        }).join('')+'</div>';
        var foot = W.multiLoc ? '<button class="zfbtn md secondary" data-back type="button">上一步</button>' : null;
        shell(sn(1),'選一個項目',inner,foot);
        mount.querySelectorAll('[data-svc]').forEach(function(b){b.addEventListener('click',function(){W.svc=svcs[+b.dataset.svc];stepTime();});});
        if(W.multiLoc){var bk=mount.querySelector('[data-back]');if(bk)bk.addEventListener('click',stepLocation);}
      }
      function stepTime(){
        shell(sn(2),'選時間','<div class="bw-loading"><span class="bw-spin"></span>載入可預約時段…</div>');
        /* 2026-09-28（gpt-6-astra 體檢）：日期用台北時間算，不是裝置時區（海外裝置會漏列或多列一天） */
        var tpe=function(n){return new Date(Date.now()+8*3600000+n*86400000).toISOString().slice(0,10);};
        /* 2026-09-27：時段請求沒綁這一次精靈。在載入中途關掉、改開另一位老師的話，舊老師的回應會用
           現在的 W 渲染——畫面上是新老師、時段是舊老師的，送出時還會拿新項目 ID 配舊項目的時間。
           req 記住這次是哪一輪（openWiz 會換成新物件、wizClose 會設成 null），對不上就把回應丟掉。 */
        var req=W, seq=W.slotSeq=(W.slotSeq||0)+1;   /* 同一精靈裡重選項目（A→B→A）也要分得出是哪一次 */
        fetch(WORKER_API+'/sb-slots?service='+encodeURIComponent(W.svc.id)+'&provider='+encodeURIComponent(W.prov.id)+'&from='+tpe(1)+'&to='+tpe(28))
          .then(function(r){if(!r.ok)throw new Error('http '+r.status);return r.json();}).then(function(d){   /* 502 不能當成「沒有空檔」 */
            if(req!==W||seq!==W.slotSeq||W.step!==sn(2)) return;
            var slots=(d&&d.slots)||{}; var dates=Object.keys(slots).sort();
            if(!dates.length){shell(sn(2),'選時間','<p class="bw-none">這位老師近 30 天暫無可預約時段，換個老師或稍後再試。</p>');return;}
            W.date=W.date&&slots[W.date]?W.date:dates[0]; W.time=null;
            renderTime(slots,dates);
          }).catch(function(){if(req!==W||seq!==W.slotSeq||W.step!==sn(2)) return;shell(sn(2),'選時間','<p class="bw-none">時段載入失敗，請稍後再試。</p>');});
      }
      function renderTime(slots,dates){
        var WK=['日','一','二','三','四','五','六'];
        function dobj(s){var p=s.split('-');return new Date(+p[0],+p[1]-1,+p[2]);}
        var dchips='<div class="bw-lbl"><i class="ph ph-calendar-dots"></i><span class="t">選日期</span></div><div class="bw-dates">'+dates.map(function(dt){var d=dobj(dt);
          return '<button class="bw-date'+(dt===W.date?' on':'')+'" data-d="'+dt+'" type="button"><span class="w">週'+WK[d.getDay()]+'</span><span class="d">'+d.getDate()+'</span><span class="n">'+(slots[dt]||[]).length+' 個</span></button>';}).join('')+'</div>';
        var sd=dobj(W.date);
        dchips+='<div class="bw-lbl second"><i class="ph ph-clock"></i><span class="t">'+(sd.getMonth()+1)+'/'+sd.getDate()+'（週'+WK[sd.getDay()]+'）可預約</span></div>';
        var times='<div class="bw-times">'+(slots[W.date]||[]).map(function(t){return '<button class="bw-time'+(t===W.time?' on':'')+'" data-t="'+t+'" type="button">'+t+'</button>';}).join('')+'</div>';
        var foot='<button class="zfbtn md secondary" data-back type="button">上一步</button><button class="zfbtn md primary'+(W.time?'':' disabled')+'" data-next type="button">下一步</button>';
        var nt=W.notice?'<p class="bw-err">'+esc(W.notice)+'</p>':''; W.notice=null;
        shell(sn(2),'選時間',nt+dchips+times,foot);
        mount.querySelectorAll('[data-d]').forEach(function(b){b.addEventListener('click',function(){W.date=b.dataset.d;W.time=null;renderTime(slots,dates);});});
        mount.querySelectorAll('[data-t]').forEach(function(b){b.addEventListener('click',function(){W.time=b.dataset.t;renderTime(slots,dates);});});
        var nx=mount.querySelector('[data-next]'); if(nx)nx.addEventListener('click',function(){if(W.time)stepInfo();});
        var bk=mount.querySelector('[data-back]'); if(bk)bk.addEventListener('click',function(){W.fixSvc=null;stepService();});   /* 項目頁帶進來的項目，按上一步就放開讓他改選 */
      }
      function stepInfo(){
        var f=W.fields||{};
        var TOPICS=['愛情','婚姻','財運','事業','運勢','健康'];
        /* 通路來源（2026-10-06 拍板：必選、有「忘了」；朋友介紹／其他多一格選填） */
        var HEARD=[['youtube','YouTube'],['threads','Threads'],['instagram','Instagram'],['facebook','Facebook'],['google','Google 搜尋'],['friend','朋友介紹'],['line','LINE'],['edm','電子報'],['returning','之前就約過'],['other','其他'],['forgot','忘了']];
        var inner='<div class="bw-form">'+
          '<div class="bw-namerow">'+fld('姓','wzLast',f.last||'')+fld('名','wzFirst',f.first||'')+'</div>'+fld('手機','wzPhone',f.phone||'','tel')+
          fld('Email（限 Gmail）','wzEmail',f.email||'','email')+
          '<div class="bw-fld"><span>想聊的主題（選填）</span><div class="bw-topics">'+TOPICS.map(function(tp){
            return '<button class="bk-chip'+(f.topic===tp?' on':'')+'" data-topic="'+tp+'" type="button">'+tp+'</button>';
          }).join('')+'</div></div>'+
          '<div class="bw-fld"><span>你是從哪裡知道風易揚老師的？</span><div class="bw-topics">'+HEARD.map(function(h){
            return '<button class="bk-chip'+(f.heard===h[0]?' on':'')+'" data-heard="'+h[0]+'" type="button">'+h[1]+'</button>';
          }).join('')+'</div></div>'+
          '<label class="bw-fld" id="wzHeardNoteWrap"'+(f.heard==='friend'||f.heard==='other'?'':' hidden')+'><span id="wzHeardNoteLabel">'+(f.heard==='other'?'是哪裡呢？（選填）':'介紹人（選填）')+'</span><input id="wzHeardNote" type="text" maxlength="60" value="'+esc(f.heardNote||'')+'"></label>'+
          '<label class="bw-fld"><span>想先讓老師知道的事（選填）</span><textarea id="wzNote" rows="3" maxlength="300" placeholder="也可以什麼都不寫，當面聊就好。">'+esc(f.note||'')+'</textarea></label>'+
          '<p class="bw-err" id="wzErr" hidden></p></div>';
        var foot='<button class="zfbtn md secondary" data-back type="button">上一步</button><button class="zfbtn md primary" data-next type="button">下一步</button>';
        shell(sn(3),'留下聯絡方式',inner,foot);
        W.topicPick=f.topic||'';
        mount.querySelectorAll('[data-topic]').forEach(function(b){b.addEventListener('click',function(){
          W.topicPick=(W.topicPick===b.dataset.topic)?'':b.dataset.topic;
          mount.querySelectorAll('[data-topic]').forEach(function(c){c.classList.toggle('on',c.dataset.topic===W.topicPick);});
        });});
        W.heardPick=f.heard||'';
        mount.querySelectorAll('[data-heard]').forEach(function(b){b.addEventListener('click',function(){
          W.heardPick=b.dataset.heard;
          mount.querySelectorAll('[data-heard]').forEach(function(c){c.classList.toggle('on',c.dataset.heard===W.heardPick);});
          var wrap=document.getElementById('wzHeardNoteWrap');
          wrap.hidden=!(W.heardPick==='friend'||W.heardPick==='other');
          document.getElementById('wzHeardNoteLabel').textContent=W.heardPick==='other'?'是哪裡呢？（選填）':'介紹人（選填）';
        });});
        mount.querySelector('[data-back]').addEventListener('click',stepTime);
        mount.querySelector('[data-next]').addEventListener('click',function(){
          var last=val('wzLast'),first=val('wzFirst'),name=last+first,phone=val('wzPhone'),email=val('wzEmail'),note=val('wzNote');   /* 姓名分開（10/06，跟全站統一） */
          var err=document.getElementById('wzErr');
          if(!last){return showErr(err,'請輸入姓。');}
          if(!first){return showErr(err,'請輸入名。');}
          if(!/^09\d{8}$/.test(phone.replace(/[\s-]/g,''))){return showErr(err,'請輸入正確手機（09xxxxxxxx）。');}
          if(!GMAIL.test(email)){return showErr(err,'Email 目前僅接受 @gmail.com。');}
          if(!W.heardPick){return showErr(err,'請選一下你是從哪裡知道風易揚老師的（記不得就選「忘了」）。');}
          var hn=(W.heardPick==='friend'||W.heardPick==='other')?val('wzHeardNote'):'';
          W.fields={name:name,last:last,first:first,phone:phone.replace(/[\s-]/g,''),email:email,topic:W.topicPick,note:note,heard:W.heardPick,heardNote:hn};
          stepConfirm();
        });
      }
      function fld(label,id,v,t){return '<label class="bw-fld"><span>'+label+'</span><input id="'+id+'" type="'+(t||'text')+'" value="'+esc(v)+'"></label>';}
      function val(id){var e=document.getElementById(id);return e?e.value.trim():'';}
      function showErr(el,m){if(!el)return;el.textContent=m;el.hidden=false;}   /* 節點可能已不在畫面上，不能讓它拋錯把後面的解鎖擋掉 */
      var HEARD_LABEL={youtube:'YouTube',threads:'Threads',instagram:'Instagram',facebook:'Facebook',google:'Google 搜尋',friend:'朋友介紹',line:'LINE',edm:'電子報',returning:'之前就約過',other:'其他',forgot:'忘了'};
      function stepConfirm(){
        var dep=Number(W.svc.deposit)||Number(W.svc.price)||0;
        /* 2026-10-01（廣告前全站掃描）：不收訂金（訂金 0）或訂金＝總額的項目，原本也寫「線上付訂金…餘額現場結清」，其實線上已付全額。
           只有「有訂金且小於總額」才算訂金；送後端的金額 dep 不變（後端 charge＝deposit>0?deposit:total） */
        var isDep=Number(W.svc.deposit)>0&&Number(W.svc.deposit)<(Number(W.svc.price)||0);
        var goLabel=isDep?'確認並付訂金':'確認並付款';
        var online=W.loc&&W.loc.type==='online';
        var locNote=W.loc?(online?'遠端諮詢，連線方式會在對談前提供。'   /* 2026-10-01（廣告前全站掃描）：原本承諾「自動開啟會議室連結」，實際沒有程式會產生；照確認信（sb.ts）的說法 */:'實體面談：'+(W.loc.note||W.loc.name)+'。'):'';
        var inner='<div class="bw-confirm">'+
          row('老師',W.prov.name)+row('項目',W.svc.name)+
          (W.loc?row('方式',W.loc.name):'')+row('時間',W.date+' '+W.time)+
          row('聯絡',W.fields.name+' · '+W.fields.phone)+
          (W.fields.topic?row('主題',W.fields.topic):'')+
          (W.fields.note?row('備註',W.fields.note):'')+
          (W.fields.heard?row('從哪裡知道',(HEARD_LABEL[W.fields.heard]||'')+(W.fields.heardNote?'（'+W.fields.heardNote+'）':'')):'')+
          '<div class="bw-dep"><span>'+(isDep?'線上付訂金':'線上付清')+'</span><b>NT$ '+dep.toLocaleString('en-US')+'</b></div>'+
          /* 2026-10-01（廣告前全站掃描）：原本寫可用 CVS 付款，但綠界收銀台已排除 CVS／BARCODE（ecpay.ts IgnorePayment），客人進收銀台找不到；改成只寫線上付款 */
          '<p class="bw-note">'+(locNote?esc(locNote)+' ':'')+(isDep?'付訂金後即為你保留時段，餘額'+(online?'依老師指示':'現場')+'結清。':'付款後即為你保留時段。')+'僅接受 Gmail，採線上付款。</p>'+
          '<p class="bw-err" id="wzErr2" hidden></p></div>';
        var foot='<button class="zfbtn md secondary" data-back type="button">上一步</button><button class="zfbtn md primary" data-go type="button">'+goLabel+'</button>';
        shell(sn(4),'確認預約',inner,foot);
        mount.querySelector('[data-back]').addEventListener('click',function(){if(W&&W.creating)return;stepInfo();});   /* 建單中不准回上一步（gpt-6-astra 複核） */
        mount.querySelector('[data-go]').addEventListener('click',function(){
          var btn=this;
          /* 2026-09-26（Codex 複審抓到）：原本只加 CSS class，鈕其實沒被停用——鍵盤 Enter／Space
             還會再觸發，第一次回應前連按會建出多筆預約與多張付款單，其中幾筆會占住時段變成孤兒單。
             改成真的設 disabled 屬性並在入口擋掉重入；成功會跳轉離開，所以只在失敗時解鎖。 */
          if(btn.disabled)return;
          btn.disabled=true; btn.classList.add('disabled'); btn.textContent='建立訂單中…'; W.creating=true;
          function unlockGo(){if(W)W.creating=false;btn.disabled=false;btn.classList.remove('disabled');btn.textContent=goLabel;}
          /* 2026-09-28（gpt-6-astra 金流複核第三輪）：前端先查價擋不住（查價後剛好調價、查價失敗照送）。改成帶「畫面上的訂金」
             expected_amount，後端算好要收的金額、開單佔時段之前比對，不一樣就回 price_changed、不開單；這裡更新畫面請客人再按一次。
             20 秒沒回應就解鎖，不會卡在建單中。 */
          var ac=new AbortController(),to=setTimeout(function(){ac.abort();},20000);
          /* 送單冪等（gpt-6-astra 金流第四輪複核）：同一份預約資料重送帶同一個識別碼——逾時後重按會拿回原本那張單，
             不會多開一張、也不會被自己保留的時段擋住；資料有改就換新的 */
          var payload={service:W.svc.id,provider:W.prov.id,datetime:W.date+' '+W.time+':00',location:W.loc?W.loc.id:null,
              name:W.fields.name,last_name:W.fields.last,first_name:W.fields.first,phone:W.fields.phone,email:W.fields.email,topic:W.fields.topic||null,note:W.fields.note||null,
              heard_from:W.fields.heard||null,heard_from_note:W.fields.heardNote||null};
          /* 識別碼存在這個分頁的 sessionStorage：重新整理、關掉精靈再開，資料沒改、一小時內還是同一個（gpt-6-astra 金流第五輪複核） */
          var REQ_KEY='winds-req-booking',fp=JSON.stringify(payload),st=null,rid='';
          try{st=JSON.parse(sessionStorage.getItem(REQ_KEY)||'null');}catch(e){}
          /* 暫存和記憶體兩邊都看，用對得上的那一份（gpt-6-astra 複核） */
          var hit=[window.__windsReqBooking,st].filter(function(x){return x&&x.fp===fp&&Date.now()-x.t<3600000;})[0];
          if(hit){window.__windsReqBooking=hit;rid=hit.id;}
          else{rid=(window.crypto&&crypto.randomUUID)?crypto.randomUUID():Array.prototype.map.call(crypto.getRandomValues(new Uint8Array(16)),function(x){return('0'+x.toString(16)).slice(-2);}).join('');
            window.__windsReqBooking={fp:fp,id:rid,t:Date.now()};
            try{sessionStorage.setItem(REQ_KEY,JSON.stringify(window.__windsReqBooking));}catch(e){}}
          payload.expected_amount=dep;payload.client_req_id=rid;
          try{payload.first_touch=JSON.parse(localStorage.getItem('winds_first_touch')||'null');}catch(e){}   /* 第一次進站的來源（BaseLayout 記的），讀不到就不帶 */
          fetch(WORKER_API+'/sb-book',{method:'POST',signal:ac.signal,headers:{'Content-Type':'application/json'},
            body:JSON.stringify(payload)})
           .then(function(r){return r.json().then(function(d){return{st:r.status,d:d};});}).then(function(o){var d=o.d;clearTimeout(to);
             if(d&&d.ok&&d.payment_url){location.href=d.payment_url;}
             else if(d&&d.error==='already_paid'){unlockGo();window.__windsReqBooking=null;try{sessionStorage.removeItem('winds-req-booking');}catch(e){}showErr(document.getElementById('wzErr2'),d.message||'這筆預約已經付款完成，我們會為你安排。');}
             else if(d&&d.error==='req_conflict'){unlockGo();window.__windsReqBooking=null;try{sessionStorage.removeItem('winds-req-booking');}catch(e){}showErr(document.getElementById('wzErr2'),d.message||'資料跟上一次不一樣，請再按一次。');}
             else if(d&&d.error==='price_changed'&&d.amount){
               unlockGo();
               // 後端另回訂金與總價就分欄更新（2026-09-28 gpt-6-astra 複核：原本不收訂金的項目改收訂金，會把訂金誤寫成總價）
               if(d.deposit!=null||d.total!=null){if(d.deposit!=null)W.svc.deposit=Number(d.deposit)||0;if(d.total!=null)W.svc.price=Number(d.total)||W.svc.price;}
               else if(Number(W.svc.deposit)>0)W.svc.deposit=Number(d.amount);else W.svc.price=Number(d.amount);
               stepConfirm();
               showErr(document.getElementById('wzErr2'),'金額剛更新為 NT$ '+Number(d.amount).toLocaleString('en-US')+'（原本顯示 NT$ '+dep.toLocaleString('en-US')+'），確認沒問題再按一次。');
             }
             /* 時段被別人約走（409）：後端把原因放在 error，原本只讀 message 被吞掉 → 說清楚並帶回去重選 */
             else if(o.st===409){unlockGo();W.date=null;W.time=null;W.notice=(d&&(d.error||d.message))||'這個時段剛被約走了，請重選一個時間。';stepTime();}
             else{unlockGo();showErr(document.getElementById('wzErr2'),d&&(d.message||d.error)||'建立預約失敗，請稍後再試。');}
           }).catch(function(){clearTimeout(to);unlockGo();showErr(document.getElementById('wzErr2'),'網路太久沒回應。資料沒改的話直接再按一次，不會重複開單。');});
        });
      }
      function row(k,v){return '<div class="bw-row"><span class="bw-k">'+esc(k)+'</span><span class="bw-v">'+esc(v)+'</span></div>';}

      grid.addEventListener('click',function(e){var b=e.target.closest('[data-book]');if(b)openWiz(b.dataset.book,SVC_Q);});

      fetch(WORKER_API + '/sb-providers').then(function(r){return r.json();}).then(function(d){
        teachers = (d && d.providers) || [];
        /* 2026-10-01（廣告前全站掃描）：零價項目（價格與訂金都是 0）原本照列「NT$ 0」，填完資料送單才被後端 400 擋下；線上收不了款的項目不列出來 */
        teachers = teachers.filter(function(t){ t.services=(t.services||[]).filter(function(s){return Number(s.price)>0||Number(s.deposit)>0;}); return t.services.length>0; });   // 2026-10-01（廣告前全站掃描・總複驗）：項目全被濾掉的老師不列，免得按「預約」後清單是空的
        LOCATIONS = (d && d.locations) || [];
        if (!teachers.length){ grid.innerHTML=''; empty.hidden=false; empty.textContent='老師清單載入中或暫無，稍後再試。'; return; }
        apply();
        var bp = new URLSearchParams(location.search).get('book'); if (bp) openWiz(bp, SVC_Q);
      }).catch(function(){ grid.innerHTML=''; empty.hidden=false; empty.textContent='老師清單載入失敗，請稍後再試。'; });
    })();
  </script>
</BaseLayout>
