---
// 完整報告永久連結（DS report-page）。報告本體＝/divination?log_id=（已套站台 Nav/Footer），
// 渲染器同源不複製。/report?log_id= 為乾淨的可分享別名，導向報告頁。
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>完整報告 · 找風問幸福</title>
  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search);
      var id = p.get('log_id') || p.get('id') || '';
      /* 2026-09-27：原本只帶 log_id，把報告憑證 k 丟掉了。從付款跳回、提醒信或換一台裝置點
         /report?log_id=…&k=… 進來的人，轉到 /divination 就證明不了存取權，已付費的報告看不到。 */
      var k = p.get('k') || '';
      var q = 'log_id=' + encodeURIComponent(id) + (k ? '&k=' + encodeURIComponent(k) : '');
      location.replace(id ? ('/divination?' + q) : '/account');
    })();
  </script>
</head>
<body></body>
</html>
