---
// 簡易 CRM（內部）— 2026-09-03 第一版，之後照 Jeffery 回饋改。
// 入口：/crm；密碼閘＝CRM 專用密碼（localStorage winds_crm_secret，請求帶 X-Crm-Secret）——刻意不用老師共用密碼，老師不該看得到全名單
// 資料：api.winds.tw/admin/crm/people（合併名單）／person（時間軸）／note（備註＋標籤）
// 視覺：殼照 teacher-ziwei（page-header／auth-gate），元件用 ds.css zf-*；列表列、時間軸為本頁專屬，值走 DS token。
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = '客戶名單｜找風問幸福（內部）';
---

<BaseLayout title={pageTitle} description="內部客戶名單" ogType="website" noindex={true}>
  <main class="crm-main">
    <header class="page-header">
      <span class="eyebrow"><span class="dot"></span>內部 · 客戶名單</span>
      <h1>客戶名單</h1>
      <p class="lede">把預約、法器、占卜、eDM 的人合併成一張名單。有互動＝點過信裡的連結、占過卜或解鎖過；每次寄信有人點就會自動加進來。</p>
    </header>

    <section class="auth-gate" id="auth-gate" hidden>
      <div class="auth-card">
        <h2>請輸入 CRM 密碼</h2>
        <p class="auth-desc">此頁含客戶個資，只有負責人可進，密碼與老師排盤工具不同。</p>
        <form id="pwd-form" style="display:flex;flex-direction:column;gap:12px;margin-top:6px">
          <input class="zf-input" type="password" id="pwd-input" autocomplete="off" placeholder="CRM 密碼" style="text-align:center" />
          <button type="submit" class="zf-btn primary md full">進入名單</button>
          <p id="pwd-error" class="auth-note" style="color:var(--critical);min-height:1.2em" hidden>密碼錯誤，請再試一次</p>
        </form>
      </div>
    </section>

    <section class="loading-section" id="loading-section" hidden>
      <span class="zf-spinner" style="width:42px;height:42px;border-width:3px"></span>
      <p>正在合併名單…</p>
    </section>

    <section id="crm-section" hidden>
      <div class="crm-stats" id="crm-stats"></div>
      <div class="crm-toolbar">
        <div class="zf-tabs segmented sm" id="tier-tabs" role="tablist">
          <button class="zf-tab on" data-tier="">全部</button>
          <button class="zf-tab" data-tier="paid">付過錢</button>
          <button class="zf-tab" data-tier="booked">預約過</button>
          <button class="zf-tab" data-tier="engaged">有互動</button>
          <button class="zf-tab" data-tier="lead">只有名單</button>
        </div>
        <input class="zf-input crm-search" id="crm-search" type="search" placeholder="搜姓名、email、電話、標籤" autocomplete="off" />
      </div>

      <div class="crm-layout">
        <div>
          <div class="crm-list" id="crm-list"></div>
          <nav class="crm-pager" id="crm-pager" hidden></nav>
        </div>
        <aside class="crm-detail" id="crm-detail" hidden></aside>
      </div>
    </section>

    <section id="error-section" class="error-section" hidden>
      <p id="error-text"></p>
      <button class="zf-btn secondary md" id="retry-btn" type="button">再試一次</button>
    </section>
  </main>
</BaseLayout>

<script>
  const WORKER_API = 'https://api.winds.tw';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const authGate = $('auth-gate'), loading = $('loading-section'), crmSection = $('crm-section'), errorSection = $('error-section');

  function getSecret() { try { return localStorage.getItem('winds_crm_secret') || ''; } catch { return ''; } }
  function setSecret(s: string) { try { localStorage.setItem('winds_crm_secret', s); } catch {} }
  function clearSecret() { try { localStorage.removeItem('winds_crm_secret'); } catch {} }
  function headers(extra: Record<string, string> = {}) { return { 'X-Crm-Secret': getSecret(), ...extra }; }
  function hideAll() { authGate.hidden = loading.hidden = crmSection.hidden = errorSection.hidden = true; }
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const ntd = (n: number) => 'NT$ ' + Number(n || 0).toLocaleString('en-US');
  const day = (ts: string) => (ts || '').replace('T', ' ').slice(0, 10);
  const TIER: Record<string, [string, string]> = { paid: ['付過錢', 'rose'], booked: ['預約過', 'clay'], engaged: ['有互動', 'sage'], lead: ['只有名單', 'neutral'] };
  const STATUS: Record<string, string> = { Pending: '未付款', pending: '未付款', Failed: '付款失敗', canceled: '已取消', unpaid: '未付款' };

  type P = { key: string; name: string; email: string; phone: string; birth: string; sources: string[]; tier: string; spend: number; paid_count: number; event_count: number; last_activity: string; alive_at: string; last_sent_at: string; last_click_at: string; tags: string[]; note: string };
  let people: P[] = [], tier = '', query = '', current = '', page = 1;
  const PAGE_SIZE = 20;

  async function load() {
    hideAll(); loading.hidden = false;
    try {
      const r = await fetch(WORKER_API + '/admin/crm/people', { headers: headers() });
      if (r.status === 401) { clearSecret(); hideAll(); authGate.hidden = false; return; }
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || d.message || '讀取失敗');
      people = d.people; renderStats(d.counts); renderList(); hideAll(); crmSection.hidden = false;
    } catch (e: any) { hideAll(); $('error-text').textContent = '讀不到名單：' + (e?.message || e); errorSection.hidden = false; }
  }

  function renderStats(c: Record<string, number>) {
    $('crm-stats').innerHTML = [['total', '總人數'], ['paid', '付過錢'], ['booked', '預約過'], ['engaged', '有互動'], ['lead', '只有名單']]
      .map(([k, l]) => `<div class="crm-stat"><b>${c[k] ?? 0}</b><span>${l}</span></div>`).join('');
  }

  function filtered() {
    const q = query.trim().toLowerCase();
    return people.filter((p) => (!tier || p.tier === tier) && (!q || [p.name, p.email, p.phone, ...(p.tags || [])].join(' ').toLowerCase().includes(q)));
  }

  function renderList() {
    const all = filtered();
    const pages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
    if (page > pages) page = pages;
    const rows = all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
    $('crm-list').innerHTML = rows.length ? rows.map((p) => `
      <button class="crm-row${p.key === current ? ' on' : ''}" data-key="${esc(p.key)}" type="button">
        <div class="crm-row-main">
          <div class="crm-row-name">${esc(p.name)}<span class="zf-badge ${TIER[p.tier][1]}"><span class="zf-badge-dot"></span>${TIER[p.tier][0]}</span></div>
          <div class="crm-row-sub">${esc(p.email || '')}${p.email && p.phone ? ' · ' : ''}${esc(p.phone || '')}</div>
          <div class="crm-row-tags">${p.sources.map((s) => `<span class="zf-tag neutral outline">${esc(s)}</span>`).join('')}${(p.tags || []).map((t) => `<span class="zf-tag rose">${esc(t)}</span>`).join('')}</div>
        </div>
        <div class="crm-row-side">
          ${p.spend ? `<b>${ntd(p.spend)}</b>` : ''}
          <span>${p.last_activity ? '最近 ' + day(p.last_activity) : '沒有互動'}</span>
        </div>
      </button>`).join('') : '<p class="crm-empty">這個條件下沒有人。</p>';
    $('crm-list').querySelectorAll<HTMLButtonElement>('.crm-row').forEach((b) => b.addEventListener('click', () => openPerson(b.dataset.key || '')));
    const pg = $('crm-pager');
    if (all.length <= PAGE_SIZE) { pg.hidden = true; return; }
    pg.hidden = false;
    const from = (page - 1) * PAGE_SIZE + 1, to = Math.min(page * PAGE_SIZE, all.length);
    pg.innerHTML = `<button class="zf-btn secondary sm" type="button" data-go="-1" ${page <= 1 ? 'disabled' : ''}>上一頁</button><span class="crm-pager-info">第 ${page} / ${pages} 頁<em>${from}–${to}，共 ${all.length} 人</em></span><button class="zf-btn secondary sm" type="button" data-go="1" ${page >= pages ? 'disabled' : ''}>下一頁</button>`;
    pg.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => { page += Number(b.dataset.go); renderList(); $('crm-list').scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  }

  async function openPerson(key: string) {
    current = key; renderList();
    const box = $('crm-detail'); box.hidden = false;
    box.innerHTML = '<div class="crm-detail-loading"><span class="zf-spinner"></span></div>';
    const r = await fetch(WORKER_API + '/admin/crm/person?key=' + encodeURIComponent(key), { headers: headers() });
    const d = await r.json();
    if (!d.ok) { box.innerHTML = `<p class="crm-empty">${esc(d.error || '讀不到')}</p>`; return; }
    const p: P = d.person; const evs: { ts: string; kind: string; title: string; amount?: number; status?: string; note?: string }[] = d.events;
    const KIND: Record<string, string> = { pay: '付款', unlock: '免費解鎖', booking: '預約', cancel: '取消預約', order: '下單未付', divination: '占卜', click: '點信', join: '加入' };
    box.innerHTML = `
      <div class="crm-detail-head">
        <div>
          <div class="crm-detail-name">${esc(p.name)}<span class="zf-badge ${TIER[p.tier][1]}"><span class="zf-badge-dot"></span>${TIER[p.tier][0]}</span></div>
          <div class="crm-detail-meta">${[p.email, p.phone, p.birth ? '生日 ' + p.birth : ''].filter(Boolean).map(esc).join(' · ')}</div>
          <div class="crm-row-tags">${p.sources.map((s) => `<span class="zf-tag neutral outline">${esc(s)}</span>`).join('')}</div>
        </div>
        <button class="zf-btn quiet sm" type="button" id="detail-close">關閉</button>
      </div>
      <div class="crm-kpis">
        <div><b>${ntd(p.spend)}</b><span>累計付款</span></div>
        <div><b>${p.paid_count}</b><span>付款次數</span></div>
        <div><b>${p.last_sent_at ? day(p.last_sent_at) : '—'}</b><span>最近寄信</span></div>
        <div><b>${p.last_click_at ? day(p.last_click_at) : '—'}</b><span>最近點信</span></div>
      </div>
      <form class="crm-note" id="note-form">
        <label class="zf-field"><span class="zf-field-label">標籤（逗號分隔）</span><input class="zf-input" name="tags" value="${esc((p.tags || []).join(', '))}" placeholder="例如：老客、要跟進、精油" /></label>
        <label class="zf-field"><span class="zf-field-label">備註</span><textarea class="zf-textarea" name="note" rows="3" placeholder="這個人的狀況、上次聊到哪…">${esc(p.note || '')}</textarea></label>
        <div class="crm-note-actions"><button class="zf-btn primary sm" type="submit">存備註</button><span class="crm-note-status" id="note-status"></span></div>
      </form>
      <h3 class="crm-tl-title">時間軸<span>${evs.length} 筆</span></h3>
      <ol class="crm-tl">${evs.map((e) => `
        <li class="crm-tl-item k-${esc(e.kind)}">
          <time>${day(e.ts)}</time>
          <div><span class="crm-tl-kind">${KIND[e.kind] || esc(e.kind)}</span>${esc(e.title)}${e.amount ? `<b>${ntd(e.amount)}</b>` : ''}${e.status && !/^(Paid|paid|confirmed)$/.test(e.status) ? `<em>${esc(STATUS[e.status] || e.status)}</em>` : ''}${e.note ? `<small>${esc(e.note)}</small>` : ''}</div>
        </li>`).join('') || '<li class="crm-empty">還沒有互動紀錄。</li>'}</ol>`;
    $('detail-close').addEventListener('click', () => { box.hidden = true; current = ''; renderList(); });
    ($('note-form') as HTMLFormElement).addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = (ev.target as HTMLFormElement).elements as any; const st = $('note-status'); st.textContent = '儲存中…';
      const tags = String(f.tags.value).split(/[,，]/).map((s: string) => s.trim()).filter(Boolean);
      const r2 = await fetch(WORKER_API + '/admin/crm/note', { method: 'POST', headers: headers({ 'Content-Type': 'application/json' }), body: JSON.stringify({ key, note: f.note.value, tags }) });
      const d2 = await r2.json();
      if (d2.ok) { st.textContent = '已存'; const me = people.find((x) => x.key === key); if (me) { me.tags = tags; me.note = f.note.value; } renderList(); }
      else st.textContent = '沒存成：' + (d2.error || d2.message || '');
    });
    if (window.innerWidth < 900) window.scrollTo({ top: box.getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });   // 手機：留 90px 給固定導覽列（scrollIntoView 不一定吃 scroll-margin）
  }

  $('tier-tabs').querySelectorAll<HTMLButtonElement>('.zf-tab').forEach((b) => b.addEventListener('click', () => {
    $('tier-tabs').querySelectorAll('.zf-tab').forEach((x) => x.classList.toggle('on', x === b)); tier = b.dataset.tier || ''; page = 1; renderList();
  }));
  ($('crm-search') as HTMLInputElement).addEventListener('input', (e) => { query = (e.target as HTMLInputElement).value; page = 1; renderList(); });
  $('retry-btn').addEventListener('click', load);

  const pwdForm = $('pwd-form') as HTMLFormElement, pwdInput = $('pwd-input') as HTMLInputElement, pwdError = $('pwd-error');
  pwdForm.addEventListener('submit', async (e) => {
    e.preventDefault(); const val = pwdInput.value.trim(); if (!val) return; pwdError.hidden = true;
    const r = await fetch(WORKER_API + '/admin/crm/people', { headers: { 'X-Crm-Secret': val } }).catch(() => null);
    if (!r || r.status === 401) { pwdError.hidden = false; return; }
    setSecret(val); load();
  });

  hideAll();
  if (getSecret()) load(); else { authGate.hidden = false; pwdInput.focus(); }
</script>

<style is:global>
  /* is:global：列表列／統計卡／時間軸都是 JS innerHTML 注入，scoped CSS 套不到（見 design-exact-value-match 第 7 條）；class 全帶 crm- 前綴不外漏 */
  .crm-main { max-width: var(--container); margin: 0 auto; padding: 32px 32px 80px; }
  .page-header { margin-bottom: 28px; }
  .page-header .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.02em; color: var(--accent-press); }
  .page-header .eyebrow .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent); flex: none; }
  .page-header h1 { font-family: var(--font-serif); font-size: 38px; font-weight: 500; color: var(--ink-900); margin: 10px 0 0; letter-spacing: 0.01em; line-height: 1.3; }
  .page-header .lede { font-family: var(--font-serif); font-weight: 300; color: var(--text-secondary); font-size: 18px; line-height: 1.8; max-width: 34em; margin: 10px 0 0; }

  .auth-gate { max-width: 480px; margin: 40px auto; }
  .auth-card { background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 32px 28px; text-align: center; box-shadow: var(--shadow-sm); }
  .auth-card h2 { font-family: var(--font-serif); font-weight: 500; color: var(--ink-900); margin: 0 0 12px; font-size: 22px; }
  .auth-desc { font-family: var(--font-serif); color: var(--ink-700); font-size: 14px; line-height: 1.7; margin: 0 0 24px; }
  .auth-note { font-family: var(--font-sans); color: var(--ink-500); font-size: 12px; margin: 4px 0 0; }
  .loading-section { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding: 72px 16px; color: var(--text-muted); font-family: var(--font-serif); font-size: 15px; }
  .error-section { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 48px 16px; font-family: var(--font-serif); color: var(--ink-900); }

  .crm-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 20px; }
  .crm-stat { background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 14px 16px; box-shadow: var(--shadow-xs); }
  .crm-stat b { display: block; font-family: var(--font-serif); font-size: 26px; font-weight: 500; color: var(--ink-900); line-height: 1.2; }
  .crm-stat span { font-family: var(--font-sans); font-size: var(--t-caption); color: var(--text-muted); }

  .crm-toolbar { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 16px; }
  .crm-search { max-width: 360px; }

  .crm-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .crm-list { display: flex; flex-direction: column; gap: 8px; }
  .crm-row { all: unset; box-sizing: border-box; display: flex; justify-content: space-between; gap: 16px; width: 100%; padding: 14px 16px; background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-md); box-shadow: var(--shadow-xs); cursor: pointer; transition: border-color var(--dur-fast), box-shadow var(--dur-fast); }
  .crm-row:hover { border-color: var(--rose-200); }
  .crm-row.on { border-color: var(--rose-300); box-shadow: 0 0 0 4px var(--focus-ring); }
  .crm-row-main { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .crm-row-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-family: var(--font-serif); font-size: 16.5px; font-weight: 500; color: var(--ink-900); }
  .crm-row-sub { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); overflow-wrap: anywhere; }
  .crm-row-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .crm-row-tags .zf-tag { padding: 2px 9px; font-size: var(--t-micro); }
  .crm-row-side { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; text-align: right; }
  .crm-row-side b { font-family: var(--font-serif); font-size: 15.5px; font-weight: 500; color: var(--ink-900); }
  .crm-row-side span { font-family: var(--font-sans); font-size: 12px; color: var(--text-muted); white-space: nowrap; }
  .crm-empty { font-family: var(--font-serif); color: var(--text-muted); padding: 24px 8px; margin: 0; }
  .crm-list { scroll-margin-top: 90px; }
  .crm-pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .crm-pager-info { font-family: var(--font-sans); font-size: 13px; color: var(--ink-700); text-align: center; }
  .crm-pager-info em { display: block; font-style: normal; font-size: 12px; color: var(--text-muted); margin-top: 2px; }

  .crm-detail { position: sticky; top: 88px; scroll-margin-top: 84px; background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 24px;   /* 不用 --space-6：global.css 沒定義這顆 token，會變 0 */ box-shadow: var(--shadow-sm); max-height: calc(100vh - 110px); overflow: auto; }
  .crm-detail-loading { display: flex; justify-content: center; padding: 40px; }
  .crm-detail-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .crm-detail-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); }
  .crm-detail-meta { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin: 4px 0 8px; overflow-wrap: anywhere; }
  .crm-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 18px 0; }
  .crm-kpis div { background: var(--surface-sunken); border-radius: var(--radius-md); padding: 10px 12px; }
  .crm-kpis b { display: block; font-family: var(--font-serif); font-size: 16px; font-weight: 500; color: var(--ink-900); }
  .crm-kpis span { font-family: var(--font-sans); font-size: var(--t-micro); color: var(--text-muted); }
  .crm-note { display: flex; flex-direction: column; gap: 12px; padding: 16px; background: var(--surface-tint); border: 1px solid var(--rose-100); border-radius: var(--radius-md); }
  .crm-note-actions { display: flex; align-items: center; gap: 12px; }
  .crm-note-status { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); }
  .crm-tl-title { display: flex; align-items: baseline; gap: 10px; font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--ink-900); margin: 22px 0 10px; }
  .crm-tl-title span { font-family: var(--font-sans); font-size: 12.5px; font-weight: 400; color: var(--text-muted); }
  .crm-tl { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border-soft); }
  .crm-tl-item { position: relative; display: grid; grid-template-columns: 96px 1fr; gap: 10px; padding: 8px 0 8px 18px; font-family: var(--font-serif); font-size: 14.5px; color: var(--ink-900); line-height: 1.6; }
  .crm-tl-item::before { content: ''; position: absolute; left: -6px; top: 15px; width: 10px; height: 10px; border-radius: 999px; background: var(--rice-300); border: 2px solid var(--surface-card); }
  .crm-tl-item.k-pay::before { background: var(--rose-400); }
  .crm-tl-item.k-booking::before { background: var(--clay-400); }
  .crm-tl-item.k-click::before { background: var(--sage-400); }
