  if(!surname)return{err:"請先輸入姓氏。"};
  if(!given)return{err:"請先輸入名字。"};
  if(!y||!m||!d)return{err:"請先選擇你的出生日期。"};
  if(!t)return{err:"請選擇出生時間（不確定可勾選午時）。"};
  if(!validPhoneTW(phone))return{err:"請輸入正確的手機號碼（例如 0912345678）。"};
  if(!validGmail(email))return{err:"Email 目前僅接受 @gmail.com 信箱。"};
  return{surname:surname,given:given,phone:phone,email:email,dob:y+"-"+pad2(m)+"-"+pad2(d)+" "+t};
}

/* ===== 分靈體 prefetch（best-effort）===== */
function soulPrefetch(){
  var btn=document.getElementById("soulBtn");if(!btn||STATE.soulConfirmed)return;
  if(!STATE.userId){showInfoErr("請先用 Google 登入（表單上方），分靈體才能認得你。");return;}
  var info=gatherInfo();if(info.err){showInfoErr(info.err);return;}
  btn.disabled=true;btn.innerHTML=ic("circle-notch")+'凝聚中…';
  fetch(API.prefetch,{method:"POST",headers:authHeaders({"Content-Type":"application/json"}),
    body:JSON.stringify({google_sub:STATE.userId,date_of_birth:info.dob,last_name:info.surname,first_name:info.given})})
   .then(function(r){return r.json();}).then(function(d){
     STATE.soulConfirmed=!!d.success;
     btn.disabled=false;btn.innerHTML=d.success?ic("check","bold")+'分靈體已上線':ic("sparkle")+'先認識它';
   }).catch(function(){btn.disabled=false;btn.innerHTML=ic("sparkle")+'再試一次';});
}

/* ===== 送出占卜 → interpreting → 輪詢 ===== */
function submitDivination(){
  if(STATE.submitting)return;
  if(!STATE.userId){showInfoErr("請先用 Google 登入（表單上方），我才能把這次的解讀保留給你。");return;}
  if(!STATE.text){showInfoErr("請先回到上一步，選一句想問的話。");return;}
  var info=gatherInfo();if(info.err){showInfoErr(info.err);return;}
  STATE.userName={surname:info.surname,given:info.given};
  STATE.submitting=true;STATE.logId="";STATE.result=null;STATE.paid=false;
  go("interpreting");
  var edmTok="";try{edmTok=localStorage.getItem("winds_edm_token")||"";}catch(e){}
  fetch(API.submit,{method:"POST",headers:authHeaders({"Content-Type":"application/json"}),
    body:JSON.stringify({google_sub:STATE.userId,question:STATE.text,divination_method:"雙占卜",
      date_of_birth:info.dob,last_name:info.surname,first_name:info.given,
      gender:STATE.gender||((STATE.prefill&&STATE.prefill.gender)||""),phone:phoneE164(info.phone),email:info.email,
      edm_token:edmTok||undefined})})
   .then(function(resp){
     if(!resp.ok){return resp.json().catch(function(){return{};}).then(function(d){
       if(d.repeat_wall){STATE.repeatWall=d;STATE.logId=d.last_log_id||"";STATE.submitting=false;go("repeatwall");return null;}
       if(resp.status===429||d.blocked){STATE.cooldown={message:d.message,available_at:d.available_at};STATE.submitting=false;go("cooldown");return null;}
       if(d.error==="phone_duplicate"||d.error==="email_duplicate"){STATE.submitting=false;go("info");setTimeout(function(){showInfoErr(d.message||"此聯絡資料已被使用。");},60);return null;}
       throw new Error(d.message||("HTTP "+resp.status));
     });}
     return resp.json();
   })
   .then(function(data){
     if(!data)return;
     if(data.blocked){STATE.cooldown={message:data.message,available_at:data.available_at};STATE.submitting=false;go("cooldown");return;}
     if(data.success===false){STATE.submitting=false;go("info");setTimeout(function(){showInfoErr(data.message||"發生錯誤，請再試一次。");},60);return;}
     if(data.pending){pollStatus(data.log_id||"");return;}
     finishResult(data);
   })
   .catch(function(e){STATE.submitting=false;go("info");setTimeout(function(){showInfoErr("送出失敗："+e.message);},60);});
}

function pollStatus(logId){
  var attempts=0,max=23;
  var timer=setInterval(function(){
    attempts++;
    fetch(API.status+"?log_id="+encodeURIComponent(logId)+"&google_sub="+encodeURIComponent(STATE.userId),{headers:authHeaders()})
     .then(function(r){return r.json();}).then(function(d){
       if(d.ready&&d.summary){clearInterval(timer);finishResult(d,logId);}
       else if(attempts>=max){clearInterval(timer);STATE.submitting=false;go("info");setTimeout(function(){showInfoErr("占卜仍在進行，結果會透過 LINE 推送給你，請留意通知 🔔");},60);}
     }).catch(function(){if(attempts>=max){clearInterval(timer);STATE.submitting=false;go("info");setTimeout(function(){showInfoErr("連線中斷，結果會透過 LINE 推送給你。");},60);}});
  },4000);
}

function finishResult(d,logId){
  STATE.submitting=false;
  STATE.logId=d.log_id||d.reading_id||logId||"";
  if(d.next_action)STATE.talismanName=d.next_action.talisman_name||STATE.talismanName;
  STATE.result=buildResult(d);
  STATE.paid=!!d.purchased;
  /* 回看模式（會員中心 ?log_id=）沒走表單，userName 用後端回的真名補上，姓名學才有得算 */
  if(!STATE.userName&&d.client_last_name)STATE.userName={surname:d.client_last_name,given:d.client_first_name||""};
  go("result");
  if(STATE.logId)loadRecs(STATE.logId);
  loadNaming();
}

/* ===== 姓名學（無狀態端點，安全；載入後就地換 #nameMount）===== */
function loadNaming(){
  var u=STATE.userName;if(!u||!u.surname||!u.given||!STATE.result)return;
  var R=STATE.result;
  fetch(API.naming,{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({surname:u.surname,given_name:u.given,zodiac:R.zodiac||"",full_access:!!STATE.paid})})
   .then(function(r){return r.json();}).then(function(d){
     var n=normName(d);if(!n||!STATE.result)return;
     STATE.result.name=n;
     var m=document.getElementById("nameMount");if(m)m.innerHTML=nameCard(STATE.paid||STATE.result.purchased);
     var s=document.getElementById("nameSection");if(s)s.style.display="";
   }).catch(function(){});
}

/* ===== 推薦 ===== */
function loadRecs(logId){
  fetch(API.recommend+"?log_id="+encodeURIComponent(logId)).then(function(r){return r.json();}).then(function(d){
    if(!STATE.result)return;
    STATE.result.recs=(d.success&&d.recommendations)?d.recommendations:[];
    var mount=document.getElementById("recsMount");
    if(mount&&STATE.result.recs.length){mount.innerHTML=recsInner(STATE.result.recs);mount.style.display="";}
  }).catch(function(){});
}

/* ===== 解鎖付款（ECPay）===== */
function createOrder(){
  if(STATE.ordering)return;
  var btn=document.getElementById("unlockBtn");
  if(!STATE.logId){alert("找不到占卜記錄，請重新占卜。");return;}
  STATE.ordering=true;
  if(btn){btn.disabled=true;btn.innerHTML=ic("circle-notch")+'建立訂單中…';}
  fetch(API.order,{method:"POST",headers:authHeaders({"Content-Type":"application/json"}),
    body:JSON.stringify({google_sub:STATE.userId,divination_log_id:Number(STATE.logId)||0,talisman_name:STATE.talismanName})})
   .then(function(r){return r.json();}).then(function(d){
     STATE.ordering=false;
     if(d.success&&d.pay_url){
       try{sessionStorage.setItem("winds_pending_log_id",STATE.logId);}catch(e){}
       var w=window.open(d.pay_url,"_blank");if(!w){location.href=d.pay_url;return;}
       if(btn){btn.disabled=false;btn.innerHTML=ic("arrow-clockwise")+'已開啟付款頁——完成後點我載入完整解讀';btn.onclick=function(){location.reload();};}
     }else{if(btn){btn.disabled=false;btn.innerHTML=ic("sparkle")+'解鎖完整解讀 · NT$ '+TALISMAN_PRICE;}alert(d.message||"建立訂單失敗，請再試一次。");}
   }).catch(function(e){STATE.ordering=false;if(btn){btn.disabled=false;btn.innerHTML=ic("sparkle")+'解鎖完整解讀 · NT$ '+TALISMAN_PRICE;}alert("付款錯誤："+e.message);});
}

/* ===== 分享（Web Share API / 剪貼簿）===== */
function shareResult(btn){
  var orig=btn?btn.innerHTML:"";
  if(btn){btn.disabled=true;btn.innerHTML=ic("circle-notch")+'生成分享圖中…';}
  var done=function(){if(btn){btn.disabled=false;btn.innerHTML=orig;}};
  fetch(WORKER_API+"/generate-og-image",{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({google_sub:STATE.userId})}).catch(function(){}).then(function(){
    done();
    var shareUrl="https://winds.tw/share?uid="+encodeURIComponent(STATE.userId)+"&t="+Date.now();
    var R=STATE.result||{};
    var snippet=(R.summary||"").replace(/[#*`>]/g,"").replace(/\s+/g," ").trim().slice(0,100);
    var shareText="🌀 找風問幸福 — 我的占卜結果\n\n"+(snippet?snippet+"…\n\n":"")+"你也來試試 ✨\n👉 "+shareUrl;
    if(navigator.share){
      navigator.share({title:"🌀 找風問幸福 — 我的占卜結果",text:shareText,url:shareUrl})
       .catch(function(){if(navigator.clipboard)navigator.clipboard.writeText(shareText).then(function(){alert("已複製分享內容 👍");});});
    }else if(navigator.clipboard){
      navigator.clipboard.writeText(shareText).then(function(){alert("已複製分享連結 👍\n可以貼到 LINE、Facebook、Threads 分享");});
    }else{
      prompt("請複製以下連結分享：",shareUrl);
    }
  });
}

/* ===== 預填（回訪）===== */
function doPrefill(){
  if(!STATE.userId)return;
  fetch(API.prefill+"?google_sub="+encodeURIComponent(STATE.userId),{headers:authHeaders()})
   .then(function(r){return r.json();}).then(function(d){
     if(d&&d.error==="maintenance"){location.href="/maintenance.html";return;}
     if(!d||!d.found)return;
     STATE.prefill={last_name:d.last_name||"",first_name:d.first_name||"",date_of_birth:d.date_of_birth||"",phone:d.phone||"",email:d.email||"",gender:d.gender||"",location:d.location||""};
     if(d.gender&&!STATE.gender)STATE.gender=d.gender;
     if(d.personality_profile)STATE.soulConfirmed=true;
     if(STATE.step==="info")render();
   }).catch(function(){});
}

/* ===== 開機（Google SSO）===== */
function adoptGoogleToken(tok){
  try{
    var p=JSON.parse(atob(tok.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
    if(p.exp&&p.exp*1000<Date.now())return false;
    googleIdToken=tok;STATE.userId=p.sub||"";
    STATE.gEmail=p.email||"";
    return !!STATE.userId;
  }catch(e){return false;}
}
function handleGoogleCredential(resp){
  if(!resp||!resp.credential)return;
  if(!adoptGoogleToken(resp.credential))return;
  try{localStorage.setItem("winds_google_token",resp.credential);}catch(e){}
  doPrefill();
  if(STATE.step==="info")render();
}
function initGoogleGIS(){
  if(typeof google==="undefined"||!google.accounts){setTimeout(initGoogleGIS,250);return;}
  google.accounts.id.initialize({client_id:GOOGLE_CLIENT_ID,callback:handleGoogleCredential,auto_select:true,context:"signin"});
  if(!STATE.userId)google.accounts.id.prompt();
  mountGisButton();
}
function mountGisButton(){
  if(STATE.userId)return;
  var el=document.getElementById("googleSignInBtn");
  if(!el)return;if(el.childNodes.length&&!mountGisButton._redo)return;mountGisButton._redo=false;
  if(typeof google==="undefined"||!google.accounts)return;
  el.innerHTML="";
  google.accounts.id.renderButton(el,{theme:(window.ZFTheme&&ZFTheme.isDark())?"filled_black":"outline",size:"large",text:"signin_with",shape:"pill",width:280,locale:"zh-TW"});
}
window.addEventListener('zf-theme-change',function(){var d=window.ZFTheme&&ZFTheme.isDark();document.querySelectorAll('.zf-theme-ico').forEach(function(i){i.className='zf-theme-ico ph-thin ph-'+(d?'sun':'moon');});document.querySelectorAll('.zf-theme-lbl').forEach(function(s){s.textContent=d?'淺色模式':'深色模式';});});
window.addEventListener('zf-theme-change',function(){mountGisButton._redo=true;mountGisButton();});
function boot(){
  var params=new URLSearchParams(location.search);
  var edmT=params.get("t");if(edmT){try{localStorage.setItem("winds_edm_token",edmT);}catch(e){}}
  var saved="";try{saved=localStorage.getItem("winds_google_token")||"";}catch(e){}
  if(saved&&!adoptGoogleToken(saved)){try{localStorage.removeItem("winds_google_token");}catch(e){}}
  var rid=params.get("log_id"),pending="";try{pending=sessionStorage.getItem("winds_pending_log_id")||"";}catch(e){}
  if(rid||pending){
    if(pending){try{sessionStorage.removeItem("winds_pending_log_id");}catch(e){}}
    STATE.reportMode=true;   // 完整報告：回訪既有占卜 → 結果頁套站台 Nav/Footer
    STATE.step="interpreting";render();pollStatus(rid||pending);
    if(!STATE.userId)initGoogleGIS();
    return;
  }
  if(STATE.userId)doPrefill();
  render();
  initGoogleGIS();
}

/* 對外（onclick handlers 需 global）*/
window.pickDir=pickDir;window.pickSub=pickSub;window.pickQ=pickQ;window.toggleNoon=toggleNoon;window.pickGender=pickGender;
window.go=go;window.back=back;window.exitFlow=exitFlow;window.openOA=openOA;window.askAnother=askAnother;
window.submitDivination=submitDivination;window.soulPrefetch=soulPrefetch;window.createOrder=createOrder;window.shareResult=shareResult;
window.STATE=STATE;

boot();
</script>
