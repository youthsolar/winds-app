    .tcard{aspect-ratio:.62;border-radius:var(--radius-md);border:1px solid var(--rose-200);background:linear-gradient(165deg,var(--paper),var(--rose-50));box-shadow:var(--shadow-sm);padding:12px 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative}
