    .paywall .veil .lk{width:48px;height:48px;border-radius:999px;background:var(--rose-100);display:flex;align-items:center;justify-content:center;margin-bottom:16px;color:var(--rose-500)}
    .paywall .veil h3{font-family:var(--font-serif);font-size:25px;font-weight:500;color:var(--ink-900);margin:0 0 8px}
    .paywall .veil p{font-family:var(--font-serif);font-weight:300;font-size:16.5px;line-height:1.8;color:var(--text-secondary);margin:0 0 6px;max-width:26em;text-align:left}
    .feat{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin:14px 0 20px}
    .feat span{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:12.5px;color:var(--rose-600);background:var(--rose-50);border-radius:var(--radius-pill);padding:5px 12px}
    .paid-card{background:var(--surface-tint);border:1px solid var(--rose-100);border-radius:var(--radius-lg);overflow:hidden}
    .paid-card .topbar{height:4px;background:linear-gradient(90deg,var(--rose-300),var(--clay-400))}
    .paid-card .body{padding:30px 34px}
    .paid-card .body p{font-family:var(--font-serif);font-weight:300;font-size:17px;line-height:2;color:var(--ink-700);margin:0 0 16px}

    /* recs */
    .recs{margin-top:60px}
    .recs .head{text-align:center;margin-bottom:34px}
    .recs .head h2{font-family:var(--font-serif);font-size:30px;font-weight:500;line-height:1.18;letter-spacing:.02em;color:var(--ink-900);margin:0 0 8px}
