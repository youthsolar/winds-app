    .nm-ce{font-family:var(--font-sans);font-size:13px;font-weight:500;margin-top:5px}
    .nm-wuge{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
    .nm-wg{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:12px 10px;text-align:center}
    .nm-wk{font-family:var(--font-sans);font-size:11px;letter-spacing:.06em;color:var(--text-muted);margin-bottom:6px}
    .nm-ws{font-family:var(--font-serif);font-size:24px;font-weight:500;color:var(--ink-900);line-height:1.1}
    .nm-we{font-family:var(--font-sans);font-size:12px;font-weight:500;margin-top:5px}
    .nm-wl{font-family:var(--font-sans);font-size:12px;font-weight:500;margin-top:3px}
    .nm-sancai{margin-top:14px;display:flex;align-items:center;gap:14px;padding:12px 16px;background:var(--surface-tint);border:1px solid var(--rose-100);border-radius:var(--radius-md);flex-wrap:wrap}
