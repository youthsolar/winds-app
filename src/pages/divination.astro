    .vqian{display:flex;flex-direction:column;gap:10px}
    .vqian .no{font-family:var(--font-serif);font-size:16px;color:var(--rose-600);letter-spacing:.1em;border-bottom:1px solid var(--rose-100);padding-bottom:8px}
    .vqian .poem{display:grid;grid-template-columns:max-content max-content;justify-content:start;gap:6px 1em}
    .vqian .poem span{font-family:var(--font-serif);font-size:18px;line-height:1.8;color:var(--ink-900)}
    .vqian .poem span.dim{color:var(--ink-300)}
    .qno{font-family:var(--font-sans);font-size:12.5px;color:var(--rose-500);letter-spacing:.06em;margin-bottom:10px}
    .qpoem{display:grid;grid-template-columns:max-content max-content;justify-content:start;gap:6px 1em}
    .qpoem span{font-family:var(--font-serif);font-size:18px;line-height:1.8;color:var(--ink-900)}
    .kpoem{font-family:var(--font-serif);font-size:18px;line-height:1.8;color:var(--ink-900);margin:0}
    @media(max-width:760px){.qpoem{gap:6px 0.8em}.qpoem span{font-size:16.5px}.kpoem{font-size:16.5px}}

    /* talisman */
    .tal-hero{display:grid;grid-template-columns:auto 1fr;gap:34px;align-items:center}
    @media(max-width:760px){.tal-hero{grid-template-columns:1fr;gap:18px}}
    .tal-wrap{width:196px;position:relative}
    @media(max-width:760px){.tal-wrap{width:168px;margin:0 auto}}
    .tframe{position:relative;width:100%;aspect-ratio:9/16;border-radius:var(--radius-lg);background:var(--paper);border:1px solid var(--rose-200);box-shadow:var(--shadow-md);overflow:hidden;display:flex;align-items:center;justify-content:center;--tf-glow:var(--rose-100);-webkit-mask-image:-webkit-radial-gradient(white,black)}
    .tframe .glow{position:absolute;inset:0;z-index:1;background:radial-gradient(132% 82% at 50% 41%,var(--tf-glow) 0%,var(--tf-glow) 16%,transparent 70%)}
    .tframe .glow2{position:absolute;inset:0;z-index:1;background:radial-gradient(80% 55% at 50% 40%,var(--tf-glow),transparent 70%);mix-blend-mode:multiply;opacity:.28}
    .tframe .inner-border{position:absolute;z-index:1;inset:8px;border-radius:calc(var(--radius-lg) - 6px);border:1px solid var(--rose-100)}
    .fulu{position:relative;z-index:1;height:100%;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:30px 0 20px;color:var(--ink-700)}
    .fulu .chi{font-family:var(--font-sans);font-size:12px;letter-spacing:.42em;color:var(--rose-500);margin-left:.42em}
    .fulu .glyph{font-family:var(--font-serif);font-size:84px;line-height:1;color:var(--accent-press)}
    .fulu .bar{width:1px;height:28px;background:linear-gradient(var(--rose-300),transparent)}
    .fulu .name{writing-mode:vertical-rl;font-family:var(--font-serif);font-size:32px;font-weight:500;letter-spacing:.16em;color:var(--ink-700)}
    .fulu .brand{font-family:var(--font-serif);font-size:11px;letter-spacing:.08em;color:var(--rose-400)}
    .fulu.sm{padding:18px 0 13px}.fulu.sm .glyph{font-size:50px}.fulu.sm .name{font-size:21px}.fulu.sm .chi{font-size:9.5px}.fulu.sm .bar{height:16px}.fulu.sm .brand{font-size:8.5px}
