    .fab-cta:hover{transform:translateX(-50%) translateY(-1px)}
    @media(max-width:600px){.fab-cta{bottom:16px}}
    /* paywall */
    .paywall{position:relative;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--rose-100);background:var(--surface-card)}
    .paywall .behind{position:absolute;inset:0;z-index:0;filter:blur(7px);opacity:.55;padding:30px 32px;pointer-events:none;user-select:none;background:var(--surface-card)}
