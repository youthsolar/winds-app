---
/*
 * 核心占卜漏斗 /divination — 純 Astro + vanilla（不用 React）。
 * 金流邏輯原樣搬自 live public/index.html（端點 / payload / 輪詢 / 付款 / 驗證 / storage 全部保留）。
 * 視覺＝新設計（design .jsx 為真值來源）；token 走 global.css（不重定 :root）。
 * 全螢幕 funnel，自帶 ProgressHeader，不掛 site Nav/Footer。
 */
import '../styles/global.css';
import ConciergeWidget from '../components/ConciergeWidget.astro';
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="format-detection" content="telephone=no,date=no,email=no,address=no" />
  <title>占卜流程 · 找風問幸福</title>
  <meta name="description" content="易經 × 塔羅 × 量能靈符，為你讀一件事。" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/thin/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
  <script is:inline src="/assets/theme-init.js"></script>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script src="/assets/nav-auth.js?v=4" defer></script>

  <style is:global>
    #root{min-height:100vh}
    .shell{max-width:var(--container);margin:0 auto;padding:48px 28px 88px}
    .shell.narrow{max-width:680px}
    @media(max-width:760px){.shell{padding:28px 18px 56px}}

    /* eyebrow（中文 → 不大寫、窄字距 0.02em，依新設計）*/
    .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-sans);font-size:12px;font-weight:500;letter-spacing:.02em;color:var(--accent-press)}
    .eyebrow .dot{width:6px;height:6px;border-radius:999px;background:var(--accent);flex:none}
    .lede{font-family:var(--font-serif);font-weight:300;font-size:18px;line-height:1.8;color:var(--text-secondary);max-width:30em}
    @media(max-width:760px){.lede{font-size:15.5px}}
    .step-intro{display:flex;flex-direction:column;gap:12px;margin-bottom:34px}
    .step-intro h1{font-size:38px;font-weight:500;line-height:1.3;color:var(--ink-900);letter-spacing:.01em;word-break:normal;overflow-wrap:anywhere;text-wrap:auto}
    @media(max-width:760px){.step-intro{margin-bottom:24px}.step-intro h1{font-size:26px}}

    /* btn/card/tag 全用 ds.css 的 zf-*（去重，不再本地手抄一份）。僅保留 card padding 對齊現行：
       DS zf-card 用 --space-6，這裡固定 24px / 手機 20px 18px，與改版前像素一致 */
    .zf-card{padding:24px}
    @media(max-width:760px){.zf-card{padding:20px 18px}}

    .placeholder-tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:11px;color:var(--text-muted);background:var(--surface-page);border:1px dashed var(--border-strong);border-radius:var(--radius-pill);padding:3px 10px;white-space:nowrap}

    /* chips */
    .chip{all:unset;cursor:pointer;white-space:nowrap;font-family:var(--font-serif);font-size:16px;font-weight:500;letter-spacing:.01em;line-height:1;color:var(--accent-press);background:var(--surface-card);border:1px solid var(--rose-200);border-radius:var(--radius-pill);padding:11px 20px;transition:all var(--dur-fast) var(--ease-soft)}
    .chip.on{color:var(--text-on-accent);background:var(--accent);border-color:transparent;box-shadow:var(--shadow-sm)}

    /* fields */
    .f-label{display:block;margin-bottom:8px;font-family:var(--font-sans);font-size:14px;font-weight:500;color:var(--ink-700);letter-spacing:.02em}
    .f-input,.f-select,.f-textarea{width:100%;box-sizing:border-box;padding:12px 16px;font-family:var(--font-serif);font-size:16px;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-md);box-shadow:var(--shadow-xs);outline:none;transition:border-color var(--dur-fast),box-shadow var(--dur-fast)}
    .f-textarea{padding:12px 14px;line-height:1.7;resize:vertical}
    .f-input:focus,.f-select:focus,.f-textarea:focus{border-color:var(--rose-300);box-shadow:0 0 0 4px var(--focus-ring)}
    .f-textarea{line-height:1.7;resize:vertical}
    .f-select-wrap{position:relative;flex:1 1 0;min-width:0}
    .f-select{padding-right:34px;appearance:none;-webkit-appearance:none}
    .f-select-wrap .caret{position:absolute;right:13px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--rose-400)}
    .hint{display:flex;align-items:flex-start;gap:8px;font-family:var(--font-sans);font-size:12.5px;line-height:1.7;color:var(--text-muted)}
    .hint i{line-height:inherit}
    /* info 表單格線：姓名/生日時間/手機email 各成對；性別/出生地整列 */
    .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .info-grid .fw{grid-column:1 / -1}
    @media(max-width:600px){.info-grid{grid-template-columns:1fr;gap:14px}}
    /* 性別三選一（依新設計）*/
    .gbtn{all:unset;cursor:pointer;flex:1;text-align:center;padding:11px 0;font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-700);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-md);transition:all var(--dur-fast) var(--ease-soft)}
    .gbtn.on{color:var(--text-on-accent);background:var(--accent);border-color:transparent}

    /* progress header */
    /* 完整報告模式站台 Nav/Footer（DS report-page 外殼）*/
    /* ===== 站台 Nav/Footer（回看模式用；markup+CSS 逐值同 BaseLayout.astro，:global() 已展開）===== */
    .zf-nav{position:sticky;top:0;z-index:40;background:var(--bar-translucent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border-soft);}
    .zf-nav-row{max-width:var(--container);margin:0 auto;padding:0 32px;height:76px;display:flex;align-items:center;justify-content:space-between;}
    .zf-logo{display:block;}
    .zf-nav .zf-logo img{height:54px;width:auto;display:block;}
    .zf-nav-links{display:flex;align-items:center;gap:26px;}
    .zf-nav-links > a:not(.zf-btn){font-family:var(--font-sans);font-size:14px;color:var(--ink-700);letter-spacing:0.03em;text-decoration:none;}
    .zf-nav-links > a:not(.zf-btn):hover{color:var(--accent-press);text-decoration:none;}
    .zf-burger{display:none;align-items:center;justify-content:center;width:44px;height:44px;border:none;background:transparent;color:var(--ink-700);cursor:pointer;}
    .zf-burger i{font-size:24px;line-height:1;}
    .zf-drawer{display:none;border-top:1px solid var(--border-soft);background:var(--surface-page);padding:8px 20px 18px;}
    .zf-drawer .zf-btn.full{margin-top:12px;}
    .zf-drawer > a:not(.zf-btn){font-family:var(--font-serif);font-size:17px;color:var(--ink-900);padding:12px 4px;border-bottom:1px solid var(--border-soft);text-decoration:none;}
    .zf-account{display:flex;align-items:center;}
    .zf-account .nav-acct{display:flex;align-items:center;}
    .zf-account a{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:14px;color:var(--ink-700);letter-spacing:0.03em;text-decoration:none;}
    .zf-account a:hover{color:var(--accent-press);text-decoration:none;}
    .zf-account-m{margin-top:8px;padding-top:10px;border-top:1px solid var(--border-soft);}
    .zf-account-m a{display:block;font-family:var(--font-serif);font-size:16px;color:var(--ink-900);padding:10px 4px;text-decoration:none;}
    @media (max-width:980px){
      .zf-nav-row{padding:0 20px;height:64px;}
      .zf-nav .zf-logo img{height:42px;}
      .zf-nav-links{display:none;}
      .zf-burger{display:flex;}
      .zf-drawer:not([hidden]){display:flex;flex-direction:column;gap:2px;}
    }
    .zf-footer{margin-top:88px;border-top:1px solid var(--border-soft);}
    .zf-footer-in{max-width:var(--container);margin:0 auto;padding:52px 32px 60px;}
    .zf-footer-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:28px;}
    .zf-footer-brand .zf-logo img{height:54px;width:auto;display:block;}
    .zf-footer-brand p{font-family:var(--font-serif);font-weight:300;font-size:13.5px;color:var(--text-muted);margin:14px 0 0;max-width:22em;}
    .zf-footer-cols{display:flex;gap:56px;}
    .zf-fh{font-family:var(--font-sans);font-size:12.5px;letter-spacing:0.02em;color:var(--text-muted);margin-bottom:14px;}
    .zf-fcol a{display:block;font-family:var(--font-serif);font-size:14.5px;color:var(--ink-700);margin-bottom:9px;text-decoration:none;}
    .zf-fcol a:hover{color:var(--accent-press);text-decoration:none;}
    .zf-footer-legal{border-top:1px solid var(--border-soft);margin-top:36px;padding-top:18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-family:var(--font-sans);font-size:12px;color:var(--text-muted);}
    @media (max-width:760px){
      .zf-footer{margin-top:56px;}
      .zf-footer-in{padding:40px 20px 48px;}
      .zf-footer-brand .zf-logo img{height:42px;}
      .zf-footer-cols{gap:36px;}
    }
    .ph-hdr{position:sticky;top:0;z-index:40;background:var(--bar-translucent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border-soft)}
    .ph-hdr .row{max-width:var(--container);margin:0 auto;padding:0 28px;height:70px;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .ph-back,.ph-exit{display:inline-flex;align-items:center;gap:6px;border:none;background:transparent;cursor:pointer;color:var(--ink-700);font-family:var(--font-sans);font-size:14px;padding:0}
    .ph-exit{color:var(--ink-400)}
    .ph-steps{display:flex;align-items:center;gap:8px}
    .ph-step{display:inline-flex;align-items:center;gap:8px}
    .ph-num{width:24px;height:24px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-family:var(--font-sans);font-size:12px;font-weight:600;border:1px solid var(--border-strong);color:var(--ink-300)}
    .ph-step.cur .ph-num{background:var(--accent);color:var(--text-on-accent);border:none}
    .ph-step.done .ph-num{background:var(--rose-100);color:var(--rose-600);border:none}
    .ph-lbl{font-family:var(--font-serif);font-size:15px;color:var(--ink-400)}
    .ph-step.cur .ph-lbl{color:var(--ink-900);font-weight:500}
    .ph-step.done .ph-lbl{color:var(--ink-700)}
    .ph-sep{width:26px;height:1px;background:var(--border-strong)}
    .ph-bar{height:2px;background:var(--rice-200)}
    .ph-bar>span{display:block;height:100%;background:linear-gradient(90deg,var(--rose-300),var(--rose-500));transition:width var(--dur-slow) var(--ease-soft)}
    .ph-mob{display:none;font-family:var(--font-serif);font-size:15px;color:var(--ink-900);font-weight:500}
    .ph-mob b{color:var(--accent-press);font-weight:600}
    @media(max-width:760px){.ph-hdr .row{padding:0 16px;height:60px}.ph-steps{display:none}.ph-mob{display:inline}.ph-back span{display:none}}

    /* topic */
    .dir-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
    .dir-card{all:unset;cursor:pointer;box-sizing:border-box;display:flex;flex-direction:column;gap:18px;padding:26px 24px;border-radius:var(--radius-lg);background:var(--surface-card);border:1px solid var(--border-soft);box-shadow:var(--shadow-sm);transition:all var(--dur-base) var(--ease-soft);width:100%}
    .dir-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
    .dir-mark{flex:none;width:56px;height:56px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:28px;font-weight:500}
    .dir-mark.rose{background:var(--rose-100);color:var(--rose-600);box-shadow:0 0 0 4px var(--surface-page),0 0 0 5px var(--rose-300)}
    .dir-mark.clay{background:var(--clay-200);color:var(--clay-500);box-shadow:0 0 0 4px var(--surface-page),0 0 0 5px var(--clay-300)}
    .dir-mark.sage{background:var(--sage-200);color:var(--sage-500);box-shadow:0 0 0 4px var(--surface-page),0 0 0 5px var(--sage-300)}
    .dir-title{font-family:var(--font-serif);font-size:22px;font-weight:500;color:var(--ink-900)}
    .dir-sub{font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.65;color:var(--text-secondary)}
    @media(max-width:760px){.dir-grid{grid-template-columns:1fr;gap:12px}.dir-card{flex-direction:row;align-items:center;gap:16px;padding:18px}.dir-mark{width:48px;height:48px;font-size:24px}.dir-title{font-size:19px}}
    .crumbs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
    .crumb{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-serif);font-size:14px;color:var(--rose-600);background:var(--rose-50);border:1px solid var(--rose-100);border-radius:var(--radius-pill);padding:5px 12px}
    .q-list{display:flex;flex-direction:column;gap:10px;margin-bottom:30px}
    .q-item{all:unset;cursor:pointer;display:flex;align-items:center;gap:12px;font-family:var(--font-serif);font-size:17.5px;line-height:1.6;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:16px 20px;transition:all var(--dur-fast) var(--ease-soft)}
    .q-item.on{background:var(--surface-tint);border-color:var(--rose-300)}
    .q-radio{flex:none;width:18px;height:18px;border-radius:999px;border:1px solid var(--border-strong);display:flex;align-items:center;justify-content:center}
    .q-item.on .q-radio{border-color:var(--accent);background:var(--accent);color:var(--text-on-accent)}
    .section-q{font-family:var(--font-serif);font-size:19px;color:var(--ink-900);margin:0 0 16px}

    /* interpreting */
    .interp{min-height:calc(100vh - 72px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 22px;position:relative;overflow:hidden}
    .interp .glow{position:absolute;inset:0;background:radial-gradient(620px 460px at 50% 32%,var(--rose-100),transparent 62%)}
    .interp .feng{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;line-height:1;font-family:var(--font-serif);font-size:40px;color:var(--accent-press);animation:breath 2.4s var(--ease-soft) infinite}
    .interp .line{font-family:var(--font-serif);font-size:23px;color:var(--ink-900);margin:0;position:relative}
    @media(max-width:760px){.interp .line{font-size:19px}}
    @keyframes breath{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
    @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .fade{animation:fade 420ms var(--ease-soft)}

    /* result */
    .summary{position:relative;border-radius:var(--radius-xl);overflow:hidden;background:linear-gradient(160deg,var(--surface-tint),var(--paper) 78%);border:1px solid var(--rose-100);padding:38px 40px;margin-bottom:8px}
    @media(max-width:760px){.summary{padding:26px 22px}}
    .summary .q{font-family:var(--font-serif);font-size:32px;font-weight:500;line-height:1.45;color:var(--ink-900);margin:0;word-break:normal;overflow-wrap:anywhere;text-wrap:auto}
    @media(max-width:760px){.summary .q{font-size:23px}}
    .res-block{margin-top:26px}
    .res-head{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
    .res-head h3{font-family:var(--font-serif);font-size:20px;font-weight:500;color:var(--ink-900)}
    .res-h3{font-family:var(--font-serif);font-size:20px;font-weight:500;color:var(--ink-900);margin:0 0 14px}
    .res-note-tag{margin:-6px 0 16px}
    .res-note{display:flex;align-items:flex-start;gap:6px;font-family:var(--font-serif);font-weight:300;font-size:14.5px;line-height:1.7;color:var(--text-secondary);margin:-6px 0 16px}
    .tpos-tag{position:absolute;top:8px;right:8px;z-index:1}
    .fact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
    @media(max-width:760px){.fact-grid{grid-template-columns:1fr 1fr}}
    .fact{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:16px 18px}
    .fact .l{font-family:var(--font-sans);font-size:11.5px;letter-spacing:.1em;color:var(--text-muted);margin-bottom:7px}
    .fact .v{font-family:var(--font-serif);font-size:21px;font-weight:500;color:var(--ink-900);line-height:1.3}
    .fact .s{font-family:var(--font-serif);font-weight:300;font-size:13px;color:var(--text-secondary);margin-top:4px}
    .profile-lower{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px;margin-top:14px}
    @media(max-width:760px){.profile-lower{grid-template-columns:1fr}}
    .mini-panel{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:16px 18px;display:flex;flex-direction:column}
    /* 完整命理檔案 ProfileCard */
    .pf-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .pf-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
    @media(max-width:760px){.pf-grid4,.pf-grid3{grid-template-columns:1fr 1fr}}
    .ftile{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:16px 18px}
    .ftile-l{font-family:var(--font-sans);font-size:11.5px;letter-spacing:.1em;color:var(--text-muted);margin-bottom:7px}
    .ftile-v{font-family:var(--font-serif);font-size:21px;font-weight:500;color:var(--ink-900);line-height:1.3}
    .ftile-s{font-family:var(--font-serif);font-weight:300;font-size:13px;color:var(--text-secondary);margin-top:4px}
    .pf-block{margin-top:14px}.pf-block.s{margin-top:10px}
    .pf-lbl{font-family:var(--font-sans);font-size:11.5px;letter-spacing:.1em;color:var(--text-muted);margin-bottom:8px}
    .bazi-grid,.nayin-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
    .bz-cell{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:12px 8px;text-align:center}
    .bz-pos{font-family:var(--font-sans);font-size:10.5px;color:var(--text-muted);margin-bottom:6px}
    .bz-ch{font-family:var(--font-serif);font-size:26px;font-weight:500;color:var(--ink-900);line-height:1.2}
    .bz-ch.b{color:var(--rose-600)}
    .bz-bar{width:1px;height:8px;background:var(--border-soft);margin:4px auto}
    .ny-cell{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-md);padding:10px 8px;text-align:center}
    .ny-pos{font-family:var(--font-sans);font-size:10.5px;color:var(--text-muted);margin-bottom:5px}
    .ny-val{font-family:var(--font-serif);font-size:14px;font-weight:500;color:var(--ink-900);line-height:1.4}
    .mmt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .mmt-card{position:relative;aspect-ratio:.62;border-radius:var(--radius-md);border:1px solid var(--rose-200);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px 8px;text-align:center;overflow:hidden}
    .mmt-tag{position:absolute;top:7px;right:7px;z-index:2}
    .mmt-disc{position:relative;display:inline-flex;width:52px;height:52px;border-radius:999px;background:var(--disc-frost-soft);border:1px solid var(--disc-frost-hair);align-items:center;justify-content:center;font-family:var(--font-serif);font-size:26px;line-height:1;margin-bottom:8px;flex-shrink:0}
    .mmt-name{position:relative;font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900)}
    .mmt-rule{position:relative;width:18px;height:1px;background:var(--rose-200);margin:5px auto}
    .mmt-line{position:relative;font-family:var(--font-serif);font-weight:300;font-size:12px;line-height:1.6;color:var(--text-secondary);padding:0 4px}
