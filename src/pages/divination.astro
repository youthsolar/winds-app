function parseKongmingText(text){
  if(!text)return null;var k={};var lines=text.split('\n');
  for(var i=0;i<lines.length;i++){var line=lines[i];
    if(line.indexOf('籤序：')===0)k.signOrder=line.substring(3);
    else if(line.indexOf('本卦：')===0){var m=line.substring(3).match(/^(.+?)（(.+?)·(.+?)）$/);if(m){k.curHex=m[1];k.palace=m[2];k.curEl=m[3];}else k.curHex=line.substring(3);}
    else if(line.indexOf('變爻：')===0)k.trigger=line.substring(3);
    else if(line.indexOf('變卦：')===0){var m2=line.substring(3).match(/^(.+?)（(.+?)）$/);if(m2){k.chgHex=m2[1];k.chgEl=m2[2];}else k.chgHex=line.substring(3);}
    else if(line.indexOf('籤等：')===0)k.fortuneLevel=line.substring(3);
    else if(line.indexOf('吉凶：')===0)k.fortuneCategory=line.substring(3);
    else if(line.indexOf('籤詩：')===0)k.poem=line.substring(3);
    else if(line.indexOf('解讀：')===0)k.interp=line.substring(3);
  }
  return k;
}
function parseOracle(type,text){
  if(!type||!text)return null;var lines=text.split('\n');var head=lines[0]||'';
  var poem=(lines.find(function(l){return l.indexOf('詩：')===0;})||'').replace('詩：','');
  var lvl='';var m=head.match(/（(.+?)）/);if(m)lvl=m[1];
  var no=head.replace(/（.+?）/,'').replace(type+' ','').trim();
  return {type:type,no:no,poem:poem,level:lvl};
}
