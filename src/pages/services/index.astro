---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';

type Service = {
  id: number;
  name: string;
  description: string | null;
  llm_description: string | null;
  price: number | null;
  duration_minutes: number | null;
  category: string | null;
  image_url: string | null;
  purchase_url: string | null;
  seo_title: string | null;
  source: string;
};

const svcs = services as Service[];

const sourceLabel = (src: string) => (src === 'simplybook' ? '預約諮詢' : '法器');

// glyph＝清理後品牌名第一個中文字（去【】等括號與非中文前綴）
const glyphOf = (name: string) => {
  const cleaned = name.replace(/[【】\[\]（）()]/g, '').trim();
  const m = cleaned.match(/[一-鿿]/);
  return m ? m[0] : cleaned.charAt(0) || '·';
};

const excerptOf = (s: Service) =>
  (s.llm_description || s.description?.replace(/<[^>]+>/g, '') || '').trim();

// featured：全部分頁時，優先用品牌主打（元辰宮代觀，與首頁一致），否則挑中高價預約諮詢
const sb = svcs.filter((s) => s.source === 'simplybook');
const sbPriced = sb.filter((s) => (s.price ?? 0) > 0);
const featured =
  sbPriced.find((s) => /元辰宮/.test(s.name)) ||
  sbPriced.find((s) => /知運勢/.test(s.name)) ||
  // 否則挑「中位偏上」的代表項目，避免拿最貴的稀有法事當門面
  [...sbPriced].sort((a, b) => (a.price ?? 0) - (b.price ?? 0))[Math.floor(sbPriced.length * 0.6)] ||
  sbPriced[0];

const sbCount = svcs.filter((s) => s.source === 'simplybook').length;
const esCount = svcs.filter((s) => s.source === 'easystore').length;

const pageTitle = '找風問幸福｜預約項目・通靈問事・元辰宮代觀・開光法器';
const pageDesc = `找風問幸福完整目錄：${sbCount} 項靈性諮詢（通靈水鏡法、元辰宮代觀、塔羅占卜等）＋ ${esCount} 項開光法器（符令、手環、供奉套組）。不確定怎麼選？先占卜，再決定。`;

const fmtPrice = (p: number | null) => (p && p > 0 ? `NT$${p.toLocaleString()}` : null);
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="website">
  <main class="svc-index">
    <nav class="breadcrumb" aria-label="麵包屑">
      <a href="/">首頁</a>
      <i class="ph ph-caret-right"></i>
      <span class="current">預約項目</span>
    </nav>

    <header class="zf-page-header">
      <span class="zf-ph-eyebrow">預約項目</span>
      <h1 class="zf-ph-title cjk-title">想為哪件事，找個人好好聊？</h1>
      <p class="zf-ph-lede">不確定怎麼選？先占卜，再決定。</p>
    </header>

    <nav class="chip-row" aria-label="項目分類">
      <button class="zf-chip selected" data-filter="all" aria-pressed="true">全部</button>
      <button class="zf-chip" data-filter="simplybook" aria-pressed="false">預約諮詢</button>
      <button class="zf-chip" data-filter="easystore" aria-pressed="false">法器選物</button>
    </nav>

    {featured && (
      <a
        class="featured zf-card tint interactive"
        href={`/services/${featured.id}/`}
        data-featured
      >
        <span class="ft-glyph">{glyphOf(featured.name)}</span>
        <div class="ft-body">
          <span class="zf-badge rose"><span class="zf-badge-dot"></span>{sourceLabel(featured.source)}</span>
          <h2 class="ft-name cjk-title">{featured.name}</h2>
          {excerptOf(featured) && <p class="ft-excerpt">{excerptOf(featured)}</p>}
        </div>
        <div class="ft-aside">
          {fmtPrice(featured.price) && <span class="ft-price">{fmtPrice(featured.price)}</span>}
          {featured.duration_minutes && (
            <span class="ft-dur">{featured.duration_minutes} 分鐘 · 一對一</span>
          )}
          <span class="zf-btn primary md">看介紹</span>
        </div>
      </a>
    )}

    <ul class="card-wall">
      {svcs.map((s) => (
        <li class="svc-cell" data-source={s.source}>
          <a class="svc-card zf-card interactive" href={`/services/${s.id}/`}>
            <div class="sc-top">
              <span class="sc-glyph">{glyphOf(s.name)}</span>
              <span class="zf-badge rose"><span class="zf-badge-dot"></span>{sourceLabel(s.source)}</span>
            </div>
            <h3 class="sc-name cjk-title">{s.name}</h3>
            {excerptOf(s) && <p class="sc-excerpt">{excerptOf(s)}</p>}
            <div class="sc-meta">
              {fmtPrice(s.price) && <span class="sc-price">{fmtPrice(s.price)}</span>}
              {s.source === 'simplybook' && s.duration_minutes && (
                <span class="sc-dur">{s.duration_minutes} 分鐘 · 一對一</span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty-note" data-empty hidden>這個分類目前沒有項目。</p>

    <section class="reading-cta">
      <p class="rc-line cjk-title">不確定適合哪個項目？先占卜看看</p>
      <a class="rc-btn" href="/">立即占卜</a>
    </section>
  </main>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip-row .zf-chip');
  const cells = document.querySelectorAll<HTMLElement>('.svc-cell');
  const featured = document.querySelector<HTMLElement>('[data-featured]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function applyFilter(filter: string) {
    let shown = 0;
    cells.forEach((cell) => {
      const match = filter === 'all' || cell.dataset.source === filter;
      cell.hidden = !match;
      if (match) shown++;
    });
    if (featured) featured.hidden = filter !== 'all';
    if (empty) empty.hidden = shown !== 0;
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        c.classList.remove('selected');
        c.setAttribute('aria-pressed', 'false');
      });
      chip.classList.add('selected');
      chip.setAttribute('aria-pressed', 'true');
      applyFilter(chip.dataset.filter || 'all');
    });
  });
</script>

<style>
  .svc-index { max-width: var(--container); margin: 0 auto; padding: 44px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .svc-index { padding: 28px 20px 48px; } }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* breadcrumb */
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
  @media (max-width: 760px) { .breadcrumb { margin-bottom: 18px; } }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-press); }
  .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }
  .breadcrumb .current { color: var(--ink-700); }

  /* chip filter row */
  .chip-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }
  @media (max-width: 760px) { .chip-row { margin-top: 24px; } }

  /* featured highlight card */
  .featured { display: grid; grid-template-columns: auto 1fr auto; gap: 26px; align-items: center; margin-top: 28px; text-decoration: none; color: inherit; }
  @media (max-width: 760px) { .featured { grid-template-columns: 1fr; gap: 18px; margin-top: 22px; } }
  .ft-glyph { flex: none; width: 76px; height: 76px; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--rose-200); border-radius: var(--radius-lg); font-family: var(--font-serif); font-size: 40px; line-height: 1; color: var(--accent-press); }
  @media (max-width: 760px) { .ft-glyph { width: 60px; height: 60px; font-size: 32px; } }
  .ft-body { min-width: 0; }
  .ft-name { font-family: var(--font-serif); font-size: 27px; font-weight: 500; line-height: 1.35; color: var(--ink-900); margin: 12px 0 0; }
  @media (max-width: 760px) { .ft-name { font-size: 22px; } }
  .featured:hover .ft-name { color: var(--accent-press); }
  .ft-excerpt { font-family: var(--font-serif); font-weight: 300; font-size: 15px; line-height: 1.8; color: var(--text-secondary); margin: 10px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ft-aside { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
  @media (max-width: 760px) { .ft-aside { align-items: flex-start; text-align: left; } }
  .ft-price { font-family: var(--font-serif); font-size: 28px; font-weight: 500; color: var(--ink-900); }
  @media (max-width: 760px) { .ft-price { font-size: 24px; } }
  .ft-dur { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); white-space: nowrap; }
  .ft-aside .zf-btn { margin-top: 6px; pointer-events: none; }

  /* service card wall */
  .card-wall { list-style: none; padding: 0; margin: 44px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  @media (max-width: 1024px) { .card-wall { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .card-wall { grid-template-columns: 1fr; gap: 16px; margin-top: 32px; } }
  .svc-cell[hidden] { display: none; }
  .svc-card { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .sc-top { display: flex; align-items: center; gap: 12px; }
  .sc-glyph { flex: none; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); font-family: var(--font-serif); font-size: 24px; line-height: 1; color: var(--accent-press); }
  .sc-name { font-family: var(--font-serif); font-size: 19px; font-weight: 500; line-height: 1.45; color: var(--ink-900); margin: 16px 0 0; }
  .svc-card:hover .sc-name { color: var(--accent-press); }
  .sc-excerpt { font-family: var(--font-serif); font-weight: 300; font-size: 14.5px; line-height: 1.8; color: var(--text-secondary); margin: 10px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sc-meta { margin-top: auto; padding-top: 16px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .sc-price { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--accent-press); }
  .sc-dur { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }

  .empty-note { font-family: var(--font-serif); font-size: 16px; color: var(--text-muted); text-align: center; margin: 40px 0; }

  /* reading CTA */
  .reading-cta { margin-top: 72px; padding: 38px 32px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  @media (max-width: 760px) { .reading-cta { margin-top: 48px; padding: 30px 22px; } }
  .rc-line { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); margin: 0 0 20px; }
  @media (max-width: 760px) { .rc-line { font-size: 19px; } }
  .rc-btn { display: inline-block; padding: 15px 30px; font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-on-accent); background: var(--accent); border-radius: var(--radius-pill); text-decoration: none; box-shadow: var(--shadow-sm); transition: background var(--dur-fast) var(--ease-soft); }
  .rc-btn:hover { background: var(--accent-hover); text-decoration: none; }
</style>
