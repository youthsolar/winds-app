---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';

type Service = {
  id: number;
  sb_service_id: string | null;
  es_product_id: string | null;
  name: string;
  description: string | null;
  duration_minutes: number | null;
  price: number | null;
  category: string | null;
  llm_description: string | null;
  seo_title: string | null;
  image_url: string | null;
  purchase_url: string | null;
  source: string;
};

export async function getStaticPaths() {
  const svcs = services as Service[];
  return svcs.map((s) => ({
    params: { id: String(s.id) },
    props: { service: s, allServices: svcs },
  }));
}

const { service, allServices } = Astro.props;
const s = service as Service;

const isSB = s.source === 'simplybook';
const sourceLabel = isSB ? '預約諮詢' : '法器';

const title = s.seo_title || s.name;
const desc = s.description?.replace(/<[^>]+>/g, '').slice(0, 160)
  || s.llm_description?.slice(0, 160)
  || s.name;

// Related: same source, exclude self, max 3
const related = (allServices as Service[])
  .filter((x) => x.id !== s.id && x.source === s.source)
  .slice(0, 3);

const priceTxt = s.price && s.price > 0 ? `NT$${s.price.toLocaleString()}` : null;
const durationTxt = s.duration_minutes ? `${s.duration_minutes} 分鐘` : null;

// 說明本文：description 去 HTML 標籤
const descBody = s.description?.replace(/<[^>]+>/g, '').trim() || '';
// intro：llm_description（無則退回 description 文字）
const intro = (s.llm_description || descBody).trim();

// glyph＝清理後品牌名第一個中文字
const glyphOf = (name: string) => {
  const cleaned = name.replace(/[【】\[\]（）()]/g, '').trim();
  const m = cleaned.match(/[一-鿿]/);
  return m ? m[0] : cleaned.charAt(0) || '·';
};

// 「這項諮詢包含」— 由 source 衍生品牌真實政策的最小列表
const includes = isSB
  ? ['一對一即時對談（線上或實體）', '老師親自為你解讀與建議', '可預約你方便的時段']
  : ['開光法器，老師親手處理', '超商店到店 · 7 天內出貨', '台灣限定寄送'];

const excerptOf = (x: Service) =>
  (x.llm_description || x.description?.replace(/<[^>]+>/g, '') || '').trim();

// 主要 CTA 路由：ES → purchase_url（買法器，新分頁）；SB → /booking
const primaryHref = isSB ? '/booking' : (s.purchase_url || '/booking');
const primaryLabel = isSB ? '預約這位老師' : '前往購買';
const reassurance = isSB ? '預約與付款將前往安全頁完成' : '超商店到店 · 7 天內 · 台灣限定';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": s.name,
  "description": s.llm_description || s.description || '',
  "provider": {
    "@type": "Organization",
    "name": "找風問幸福",
    "url": "https://app.winds.tw"
  },
  ...(s.price && s.price > 0 && {
    "offers": {
      "@type": "Offer",
      "price": s.price,
      "priceCurrency": "TWD",
      ...(!isSB && s.purchase_url && { "url": s.purchase_url })
    }
  })
};
---

<BaseLayout
  title={title}
  description={desc}
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="svc-detail">
    <nav class="breadcrumb" aria-label="麵包屑">
      <a href="/">首頁</a>
      <i class="ph ph-caret-right"></i>
      <a href="/services/">{sourceLabel}</a>
      <i class="ph ph-caret-right"></i>
      <span class="current cjk-title">{s.name}</span>
    </nav>

    <div class="layout">
      <article class="main">
        <header class="dt-head">
          <h1 class="cjk-title">{s.name}</h1>
          {intro && <p class="dt-intro">{intro}</p>}
          <div class="dt-meta">
            {priceTxt && <span class="dt-price">{priceTxt}</span>}
            {durationTxt && <><span class="dot">·</span><span>{durationTxt}</span></>}
            <span class="dot">·</span>
            <span class="zf-badge rose"><span class="zf-badge-dot"></span>{sourceLabel}</span>
          </div>
        </header>

        {descBody && (
          <section class="dt-section">
            <h2>項目說明</h2>
            <p class="dt-body">{descBody}</p>
          </section>
        )}

        <section class="dt-section">
          <h2>{isSB ? '這項諮詢包含' : '這項服務包含'}</h2>
          <ul class="includes">
            {includes.map((it) => (
              <li><i class="ph-fill ph-check-circle"></i><span>{it}</span></li>
            ))}
          </ul>
        </section>

        {related.length > 0 && (
          <section class="dt-section">
            <h2>相關項目</h2>
            <div class="related-list">
              {related.map((r) => (
                <a class="zf-card interactive related-item" href={`/services/${r.id}/`}>
                  <span class="ri-glyph">{glyphOf(r.name)}</span>
                  <span class="ri-text">
                    <span class="ri-title cjk-title">{r.name}</span>
                    {excerptOf(r) && <span class="ri-desc">{excerptOf(r)}</span>}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="aside">
        <div class="book-card zf-card">
          <span class="bc-label">{isSB ? '預約這個項目' : '請這件法器'}</span>
          {priceTxt && (
            <div class="bc-price-row">
              <span class="bc-price">{priceTxt}</span>
              {isSB && durationTxt && <span class="bc-dur">/ {s.duration_minutes} 分鐘</span>}
            </div>
          )}
          {isSB ? (
            <a class="zf-btn primary lg full" href={primaryHref}>{primaryLabel}</a>
          ) : (
            <a class="zf-btn primary lg full" href={primaryHref} target="_blank" rel="noopener">{primaryLabel}</a>
          )}
          <p class="bc-note">{reassurance}</p>
        </div>

        <section class="reading-cta">
          <p class="rc-line cjk-title">不確定適合哪個項目？</p>
          <a class="rc-btn" href="/">立即占卜</a>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .svc-detail { max-width: var(--container); margin: 0 auto; padding: 44px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .svc-detail { padding: 28px 20px 48px; } }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* breadcrumb */
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 28px; }
  @media (max-width: 760px) { .breadcrumb { margin-bottom: 20px; } }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-press); }
  .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }
  .breadcrumb .current { color: var(--ink-700); }

  /* 2-col layout */
  .layout { display: grid; grid-template-columns: 1fr 360px; gap: 44px; align-items: start; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; gap: 28px; } }

  /* main header */
  .dt-head { padding-bottom: 26px; border-bottom: 1px solid var(--border-soft); }
  .dt-head h1 { font-family: var(--font-serif); font-size: 38px; font-weight: 500; line-height: 1.3; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .dt-head h1 { font-size: 28px; } }
  .dt-intro { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.9; color: var(--ink-700); margin: 18px 0 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  @media (max-width: 760px) { .dt-intro { font-size: 16px; } }
  .dt-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 20px; font-family: var(--font-sans); font-size: 14px; color: var(--text-secondary); }
  .dt-meta .dot { color: var(--rose-200); }
  .dt-price { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); }

  /* sections */
  .dt-section { margin-top: 40px; }
  @media (max-width: 760px) { .dt-section { margin-top: 32px; } }
  .dt-section h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--ink-900); margin: 0 0 16px; }
  @media (max-width: 760px) { .dt-section h2 { font-size: 21px; } }
  .dt-body { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.95; color: var(--ink-700); margin: 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  @media (max-width: 760px) { .dt-body { font-size: 16px; } }

  /* includes list */
  .includes { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .includes li { display: flex; align-items: flex-start; gap: 11px; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.7; color: var(--ink-700); }
  @media (max-width: 760px) { .includes li { font-size: 15.5px; } }
  .includes .ph-fill { flex: none; font-size: 20px; color: var(--sage-400); margin-top: 2px; }

  /* related */
  .related-list { display: flex; flex-direction: column; gap: 12px; }
  .related-item { display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit; padding: 16px 18px; }
  .ri-glyph { flex: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); font-family: var(--font-serif); font-size: 21px; line-height: 1; color: var(--accent-press); }
  .ri-text { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .ri-title { font-family: var(--font-serif); font-size: 16.5px; font-weight: 500; color: var(--ink-900); }
  .related-item:hover .ri-title { color: var(--accent-press); }
  .ri-desc { font-family: var(--font-serif); font-weight: 300; font-size: 13.5px; line-height: 1.7; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* aside */
  .aside { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 900px) { .aside { position: static; } }
  .book-card { box-shadow: var(--shadow-md); display: flex; flex-direction: column; }
  .bc-label { font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; letter-spacing: 0.02em; color: var(--text-muted); }
  .bc-price-row { display: flex; align-items: baseline; gap: 8px; margin: 12px 0 20px; }
  .bc-price { font-family: var(--font-serif); font-size: 28px; font-weight: 500; color: var(--ink-900); }
  .bc-dur { font-family: var(--font-sans); font-size: 14px; color: var(--text-muted); }
  .bc-note { font-family: var(--font-sans); font-size: 12.5px; line-height: 1.6; color: var(--text-muted); margin: 14px 0 0; text-align: center; }

  /* reading CTA (compact) */
  .reading-cta { padding: 28px 24px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  .rc-line { font-family: var(--font-serif); font-size: 18px; font-weight: 500; color: var(--ink-900); margin: 0 0 16px; }
  .rc-btn { display: inline-block; padding: 13px 28px; font-family: var(--font-serif); font-size: 16px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-on-accent); background: var(--accent); border-radius: var(--radius-pill); text-decoration: none; box-shadow: var(--shadow-sm); transition: background var(--dur-fast) var(--ease-soft); }
  .rc-btn:hover { background: var(--accent-hover); text-decoration: none; }
</style>
