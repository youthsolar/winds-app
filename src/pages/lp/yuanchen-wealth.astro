// 元辰運財與防破符令的舊單品頁：2026-10-22 商城文案 商 21（Jeffery 拍板）收掉，內容與 /shop/9920676/ 重複。
// 付款回來（?paid=）照舊先去訂單狀態頁；其餘一律轉到商城那件商品頁。
export const prerender = false;
const paidNo = Astro.url.searchParams.get('paid');
