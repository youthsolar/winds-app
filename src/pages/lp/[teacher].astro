         2026-10-01（廣告前全站掃描）：9/28 起後端有只回狀態的 /booking-order/:單號 → 照搬 LIFF 預約頁（liff/booking.html checkPaid）
         的查詢與畫面：查實際狀態再決定怎麼說，待付款自動再查 6 次，每次 10 秒逾時，只認最新一次回應；
         「重新預約」回這頁的預約區、「LINE」附官方帳號連結。後端 /pay-booking 還是寫死回 LIFF 時，這段只有手動帶 ?paid= 才會進來。 */
      var PAID_SEQ = 0, WK = '日一二三四五六';
      function paidView(icon, title, msg, extra) {
        card.innerHTML = '<div class="bw-body"><div class="bw-done"><i class="ph ph-' + icon + '" style="font-size:36px;color:var(--rose-600)"></i>' +
          '<p style="font-size:20px;margin:10px 0 8px">' + esc(title) + '</p>' +
          '<p class="bw-note" style="max-width:26em;margin:0 auto">' + esc(msg) + '</p>' +
          (extra ? '<div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:16px">' + extra + '</div>' : '') +
          '<p class="bw-note" style="margin-top:16px">有任何問題，隨時來 <a class="zf-text-link" href="https://lin.ee/tQHsgWB" target="_blank" rel="noopener">LINE</a> 找我們就好。</p></div></div>';
      }
      function fmtStart(v) {
        var d = new Date(String(v || '').slice(0, 10) + 'T00:00:00');
        if (isNaN(d.getTime())) return '';
        return (d.getMonth() + 1) + '/' + d.getDate() + '（週' + WK.charAt(d.getDay()) + '）' + String(v).slice(11, 16);
      }
      function checkPaid(tradeNo, n) {
        var again = '<a class="zf-btn primary md" href="' + location.pathname + '#book">重新預約</a>';
        var retry = '<button class="zf-btn ghost md" type="button" data-recheck>重新查詢</button>';
        function view(icon, title, msg, extra) { paidView(icon, title, msg, extra); on('[data-recheck]', function () { checkPaid(tradeNo, 0); }); }
        if (!/^BK[A-Za-z0-9]+$/.test(tradeNo)) { view('question', '找不到這筆預約', '連結可能不完整。如果你已經付款，請直接來 LINE 找我們，我們幫你查。'); return; }
        var my = ++PAID_SEQ;
        var ac = window.AbortController ? new AbortController() : null, to = setTimeout(function () { if (ac) ac.abort(); }, 10000);
        fetch(API + '/booking-order/' + encodeURIComponent(tradeNo), ac ? { signal: ac.signal } : undefined)
          .then(function (r) { if (r.status === 404) return { notFound: true }; if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
          .then(function (d) {
            clearTimeout(to);
            if (my !== PAID_SEQ) return;
            if (d && d.notFound) { view('question', '找不到這筆預約', '連結可能不完整。如果你已經付款，請直接來 LINE 找我們，我們幫你查。'); return; }
            if (!d || !d.ok) throw new Error('bad');
            var what = [d.provider ? d.provider + ' 老師' : '', d.service || '', fmtStart(d.start)].filter(Boolean).join(' · ');
            if (d.status === 'Paid') { view('check-circle', '預約完成 🙏', '我們已收到你的訂金' + (what ? '：' + what : '') + '。預約確認信會寄到你的 email，到時候見。'); return; }
            if (d.status === 'PaidSbFailed') { view('check-circle', '已收到你的訂金 🙏', '我們正在為你安排時段' + (what ? '（' + what + '）' : '') + '，確認後會通知你。'); return; }
            if (d.status === 'Failed') { view('x-circle', '這次付款沒有完成', '沒有扣款成功。可以回預約頁重新選一次時段。', again); return; }
            // 保留失效不代表付款一定失效：付款結果可能晚到（同 LIFF 第二輪複核）
            if (d.status === 'Expired') { view('clock', '這筆預約的保留時間已過', '如果你剛才已經付過款，請先不要重新預約，稍等幾分鐘再查一次，或直接來 LINE 找我們；還沒付款的話，回預約頁重新挑一個時間就好。', retry + again); return; }
            if (n < 6) { view('clock', '正在確認付款結果…', '付款結果有時會晚一點送到，我們再確認一次。'); setTimeout(function () { if (my === PAID_SEQ) checkPaid(tradeNo, n + 1); }, 5000); return; }
            view('clock', '還沒收到付款結果', '如果你已經付款，稍等幾分鐘再重新查詢；請先不要重複付款。', retry);
          })
          .catch(function () { clearTimeout(to); if (my !== PAID_SEQ) return; view('warning', '暫時查不到付款結果', '這不代表付款沒成功，請先不要重複付款。稍等一下再查一次。', retry); });
      }

      // DS：預約區進入畫面時收起手機底部列與風小編浮動鈕，不蓋表單
      (function () {
        var bk = document.getElementById('book'), bar = document.getElementById('lpBar');
        if (!bk || !window.IntersectionObserver) return;
        new IntersectionObserver(function (es) { var inV = es[0].isIntersecting; if (bar) bar.classList.toggle('hide', inV); document.body.classList.toggle('lp-book-in', inV); }, { rootMargin: '0px 0px -20% 0px' }).observe(bk);
      })();

      var paidNo = new URLSearchParams(location.search).get('paid');
      if (paidNo) {
        paidView('clock', '正在確認付款結果…', '稍等一下，我們正在確認這筆預約。');
        checkPaid(paidNo, 0);
        setTimeout(function () { var bk = document.getElementById('book'); if (bk) bk.scrollIntoView({ block: 'start' }); }, 0);   // 結果在頁尾預約區，回來時直接捲過去
      } else {
        stepLocation();
      }
    })();
  </script>
</BaseLayout>
