---
// 一頁式預約頁（2026-09-03 風易揚老師起；2026-10-06 改成六位老師共用，各老師文案在 src/data/lp-teachers.ts）
// 一頁講完一位老師：是誰、怎麼看事情、有哪些項目、怎麼進行 → 頁尾直接選時段付訂金，不跳頁。
// 資料全部是真的：老師檔案/項目/價格/訂金 build 時抓 /sb-providers；時段 client 抓 /sb-slots；
// 送單走現有 /sb-book（伺服器端重算金額 → 綠界正式商店收訂金）。
// ⚠️ 文案（各段標題、FAQ）是佔位，等 Jeffery 改；老師檔案文字取 SB 現有欄位。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LP_TEACHERS } from '../../data/lp-teachers';

const API = 'https://api.winds.tw';
const slug = String(Astro.params.teacher || '');
const cfg = LP_TEACHERS[slug];
if (!cfg) return new Response(null, { status: 404 });
const PROVIDER_ID = cfg.providerId;
let prov: any = null;
let locations: any[] = [];
/* 2026-09-27：原本 catch 掉就發一個「老師資料載入失敗」的空殼頁上線，預約與付款入口整條失效，
   而且 API 恢復也不會自己好。改成讓 build 失敗。 */
// 2026-09-28（gpt-6-astra 體檢）：原本 build 時抓＝調價後頁面還是舊價（後端照現價收）、API 一抖就發殘缺頁且不會自己好。
// 改成每次請求即時讀＋瀏覽器快取 5 分鐘（Workers 回應不經邊緣快取，實測無 cf-cache-status）；讀不到回 503 讓人重整。
export const prerender = false;
let provResp: Response | null = null;
try { provResp = await fetch(API + '/sb-providers'); } catch { provResp = null; }
if (!provResp || !provResp.ok) return new Response('暫時讀不到資料，請稍後重新整理。', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store', 'Retry-After': '30' } });
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
{
  const d = await provResp.json();
  prov = (d.providers || []).find((p: any) => String(p.id) === PROVIDER_ID) || null;
  locations = (d.locations || []).filter((l: any) => (prov?.locations || []).includes(String(l.id)));
}
if (!prov) return new Response('暫時讀不到資料，請稍後重新整理。', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store', 'Retry-After': '30' } });

const services: any[] = (prov?.services || []).filter((s: any) => Number(s.price) > 0);

const LP_LEDE = cfg.lede, LP_SKILLS = cfg.skills, LP_SKILL_MAIN = cfg.skillMain, LP_FEATURED_DESC = cfg.featuredDesc;
const ntd = (n: number) => 'NT$ ' + Number(n).toLocaleString('en-US');
const clean = (n: string) => String(n || '').replace(/^【/, '').replace(/】$/, '');

// 33 項太多，一頁式要能一眼看懂 → 依名稱分六組（只影響顯示，不影響預約）
const GROUPS: { key: string; name: string; re: RegExp }[] = [
  { key: 'ask',   name: '問事與查看',   re: /水鏡|代觀|籤詩|阿卡西|塔羅|問事/ },
  { key: 'fix',   name: '元辰宮修補',   re: /修補|安太歲/ },
  { key: 'money', name: '財運',         re: /財|彩虹橋|天官/ },
  { key: 'love',  name: '感情與人緣',   re: /桃花|五合|閨輪|斬偏|祈孕|關心術|人緣/ },
  { key: 'clear', name: '渡化與解煞',   re: /嬰靈|冤親|祖靈|小人|中煞|陰纏|驅魔|靈療|轉靈/ },
  { key: 'other', name: '命名與風水',   re: /./ },
];
const grouped = GROUPS.map((g) => ({ ...g, items: [] as any[] }));
for (const s of services) {
  const g = grouped.find((g) => g.re.test(s.name)) || grouped[grouped.length - 1];
  g.items.push(s);
}
const FEATURED_IDS = ['4', '6', '136'];
// 2026-10-06 DS 稿（lp-fengyiyang）：主打卡最多 3 張（指定的先、不夠從其餘補）；超過 3 項才把其餘列進「全部項目」，3 項以內不重複列
const featured = [...FEATURED_IDS.map((id) => services.find((s) => String(s.id) === id)).filter(Boolean), ...services.filter((s) => !FEATURED_IDS.includes(String(s.id)))].slice(0, 3);
const rest = services.filter((s) => !featured.includes(s));
const restGroups = grouped.map((g) => ({ ...g, items: g.items.filter((s: any) => rest.includes(s)) })).filter((g) => g.items.length);
const minPrice = services.length ? Math.min(...services.map((s) => Number(s.price))) : 0;

const canonical = `https://winds.tw/lp/${slug}/`;
const title = cfg.title;
// 見面方式依老師實際有的地點講（只有台北實體的老師不提遠端）
const hasPhysical = locations.some((l: any) => l.type !== 'online'), hasOnline = locations.some((l: any) => l.type === 'online');
const eyebrowWhere = hasPhysical && hasOnline ? '台北大安 或 遠端視訊' : hasOnline ? '遠端視訊' : '台北大安';
const balanceNote = hasPhysical && hasOnline ? '餘額實體當天現場結清；遠端依老師指示結清。' : hasOnline ? '餘額依老師指示結清。' : '餘額當天現場結清。';
const faqBalance = hasPhysical && hasOnline ? '餘額實體當天現場結清，遠端依老師指示結清。' : balanceNote;   // 風易揚原文 FAQ 用逗號，照舊
const description = (LP_LEDE.join('') + eyebrowWhere.replace(/ /g, '') + '一對一，線上付訂金保留時段。').slice(0, 155);
const jsonLd = prov ? [
  {
    '@context': 'https://schema.org', '@type': 'Person', name: prov.name, url: canonical,
    image: prov.photo, description: prov.blurb, jobTitle: '靈性諮詢老師',
    worksFor: { '@type': 'Organization', name: '找風問幸福', url: 'https://winds.tw' },
    knowsAbout: prov.skills || [],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: prov.name + ' 預約項目',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Service', name: clean(s.name), description: s.desc || undefined, url: canonical + '#items',
        provider: { '@type': 'Person', name: prov.name },
        offers: { '@type': 'Offer', price: s.price, priceCurrency: 'TWD', availability: 'https://schema.org/InStock' } },
    })),
  },
] : undefined;
---

<BaseLayout title={title} description={description} ogImage={prov?.photo || '/og-default.jpg'} jsonLd={jsonLd} noindex={true}>
  <div class="lp">
    {!prov ? (
      <p class="lp-empty">老師資料載入失敗，請稍後再試。</p>
    ) : (
      <>
        <!-- ① 是誰（2026-10-06 照 DS lp-teacher.jsx：容器 1120、hero 7fr／5fr；手機名字右邊 88px 頭像，首屏先看到名字與預約鈕） -->
        <section class="lp-hero">
          <div class="lp-hero-glow"></div>
          <div class="lp-wrap lp-hero-grid">
            <div class="lp-hero-text">
              <span class="lp-eyebrow">一對一預約 · {eyebrowWhere}</span>
              <div class="lp-name-row">
                <div class="lp-name">
                  <h1 class="lp-h1">{prov.name}</h1>
                  <p class="lp-style">{prov.style}</p>
                </div>
                <img class="lp-avatar" src={prov.photo} alt="" width="88" height="110" loading="eager" />
              </div>
              <p class="lp-q">{LP_LEDE[0]}</p>
              <p class="lp-lede">{LP_LEDE.slice(1).join('')}</p>
              <div class="lp-chips">{LP_SKILLS.map((k: string) => <span class="zf-tag rose">{k}</span>)}</div>
              <div class="lp-cta">
                <a class="zf-btn primary lg" href="#book">預約老師<i class="ph ph-arrow-down"></i></a>
                <a class="zf-btn secondary lg" href="#items">看項目與價格</a>
              </div>
              <!-- 2026-10-01（廣告前全站掃描）：金額「NT$ 3,040」在手機上被折成「NT$ 3,⏎040」→ 金額整段包 nowrap＋不給斷行程式處理 -->
              <p class="lp-meta">線上付訂金即保留時段 · 項目 <span data-nocjk style="white-space:nowrap">{ntd(minPrice)}</span> 起 · 共 {services.length} 個項目</p>
            </div>
            <figure class="lp-hero-photo">
              <img src={prov.photo} alt={prov.name} width="400" height="500" loading="eager" />
            </figure>
          </div>
        </section>

        <!-- ② 怎麼看事情 -->
        <section class="lp-block"><div class="lp-wrap lp-two">
          <div>
            <div class="lp-head">
              <span class="lp-eyebrow">老師怎麼看事情</span>
              <h2 class="lp-h2">{prov.desc.split('：')[0]}</h2>
            </div>
            <p class="lp-p">{prov.desc}</p>
          </div>
          <div class="lp-tintcard">
            <p class="lp-skillmain">{LP_SKILL_MAIN}</p>
            <div class="lp-chips">{String(prov.style || '').split(/\s*[・·]\s*/).filter(Boolean).map((t: string) => <span class="zf-tag rose">{t}</span>)}</div>
          </div>
        </div></section>

        <!-- ③ 項目與價格：1 項橫式寬卡、2 項兩欄、3 項三欄；超過 3 項其餘進「全部項目」 -->
        <section id="items" class="lp-block"><div class="lp-wrap">
          <div class="lp-head">
            <span class="lp-eyebrow">項目與價格</span>
            <h2 class="lp-h2">{featured.length === 1 ? '從這一項開始' : '先從這幾項開始'}</h2>   {/* 10/07 Jeffery 選項卡：只有 1 個項目的老師換字 */}
            <p class="lp-lede-s">{featured.length === 1 ? '第一次找老師，可以直接選這一項。' : '第一次找老師，不知道該選哪一項，可以先從下面幾項看起。'}價格是項目全額，線上先付四成訂金，時段就會保留下來。</p>
          </div>
          <div class={'lp-featured n' + featured.length}>
            {featured.map((s: any) => (
              <article class="zf-card lp-fcard">
                <div class="lp-fcard-main">
                  <div class="lp-fcard-top">
                    <span class="zf-tag rose">{s.duration} 分鐘</span>
                    <span class="lp-fcard-price" data-nocjk>{ntd(s.price)}</span>
                  </div>
                  <h3>{clean(s.name)}</h3>
                  {(LP_FEATURED_DESC[String(s.id)] || [s.desc]).map((t) => <p>{t}</p>)}
                </div>
                <div class="lp-fcard-act">
                  <button class="zf-btn primary md" type="button" data-pick={s.id}>預約這項<i class="ph ph-arrow-right"></i></button>
                  <span class="lp-fcard-dep">訂金 <span data-nocjk style="white-space:nowrap">{ntd(s.deposit)}</span></span>
                </div>
              </article>
            ))}
          </div>
          {restGroups.length > 0 && (
            <>
              <h3 class="lp-sub">全部項目</h3>
              <div class="lp-groups">
                {restGroups.map((g, gi) => (
                  <details class="lp-group" open={gi === 0}>
                    <summary><span>{g.name}</span><span class="lp-group-n">{g.items.length} 項</span><i class="ph ph-caret-down"></i></summary>
                    <ul>
                      {g.items.map((s: any) => (
                        <li>
                          <div class="lp-row-main">
                            <span class="lp-row-name">{clean(s.name)}</span>
                            <span class="lp-row-meta">{s.duration} 分鐘 · 訂金 <span data-nocjk style="white-space:nowrap">{ntd(s.deposit)}</span></span>
                          </div>
                          <span class="lp-row-price" data-nocjk>{ntd(s.price)}</span>
                          <button class="zf-btn secondary sm" type="button" data-pick={s.id}>預約</button>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </>
          )}
        </div></section>

        <!-- ④ 怎麼進行：三卡等高；地址移出第 1 張卡，改成卡下一條地點列（DS） -->
        <section class="lp-block"><div class="lp-wrap">
          <div class="lp-head">
            <span class="lp-eyebrow">怎麼進行</span>
            <h2 class="lp-h2">想找老師，就從這裡選時間</h2>
          </div>
          <ol class="lp-steps">
            {hasPhysical && hasOnline ? (
              <li><div class="lp-step-t"><span class="lp-step-n">1</span><b>選實體或遠端</b></div><p>台北可以到大安區現場；不方便過來，也可以選遠端視訊。</p></li>
            ) : hasOnline ? (
              <li><div class="lp-step-t"><span class="lp-step-n">1</span><b>遠端視訊</b></div><p>用手機或電腦連線，不用出門。</p></li>
            ) : (
              <li><div class="lp-step-t"><span class="lp-step-n">1</span><b>到台北大安區現場</b></div><p>老師在台北大安區見面，捷運忠孝復興站附近。</p></li>
            )}
            <li><div class="lp-step-t"><span class="lp-step-n">2</span><b>選項目和時間</b></div><p>頁面會顯示老師未來四週可以預約的時間，挑一個你方便的就好。</p></li>
            <li><div class="lp-step-t"><span class="lp-step-n">3</span><b>付四成訂金</b></div><p>線上付四成訂金後，時段就會保留下來。{balanceNote}</p></li>
          </ol>
          <div class="lp-locs">
            {locations.map((l: any) => <span><i class={'ph ph-' + (l.type === 'online' ? 'video-camera' : 'map-pin')}></i>{(l.type === 'online' ? '遠端視訊：' : '台北實體：') + l.note}</span>)}
          </div>
        </div></section>

        <!-- ⑤ 預約（就在這頁）-->
        <section id="book" class="lp-block"><div class="lp-wrap">
          <div class="lp-head">
            <span class="lp-eyebrow">預約</span>
            <h2 class="lp-h2">就在這裡，不用跳頁</h2>
          </div>
          <div class="zf-card lp-book" id="bkCard"><div class="bw-loading"><span class="zf-spinner" style="width:18px;height:18px"></span></div></div>
        </div></section>

        <!-- ⑥ 常見問題 -->
        <section class="lp-block lp-faq"><div class="lp-wrap">
          <div class="lp-head">
            <span class="lp-eyebrow">常見問題</span>
            <h2 class="lp-h2">來之前想知道的</h2>
          </div>
          <div class="lp-faq-list">
            <details><summary>訂金是多少？餘額什麼時候付？<i class="ph ph-plus lp-pl"></i><i class="ph ph-minus lp-mi"></i></summary><p>訂金為項目全額的四成，線上付款後時段即保留。{faqBalance}</p></details>
            {hasOnline && (<details><summary>遠端視訊怎麼進行？<i class="ph ph-plus lp-pl"></i><i class="ph ph-minus lp-mi"></i></summary><p>預約完成後，連線方式會在對談前提供，時間到用手機或電腦點進去即可，不用另外安裝軟體。</p></details>)}
            <!-- 2026-10-01（廣告前全站掃描）：遠端那題原本寫「自動開啟會議室連結」，實際沒有程式會產生；照確認信的說法 -->
            <details><summary>為什麼 Email 只收 Gmail？<i class="ph ph-plus lp-pl"></i><i class="ph ph-minus lp-mi"></i></summary><p>預約確認信與會議連結都靠信箱送達，Gmail 送達率最穩定，避免你收不到通知。</p></details>
            <details><summary>要準備什麼？<i class="ph ph-plus lp-pl"></i><i class="ph ph-minus lp-mi"></i></summary><p>本人姓名、西元生日；如果知道出生時辰，也一起準備。</p><p>另外，把你最想問的一兩件事先放在心裡，來了直接跟老師說就好。</p></details>
          </div>
        </div></section>

        <!-- 浮動預約（DS）：手機底部霧面列；預約區進入畫面就收起，不蓋表單。手機風小編在原位置（右下），列的右側讓出空間。 -->
        <div class="lp-bar" id="lpBar"><span>項目 <span data-nocjk style="white-space:nowrap">{ntd(minPrice)}</span> 起</span><a class="zf-btn primary md" href="#book">預約老師</a></div>
      </>
    )}
  </div>

  <script type="application/json" id="lpData" set:html={JSON.stringify({ prov, locations, slug })} />

  <style>
    /* 2026-10-06 照 DS 稿 contribution-to-ds/ui_kits/booking/lp-teacher.jsx 逐值改（交辦 lp-fengyiyang/BRIEF-lp-fengyiyang-2026-10-06.md）：
       容器＝Nav 的 1120（左右 32／手機 20）；區塊上下各 48（手機 32）→ 相鄰區塊 96／64；eyebrow→h2 8、h2→lede 12、標題組→內容 32／24。 */
    .lp-wrap { max-width: var(--container); margin: 0 auto; padding: 0 32px; box-sizing: border-box; }
    .lp-block { padding: 48px 0; }
    #book, #items { scroll-margin-top: 88px; }
    .lp-empty { text-align: center; padding: 80px 20px; font-family: var(--font-serif); color: var(--text-muted); }
    .lp-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 12.5px; letter-spacing: .02em; color: var(--accent-press); }
    .lp-eyebrow::before { content: ''; width: 5px; height: 5px; border-radius: 999px; background: var(--accent-press); }
    .lp-head { display: flex; flex-direction: column; margin-bottom: 32px; }
    .lp-h2 { margin: 8px 0 0; font-family: var(--font-serif); font-size: 32px; font-weight: 500; line-height: 1.3; color: var(--text-primary); }
    .lp-lede-s, .lp-p { margin: 12px 0 0; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.85; color: var(--text-secondary); max-width: none; }
    .lp-p { margin: 0; }

    /* hero */
    .lp-hero { position: relative; overflow: hidden; padding: 80px 0 48px; }
    .lp-hero-glow { position: absolute; right: -10%; top: -20%; width: 60%; height: 90%; pointer-events: none; background: radial-gradient(closest-side, var(--rose-100), transparent); opacity: .6; }
    .lp-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: center; }
    .lp-hero-text { display: flex; flex-direction: column; }
    .lp-name-row { display: flex; align-items: center; gap: 16px; margin-top: 12px; }
    .lp-name { flex: 1; min-width: 0; }
    .lp-h1 { margin: 0; font-family: var(--font-serif); font-size: 48px; font-weight: 500; line-height: 1.2; letter-spacing: .02em; color: var(--text-primary); }
    .lp-style { margin: 8px 0 0; font-family: var(--font-sans); font-size: 14px; letter-spacing: .04em; color: var(--accent-press); }
    .lp-avatar { display: none; }
    .lp-q { margin: 24px 0 0; font-family: var(--font-serif); font-size: 21px; font-weight: 400; line-height: 1.6; color: var(--text-primary); }
    .lp-lede { margin: 12px 0 0; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.85; color: var(--text-secondary); max-width: none; }
    .lp-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
    .lp-cta { display: flex; gap: 12px; margin-top: 32px; }
    .lp-meta { margin: 12px 0 0; font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); font-variant-numeric: tabular-nums; }
    .lp-hero-photo { margin: 0; justify-self: end; width: 100%; max-width: 400px; }
    .lp-hero-photo img, .lp-avatar { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-xl); box-shadow: var(--shadow-md); background: var(--rose-100); }

    /* 怎麼看事情 */
    .lp-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; }
    .lp-tintcard { margin-top: 36px; padding: 24px 28px; background: var(--surface-tint); border: 1px solid var(--rose-100); border-radius: var(--radius-lg); }
    .lp-skillmain { margin: 0; font-family: var(--font-serif); font-size: 16px; line-height: 1.8; color: var(--text-primary); max-width: none; }

    /* 項目 */
    .lp-featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
    .lp-featured.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lp-featured.n1 { grid-template-columns: 1fr; }
    .lp-fcard { padding: 24px; display: flex; flex-direction: column; gap: 16px; box-sizing: border-box; height: 100%; }
    .lp-featured.n1 .lp-fcard { flex-direction: row; gap: 32px; }
    .lp-fcard-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
