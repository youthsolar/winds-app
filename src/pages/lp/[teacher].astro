  <script is:inline>
    (function () {
      var D = JSON.parse(document.getElementById('lpData').textContent || '{}');
      var prov = D.prov, LOCS = D.locations || [];
      var card = document.getElementById('bkCard');
      if (!prov || !card) return;
      var API = 'https://api.winds.tw';
      var GMAIL = /^[^\s@]+@gmail\.com$/i;
      var GROUPS = [
        ['問事與查看', /水鏡|代觀|籤詩|阿卡西|塔羅|問事/], ['元辰宮修補', /修補|安太歲/], ['財運', /財|彩虹橋|天官/],
        ['感情與人緣', /桃花|五合|閨輪|斬偏|祈孕|關心術|人緣/], ['渡化與解煞', /嬰靈|冤親|祖靈|小人|中煞|陰纏|驅魔|靈療|轉靈/], ['命名與風水', /./]
      ];
      var svcs = (prov.services || []).filter(function (s) { return Number(s.price) > 0; });
      var W = { step: 1 };
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function clean(n) { return String(n || '').replace(/^【/, '').replace(/】$/, ''); }
      function ntd(n) { return 'NT$ ' + (Number(n) || 0).toLocaleString('en-US'); }
      function shell(step, title, inner, footer) {
        W.step = step;   // 記住目前在第幾步：時段請求回來時不在「選時間」就丟掉（gpt-6-astra 複核）
        // 2026-10-06 照 DS lp-wizard.jsx：5 段進度＋右側「N / 5」；底部列上一步＝安靜文字鈕、下一步＝主鈕
        var dots = ''; for (var i = 1; i <= 5; i++) dots += '<i class="bw-dot' + (i <= step ? ' on' : '') + '"></i>';
        var sub = [W.loc && W.loc.name, W.svc && clean(W.svc.name), W.date && W.time && (W.date + ' ' + W.time)].filter(Boolean).join(' · ');
        card.innerHTML = '<div class="bw-prog-wrap"><div class="bw-prog">' + dots + '</div><span class="bw-prog-n">' + step + ' / 5</span></div>' +
          '<div class="bw-body"><div class="bw-head"><div class="bw-title">' + esc(title) + '</div><div class="bw-sub">' + esc(sub || prov.name) + '</div></div>' + inner + '</div>' +
