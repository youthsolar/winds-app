---
import BaseLayout from '../layouts/BaseLayout.astro';
import servicesData from '../data/services.json';
import '../styles/cast-landing.css';   // 水鏡＋起卦區塊（與 /home-gua、/love 共用）
// 首頁輕入口 — 值對齊 handoff home-page.jsx + home-free-draw.jsx + site-nav-footer.jsx
// 暫放 /home（不動現有 root=/ 占卜流程）；之後翻 root 再一步處理
// 2026-10-02 Jeffery：首頁塔羅抽牌換成活動頁的水鏡起卦。情境＝① 的四個選項；head／lede＝選了哪個，hero 大標題與副句就換成哪句
// （Jeffery 選項卡：大標題跟著選項換，同舊版首頁；原本 hero 問句＋副句，「抽一張牌」改成起卦）；預設選「有沒有未來」。
// 2026-10-03 Jeffery：四個情境照老師多年問事的四大類改成「財、情、健康、入煞」各一個（文案 OpenAI 修過、選項卡逐題拍板）。
// dir／sub／ask／service＝交給 /divination 的題目（dir、sub 對 FunnelDocument TOPICS 的 key，ask 是寫進問題字串給老師看的那句）
const SCENARIOS = [
  { key: '錢總留不住', head: '明明有在賺錢，怎麼月底又沒剩多少？', lede: '先別急著怪自己，起一卦看看錢卡在哪裡。', dir: 'work', sub: 'wealth', service: 'karma', ask: '我最近錢一直留不住，想知道問題出在哪裡。' },
  { key: '有沒有未來', head: '你們還有沒有可能？', lede: '先不用急著決定，起一卦看看你在這段關係裡的猶豫。', dir: 'love', sub: 'reunion', service: 'fortune', ask: '我們還有沒有可能？' },
  { key: '累卻睡不好', head: '白天累得要命，躺上床卻又睡不好？', lede: '睡不好可以找醫師討論，心裡掛著的事，起一卦看看。', dir: 'self', sub: 'mind', service: 'fortune', ask: '最近總是很累、睡不好，想知道是怎麼了。' },
  { key: '總覺得怪怪', head: '最近有些事讓你覺得怪怪的，卻又說不上來？', lede: '先不用往壞處想，起一卦，把你在意的事說清楚。', dir: 'self', sub: 'luck', service: 'karma', ask: '最近總覺得哪裡怪怪的，想請老師幫我看看是不是沖到了。' },
];
const DEFAULT = 1;   // 一進來先選好「有沒有未來」，大標題就有一句完整的問句
const DAILY_QUOTE = '有些事情想很久，還是沒有答案。那就換個角度看看。';
const FIELDS = ['姓', '名', '西元生日（陽曆）', '出生時間', '手機', '電子郵件'];
// 預約項目：接真實 SB 服務（services.json = D1，source==='simplybook'），連到真項目頁
const sbServices = (servicesData as any[]).filter((s) => s.source === 'simplybook' && (s.price ?? 0) > 0);
const glyphOf = (name: string) => {
  const m = String(name || '').replace(/[【\[\(（][^】\]\)）]*[】\]\)）]/g, '').match(/[一-鿿]/);
  return m ? m[0] : '占';
};
const cleanName = (name: string) => String(name || '').replace(/^[【\[]/, '').replace(/[】\]][\s\S]*$/, '').trim() || name;
const lineOf = (s: any) => String(s.llm_description || (s.description || '').replace(/<[^>]+>/g, '') || '').replace(/\s+/g, ' ').trim();
const durOf = (s: any) => (s.duration_minutes ? `${s.duration_minutes} 分鐘` : '一對一');
const ntd = (p: number) => `NT$ ${Number(p).toLocaleString()}`;
// 首頁專用介紹（2026-09-24 Jeffery 首頁文案修改：像老師坐在個案對面講話；只覆蓋首頁這一行，/services 與 D1 不動）
const HOME_SVC_LINES: [RegExp, string][] = [
  [/元辰宮|知運勢|代觀/, '如果你最近很多事情一起不順，卻又說不上來問題到底在哪裡，可以從元辰宮開始看。老師會代替你進入元辰宮，看看目前整體狀態，以及是哪個地方出了問題。'],
  [/水鏡|查因果/, '有一件事情，你一直很想知道真正的原因嗎？通靈水鏡法主要就是用來查這件事。不繞圈，直接從你最在意的問題開始。'],
  [/命書|籤詩|問事/, '如果你現在只有一件事情想問，而且希望直接一點，可以選這個。不需要八字，告訴老師你想問什麼就可以。'],
];
const homeLine = (name: string) => (HOME_SVC_LINES.find(([re]) => re.test(String(name || ''))) || [])[1] || '';
const featuredSvc = sbServices.find((s) => /元辰宮|知運勢/.test(s.name)) || sbServices[0];
const FEATURED = featuredSvc && {
  id: featuredSvc.id, glyph: glyphOf(featuredSvc.name), kind: '先從這裡看',
  name: cleanName(featuredSvc.name), line: homeLine(featuredSvc.name) || lineOf(featuredSvc).slice(0, 64),
  price: ntd(featuredSvc.price), duration: durOf(featuredSvc),
};
const smallPicks: any[] = [];
for (const re of [/水鏡|查因果/, /命書|籤詩|問事/]) {
  const f = sbServices.find((s) => re.test(s.name) && s.id !== featuredSvc?.id && !smallPicks.includes(s));
  if (f) smallPicks.push(f);
}
for (const s of sbServices) { if (smallPicks.length >= 2) break; if (s.id !== featuredSvc?.id && !smallPicks.includes(s)) smallPicks.push(s); }
const SVC = smallPicks.slice(0, 2).map((s) => ({
  id: s.id, glyph: glyphOf(s.name), name: cleanName(s.name),
  line: homeLine(s.name) || lineOf(s).slice(0, 40), price: ntd(s.price), duration: durOf(s),
}));
const FLOW = '/divination';  // 深度占卜漏斗（DS 重建）
const BOOK = '/booking';     // 預約老師（真 SB 老師 + 預約精靈）
const SHOP = '/shop';        // 法器選物（真 ES 商品）
const pageDesc = '按住水鏡起一卦，老師依你這一卦給一張親手畫的靈符解方。只要 6 個基本資料，大概 30 秒。心裡那件事，在找風問幸福慢慢說就好。';

// GEO：品牌實體錨點（Organization + WebSite）。AI 引擎靠這個認識「找風問幸福是誰」；
// 文章頁的 Article schema 已各自帶，這裡只放站級兩型。
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://winds.tw/#org',
      name: '找風問幸福',
      alternateName: 'Uneedwind',
      url: 'https://winds.tw',
      logo: 'https://winds.tw/assets/logo.png',
      description: '找風問幸福提供老師的解卦、通靈問事、元辰宮與風水，也有風易揚老師親手畫的符令。',
      areaServed: 'TW',
      sameAs: [
        'https://www.facebook.com/1056598467870017',
        'https://www.instagram.com/uneedwind',
        'https://www.threads.net/@uneedwind',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://winds.tw/#website',
      url: 'https://winds.tw',
      name: '找風問幸福',
      publisher: { '@id': 'https://winds.tw/#org' },
      inLanguage: 'zh-Hant',
    },
  ],
};
---
<BaseLayout title="找風問幸福｜先聽聽現在的自己" description={pageDesc} ogType="website" jsonLd={homeJsonLd}>
  <main class="home" data-scenarios={JSON.stringify(SCENARIOS)} data-default={DEFAULT}>
    <!-- Hero＋起卦（2026-10-02 DS 回稿 contribution-to-ds/ui_kits/free-flow/home-cast.jsx：hero 與起卦合成一屏、單一 1120 容器；
         桌機兩欄＝左 hero＋① 選項＋社群證明、右 ② 水鏡卡 sticky；手機單欄＝hero → ① → ② → 社群證明 → 每日一句） -->
    <header class="hc">
      <div class="hc-grid">
        <div class="hc-left">
          <div class="hc-hero">
            <span class="hc-eyebrow"><i></i>找風問幸福 · 先聽聽現在的自己</span>
            <!-- 大標題跟著選項換；四句都疊在同一格當隱形量尺，高度取最長那句，換選項時下面的選項不跳 -->
            <div class="hc-q">
              <div class="hc-qcur" id="hmQ"><h1 class="hc-h1" id="hmHead">{SCENARIOS[DEFAULT].head}</h1><p class="hc-lede" id="hmLede">{SCENARIOS[DEFAULT].lede}</p></div>
              {SCENARIOS.map((m) => (<div class="hc-qsizer" aria-hidden="true"><div class="hc-h1">{m.head}</div><p class="hc-lede">{m.lede}</p></div>))}
            </div>
          </div>
          <!-- 10/7 DS：八卦照活動頁 .hg-bagua（48px、opacity .9、純裝飾），放量尺之後＝換選項不跳；手機桌機都置中（10/7 Jeffery）；手機上下間距相等 -->
          <div class="hc-bagua" aria-hidden="true"><img src="/assets/bagua-nav.png" alt="" width="48" height="48"></div>
          <section class="hc-step1">
            <div class="hc-step"><span class="hc-num done" id="hmN1" aria-hidden="true">1</span><div class="hc-step-txt"><h3>現在的你，比較像——</h3></div></div>
            <div class="hc-opts" role="group" id="hmOpts">
              {SCENARIOS.map((m, i) => (
                <button type="button" aria-pressed={i === DEFAULT ? 'true' : 'false'} class={`hc-opt${i === DEFAULT ? ' on' : ''}`} data-i={i}><span class="hc-radio" aria-hidden="true"><i class="ph-bold ph-check"></i></span><span>{m.key}</span></button>
              ))}
            </div>
          </section>
          <div class="hc-extra">
            <div class="social"><div class="av-stack"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span></div><span class="social-line">已陪 <b>2,700+</b> 人，把心裡的事慢慢說完</span></div>
            <a class="hc-book" id="scrollDeepen" href="#deepen">或預約老師慢慢聊 <i class="ph ph-arrow-right"></i></a>
          </div>
        </div>
        <div class="hc-side">
          <div class="hc-card ready" id="hmCast">
            <div class="hc-step"><span class="hc-num" id="hmN2" aria-hidden="true">2</span><div class="hc-step-txt"><h3>把手放在水鏡上。</h3><p>按著三秒，不要急著放開。卦會自己浮上來。</p></div></div>
            <div class="hc-guide"><p>想著這件事，把手放到水鏡上。</p><p>起卦之後，老師依你這一卦給一張親手畫的靈符解方。</p></div>
            <div class="hc-mirror" id="hmMirror"></div>
          </div>
        </div>
      </div>

      <div class="hc-daily">
        <i class="ph-thin ph-quotes"></i>
        <div class="hc-daily-row"><span class="hc-daily-k">今日一句</span><p>{'「' + DAILY_QUOTE + '」'}</p></div>
      </div>
    </header>

    <!-- Selling point -->
    <section class="selling">
      <div class="wrap selling-row">
        <div class="selling-claim">
          <span>只要 <em>6 個</em> 基本資料</span><span class="plus">＋</span><span><em>30 秒</em> 得到幸福</span>
        </div>
        <div class="fields">
          {FIELDS.map((f, i) => (<span class="field"><span class="fn">{String(i + 1).padStart(2, '0')}</span>{f}</span>))}
        </div>
      </div>
    </section>

    <!-- 預約項目 -->
    <section class="wrap block">
      <div class="zf-section-heading sh"><h2 class="zf-sh-title cjk">預約項目</h2><p class="zf-sh-lede">有些事情，還是要讓老師親自看。你可以從下面選一個最接近目前狀況的項目。</p></div>
      <div class="svc-grid">
        {FEATURED && (
        <a class="zf-card tint interactive svc-featured" href={`/services/sb-${FEATURED.id}/`} id="homeSvcFeatured">
          <div class="sf-head">
            <span class="disc lg">{FEATURED.glyph}</span>
            <div><span class="badge">{FEATURED.kind}</span><h3>{FEATURED.name}</h3></div>
          </div>
          <p class="sf-line">{FEATURED.line}</p>
          <div class="sf-foot">
            <span><span class="meta">{FEATURED.duration} · 一對一</span><span class="price">{FEATURED.price}</span></span>
            <span class="zf-btn primary md">看介紹 <i class="ph ph-arrow-right" style="font-size:15px"></i></span>
          </div>
        </a>
        )}
        <div class="svc-small" id="homeSvcSmall">
          {SVC.map(it => (
            <a class="zf-card interactive svc-card" href={`/services/sb-${it.id}/`}>
              <span class="disc">{it.glyph}</span>
              <div class="sc-body">
                <h4>{it.name}</h4><p>{it.line}</p>
                <div class="sc-foot"><span class="price">{it.price}</span><span class="meta">{it.duration}</span></div>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="svc-all"><a href="/services">看全部預約項目 <i class="ph ph-arrow-right"></i></a></div>
    </section>

    <!-- 預約對談 + 法器 -->
    <section id="deepen" class="wrap block">
      <div class="zf-section-heading sh"><h2 class="zf-sh-title cjk">還想再往下看看？</h2><p class="zf-sh-lede">沒關係，你慢慢選。</p></div>
      <div class="deepen-grid">
        <div class="zf-card talk-card">
          <div class="talk-banner"><img src="/assets/talk-space-banner.png" alt="預約對談的空間" /><span class="badge on-img">預約對談</span></div>
          <div class="talk-body">
            <h3>選一位老師慢慢聊</h3>
            <p>有些事情，打字真的講不清楚。那就直接找老師聊。可選實體或線上。</p>
            <div class="readers" id="homeReaders"><span class="av rose">林</span><span class="av clay">陳</span><span class="av sage">王</span><span class="rd-note">資深老師線上預約</span></div>
            <div class="talk-foot">
              <span><span class="meta" id="homeBookMeta">單次 30 分鐘起</span><span class="price" id="homeBookPrice">NT$ 2,000 起</span></span>
              <a class="zf-btn primary md" href={BOOK}>預約老師 <i class="ph ph-arrow-right" style="font-size:16px"></i></a>
            </div>
          </div>
        </div>
        <div class="zf-card tint shop-card">
          <div class="shop-head"><h3>帶一件靈性的小物回家</h3><span class="badge">法器選物</span></div>
          <!-- 2026-09-28（gpt-6-astra 體檢）：原本先放 4 個寫死的示意商品與價格，API 讀不到就一直顯示假商品。
               改成先顯示載入中，拿到真的商品才畫；讀不到或沒有商品就說清楚、引導到全部選物 -->
          <div class="shop-list" id="homeShopList">
            <p class="si-line" style="padding:12px 0;margin:0">選物載入中…</p>
          </div>
          <a class="zf-btn secondary md full" href={SHOP}>逛逛全部選物 <i class="ph ph-arrow-right" style="font-size:15px"></i></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
(function () {
  const root = document.querySelector('.home');
  if (!root) return;
  /* ===== 水鏡起卦（2026-10-02 Jeffery：首頁塔羅換成活動頁的水鏡）=====
     鏡子的畫法與按住起卦的手感照抄 FunnelDocument 的 ffStars／ffYaos／ffMirror／ffRip*／ffCastWire——那邊改了這裡要跟著改。
     卦起好就存進 sessionStorage 交給 /divination（FunnelDocument takeHomeCast），從「你的卦」接著走，不用再按一次；卦的真假後端照樣驗。 */
  const SC = JSON.parse(root.dataset.scenarios);
  const API = 'https://api.winds.tw';
  const REDUCE = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
  let sel = parseInt(root.dataset.default, 10);   // 預設選好的那一個（DEFAULT）
  const STARS = (function(){var s=7;function rnd(){s=(s*9301+49297)%233280;return s/233280;}var pts=[];for(var i=0;i<26;i++){var a=rnd()*Math.PI*2,r=0.18+Math.sqrt(rnd())*0.72;pts.push({x:0.5+r*0.5*Math.cos(a),y:0.5+r*0.5*Math.sin(a),r:0.6+rnd()*1.3,o:0.22+rnd()*0.5,d:rnd()*6});}return pts;})();
  function stars(size){return '<svg class="ff-stars" viewBox="0 0 '+size+' '+size+'">'+STARS.map(function(p,i){return '<circle cx="'+(p.x*size).toFixed(1)+'" cy="'+(p.y*size).toFixed(1)+'" r="'+p.r.toFixed(2)+'" opacity="'+p.o.toFixed(2)+'"'+(REDUCE?'':' style="animation:ffTwinkle '+(5+(i%4))+'s ease-in-out '+p.d.toFixed(2)+'s infinite alternate"')+'/>'}).join('')+'</svg>';}
  function yaos(code,rising){return '<div class="ff-yaos">'+String(code||'000000').split('').map(function(c,i){var shown=(6-i)<=rising;return '<div class="ff-yao'+(c==='1'?' yang':'')+(shown?' on':'')+'">'+(c==='1'?'<i></i>':'<i></i><i></i>')+'</div>'}).join('')+'</div>';}
  const size = window.innerWidth < 900 ? 232 : 256, inner = size - 20;
  document.getElementById('hmMirror').innerHTML =
    '<div class="ff-mirrorwrap"><div class="ff-mirror cast" id="ffMirror" style="width:'+size+'px;height:'+size+'px" role="button" tabindex="0" aria-label="按住水鏡起卦">'+
    stars(inner)+'<span class="ff-sheen"></span><div class="ff-rips" id="ffRips"></div><div class="ff-hexc" id="ffYaos">'+yaos('000000',0)+'</div></div>'+
    '<div class="ff-hexname" id="ffHexName"></div></div><div class="ff-clock" id="ffClock"></div>';
  const m = document.getElementById('ffMirror'), yEl = document.getElementById('ffYaos'), nEl = document.getElementById('ffHexName'), clock = document.getElementById('ffClock');

  /* 漣漪：一組 3～4 圈依序往外散；閒置每 5.2s 一組，按住 1.6s 一組 */
  let ripTimer = null;
  function ripBurst(){var box=document.getElementById('ffRips');if(!box||REDUCE)return;var n=3+Math.round(Math.random());for(var k=0;k<n;k++){setTimeout(function(){var b=document.getElementById('ffRips');if(!b)return;var s=document.createElement('span');b.appendChild(s);setTimeout(function(){if(s.parentNode)s.parentNode.removeChild(s);},3400);},k*380);}}
  function ripStop(){if(ripTimer){clearInterval(ripTimer);ripTimer=null;}}
  function ripStart(busy){ripStop();ripBurst();ripTimer=setInterval(ripBurst,busy?1600:5200);}
  // 2026-10-02（Astra 審查 #5）：錯誤除了畫面上的提示，另外寫進一開始就在的 role=alert 隱形區，讀屏軟體才會唸出來
  const srAlert = document.createElement('div');
  srAlert.setAttribute('role', 'alert');
  srAlert.style.cssText = 'position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0';
  document.body.appendChild(srAlert);
  function showErr(msg){var e=document.getElementById('ffErr');if(!e){e=document.createElement('div');e.id='ffErr';e.className='ff-err';document.body.appendChild(e);}e.textContent=msg;e.style.display='block';srAlert.textContent='';setTimeout(function(){srAlert.textContent=msg;},50);setTimeout(function(){e.style.display='none';},4000);}

  // ① 選情境：切按鈕，大標題與副句淡出換成這個情境的那句（同舊版首頁 280ms；點下去就更新 sel，取消上一次還沒跑的換字）
  const opts = document.getElementById('hmOpts');
  const qEl = document.getElementById('hmQ');
  let qTimer = null;
  opts.addEventListener('click', (e) => {
    const b = e.target.closest('.hc-opt'); if (!b) return;
    const i = parseInt(b.dataset.i, 10); if (i === sel) return;
    if (CAST.t) return;   // 起卦中不換題
    sel = i;
    [...opts.querySelectorAll('.hc-opt')].forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    if (qTimer) clearTimeout(qTimer);
    qEl.classList.add('fade');
    qTimer = setTimeout(() => { qTimer = null; document.getElementById('hmHead').textContent = SC[i].head; document.getElementById('hmLede').textContent = SC[i].lede; qEl.classList.remove('fade'); }, 280);
    const er = document.getElementById('ffErr'); if (er) er.style.display = 'none';
  });

  // ② 按住水鏡起卦：按下那一刻向後端起卦（同 /divination），六爻浮上來後交給 /divination
  let CAST = { t: null, rising: 0, req: 0, cast: null, auto: false };
  let handTimer = null;   // 六爻浮完 → 1.7 秒後交接的計時器
  function draw(){yEl.innerHTML=yaos(CAST.cast?CAST.cast.code:'000000',CAST.rising);nEl.textContent=CAST.cast?CAST.cast.name:'';nEl.classList.toggle('on',CAST.rising>=6);}
  function stop(){if(CAST.t&&CAST.t!=='done'){clearInterval(CAST.t);CAST.t=null;CAST.rising=0;CAST.cast=null;draw();ripStart(false);clock.textContent='';m.classList.remove('busy');}}
  // 整個水鏡回到可以再按的樣子（取消還沒跑的交接；req 加一，還在路上的起卦回應就作廢）
  function reset(){
    if (handTimer) { clearTimeout(handTimer); handTimer = null; }
    if (CAST.t && CAST.t !== 'done' && CAST.t !== 'pending') clearInterval(CAST.t);
    CAST = { t: null, rising: 0, req: CAST.req + 1, cast: null, auto: false };
    document.getElementById('hmN2').classList.remove('done'); draw(); clock.textContent = ''; m.classList.remove('busy'); ripStart(false);
  }
  function handOff(){
    handTimer = null;
    if (CAST.t !== 'done' || !CAST.cast) return;   // 2026-10-02（Astra 審查 #2）：等待中被重設過（例如離開再按上一頁回來）就不跳
    const s = SC[sel];
    const data = JSON.stringify({ dir: s.dir, sub: s.sub, q: s.ask, service: s.service, cast: CAST.cast });
    // 2026-10-02（Astra 審查 #3）：存不進 sessionStorage（私密模式、額度滿）就把卦放在網址 #hc= 帶過去，卦不會掉
    let saved = false;
    try { sessionStorage.setItem('winds_home_cast', data); saved = sessionStorage.getItem('winds_home_cast') === data; } catch (e) {}
    // 2026-10-03：網址上的 utm 原樣帶到 /divination/，那邊的進站記點才記得到「從社群留言進首頁、真的起完卦」的人
    location.href = '/divination/' + location.search + (saved ? '' : '#hc=' + encodeURIComponent(data));
  }
  function start(e, auto){
    if (CAST.t) return;
    if (!auto) { e.preventDefault(); try { m.setPointerCapture(e.pointerId); } catch (x) {} }
    if (sel < 0) { opts.scrollIntoView({ behavior: 'smooth', block: 'center' }); showErr('先選一個，再按水鏡。'); return; }
    CAST.auto = !!auto;
    m.classList.add('busy'); ripStart(true);
    CAST.t = 'pending';
    const myReq = CAST.req = CAST.req + 1;   // 按 A 放開再按 B，A 較晚回來不能被當成 B
    fetch(API + '/free-cast', { method: 'POST' }).then((r) => r.json()).then((d) => {
      if (CAST.t !== 'pending' || myReq !== CAST.req) return;
      if (!d || !d.success) { CAST.t = null; stop(); showErr('起卦沒成功，再按一次。'); return; }
      CAST.cast = { code: d.code, name: d.name, line: d.line, castAt: d.cast_at, castLabel: d.cast_label || '' };
      clock.textContent = CAST.cast.castLabel + ' 起卦';
      CAST.t = setInterval(() => {
        CAST.rising++; draw();
        if (CAST.rising >= 6) { clearInterval(CAST.t); CAST.t = 'done'; document.getElementById('hmN2').classList.add('done'); ripStart(false); handTimer = setTimeout(handOff, 1700); }
      }, 520);
    }).catch(() => { if (myReq !== CAST.req) return; CAST.t = null; stop(); showErr('連線不穩，再按一次。'); });
  }
  function release(){ if (CAST.auto) return; if (CAST.t === 'pending') { CAST.t = null; stop(); return; } stop(); }
  m.addEventListener('pointerdown', (e) => start(e)); m.addEventListener('pointerup', release); m.addEventListener('pointercancel', release);
  // 鍵盤：按住 Enter／空白鍵＝按住水鏡，放開＝放手
  m.addEventListener('keydown', (e) => { if (e.key !== 'Enter' && e.key !== ' ') return; e.preventDefault(); if (!e.repeat) start(e); });
  m.addEventListener('keyup', (e) => { if (e.key === 'Enter' || e.key === ' ') release(); });
  // 2026-10-02（Astra 審查 #4）：讀屏軟體／語音控制只送一個 click（沒有按下、放開，detail 為 0），這時按一下就整卦起完，不必按住
  m.addEventListener('click', (e) => { if (e.detail === 0 && !CAST.t) start(e, true); });
  // 離開這頁時取消還沒跑的交接；從 /divination 按上一頁回來（瀏覽器直接還原這頁）時水鏡回到可以再按的樣子
  window.addEventListener('pagehide', () => { if (handTimer) reset(); });
  window.addEventListener('pageshow', (e) => { if (e.persisted && CAST.t) reset(); });
  ripStart(false);

  // 平滑捲動
  document.getElementById('scrollDeepen').addEventListener('click', (e) => {
    e.preventDefault();
    const el = document.getElementById('deepen');
    if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 16, behavior: 'smooth' });
  });

  /* JS 注入元素無 Astro scope → 樣式一律 inline（gotcha：scoped <style> 不套用到 innerHTML 元素）*/
  function escH(s){return String(s||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}

  /* 預約對談卡：接真 SB 老師（圓形彩色頭像 + 真人數）*/
  (function(){
    var box = document.getElementById('homeReaders'); if(!box) return;
    var TONE_BG = ['var(--rose-100)','var(--clay-200)','var(--sage-200)'];
    var TONE_FG = ['var(--rose-600)','var(--clay-500)','var(--sage-500)'];
    var TONE_RING = ['var(--rose-300)','var(--clay-300)','var(--sage-300)'];
    fetch('https://api.winds.tw/sb-providers').then(function(r){return r.json();}).then(function(d){
      var ts = (d && d.providers) || []; if(!ts.length) return;
      var avs = ts.slice(0,3).map(function(t,i){
        var nm = (t.name||'').replace(/老師$/,'');
        var ring = t.color || TONE_RING[i%3];
        var st = 'display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;font-family:var(--font-serif);font-size:17px;font-weight:500;overflow:hidden;flex:none;background:'+TONE_BG[i%3]+';color:'+TONE_FG[i%3]+';box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px '+ring+';margin-left:'+(i?-10:0)+'px;position:relative;z-index:'+(9-i);
        return '<span style="'+st+'">'+escH(nm.slice(0,1)||'師')+'</span>';
      }).join('');
      box.innerHTML = avs + '<span style="font-family:var(--font-sans);font-size:12.5px;color:var(--text-muted);margin-left:12px;white-space:nowrap">'+ts.length+' 位資深老師．線上預約</span>';
    }).catch(function(){});
  })();

  /* 預約對談：接真實 SB 服務（/sb-services），最低價/最短時長覆蓋佔位 */
  (function(){
    fetch('https://api.winds.tw/sb-services').then(function(r){return r.json();}).then(function(d){
      var svs=(d&&(d.services||d.data))||(Array.isArray(d)?d:[]);
      var priced=svs.filter(function(x){return +x.price>0});if(!priced.length)return;
      var minP=Math.min.apply(null,priced.map(function(x){return +x.price}));
      var minD=Math.min.apply(null,priced.map(function(x){return +x.duration||999}));
      var m=document.getElementById('homeBookMeta'),pr=document.getElementById('homeBookPrice');
      if(m&&minD<999)m.textContent='單次 '+minD+' 分鐘起';
      if(pr)pr.textContent='NT$ '+minP.toLocaleString()+' 起';
    }).catch(function(){});
  })();

  /* 法器選物：接真實 ES 商品（/shop-products），覆蓋 SSR 佔位 */
  (function(){
    var box = document.getElementById('homeShopList'); if(!box) return;
    function none(msg){ var p = box.querySelector('p'); if (p) { p.textContent = msg; return; } box.innerHTML = '<p style="padding:12px 0;margin:0;font-family:var(--font-serif);font-weight:300;font-size:13px;line-height:1.6;color:var(--text-secondary)">'+msg+'</p>'; }   // 更新頁面原本那一行（有 Astro scope 樣式），不另外塞新節點（gpt-6-astra 複核）
    fetch('https://api.winds.tw/shop-products').then(function(r){if(!r.ok)throw new Error('http '+r.status);return r.json();}).then(function(d){
      var ps = (d && d.products) || []; if(!ps.length){ none('選物正在整理中，點下面看全部選物。'); return; }
      box.innerHTML = ps.slice(0,4).map(function(p,idx){
        var nm = (p.name||'').replace(/^[【\[]/,'').replace(/[】\]][\s\S]*$/,'').trim() || p.name;
        var pm = (p.desc||'').match(/<p[^>]*>([\s\S]*?)<\/p>/i);
        var line = pm ? pm[1].replace(/<[^>]+>/g,'').replace(/\s+/g,' ').trim().slice(0,20) : '';
        var thumb = p.image
          ? '<span style="flex:none;width:46px;height:46px;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--rose-100);background:var(--paper);display:block"><img src="'+escH(p.image)+'" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></span>'
          : '<span style="flex:none;width:46px;height:46px;border-radius:var(--radius-md);background:var(--paper);border:1px solid var(--rose-100);display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:22px;color:var(--accent-press)">符</span>';
        return '<div style="display:flex;align-items:center;gap:14px;padding:12px 0;'+(idx?'border-top:1px solid var(--rose-100);':'')+'">'+thumb+
          '<div style="flex:1;min-width:0"><div style="font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900)">'+escH(nm)+'</div>'+
          (line?'<div style="font-family:var(--font-serif);font-weight:300;font-size:13px;line-height:1.6;color:var(--text-secondary)">'+escH(line)+'</div>':'')+'</div>'+
          '<span style="font-family:var(--font-sans);font-size:13.5px;color:var(--ink-700);white-space:nowrap">NT$ '+(Number(p.price)||0).toLocaleString('en-US')+'</span></div>';   // 2026-10-01（廣告前全站掃描）：原本印原始數字「NT$ 1200」，同頁其他價格都有千分位 → 補千分位
      }).join('');
    }).catch(function(){ none('選物清單暫時讀不到，點下面看全部選物。'); });
  })();

  /* 預約項目：接真實 SB 服務（/sb-services）。就地更新 SSR 卡片文字（保留 scoped 樣式，不用 innerHTML 注入無樣式節點）*/
  (function(){
    var featBox = document.getElementById('homeSvcFeatured');
    var smallBox = document.getElementById('homeSvcSmall');
    if(!featBox && !smallBox) return;
    function cleanNm(n){ return String(n||'').replace(/^[【\[]/,'').replace(/[】\]][\s\S]*$/,'').trim() || n; }
    function glyph(n){ var m = cleanNm(n).match(/[一-鿿]/); return m ? m[0] : '占'; }
    function ntd(p){ return 'NT$ ' + (Number(p)||0).toLocaleString('en-US'); }
    var HOME_LINES=[[/元辰宮|知運勢|代觀/,'如果你最近很多事情一起不順，卻又說不上來問題到底在哪裡，可以從元辰宮開始看。老師會代替你進入元辰宮，看看目前整體狀態，以及是哪個地方出了問題。'],[/水鏡|查因果/,'有一件事情，你一直很想知道真正的原因嗎？通靈水鏡法主要就是用來查這件事。不繞圈，直接從你最在意的問題開始。'],[/命書|籤詩|問事/,'如果你現在只有一件事情想問，而且希望直接一點，可以選這個。不需要八字，告訴老師你想問什麼就可以。']];
    function homeLine(n){ for(var i=0;i<HOME_LINES.length;i++){ if(HOME_LINES[i][0].test(String(n||''))) return HOME_LINES[i][1]; } return ''; }
    function lineOf(s,n){ return homeLine(s.name) || String(s.llm || (s.desc||'').replace(/<[^>]+>/g,'') || '').replace(/\s+/g,' ').trim().slice(0,n); }
    function setTxt(box,sel,t){ var el = box && box.querySelector(sel); if(el) el.textContent = t; }
    fetch('https://api.winds.tw/sb-services').then(function(r){return r.json();}).then(function(d){
      var all = ((d && d.services) || []).filter(function(s){ return (Number(s.price)||0) > 0; });
      if(!all.length) return;
      var featured = all.find(function(s){ return /知運勢|代觀/.test(s.name); }) || all.find(function(s){ return /元辰宮/.test(s.name); }) || all[0];
      if(featBox && featured){
        featBox.setAttribute('href', '/services/sb-' + featured.id + '/');   // 2026-10-01（廣告前全站掃描）：原本連 /services?id=，要等列表頁兩支 API 都成功才轉到項目頁，任一支壞就卡在列表頁 → 直接連項目頁
        setTxt(featBox, '.disc', glyph(featured.name));
        setTxt(featBox, 'h3', cleanNm(featured.name));
        setTxt(featBox, '.sf-line', lineOf(featured,64));
        setTxt(featBox, '.sf-foot .meta', featured.duration ? (featured.duration + ' 分鐘 · 一對一') : '一對一');
        setTxt(featBox, '.sf-foot .price', ntd(featured.price));
      }
      if(smallBox){
        var picks = [], used = {};
        if(featured) used[featured.id] = true;
        [/水鏡|查因果/, /命書|籤詩|問事/].forEach(function(re){
          var f = all.find(function(s){ return re.test(s.name) && !used[s.id]; });
          if(f){ picks.push(f); used[f.id] = true; }
        });
        for(var i=0;i<all.length && picks.length<2;i++){ if(!used[all[i].id]){ picks.push(all[i]); used[all[i].id]=true; } }
        var cards = smallBox.querySelectorAll('.svc-card');
        for(var j=0;j<cards.length;j++){
          var s = picks[j];
          if(!s){ cards[j].style.display='none'; continue; }
          cards[j].style.display='';
          cards[j].setAttribute('href', '/services/sb-' + s.id + '/');
          setTxt(cards[j], '.disc', glyph(s.name));
          setTxt(cards[j], 'h4', cleanNm(s.name));
          setTxt(cards[j], '.sc-body p', lineOf(s,40));
          setTxt(cards[j], '.sc-foot .price', ntd(s.price));
          setTxt(cards[j], '.sc-foot .meta', s.duration ? (s.duration + ' 分鐘') : '一對一');
        }
      }
    }).catch(function(){});
  })();
})();
</script>

<style>
  .home { background: var(--surface-page); }
  .wrap { max-width: var(--container); margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  @media (max-width: 760px) { .wrap { padding-left: 20px; padding-right: 20px; } }
  .cjk { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* Hero＋起卦（2026-10-02 DS 回稿 home-cast.jsx 逐值；DS 斷點 900＝手機 ≤899）。水鏡本體與 ff-clock／ff-err 在共用 styles/cast-landing.css；
     選項、序號圓、水鏡卡、引導塊照 DS 值在這裡寫（首頁手機選項 2×2、padding 13/14，與活動頁 love-cast 不同，故不共用 .lc-*） */
  .hc { max-width: var(--container); margin: 0 auto; padding: 72px 32px 64px; box-sizing: border-box; }
  .hc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 72px; align-items: start; }
  .hc-left { display: flex; flex-direction: column; gap: 40px; padding-top: 8px; }
  .hc-side { position: sticky; top: 96px; }
  .hc-hero { display: flex; flex-direction: column; gap: 16px; }
  .hc-bagua { display: flex; justify-content: center; margin: -16px 0; }
  .hc-bagua img { display: block; width: 48px; height: 48px; opacity: .9; }
  .hc-q { display: grid; }
  .hc-qcur, .hc-qsizer { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 16px; }
  .hc-qsizer { visibility: hidden; pointer-events: none; }
  .hc-qcur { transition: opacity 280ms var(--ease-soft), transform 280ms var(--ease-soft); }
  .hc-qcur.fade { opacity: 0; transform: translateY(6px); }
  .hc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.02em; color: var(--accent-press); }
  .hc-eyebrow i { width: 5px; height: 5px; border-radius: 999px; background: var(--accent-press); }
  .hc-h1 { margin: 0; font-family: var(--font-serif); font-size: 40px; font-weight: 500; line-height: 1.3; letter-spacing: 0.01em; color: var(--text-primary); }
  .hc-lede { margin: 0; font-family: var(--font-serif); font-size: 18px; font-weight: 300; line-height: 1.8; color: var(--text-secondary); max-width: none; }
  .hc-h1, .hc-lede, .hc-step-txt h3, .hc-step-txt p, .hc-guide :global(p), .hc-daily p, .social-line { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  .hc-step1 { display: flex; flex-direction: column; gap: 16px; }
  .hc-step { display: flex; gap: 12px; align-items: flex-start; }
  .hc-num { flex: none; width: 26px; height: 26px; margin-top: 3px; box-sizing: border-box; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--accent-press); background: transparent; border: 1px solid var(--rose-300); transition: all var(--dur-fast) var(--ease-soft); }
  .hc-num.done { color: var(--text-on-accent); background: var(--accent); border-color: transparent; }
  .hc-step-txt { min-width: 0; }
  .hc-step-txt h3 { margin: 0; font-family: var(--font-serif); font-size: 22px; font-weight: 500; line-height: 1.4; color: var(--text-primary); }
  .hc-step-txt p { margin: 8px 0 0; font-family: var(--font-serif); font-size: 16px; font-weight: 300; line-height: 1.8; color: var(--text-secondary); max-width: none; }
  .hc-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .hc-opt { cursor: pointer; box-sizing: border-box; width: 100%; text-align: left; display: flex; align-items: center; gap: 12px; font-family: var(--font-serif); font-size: 17.5px; line-height: 1.6; color: var(--ink-900); background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 16px 20px; white-space: nowrap; margin: 0; -webkit-appearance: none; appearance: none; transition: all var(--dur-fast) var(--ease-soft); }
  .hc-opt.on { background: var(--surface-tint); border-color: var(--rose-300); }
  .hc-radio { flex: none; width: 18px; height: 18px; box-sizing: border-box; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border-strong); background: transparent; }
  .hc-radio i { display: none; font-size: 11px; line-height: 1; color: var(--text-on-accent); }
  .hc-opt.on .hc-radio { border-color: var(--accent); background: var(--accent); }
  .hc-opt.on .hc-radio i { display: block; }
  .hc-extra { display: flex; flex-direction: column; gap: 12px; }
  .hc-book { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; font-family: var(--font-sans); font-size: 13.5px; color: var(--accent-press); text-decoration: none; border-bottom: 1px solid var(--rose-300); padding-bottom: 2px; }
  .hc-book i { font-size: 13px; }
  .hc-card { background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 32px 32px 24px; display: flex; flex-direction: column; gap: 24px; }
  .hc-guide { background: var(--accent-quiet); border-radius: var(--radius-md); padding: 16px 20px; display: flex; flex-direction: column; gap: 2px; }
  .hc-guide :global(p) { margin: 0; font-family: var(--font-serif); font-size: 16px; font-weight: 300; line-height: 1.8; color: var(--text-secondary); max-width: none; }
  .hc-card.ready .hc-guide :global(p) { color: var(--text-primary); }
  .hc-mirror { display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0.4; filter: saturate(.5); pointer-events: none; transition: opacity var(--dur-slow, .42s) var(--ease-soft), filter var(--dur-slow, .42s) var(--ease-soft); }
  .hc-card.ready .hc-mirror { opacity: 1; filter: none; pointer-events: auto; }
  .hc-mirror :global(.ff-mirrorwrap) { margin-top: 0; }
  .hc-daily { margin-top: 72px; border-top: 1px solid var(--border-soft); padding-top: 24px; display: flex; align-items: flex-start; gap: 16px; }
  .hc-daily > i { flex: none; font-size: 26px; color: var(--rose-400); line-height: 1; margin-top: 2px; }
  .hc-daily-row { min-width: 0; display: flex; align-items: baseline; gap: 16px; }
  .hc-daily-k { flex: none; font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.02em; color: var(--text-muted); white-space: nowrap; }
  .hc-daily p { margin: 0; font-family: var(--font-serif); font-size: 18px; font-weight: 400; line-height: 1.7; color: var(--ink-700); max-width: none; }

  /* social proof（DS Avatar 36／-10 疊、字 13.5；手機 32／12.5） */
  .social { display: flex; align-items: center; gap: 12px; }
  .av-stack { display: flex; flex: none; }
  /* DS Avatar：淡色底 + 深色字 + 雙層 ring（3px surface-page + 4.5px tone-ring）*/
  .av { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-pill); font-family: var(--font-serif); font-size: 15px; font-weight: var(--w-medium); overflow: hidden; flex: none; }
  .av-stack .av { position: relative; }
  .av-stack .av:nth-child(1) { z-index: 3; }
  .av-stack .av:nth-child(2) { z-index: 2; }
  .av-stack .av:nth-child(3) { z-index: 1; }
