---
// 舊篇存檔：/love-gua/<id>/，內容不刪，當搜尋資產；找不到就退回最新。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicGua from '../../components/TopicGua.astro';
import { TOPICS, fetchTopicGua } from '../../data/topics';
const topic = TOPICS['love'];
const id = String(Astro.params.id || '').replace(/[^0-9]/g, '');
if (!id) return Astro.redirect(`/${topic.path}/`, 302);
const { data, isCurrent, failed } = await fetchTopicGua('love', id);
// 故障時不要跳去最新篇（那是另一卦），回 503 讓他重整
if (failed) return new Response('暫時讀不到這一卦，請稍後重新整理。', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store', 'Retry-After': '30' } });
if (!data) return Astro.redirect(`/${topic.path}/`, 302);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<BaseLayout
  title={`${data.posted_label} 的${topic.label}卦・${data.hex.name} · 找風問幸福`}
  description={`${data.posted_long}起的${topic.label}卦，走「${data.hex.char}」。${data.line} 風易揚老師的解卦。`}
>
  <TopicGua data={data} topic={topic} isCurrent={isCurrent} />
</BaseLayout>
