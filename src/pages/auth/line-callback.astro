---
import BaseLayout from '../../layouts/BaseLayout.astro';
/* LINE 登入回來的過場頁（2026-10-16）。客人在 LINE 按完同意會先回到這裡，換好憑證就跳回原本那頁。
   版面暫用登入頁的卡片＋站上現有 zf-btn；三個狀態的正式設計與字已交辦 DS
   （415a282e contribution-to-ds/line-login/BRIEF-LINE登入與加好友-2026-10-16.md ③），回稿後照改。 */
---
<BaseLayout title="LINE 登入 · 找風問幸福" description="用 LINE 登入找風問幸福。" noindex={true}>
  <div class="lc-wrap">
    <div class="lc-card">
      <div id="lcBusy">
        <p class="lc-hint"><span class="lc-spinner"></span>正在用 LINE 登入…</p>
      </div>
      <div id="lcFail" hidden>
        <h1 class="lc-h1" id="lcTitle">登入沒有完成</h1>
        <p class="lc-sub" id="lcMsg">可能是等太久或網路不穩，再試一次就好。</p>
        <div class="lc-actions">
          <button type="button" class="zf-btn primary md full" id="lcRetry">重新登入</button>
          <a class="zf-btn ghost sm" id="lcBack" href="/">回上一頁</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .lc-wrap{min-height:calc(100vh - 76px);display:flex;align-items:center;justify-content:center;padding:64px 32px;background:var(--surface-page);}
    .lc-card{width:100%;max-width:420px;background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:40px 40px 34px;text-align:center;}
    .lc-h1{margin:0;font-family:var(--font-serif);font-size:29px;font-weight:500;color:var(--ink-900);letter-spacing:0.02em;}
    .lc-sub{margin:14px auto 0;max-width:22em;font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.7;color:var(--text-secondary);}
    .lc-hint{display:inline-flex;align-items:center;gap:8px;margin:0;font-family:var(--font-sans);font-size:13px;color:var(--text-muted);}
    .lc-spinner{display:inline-block;flex:none;width:18px;height:18px;border-radius:999px;border:2px solid var(--rose-200);border-top-color:var(--rose-500);animation:lcSpin 1.1s linear infinite;box-sizing:border-box;}
    @keyframes lcSpin{to{transform:rotate(360deg);}}
    .lc-actions{display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:24px;}
    @media (max-width:640px){
      .lc-wrap{min-height:calc(100vh - 64px);padding:40px 20px;}
      .lc-card{padding:30px 24px 28px;}
      .lc-h1{font-size:25px;}
    }
  </style>

  <script is:inline src="/assets/line-login.js"></script>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(location.search);
      /* code 不要留在網址列與瀏覽紀錄裡 */
      try { history.replaceState(null, '', location.pathname); } catch (e) {}
      var STORAGE_MSG = '這個瀏覽器沒辦法存登入資料，請換一般瀏覽器（不是無痕視窗）再試一次。';
      function fail(kind, ret) {
        document.getElementById('lcBusy').hidden = true;
        document.getElementById('lcFail').hidden = false;
        if (kind === 'cancel') {
          document.getElementById('lcTitle').textContent = '這次沒有登入';
          document.getElementById('lcMsg').textContent = '你在 LINE 按了取消。想看紀錄的話，再登入一次就好。';
        } else if (kind === 'storage') {
          document.getElementById('lcMsg').textContent = STORAGE_MSG;
        }
        /* 回去的頁一律再過一次白名單；腳本沒載到時「重新登入」改成重新整理這頁 */
        ret = window.WindsLine ? WindsLine.safeReturn(ret) : '/';
        document.getElementById('lcBack').setAttribute('href', ret);
        document.getElementById('lcRetry').addEventListener('click', function () {
          if (window.WindsLine) WindsLine.start(ret).catch(function () { document.getElementById('lcMsg').textContent = STORAGE_MSG; }); else location.reload();
        });
      }
      if (!window.WindsLine) { fail('exchange', '/'); return; }
      WindsLine.finish(params).then(function (ret) { location.replace(ret); },
        function (e) { fail(e && e.kind, e && e.ret); });
    })();
  </script>
</BaseLayout>
