---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORG_JSONLD } from '../data/org';
// 品牌故事頁 — 值對齊 handoff brand-story-page.jsx + DS SectionHeading/IconDisc/GlyphDisc/Card
const BELIEFS = [
  { icon: 'feather', title: '決定留給自己', body: '找風問幸福尊重每個人做決定的權利。命理提供思考的角度，你可以依照自己的處境，選擇接下來怎麼做。' },
  { icon: 'ear', title: '心事值得細聽', body: '問事時，重視完整的傾聽。難開口的心事可以慢慢說，還沒整理好的感受，也值得留下時間談談。' },
  { icon: 'sun-horizon', title: '方向可以重想', body: '選擇可以隨處境重新思考。走得累的時候，可以先看看眼前的方向，是否仍適合現在的你。' },
];
const MARKS = [
  { g: '通', name: '通靈', note: '與無形溝通', href: '/booking' },
  { g: '易', name: '易經', note: '問一件具體的事', href: '/' },
  { g: '塔', name: '塔羅', note: '看現在的心境', href: '/' },
  { g: '紫', name: '紫微', note: '讀一生的命盤', href: '/ziwei' },
  { g: '名', name: '姓名學', note: '名字裡的能量', href: '/' },
  { g: '靈', name: '分靈體', note: '和自己對話', href: '/spirit' },
];
const ORIGIN = [
  '在對談裡常會發現，一個難以開口的問題，背後還有很多沒說完的心事。所以我們想留些時間，聽懂生活裡的困擾，也聊聊靈魂層次的疑問。',
  '先從你的話裡慢慢了解，再透過易經、塔羅、紫微、姓名學，一起看清楚卡住的地方。希望每一次對談，都能讓心裡的疑問更清楚一些。',
  '不需要事先想好怎麼說。哪怕只是「最近心裡怪怪的」，我們也願意從這一句開始聽。',
];
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_JSONLD,
    { '@type': 'AboutPage', '@id': 'https://winds.tw/about/#page', url: 'https://winds.tw/about/', name: '品牌故事｜找風問幸福', about: { '@id': 'https://winds.tw/#org' }, inLanguage: 'zh-Hant' },
  ],
};
const pageDesc = '找風問幸福是風易揚老師創立的命理與心靈品牌，位於台北市大安區，可預約一對一問事，或透過官方 LINE 遠端通話，幫你在做決定前把事情看清楚。網站也可免費起卦看卦象。';
---
<BaseLayout title="品牌故事｜找風問幸福" description={pageDesc} ogType="website" jsonLd={aboutJsonLd}>
  <main class="story">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="wrap">
        <div class="zf-section-heading">
          <span class="zf-sh-eyebrow">品牌故事</span>
          <h1 class="zf-sh-title cjk">找風問幸福，陪你看清楚再決定</h1>
          <div class="zf-prose"><p>找風問幸福是風易揚老師創立的命理與心靈品牌，在台北市大安區可預約一對一問事，也可透過官方 LINE 遠端通話，陪你釐清做決定前的疑問。已經有 2,700 多人來這裡問過心裡的事。你的疑問，也值得好好談一談。</p></div>
        </div>
      </div>
    </section>

    <!-- Origin -->
    <section class="wrap origin">
      <div class="origin-grid">
        <div class="origin-text">
          <h2 class="zf-sh-title cjk">起念，是因為有太多人的靈魂層次與困擾沒被好好傾聽。</h2>
          <div class="zf-prose">{ORIGIN.map(p => <p>{p}</p>)}</div>
        </div>
        <div class="origin-img"><img src="/assets/talk-space.png" alt="預約對談的空間" /></div>
      </div>
    </section>

    <!-- Beliefs -->
    <section class="wrap block">
      <div class="zf-section-heading"><span class="zf-sh-eyebrow">我們相信</span><h2 class="zf-sh-title cjk">每個決定，都值得先好好理解自己。</h2></div>
      <div class="beliefs">
        {BELIEFS.map(b => (
          <article class="zf-card belief-card">
            <span class="icon-disc"><i class={`ph-thin ph-${b.icon}`}></i></span>
            <h3>{b.title}</h3>
            <p class="zf-prose sm">{b.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Practices -->
    <section class="wrap block">
      <div class="zf-section-heading"><span class="zf-sh-eyebrow">我們的命理</span><h2 class="zf-sh-title cjk">從你想問的事，找到適合的探索方式。</h2></div>
      <div class="marks">
        {MARKS.map(m => {
          const Tag = m.href ? 'a' : 'div';
          return (
            <Tag class:list={['zf-card mark', { interactive: m.href }]} href={m.href}>
              <span class="glyph-disc">{m.g}</span>
              <div class="mark-name">{m.name}</div>
              <div class="mark-note">{m.note}</div>
            </Tag>
          );
        })}
      </div>
    </section>

    <!-- Ink quote -->
    <section class="wrap block">
      <figure class="quote-card">
        <span class="qc-glow" aria-hidden="true"></span>
        <i class="ph-thin ph-quotes" aria-hidden="true"></i>
        <blockquote class="qc-line cjk">陪你理解心裡的事，決定自己的方向。</blockquote>
        <figcaption class="qc-sign">找風問幸福</figcaption>
      </figure>
    </section>

    <!-- CTA -->
    <section class="wrap block">
      <div class="zf-card tint cta-card">
        <h2 class="cjk">有件事放在心上很久了嗎？</h2>
        <p class="zf-prose sm center cta-sub">不用先想清楚想問什麼，可以先按住水鏡三秒，免費看卦象。</p>
        <div class="cta-btns">
          <a class="zf-btn lg primary" href="/">免費起卦</a>
          <a class="zf-btn lg secondary" href="/booking"><i class="ph-thin ph-calendar-heart" style="font-size:18px"></i>預約老師</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .story { background: var(--surface-page); }
  .wrap { max-width: var(--container); margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  @media (max-width: 820px) { .wrap { padding-left: 20px; padding-right: 20px; } }
  .cjk { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* SectionHeading / Prose 全用 DS .zf-section-heading / .zf-sh-* / .zf-prose（hero 也對齊權威 SectionHeading＝30px t-h2）*/

  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(720px 460px at 78% -8%, var(--rose-100), transparent 62%), radial-gradient(560px 420px at 6% 12%, var(--clay-100), transparent 60%); }
  .hero .wrap { position: relative; padding-top: 92px; padding-bottom: 8px; }
  @media (max-width: 820px) { .hero .wrap { padding-top: 56px; } }

  /* Origin */
  .origin { padding-top: 72px; }
  @media (max-width: 820px) { .origin { padding-top: 44px; } }
  .origin-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  @media (max-width: 820px) { .origin-grid { grid-template-columns: 1fr; gap: 28px; } }
  .origin-text { max-width: var(--measure-prose); }
  .origin-text .zf-sh-title { margin-bottom: 18px; }
  /* DS 品牌故事 useMedia(820) 傳 Prose mobile＝16 */
  @media (max-width: 820px) { .origin-text .zf-prose { font-size: 16px; } }
  .origin-img { width: 100%; height: 360px; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--border-soft); }
  @media (max-width: 820px) { .origin-img { height: 240px; } }
  .origin-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .block { padding-top: 84px; }
  @media (max-width: 820px) { .block { padding-top: 48px; } }

  /* Beliefs */
  .beliefs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
  @media (max-width: 820px) { .beliefs { grid-template-columns: 1fr; gap: 14px; margin-top: 28px; } }
  .belief-card { padding: 28px 26px; }
  .belief-card p.zf-prose { margin: 0; }
  @media (max-width: 820px) { .belief-card { padding: 22px; } }
  .icon-disc { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 999px; background: var(--rose-100); margin-bottom: 16px; }
  .icon-disc i { font-size: 23px; color: var(--rose-500); line-height: 1; }
  .belief-card h3 { font-family: var(--font-serif); font-size: var(--t-card-title); font-weight: var(--w-medium); line-height: 1.4; color: var(--ink-900); margin: 0 0 8px; }

  /* Practices marks */
  .marks { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; margin-top: 40px; }
  @media (max-width: 820px) { .marks { grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 28px; } }
  .mark { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 26px 10px; }
  @media (max-width: 820px) { .mark { padding: 20px 8px; } }
  .mark.interactive { text-decoration: none; }
  .glyph-disc { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 999px; background: var(--surface-card); border: 1px solid var(--rose-100); font-family: var(--font-serif); font-size: 27px; line-height: 1; color: var(--accent-press); }
  @media (max-width: 820px) { .glyph-disc { width: 50px; height: 50px; font-size: 24px; } }
  .mark-name { font-family: var(--font-serif); font-size: 16px; font-weight: var(--w-medium); color: var(--ink-900); margin-top: 14px; }
  .mark-note { font-family: var(--font-serif); font-weight: var(--w-light); font-size: 12.5px; color: var(--text-muted); margin-top: 4px; }

  /* Ink quote */
  /* 金句卡＝DS QuoteCard（components/quote-card，2026-10-15）；暗版仍深色卡，走 --surface-quote 系 token */
  .quote-card { margin: 0; position: relative; overflow: hidden; background: var(--surface-quote); border: 1px solid var(--border-quote); border-radius: var(--radius-xl); padding: 64px 48px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .qc-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(520px 260px at 50% -10%, var(--quote-glow), transparent 70%); }
  .quote-card > i { position: relative; font-size: 36px; line-height: 1; color: var(--quote-mark); }
  .qc-line { position: relative; margin: 22px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 26px; line-height: 1.6; letter-spacing: 0.02em; color: var(--text-on-quote); max-width: 24em; text-wrap: pretty; }
  .qc-sign { position: relative; margin-top: 20px; font-family: var(--font-sans); font-size: 12.5px; letter-spacing: 0.04em; color: var(--text-quote-sign); }
  @media (max-width: 760px) {
    .quote-card { padding: 40px 24px; }
    .quote-card > i { font-size: 30px; }
    .qc-line { margin-top: 18px; font-size: 20px; }
    .qc-sign { margin-top: 16px; }
  }

  /* CTA */
  /* 結尾卡＝DS Card tint 組成（2026-10-15）：radius-xl、無陰影、標題 t-h3、說明 Prose sm 置中 cap 28em */
  .cta-card { border-radius: var(--radius-xl); box-shadow: none; padding: 44px 40px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cta-card h2 { margin: 0; font-family: var(--font-serif); font-size: var(--t-h3); font-weight: var(--w-medium); line-height: 1.35; color: var(--ink-900); }
  .cta-sub { margin-top: 10px; margin-bottom: 0; max-width: 28em; }
  .cta-btns { margin-top: 22px; display: flex; gap: 12px; justify-content: center; align-items: center; }
  @media (max-width: 760px) {
    .cta-card { padding: 32px 22px; }
    .cta-card h2 { font-size: 22px; }
    .cta-btns { flex-direction: column; }
  }
</style>
