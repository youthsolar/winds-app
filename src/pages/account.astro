---
import BaseLayout from '../layouts/BaseLayout.astro';

// 入口卡 → winds-app 真路由。我的訂單：shop.winds.tw 9/3 起已 301，9/30 先連站內商店；WP 商城上線後換成訂單查詢頁。
const entries = [
  { icon: 'cards',          title: '我的占卜紀錄', line: '回看你問過的事與當時的牌。', href: '/history' },
  { icon: 'calendar-heart', title: '我的預約',     line: '和老師約好的時間都在這。',   href: '/bookings' },
  { icon: 'shopping-bag',   title: '我的訂單',     line: '法器選物的出貨與取貨狀態。', href: '/shop/' },
  { icon: 'sparkle',        title: '我的紫微命盤', line: '排好的本命盤，隨時回來看。', href: '/ziwei' },
];
---
<BaseLayout
  title="會員中心 · 找風問幸福"
  description="你的占卜紀錄、預約、訂單與紫微命盤，都在這裡。"
  noindex={true}
>
  <main class="ac-main" id="acMain" hidden>
    <!-- 帳號合併提示（DS account-merge v1 ②④：拆完、兩組衝突、綁好） -->
    <div class="am-note" id="amNote" hidden><i class="ph" id="amNoteIcon"></i><span id="amNoteText"></span><span id="amNoteAct"></span></div>
    <!-- 個人卡（DS 會員中心標頭 v1，2026-10-17）：大標自己佔一整列，登出移到底列跟登入方式放一起；
         手機頭像跟眉題同一列、大標在下一列。名字越長字級降一階，不截斷；「你好」黏住名字最後一個字 -->
    <div class="ac-card ac-person">
      <div class="ac-top">
        <div class="ac-avatar" id="acAvatar"></div>
        <div class="ac-eyebrow">會員中心</div>
        <h1 class="ac-h1" id="acTitle"></h1>
      </div>
      <div class="ac-meta">
        <div class="ac-method">
          <div class="ac-email">
            <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true" style="flex:none;display:block">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            <span id="acEmail"></span>
          </div>
          <div class="ac-via-line" id="acViaLine" hidden><img src="/assets/line-btn-base.png" alt="" width="18" height="18">用 LINE 登入</div>
        </div>
        <!-- DS SSO-介面字-1028 A11：〔登出〕維持次鈕；旁邊文字連結「登出商城、預約、課程」→ WP 登出頁（手機換到下一行置左） -->
        <div class="ac-out">
          <button id="acLogout" class="ac-logout" type="button"><i class="ph-thin ph-sign-out"></i>登出</button>
          <span class="ac-wpout"><a id="acWpOut" class="zf-text-link sm muted" href="https://wp.winds.tw/winds-sso/logout" referrerpolicy="strict-origin-when-cross-origin">登出商城、預約、課程</a></span>
        </div>
      </div>
    </div>

    <!-- need_link 卡（DS SSO-介面字-1028 A4，2026-10-29）：Google 登入、這個 Gmail 之前只用信箱題驗過的人，跟 /sso/wp 同一張 -->
    <div class="ac-needlink" id="amNeedLink" hidden><div id="amNeedLinkCard"></div></div>

    <!-- 已連結的帳號（DS account-merge v1 ①，2026-10-17）：連在一起的帳號，占卜紀錄和預約合在一起看 -->
    <div class="ac-card ac-linked" id="amCard" hidden>
      <h2 class="am-h2">已連結的帳號</h2>
      <p class="am-body">連在一起的帳號，占卜紀錄和預約會合在一起看。</p>
      <div class="am-rows" id="amRows"></div>
      <p class="am-solo" id="amSolo" hidden>還沒連其他帳號</p>
      <div class="am-add" id="amAdd" hidden></div>
    </div>

    <!-- 加入官方 LINE 提示（只給確定不是好友的 LINE 登入者） -->
    <div class="ac-friend" id="acFriend" hidden></div>

    <!-- 我的內容入口 -->
    <div class="ac-entries">
      {entries.map((e) => (
        <a href={e.href} class="ac-entry-link" target={e.ext ? '_blank' : undefined} rel={e.ext ? 'noopener' : undefined}>
          <div class="ac-card ac-entry">
            <span class="ac-entry-icon"><i class={`ph-thin ph-${e.icon}`}></i></span>
            <div class="ac-entry-body">
              <div class="ac-entry-title">{e.title}</div>
              <div class="ac-entry-line">{e.line}</div>
            </div>
            <i class="ph ph-arrow-right ac-entry-arrow"></i>
          </div>
        </a>
      ))}
    </div>
  </main>

  <style>
    .ac-main{max-width:var(--container-narrow);width:100%;margin:0 auto;box-sizing:border-box;padding:52px 32px 72px;}
    /* DS Card */
    .ac-card{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);}
    .ac-person{padding:30px 36px;border-radius:var(--radius-xl);box-shadow:var(--shadow-sm);}
    /* 電腦：頭像在左跨兩列，右欄眉題＋大標；手機：頭像＋眉題一列，大標佔滿下一列 */
    .ac-top{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:22px;align-items:start;}
    .ac-top .ac-avatar{grid-row:1 / span 2;}
    .ac-top .ac-eyebrow{padding-top:4px;margin-bottom:0;}
    .ac-top .ac-h1{grid-column:2;margin-top:8px;}
    /* DS Avatar rose ring（淡底深字雙環）*/
    .ac-avatar{width:72px;height:72px;border-radius:999px;background:var(--rose-100);color:var(--rose-600);display:flex;align-items:center;justify-content:center;overflow:hidden;flex:none;font-family:var(--font-serif);font-size:30px;font-weight:500;box-shadow:0 0 0 3px var(--surface-page),0 0 0 4.5px var(--rose-300);}
    .ac-avatar img{width:100%;height:100%;object-fit:cover;}
    .ac-eyebrow{font-family:var(--font-sans);font-size:12px;letter-spacing:0.02em;color:var(--accent-press);margin-bottom:4px;}
    .ac-h1{margin:0;font-family:var(--font-serif);font-size:31px;font-weight:500;line-height:1.3;color:var(--ink-900);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}
    .ac-h1.sz2{font-size:28px;}
    .ac-h1.sz3{font-size:25px;}
    .ac-h1 .nb{white-space:nowrap;}
    /* 底列：左登入方式、右登出，上面一條細線 */
    .ac-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;padding-top:16px;border-top:1px solid var(--border-soft);}
    .ac-method{flex:1 1 auto;min-width:0;}
    .ac-email{display:flex;align-items:center;gap:8px;min-width:0;font-family:var(--font-sans);font-size:13.5px;color:var(--text-muted);}
    .ac-email span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    /* DS line-login v1 ⑥：LINE 登入時名字下面標「LINE 小方塊＋用 LINE 登入」（圖示＝LINE 官方素材） */
    .ac-via-line{display:flex;align-items:center;gap:8px;font-family:var(--font-sans);font-size:13px;color:var(--text-muted);white-space:nowrap;}
    .ac-via-line[hidden]{display:none;}
    .ac-via-line img{flex:none;display:block;width:18px;height:18px;border-radius:5px;}
    .ac-friend{margin-top:20px;}

    /* DS Btn secondary sm */
    .ac-logout{flex:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 16px;min-height:36px;font-family:var(--font-serif);font-size:var(--t-body-sm);font-weight:var(--w-medium);letter-spacing:0.04em;line-height:1;white-space:nowrap;cursor:pointer;background:var(--surface-card);color:var(--ink-900);border:1px solid var(--border-strong);border-radius:var(--radius-pill);box-shadow:var(--shadow-xs);transition:background var(--dur-fast) var(--ease-soft);}
    .ac-logout:hover{background:var(--rice-100);}
    .ac-out{flex:none;display:flex;align-items:center;gap:20px;}
    .ac-logout i{font-size:15px;line-height:1;}

    .ac-entries{margin-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:18px;}
    .ac-entry-link{text-decoration:none;}
    .ac-entry{display:flex;align-items:center;gap:16px;height:100%;box-sizing:border-box;padding:24px 26px;box-shadow:var(--shadow-sm);transition:box-shadow var(--dur-base) var(--ease-soft),transform var(--dur-base) var(--ease-soft);}
    .ac-entry-link:hover .ac-entry{box-shadow:var(--shadow-md);transform:translateY(-2px);}
    .ac-entry-icon{flex:none;width:48px;height:48px;border-radius:var(--radius-md);background:var(--surface-tint);border:1px solid var(--rose-100);display:flex;align-items:center;justify-content:center;}
    .ac-entry-icon i{font-size:24px;line-height:1;color:var(--rose-500);}
    .ac-entry-body{flex:1;min-width:0;}
    .ac-entry-title{font-family:var(--font-serif);font-size:18px;font-weight:500;color:var(--ink-900);}
    .ac-entry-line{font-family:var(--font-serif);font-weight:300;font-size:14px;line-height:1.7;color:var(--text-secondary);}
    .ac-entry-arrow{font-size:18px;color:var(--rose-300);flex:none;}

    @media (max-width:760px){
      .ac-main{padding:32px 20px 48px;}
      .ac-person{padding:22px 20px;}
      .ac-top{grid-template-columns:56px minmax(0,1fr);column-gap:14px;align-items:center;}
      .ac-top .ac-avatar{grid-row:auto;}
      .ac-top .ac-eyebrow{padding-top:0;}
      .ac-top .ac-h1{grid-column:1 / -1;margin-top:14px;}
      .ac-avatar{width:56px;height:56px;font-size:24px;}
      .ac-h1{font-size:25px;}
      .ac-h1.sz2{font-size:23px;}
      .ac-h1.sz3{font-size:21px;}
      .ac-meta{margin-top:16px;padding-top:14px;flex-wrap:wrap;row-gap:14px;}
      .ac-out{display:contents;}
      .ac-wpout{flex:1 1 100%;}
      .ac-entries{grid-template-columns:1fr;gap:14px;margin-top:22px;}
      .ac-friend{margin-top:16px;}

      .ac-entry{padding:20px 20px;}
    }
  </style>


  <!-- 帳號合併的元素是腳本畫出來的，scoped 樣式套不到 → 這段用 global（類名都以 am- 開頭） -->
  <style is:global>
    /* DS account-merge v1（2026-10-17）：已連結的帳號、拆開確認、提示框——只組現有元件，數值照 DS 稿 */
    .ac-linked{margin-top:20px;padding:28px 32px;box-shadow:var(--shadow-sm);}
    .ac-linked[hidden],.am-note[hidden],.ac-needlink[hidden]{display:none;}
    .ac-needlink{margin-top:20px;}
    .ac-needlink .zf-sso-card{max-width:none;}
    .am-h2{margin:0;font-family:var(--font-serif);font-size:19px;font-weight:500;line-height:1.4;color:var(--text-primary);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}
    .am-body{margin:6px 0 0;font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.85;color:var(--text-secondary);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}
    .am-rows{margin-top:8px;}
    .am-solo{margin:4px 0 0;font-family:var(--font-sans);font-size:13.5px;line-height:1.6;color:var(--text-muted);}
    .am-add{margin-top:18px;display:grid;grid-template-columns:1fr;gap:12px;max-width:360px;}
    .am-add[hidden]{display:none;}
    .am-row{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--border-soft);}
    .am-row:last-child{border-bottom:none;}
    .am-mark{width:36px;height:36px;flex:none;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;overflow:hidden;}
    .am-mark.line{background:#06C755;}
    .am-mark.line img{width:36px;height:36px;display:block;}
    .am-mark.google{background:var(--surface-card);border:1px solid var(--border-soft);}
    .am-mark.old{background:var(--rice-100);color:var(--ink-500);}
    .am-mark i{font-size:18px;line-height:1;}
    .am-who{flex:1;min-width:0;}
    .am-name{font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--text-primary);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}
    .am-sub{font-family:var(--font-sans);font-size:12.5px;line-height:1.6;color:var(--text-muted);word-break:normal;overflow-wrap:anywhere;text-wrap:auto;}
    .am-unlink{all:unset;cursor:pointer;flex:none;min-height:44px;padding:0 4px;display:inline-flex;align-items:center;font-family:var(--font-sans);font-size:14px;color:var(--accent-press);text-decoration:underline;text-decoration-color:var(--rose-300);text-underline-offset:4px;white-space:nowrap;}
    .am-unlink:focus-visible{box-shadow:var(--focus-ring);border-radius:4px;}
    /* Google 官方鈕的樣子（GIS size=large 40 高；按下才去 /account/link 開真的 Google 登入，要帶這次綁定的 nonce） */
    .am-gbtn{all:unset;cursor:pointer;display:flex;width:100%;height:40px;border-radius:var(--radius-pill);box-sizing:border-box;align-items:center;padding:0 12px;gap:10px;background:#fff;border:1px solid #DADCE0;color:#1F1F1F;font-family:Roboto,var(--font-sans);font-size:14px;font-weight:500;white-space:nowrap;}
    .am-gbtn span{flex:1;text-align:center;margin-right:28px;}
    .am-gbtn:focus-visible{box-shadow:var(--focus-ring);}
    [data-theme="dark"] .am-gbtn{background:#131314;border-color:#8E918F;color:#E3E3E3;}
    @media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .am-gbtn{background:#131314;border-color:#8E918F;color:#E3E3E3;}}
    .am-note{margin-bottom:16px;padding:12px 14px;border-radius:var(--radius-md);background:var(--surface-tint);border:1px solid var(--rose-100);display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
    .am-note > i{flex:none;font-size:16px;color:var(--accent-press);}
    .am-note #amNoteText{flex:1 1 12em;min-width:0;font-family:var(--font-sans);font-size:13.5px;line-height:1.7;color:var(--ink-700);word-break:normal;overflow-wrap:anywhere;}
    /* 拆開確認：手機底部抽屜、電腦置中小視窗（站上既有 sheet／modal 的值） */
    .am-sheet-bg{position:fixed;inset:0;z-index:200;background:var(--scrim);display:flex;align-items:center;justify-content:center;padding:32px;}
    .am-sheet{width:100%;max-width:460px;box-sizing:border-box;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:32px 32px 28px;max-height:calc(100vh - 64px);overflow:auto;}
    .am-handle{display:none;width:40px;height:4px;border-radius:999px;background:var(--border-strong);margin:0 auto 18px;}
    .am-sheet h2{font-size:21px;}
    .am-check{display:flex;align-items:center;gap:10px;min-height:44px;cursor:pointer;font-family:var(--font-sans);font-size:14px;color:var(--ink-700);margin-top:8px;}
    .am-check i{flex:none;font-size:22px;}
    .am-check .on{color:var(--accent);}
    .am-check .off{color:var(--border-strong);}
    .am-remain{margin-top:12px;padding:12px 16px 4px;border-radius:var(--radius-md);background:var(--surface-sunken);}
    .am-remain-h{font-family:var(--font-sans);font-size:13.5px;line-height:1.6;color:var(--ink-700);}
    .am-actions{margin-top:22px;display:flex;flex-direction:row-reverse;gap:10px;}
    .am-err{margin:12px 0 0;font-family:var(--font-sans);font-size:13.5px;color:var(--critical);}
    .am-pending{margin:12px 0 0;font-family:var(--font-sans);font-size:13px;line-height:1.6;color:var(--text-secondary);}   /* DS A7：Small、text-secondary */
    .am-pending[hidden],.am-err[hidden]{display:none;}
    @media (max-width:760px){
      .ac-linked{margin-top:16px;padding:22px 20px;}
      .am-add{max-width:none;}
      .am-sheet-bg{align-items:flex-end;padding:0;}
      .am-sheet{max-width:none;border-radius:var(--radius-xl) var(--radius-xl) 0 0;box-shadow:var(--shadow-sheet-up);padding:12px 20px 28px;max-height:90vh;}
      .am-handle{display:block;}
      .am-actions{flex-direction:column;}
      .am-actions .zf-btn{width:100%;}
    }
  </style>
  <script is:inline src="/assets/line-login.js"></script>
  <script is:inline src="/assets/account-link.js"></script>
  <script is:inline>
    (function () {
      var token = '';
      try { token = localStorage.getItem('winds_google_token') || ''; } catch (e) {}
      var user = null;
      if (token) {
        try {
          var p = JSON.parse(decodeURIComponent(escape(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')))));   // UTF-8：中文姓名才不會變亂碼
          if (p.exp && p.exp * 1000 > Date.now()) {
            user = { name: p.name || p.given_name || '朋友', email: p.email || '', picture: p.picture || '' };
          }
        } catch (e) {}
      }
      /* 2026-10-16：LINE 登入（line-login.js）也算登入；LINE 沒有信箱，信箱那行留空 */
      if (!user) {
        var ls = window.WindsLine && WindsLine.session();
        if (ls) user = { name: ls.p.name || '朋友', email: '', picture: ls.p.picture || '', viaLine: true };
      }
      if (!user) { location.href = '/login?return=' + encodeURIComponent('/account'); return; }

      /* DS 會員中心標頭 v1：名字視覺長度（中文 1、半形 .55）決定字級三階；名字最後一個字＋「，你好」包進不換行的 span */
      (function () {
        var name = user.name, w = 0;
        for (var ch of name) w += /[\u0000-\u024F]/.test(ch) ? 0.55 : 1;
        var seg = (window.Intl && Intl.Segmenter) ? Array.from(new Intl.Segmenter('zh-Hant', { granularity: 'grapheme' }).segment(name), function (x) { return x.segment; }) : Array.from(name);
        var t = document.getElementById('acTitle');
        t.className = 'ac-h1' + (w > 15 ? ' sz3' : w > 9 ? ' sz2' : '');
        t.textContent = seg.slice(0, -1).join('');
        var nb = document.createElement('span'); nb.className = 'nb'; nb.textContent = (seg[seg.length - 1] || '') + '，你好';
        t.appendChild(nb);
      })();
      var em = document.getElementById('acEmail');
      em.textContent = user.email; em.title = user.email;
      /* LINE 登入沒有信箱，那行的 Google 圖示也不對 → 換成「用 LINE 登入」標示（DS line-login v1 ⑥） */
      if (user.viaLine) { var er = document.querySelector('.ac-email'); if (er) er.style.display = 'none'; document.getElementById('acViaLine').hidden = false; }
      var av = document.getElementById('acAvatar');
      if (user.picture) {
        var img = document.createElement('img');
        img.src = user.picture; img.alt = user.name; av.appendChild(img);
      } else {
        av.textContent = (user.name || '').trim().slice(0, 1);
      }
      document.getElementById('acMain').hidden = false;
      if (user.viaLine) WindsLine.mountFriend(document.getElementById('acFriend'));
      if (window.WindsLink) WindsLink.mountAccount();

      document.getElementById('acLogout').addEventListener('click', function () {
        /* 2026-09-26（Codex 複審抓到，實際比它說的更嚴重）：原本登出只清 winds_google_token，
           其他本機痕跡全部留著。在共用的手機或電腦上，下一個人會拿到前一個人的東西：
             ・winds_booking_session ＝ 預約對話的整段紀錄（感情、健康、想問的事）
             ・winds_ff_log / winds_ff_k ＝ 占卜漏斗開機會拿這兩個去撈「上次的資料」，
               於是下一個人會看到前一個人的生日、姓名、信箱被端出來讓他「沿用上次的資料」
           登出就是要把痕跡清掉，所以一律清掉 winds_ 開頭的本機資料（含日後新增的鍵）。 */
        /* 2026-10-29 SSO（規格 §11）：先讀 winds_wp_sso 再清；登入過商城／預約／課程就繞 WP 登出頁。
           10/29 第三批：要去 WP 登出頁時旗標先留著，回到 /?signed_out=1 才由首頁清（客人沒按 WP 登出鈕就離開，之後還會再繞）；網站本機憑證照清 */
        var hadWp = null;
        try { hadWp = localStorage.getItem('winds_wp_sso'); } catch (e) {}
        try {
          var kill = [];
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf('winds_') === 0 && k !== 'winds_teacher_provider' && !(hadWp && k === 'winds_wp_sso')) kill.push(k);   // 老師後台的篩選偏好不是個資，留著；老師密碼照清（winds_sso_s 也清；winds_wp_sso 要去 WP 登出頁時先留）
          }
          kill.forEach(function (k) { localStorage.removeItem(k); });
        } catch (e) {}
        try { sessionStorage.removeItem('winds_pending_log_id'); } catch (e) {}
        if (hadWp) { document.getElementById('acWpOut').click(); return; }
        location.href = '/';
      });
    })();
  </script>
</BaseLayout>
