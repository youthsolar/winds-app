---
import BaseLayout from '../../layouts/BaseLayout.astro';
import courses from '../../data/courses.json';

type Course = {
  id: number;
  sb_service_id: number;
  cat: 'cultivate' | 'sense' | 'ritual' | 'bundle';
  streamName: string;
  glyph: string;
  name: string;
  level: string;
  format: string;
  kind: string;
  featured: boolean;
  price: string;
  priceVal: number;
  sessions: string;
  place: string;
  freq: string;
  outline: string;
  excerpt: string;
  intro: string;
  body: string;
  learn: string[];
  forWho: string[];
};

export async function getStaticPaths() {
  const list = courses as Course[];
  return list.map((c) => ({
    params: { id: String(c.id) },
    props: { course: c, all: list },
  }));
}

const { course, all } = Astro.props;
const c = course as Course;

const title = `${c.name}｜找風問幸福 靈修課程`;
const desc = c.intro.slice(0, 160);

// 相關課程：排除自己，最多 3
const related = (all as Course[]).filter((x) => x.id !== c.id).slice(0, 3);

// 上課方式：由真實欄位組三張卡（不虛構）
const formatNotes = [
  { icon: 'ph-map-pin', h: '實體授課', s: c.place },
  { icon: 'ph-calendar-dots', h: '上課頻率', s: c.freq },
  { icon: 'ph-arrow-counter-clockwise', h: '免費回訓一次', s: '沒學好可免費重上同一級' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: c.name,
  description: c.intro,
  provider: {
    '@type': 'Organization',
    name: '找風問幸福',
    url: 'https://app.winds.tw',
  },
};
---

<BaseLayout title={title} description={desc} ogType="website" jsonLd={jsonLd}>
  <main class="course-detail">
    <nav class="breadcrumb" aria-label="麵包屑">
      <a href="/">首頁</a>
      <i class="ph ph-caret-right"></i>
      <a href="/course/">靈修課程</a>
      <i class="ph ph-caret-right"></i>
      <span class="current cjk-title">{c.name}</span>
    </nav>

    <div class="layout">
      <article class="main">
        <header class="dt-head">
          <div class="dt-tags">
            <span class="zf-tag sage outline format-tag">
              <i class="ph ph-users-three"></i>{c.format}
            </span>
            <span class="zf-tag rose">{c.level}</span>
          </div>
          <h1 class="cjk-title">{c.name}</h1>
          <p class="dt-intro">{c.intro}</p>
          <div class="dt-meta">
            <span class="dt-price">{c.price}</span>
            <span class="dot">·</span>
            <span>{c.sessions}</span>
          </div>
        </header>

        <section class="dt-section">
          <h2>課程介紹</h2>
          <p class="dt-body">{c.body}</p>
        </section>

        <section class="dt-section">
          <h2>你會學到</h2>
          <ul class="learn-list">
            {c.learn.map((x) => (
              <li><i class="ph-fill ph-check-circle"></i><span>{x}</span></li>
            ))}
          </ul>
        </section>

        <section class="dt-section">
          <div class="format-grid">
            {formatNotes.map((t) => (
              <div class="format-card">
                <i class={`ph ${t.icon}`}></i>
                <div class="fc-h">{t.h}</div>
                <div class="fc-s">{t.s}</div>
              </div>
            ))}
          </div>
        </section>

        <section class="dt-section">
          <h2>完整課綱導引</h2>
          <a class="outline-link zf-card interactive" href={c.outline} target="_blank" rel="noopener">
            <span class="ol-icon"><i class="ph ph-list-bullets"></i></span>
            <span class="ol-text">
              <span class="ol-title">查看完整課綱</span>
              <span class="ol-desc">完整的課綱導引，由老師在 SimplyBook 課程頁說明。</span>
            </span>
            <i class="ph ph-arrow-up-right ol-arrow"></i>
          </a>
        </section>

        <section class="dt-section">
          <div class="zf-card tint forwho-card">
            <h2 class="fw-title">這門課適合誰</h2>
            <ul class="forwho-list">
              {c.forWho.map((x) => (
                <li><i class="ph-fill ph-heart"></i><span>{x}</span></li>
              ))}
            </ul>
          </div>
        </section>

        {related.length > 0 && (
          <section class="dt-section related-section">
            <h2 class="related-h2">相關課程</h2>
            <div class="related-list">
              {related.map((r) => (
                <a class="zf-card interactive related-item" href={`/course/${r.id}/`}>
                  <span class="ri-title cjk-title">{r.name}</span>
                  <span class="ri-desc">{r.excerpt}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="aside">
        <div class="enroll-card zf-card">
          <span class="ec-label">報名這個課程</span>
          <div class="ec-price-row">
            <span class="ec-price">{c.price}</span>
            <span class="ec-sessions">{c.sessions}</span>
          </div>
          <div class="ec-tags">
            <span class="zf-tag sage outline format-tag">
              <i class="ph ph-users-three"></i>{c.format}
            </span>
            <span class="zf-tag rose">{c.level}</span>
          </div>
          <a class="zf-btn primary lg full ec-btn" href={c.outline} target="_blank" rel="noopener">
            前往報名<i class="ph ph-arrow-up-right"></i>
          </a>
          <p class="ec-note"><i class="ph ph-lock-simple"></i>報名與付款將於 SimplyBook 安全頁完成</p>
          <a class="ec-secondary" href={c.outline} target="_blank" rel="noopener">看完整課綱</a>
        </div>

        <section class="reading-cta">
          <p class="rc-line cjk-title">還在猶豫？先占卜看看</p>
          <a class="rc-btn" href="/">立即占卜</a>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .course-detail { max-width: var(--container); margin: 0 auto; padding: 44px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .course-detail { padding: 28px 20px 48px; } }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* breadcrumb */
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 28px; }
  @media (max-width: 760px) { .breadcrumb { margin-bottom: 20px; } }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-press); }
  .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }
  .breadcrumb .current { color: var(--ink-700); }

  /* 2-col layout */
  .layout { display: grid; grid-template-columns: 1fr 360px; gap: 44px; align-items: start; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; gap: 28px; } }

  /* format tag */
  .format-tag { font-size: 12.5px; }
  .format-tag .ph { font-size: 13px; }

  /* main header */
  .dt-head { padding-bottom: 28px; border-bottom: 1px solid var(--border-soft); }
  .dt-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .dt-head h1 { font-family: var(--font-serif); font-size: 38px; font-weight: 500; line-height: 1.3; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .dt-head h1 { font-size: 28px; } }
  .dt-intro { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.9; color: var(--ink-700); margin: 16px 0 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  @media (max-width: 760px) { .dt-intro { font-size: 16px; } }
  .dt-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 20px; font-family: var(--font-sans); font-size: 14px; color: var(--ink-500); }
  .dt-meta .dot { color: var(--rose-200); }
  .dt-price { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); }

  /* sections */
  .dt-section { margin-top: 36px; }
  @media (max-width: 760px) { .dt-section { margin-top: 28px; } }
  .dt-section > h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--ink-900); margin: 0 0 16px; }
  @media (max-width: 760px) { .dt-section > h2 { font-size: 21px; } }
  .dt-body { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.95; color: var(--ink-700); margin: 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  @media (max-width: 760px) { .dt-body { font-size: 16px; } }

  /* learn list */
  .learn-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .learn-list li { display: flex; align-items: flex-start; gap: 12px; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.75; color: var(--ink-700); }
  @media (max-width: 760px) { .learn-list li { font-size: 15.5px; } }
  .learn-list .ph-fill { flex: none; font-size: 20px; color: var(--sage-400); margin-top: 1px; }

  /* 上課方式 grid */
  .format-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 760px) { .format-grid { grid-template-columns: 1fr; } }
  .format-card { background: var(--surface-sunken); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 18px 20px; }
  .format-card > .ph { font-size: 24px; color: var(--rose-500); }
  .fc-h { font-family: var(--font-serif); font-size: 16.5px; font-weight: 500; color: var(--ink-900); margin-top: 10px; }
  .fc-s { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin-top: 4px; }

  /* outline link (取代虛構大綱) */
  .outline-link { display: flex; align-items: center; gap: 16px; text-decoration: none; color: inherit; padding: 20px 22px; }
  @media (max-width: 760px) { .outline-link { padding: 18px 18px; } }
  .ol-icon { flex: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); color: var(--accent-press); }
  .ol-icon .ph { font-size: 22px; }
  .ol-text { min-width: 0; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .ol-title { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--ink-900); }
  .outline-link:hover .ol-title { color: var(--accent-press); }
  .ol-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.7; color: var(--text-secondary); }
  .ol-arrow { flex: none; font-size: 18px; color: var(--text-muted); }
  .outline-link:hover .ol-arrow { color: var(--accent-press); }

  /* 適合誰 */
  .forwho-card { padding: 26px 28px; }
  @media (max-width: 760px) { .forwho-card { padding: 22px 20px; } }
  .fw-title { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); margin: 0 0 14px; }
  @media (max-width: 760px) { .fw-title { font-size: 20px; } }
  .forwho-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .forwho-list li { display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.7; color: var(--ink-700); }
  @media (max-width: 760px) { .forwho-list li { font-size: 15.5px; } }
  .forwho-list .ph-fill { flex: none; font-size: 18px; color: var(--rose-300); margin-top: 2px; }

  /* related */
  .related-section { margin-top: 48px; }
  @media (max-width: 760px) { .related-section { margin-top: 36px; } }
  .related-h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--accent-press); margin: 0 0 16px; }
  @media (max-width: 760px) { .related-h2 { font-size: 21px; } }
  .related-list { display: flex; flex-direction: column; gap: 12px; }
  .related-item { display: flex; flex-direction: column; gap: 7px; text-decoration: none; color: inherit; padding: 20px 24px; }
  @media (max-width: 760px) { .related-item { padding: 18px 18px; } }
  .ri-title { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--ink-900); }
  .related-item:hover .ri-title { color: var(--accent-press); }
  .ri-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.8; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* aside */
  .aside { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 900px) { .aside { position: static; } }
  .enroll-card { box-shadow: var(--shadow-md); display: flex; flex-direction: column; }
  .ec-label { font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; letter-spacing: 0.02em; color: var(--text-muted); }
  .ec-price-row { display: flex; align-items: baseline; gap: 10px; margin: 12px 0 14px; }
  .ec-price { font-family: var(--font-serif); font-size: 28px; font-weight: 500; color: var(--ink-900); }
  .ec-sessions { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); }
  .ec-tags { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--border-soft); }
  .ec-btn { font-size: 17px; }
  .ec-note { display: flex; align-items: center; justify-content: center; gap: 6px; font-family: var(--font-sans); font-size: 12px; line-height: 1.6; color: var(--text-muted); margin: 12px 0 0; }
  .ec-note .ph { font-size: 13px; }
  .ec-secondary { display: block; text-align: center; margin-top: 12px; font-family: var(--font-sans); font-size: 13px; color: var(--accent-press); text-decoration: none; }
  .ec-secondary:hover { text-decoration: underline; }

  /* reading CTA (compact) */
  .reading-cta { padding: 28px 24px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  .rc-line { font-family: var(--font-serif); font-size: 18px; font-weight: 500; color: var(--ink-900); margin: 0 0 16px; }
  .rc-btn { display: inline-block; padding: 13px 28px; font-family: var(--font-serif); font-size: 16px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-on-accent); background: var(--accent); border-radius: var(--radius-pill); text-decoration: none; box-shadow: var(--shadow-sm); transition: background var(--dur-fast) var(--ease-soft); }
  .rc-btn:hover { background: var(--accent-hover); text-decoration: none; }
</style>
