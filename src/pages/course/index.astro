---
import BaseLayout from '../../layouts/BaseLayout.astro';
import streams from '../../data/course-streams.json';

// 課程清單／價格／堂數＝即時 worker /sb-courses（SB 同步）；敘述性框架＝course-streams.json（依 stream 繼承）。
// 整頁 client 渲染：無 ?c= → 列表；?c={id} → 詳情。課程異動免重建。
const pageTitle = '靈修課程｜找風問幸福 靈修・通靈・法術三條路';
const pageDesc =
  '找風問幸福靈修課程：靈修、通靈、法術三條路，循序漸進的實體課程。從一堂適合你的開始，慢慢學，把自己照顧好。';

const STREAM = JSON.stringify(streams);
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="website">
  <div class="course-root">
    <main class="course-shell" id="courseShell">
      <div class="course-skel" id="courseSkel">
        <div class="cs-line cs-bc"></div>
        <div class="cs-line cs-title"></div>
        <div class="cs-line cs-lede"></div>
        <p class="cs-loading">載入課程中…</p>
      </div>
    </main>
    <p class="course-fallback" id="courseFallback" hidden>課程資料載入中，請稍後再試。</p>
  </div>

  <script type="application/json" id="streamData" set:html={STREAM} is:inline></script>

  <style is:global>
    /* ====== 靈修課程（namespaced under .course-root；client innerHTML 注入故走 is:global）====== */
    .course-root { background: var(--surface-page); }
    .course-shell { max-width: var(--container); margin: 0 auto; padding: 44px 32px 72px; }
    @media (max-width: 760px) { .course-shell { padding: 28px 20px 48px; } }
    .course-root .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

    /* loading skeleton */
    .course-skel { display: flex; flex-direction: column; gap: 16px; }
    .cs-line { border-radius: var(--radius-md); background: linear-gradient(90deg, var(--rice-100), var(--rice-50), var(--rice-100)); background-size: 200% 100%; animation: csShim 1.4s linear infinite; }
    .cs-bc { width: 220px; height: 14px; }
    .cs-title { width: min(420px, 80%); height: 40px; margin-top: 14px; }
    .cs-lede { width: min(540px, 90%); height: 20px; }
    @keyframes csShim { to { background-position: -200% 0; } }
    .cs-loading { font-family: var(--font-serif); font-weight: 300; font-size: 15px; color: var(--text-muted); margin-top: 18px; }
    .course-fallback { font-family: var(--font-serif); font-size: 16px; color: var(--text-muted); text-align: center; margin: 60px 0; }

    /* breadcrumb */
    .course-root .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
    @media (max-width: 760px) { .course-root .breadcrumb { margin-bottom: 18px; } }
    .course-root .breadcrumb a { color: var(--text-muted); text-decoration: none; }
    .course-root .breadcrumb a:hover { color: var(--accent-press); }
    .course-root .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }
    .course-root .breadcrumb .current { color: var(--ink-700); }

    /* format tag (sage outline) */
    .course-root .format-tag { font-size: 12.5px; }
    .course-root .format-tag .ph { font-size: 13px; }

    /* ── 列表 view ── */
    .course-root .chip-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 34px; }
    @media (max-width: 760px) { .course-root .chip-row { margin-top: 26px; } }
    .course-root .zf-chip { all: unset; cursor: pointer; white-space: nowrap; flex: none; font-family: var(--font-serif); font-size: 16px; font-weight: 500; letter-spacing: 0.01em; line-height: 1; color: var(--accent-press); background: var(--surface-card); border: 1px solid var(--rose-200); border-radius: var(--radius-pill); padding: 11px 20px; transition: all var(--dur-fast) var(--ease-soft); }
    .course-root .zf-chip.selected { color: var(--text-on-accent); background: var(--accent); border-color: transparent; box-shadow: var(--shadow-sm); }
    @media (max-width: 760px) { .course-root .zf-chip { font-size: 15px; padding: 10px 17px; } }

    /* featured highlight card */
    .course-root .featured { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; margin-top: 38px; padding: 32px 36px; text-decoration: none; color: inherit; }
    @media (max-width: 760px) { .course-root .featured { grid-template-columns: 1fr; gap: 18px; margin-top: 28px; padding: 24px 22px; } }
    .course-root .ft-glyph { width: 76px; height: 76px; font-size: 40px; background: var(--paper); border-color: var(--rose-200); }
    @media (max-width: 760px) { .course-root .ft-glyph { width: 60px; height: 60px; font-size: 32px; } }
    .course-root .ft-body { min-width: 0; }
    .course-root .ft-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .course-root .ft-name { font-family: var(--font-serif); font-size: 27px; font-weight: 500; line-height: 1.35; color: var(--ink-900); margin: 0; }
    @media (max-width: 760px) { .course-root .ft-name { font-size: 22px; } }
    .course-root .featured:hover .ft-name { color: var(--accent-press); }
    .course-root .ft-excerpt { font-family: var(--font-serif); font-weight: 300; font-size: 15px; line-height: 1.8; color: var(--text-secondary); margin: 8px 0 0; }
    .course-root .ft-aside { flex: none; align-self: center; text-align: right; }
    @media (max-width: 760px) { .course-root .ft-aside { text-align: left; } }
    .course-root .ft-price { display: block; font-family: var(--font-serif); font-size: 28px; font-weight: 500; color: var(--ink-900); }
    @media (max-width: 760px) { .course-root .ft-price { font-size: 24px; } }
    .course-root .ft-sessions { display: block; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
    .course-root .ft-aside .zf-btn { pointer-events: none; }

    /* course card wall */
    .course-root .card-wall { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; align-items: stretch; }
    @media (max-width: 1024px) { .course-root .card-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 760px) { .course-root .card-wall { grid-template-columns: 1fr; gap: 16px; margin-top: 22px; } }
    .course-root .course-cell[hidden] { display: none; }
    .course-root .course-card { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; padding: 26px 24px; }
    @media (max-width: 760px) { .course-root .course-card { padding: 22px 20px; } }
    .course-root .cc-top { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .course-root .cc-glyph { width: 56px; height: 56px; font-size: 28px; }
    @media (max-width: 760px) { .course-root .cc-glyph { width: 50px; height: 50px; font-size: 25px; } }
    .course-root .cc-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .course-root .cc-name { font-family: var(--font-serif); font-size: 21px; font-weight: 500; line-height: 1.4; color: var(--ink-900); margin: 0; }
    @media (max-width: 760px) { .course-root .cc-name { font-size: 19px; } }
    .course-root .course-card:hover .cc-name { color: var(--accent-press); }
    .course-root .cc-excerpt { font-family: var(--font-serif); font-weight: 300; font-size: 14.5px; line-height: 1.85; color: var(--text-secondary); margin: 10px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .course-root .cc-meta { margin-top: auto; padding-top: 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .course-root .cc-priceblock { display: flex; flex-direction: column; }
    .course-root .cc-sessions { font-family: var(--font-sans); font-size: 11.5px; color: var(--text-muted); }
    .course-root .cc-price { font-family: var(--font-serif); font-size: 19px; font-weight: 500; color: var(--ink-900); }
    .course-root .cc-more { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-sans); font-size: 13.5px; color: var(--accent-press); white-space: nowrap; transition: transform var(--dur-fast) var(--ease-soft); }
    .course-root .cc-more .ph { font-size: 14px; }
    .course-root .course-card:hover .cc-more { transform: translateX(2px); }
    .course-root .empty-note { font-family: var(--font-serif); font-size: 16px; color: var(--text-muted); text-align: center; margin: 40px 0; }

    /* reading CTA (列表大版) */
    .course-root .reading-cta { margin-top: 80px; padding: 38px 32px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
    @media (max-width: 760px) { .course-root .reading-cta { margin-top: 52px; padding: 30px 22px; } }
    .course-root .rc-line { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); margin: 0 0 8px; }
    @media (max-width: 760px) { .course-root .rc-line { font-size: 19px; } }
    .course-root .rc-sub { font-family: var(--font-serif); font-weight: 300; font-size: 15px; line-height: 1.8; color: var(--text-secondary); margin: 0 0 20px; }
    .course-root .rc-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .course-root .rc-btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 30px; font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-on-accent); background: var(--accent); border-radius: var(--radius-pill); text-decoration: none; box-shadow: var(--shadow-sm); transition: background var(--dur-fast) var(--ease-soft); }
    .course-root .rc-btn:hover { background: var(--accent-hover); text-decoration: none; }
    .course-root .rc-btn.ghost { color: var(--accent-press); background: transparent; border: 1px solid var(--border-accent); box-shadow: none; }
    .course-root .rc-btn.ghost:hover { background: var(--accent-quiet); }
    .course-root .rc-btn .ph { font-size: 16px; }

    /* ── 詳情 view ── */
    .course-root .layout { display: grid; grid-template-columns: 1fr 360px; gap: 44px; align-items: start; }
    @media (max-width: 900px) { .course-root .layout { grid-template-columns: 1fr; gap: 28px; } }
    .course-root .dt-head { padding-bottom: 28px; border-bottom: 1px solid var(--border-soft); }
    .course-root .dt-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
    .course-root .dt-head h1 { font-family: var(--font-serif); font-size: 38px; font-weight: 500; line-height: 1.3; color: var(--ink-900); margin: 0; }
    @media (max-width: 760px) { .course-root .dt-head h1 { font-size: 28px; } }
    .course-root .dt-intro { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.9; color: var(--ink-700); margin: 16px 0 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
    @media (max-width: 760px) { .course-root .dt-intro { font-size: 16px; } }
    .course-root .dt-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 20px; font-family: var(--font-sans); font-size: 14px; color: var(--ink-500); }
    .course-root .dt-meta .dot { color: var(--rose-200); }
    .course-root .dt-price { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); }

    .course-root .dt-section { margin-top: 36px; }
    @media (max-width: 760px) { .course-root .dt-section { margin-top: 28px; } }
    .course-root .dt-section > h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--ink-900); margin: 0 0 16px; }
    @media (max-width: 760px) { .course-root .dt-section > h2 { font-size: 21px; } }
    .course-root .dt-body { font-family: var(--font-serif); font-weight: 300; font-size: 17.5px; line-height: 1.95; color: var(--ink-700); margin: 0; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
    @media (max-width: 760px) { .course-root .dt-body { font-size: 16px; } }

    .course-root .learn-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .course-root .learn-list li { display: flex; align-items: flex-start; gap: 12px; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.75; color: var(--ink-700); }
    @media (max-width: 760px) { .course-root .learn-list li { font-size: 15.5px; } }
    .course-root .learn-list .ph-fill { flex: none; font-size: 20px; color: var(--sage-400); margin-top: 1px; }

    .course-root .format-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    @media (max-width: 760px) { .course-root .format-grid { grid-template-columns: 1fr; } }
    .course-root .format-card { background: var(--surface-sunken); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 18px 20px; }
    .course-root .format-card > .ph { font-size: 24px; color: var(--rose-500); }
    .course-root .fc-h { font-family: var(--font-serif); font-size: 16.5px; font-weight: 500; color: var(--ink-900); margin-top: 10px; }
    .course-root .fc-s { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin-top: 4px; }

    .course-root .outline-link { display: flex; align-items: center; gap: 16px; text-decoration: none; color: inherit; padding: 20px 22px; }
    @media (max-width: 760px) { .course-root .outline-link { padding: 18px 18px; } }
    .course-root .ol-icon { flex: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--rose-100); border-radius: var(--radius-md); color: var(--accent-press); }
    .course-root .ol-icon .ph { font-size: 22px; }
    .course-root .ol-text { min-width: 0; display: flex; flex-direction: column; gap: 4px; flex: 1; }
    .course-root .ol-title { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--ink-900); }
    .course-root .outline-link:hover .ol-title { color: var(--accent-press); }
    .course-root .ol-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.7; color: var(--text-secondary); }
    .course-root .ol-arrow { flex: none; font-size: 18px; color: var(--text-muted); }
    .course-root .outline-link:hover .ol-arrow { color: var(--accent-press); }

    .course-root .forwho-card { padding: 26px 28px; }
    @media (max-width: 760px) { .course-root .forwho-card { padding: 22px 20px; } }
    .course-root .fw-title { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); margin: 0 0 14px; }
    @media (max-width: 760px) { .course-root .fw-title { font-size: 20px; } }
    .course-root .forwho-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
    .course-root .forwho-list li { display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-serif); font-size: 16.5px; font-weight: 300; line-height: 1.7; color: var(--ink-700); }
    @media (max-width: 760px) { .course-root .forwho-list li { font-size: 15.5px; } }
    .course-root .forwho-list .ph-fill { flex: none; font-size: 18px; color: var(--rose-300); margin-top: 2px; }

    .course-root .related-section { margin-top: 48px; }
    @media (max-width: 760px) { .course-root .related-section { margin-top: 36px; } }
    .course-root .related-h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--accent-press); margin: 0 0 16px; }
    @media (max-width: 760px) { .course-root .related-h2 { font-size: 21px; } }
    .course-root .related-list { display: flex; flex-direction: column; gap: 12px; }
    .course-root .related-item { display: flex; flex-direction: column; gap: 7px; text-decoration: none; color: inherit; padding: 20px 24px; }
    @media (max-width: 760px) { .course-root .related-item { padding: 18px 18px; } }
    .course-root .ri-title { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--ink-900); }
    .course-root .related-item:hover .ri-title { color: var(--accent-press); }
    .course-root .ri-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.8; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .course-root .aside { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 20px; }
    @media (max-width: 900px) { .course-root .aside { position: static; } }
    .course-root .enroll-card { box-shadow: var(--shadow-md); display: flex; flex-direction: column; }
    .course-root .ec-label { font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; letter-spacing: 0.02em; color: var(--text-muted); }
    .course-root .ec-price-row { display: flex; align-items: baseline; gap: 10px; margin: 12px 0 14px; }
    .course-root .ec-price { font-family: var(--font-serif); font-size: 28px; font-weight: 500; color: var(--ink-900); }
    .course-root .ec-sessions { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); }
    .course-root .ec-tags { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--border-soft); }
    .course-root .ec-btn { font-size: 17px; }
    .course-root .ec-note { display: flex; align-items: center; justify-content: center; gap: 6px; font-family: var(--font-sans); font-size: 12px; line-height: 1.6; color: var(--text-muted); margin: 12px 0 0; }
    .course-root .ec-note .ph { font-size: 13px; }
    .course-root .ec-secondary { display: block; text-align: center; margin-top: 12px; font-family: var(--font-sans); font-size: 13px; color: var(--accent-press); text-decoration: none; }
    .course-root .ec-secondary:hover { text-decoration: underline; }

    .course-root .back-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 40px; font-family: var(--font-sans); font-size: 14px; color: var(--accent-press); text-decoration: none; }
    .course-root .back-link .ph { font-size: 15px; }
    .course-root .back-link:hover { text-decoration: underline; }

    /* reading CTA (詳情 compact) */
    .course-root .reading-cta.compact { margin-top: 0; padding: 28px 24px; }
    .course-root .reading-cta.compact .rc-line { font-size: 18px; margin-bottom: 16px; }
    .course-root .reading-cta.compact .rc-btn { padding: 13px 28px; font-size: 16px; }
  </style>

  <script type="module" is:inline>
    (function () {
      var WORKER_API = 'https://api.winds.tw';
      var STREAM = JSON.parse(document.getElementById('streamData').textContent || '{}');
      var FORMAT_NOTES = STREAM._format_notes || [];
      var shell = document.getElementById('courseShell');
      var skel = document.getElementById('courseSkel');
      var fallback = document.getElementById('courseFallback');

      var CATS = [
        { key: 'all', name: '全部' },
        { key: 'cultivate', name: '靈修' },
        { key: 'sense', name: '通靈' },
        { key: 'ritual', name: '法術' },
      ];

      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function nf(n) { return (Number(n) || 0).toLocaleString('en-US'); }
      function priceLabel(c) { return 'NT$ ' + nf(c.price); }
      // 每門課繼承其 stream 的敘述框架（新課程落到已知 stream 仍有好內容）
      function merge(c) {
        var s = STREAM[c.stream] || {};
        return Object.assign({}, c, {
          kind: s.kind || '',
          intro: s.intro || '',
          body: s.body || '',
          learn: s.learn || [],
          forWho: s.forWho || [],
          level: '全程班',
          format: '實體',
        });
      }

      function fail() { skel && (skel.hidden = true); shell.innerHTML = ''; fallback.hidden = false; }

      /* ── 列表 view ── */
      function renderList(courses) {
        var featured = courses.find(function (c) { return c.stream === 'bundle'; });
        var wall = courses.filter(function (c) { return c.stream !== 'bundle'; });

        var chips = CATS.map(function (c, i) {
          return '<button class="zf-chip' + (i === 0 ? ' selected' : '') + '" data-filter="' + c.key + '" aria-pressed="' + (i === 0 ? 'true' : 'false') + '">' + esc(c.name) + '</button>';
        }).join('');

        var featuredHtml = featured ? (
          '<a class="featured zf-card tint interactive" href="/course?c=' + featured.id + '" data-featured>' +
            '<span class="ft-glyph zf-glyph-disc">' + esc(featured.glyph) + '</span>' +
            '<div class="ft-body"><div class="ft-tags">' +
              '<span class="zf-badge rose"><span class="zf-badge-dot"></span>' + esc(featured.kind) + '</span>' +
              '<span class="zf-tag sage outline format-tag"><i class="ph ph-users-three"></i>' + esc(featured.format) + '</span>' +
            '</div>' +
            '<h2 class="ft-name cjk-title">' + esc(featured.name) + '</h2>' +
            '<p class="ft-excerpt">' + esc(featured.intro) + '</p></div>' +
            '<div class="ft-aside"><span class="ft-price">' + priceLabel(featured) + '</span>' +
            '<span class="ft-sessions">' + esc(featured.sessionsLabel) + '</span>' +
            '<span class="zf-btn primary md">看課程<i class="ph ph-arrow-right"></i></span></div>' +
          '</a>'
        ) : '';

        var cells = wall.map(function (c) {
          return '<li class="course-cell" data-cat="' + esc(c.stream) + '">' +
            '<a class="course-card zf-card interactive" href="/course?c=' + c.id + '">' +
              '<div class="cc-top"><span class="cc-glyph zf-glyph-disc">' + esc(c.glyph) + '</span>' +
                '<div class="cc-tags">' +
                  '<span class="zf-tag sage outline format-tag"><i class="ph ph-users-three"></i>' + esc(c.format) + '</span>' +
                  '<span class="zf-tag rose">' + esc(c.level) + '</span>' +
                '</div></div>' +
              '<h3 class="cc-name cjk-title">' + esc(c.name) + '</h3>' +
              '<p class="cc-excerpt">' + esc(c.intro) + '</p>' +
              '<div class="cc-meta"><span class="cc-priceblock">' +
                '<span class="cc-sessions">' + esc(c.sessionsLabel) + '</span>' +
                '<span class="cc-price">' + priceLabel(c) + '</span></span>' +
                '<span class="cc-more">看課程<i class="ph ph-arrow-right"></i></span></div>' +
            '</a></li>';
        }).join('');

        shell.innerHTML =
          '<nav class="breadcrumb" aria-label="麵包屑"><a href="/">首頁</a><i class="ph ph-caret-right"></i><span class="current">靈修課程</span></nav>' +
          '<header class="zf-page-header"><span class="zf-ph-eyebrow">靈修課程</span>' +
            '<h1 class="zf-ph-title cjk-title">慢慢學，把自己照顧好。</h1>' +
            '<p class="zf-ph-lede">靈修、通靈、法術三條路，循序漸進。不用一次到位，從一堂適合你的開始。</p></header>' +
          '<nav class="chip-row" aria-label="課程分類">' + chips + '</nav>' +
          featuredHtml +
          '<ul class="card-wall">' + cells + '</ul>' +
          '<p class="empty-note" data-empty hidden>這個分類目前沒有課程。</p>' +
          '<section class="reading-cta"><p class="rc-line cjk-title">不確定哪一堂適合你？先占卜看看</p>' +
            '<p class="rc-sub">抽一張牌，看看現在的自己需要什麼，再決定從哪裡開始。</p>' +
            '<div class="rc-actions"><a class="rc-btn" href="/">立即占卜</a>' +
            '<a class="rc-btn ghost" href="/booking">問問老師<i class="ph ph-chat-circle-dots"></i></a></div></section>';

        wireFilter();
      }

      function wireFilter() {
        var chips = shell.querySelectorAll('.chip-row .zf-chip');
        var cells = shell.querySelectorAll('.course-cell');
        var featured = shell.querySelector('[data-featured]');
        var empty = shell.querySelector('[data-empty]');
        function apply(filter) {
          var shown = 0;
          cells.forEach(function (cell) {
            var match = filter === 'all' || cell.dataset.cat === filter;
            cell.hidden = !match;
            if (match) shown++;
          });
          if (featured) featured.hidden = filter !== 'all';
          if (empty) empty.hidden = shown !== 0;
        }
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.classList.remove('selected'); c.setAttribute('aria-pressed', 'false'); });
            chip.classList.add('selected'); chip.setAttribute('aria-pressed', 'true');
            apply(chip.dataset.filter || 'all');
          });
        });
      }

      /* ── 詳情 view ── */
      function renderDetail(c, all) {
        var related = all.filter(function (x) { return x.id !== c.id; }).slice(0, 3);
        var formatNotes = FORMAT_NOTES;

        var learnHtml = (c.learn || []).map(function (x) {
          return '<li><i class="ph-fill ph-check-circle"></i><span>' + esc(x) + '</span></li>';
        }).join('');
        var notesHtml = formatNotes.map(function (t) {
          return '<div class="format-card"><i class="ph ph-' + esc(t.icon) + '"></i>' +
            '<div class="fc-h">' + esc(t.h) + '</div><div class="fc-s">' + esc(t.s) + '</div></div>';
        }).join('');
        var forWhoHtml = (c.forWho || []).map(function (x) {
          return '<li><i class="ph-fill ph-heart"></i><span>' + esc(x) + '</span></li>';
        }).join('');
        var relatedHtml = related.length ? (
          '<section class="dt-section related-section"><h2 class="related-h2">相關課程</h2><div class="related-list">' +
          related.map(function (r) {
            return '<a class="zf-card interactive related-item" href="/course?c=' + r.id + '">' +
              '<span class="ri-title cjk-title">' + esc(r.name) + '</span>' +
              '<span class="ri-desc">' + esc(r.intro) + '</span></a>';
          }).join('') + '</div></section>'
        ) : '';

        shell.innerHTML =
          '<nav class="breadcrumb" aria-label="麵包屑"><a href="/">首頁</a><i class="ph ph-caret-right"></i>' +
            '<a href="/course">靈修課程</a><i class="ph ph-caret-right"></i>' +
            '<span class="current cjk-title">' + esc(c.name) + '</span></nav>' +
          '<div class="layout"><article class="main">' +
            '<header class="dt-head"><div class="dt-tags">' +
              '<span class="zf-tag sage outline format-tag"><i class="ph ph-users-three"></i>' + esc(c.format) + '</span>' +
              '<span class="zf-tag rose">' + esc(c.level) + '</span></div>' +
              '<h1 class="cjk-title">' + esc(c.name) + '</h1>' +
              '<p class="dt-intro">' + esc(c.intro) + '</p>' +
              '<div class="dt-meta"><span class="dt-price">' + priceLabel(c) + '</span>' +
              '<span class="dot">·</span><span>' + esc(c.sessionsLabel) + '</span></div></header>' +
            '<section class="dt-section"><h2>課程介紹</h2><p class="dt-body">' + esc(c.body) + '</p></section>' +
            '<section class="dt-section"><h2>你會學到</h2><ul class="learn-list">' + learnHtml + '</ul></section>' +
            '<section class="dt-section"><div class="format-grid">' + notesHtml + '</div></section>' +
            '<section class="dt-section"><h2>完整課綱導引</h2>' +
              '<a class="outline-link zf-card interactive" href="' + esc(c.outline) + '" target="_blank" rel="noopener">' +
                '<span class="ol-icon"><i class="ph ph-list-bullets"></i></span>' +
                '<span class="ol-text"><span class="ol-title">查看完整課綱</span>' +
                '<span class="ol-desc">完整的課綱導引，由老師在 SimplyBook 課程頁說明。</span></span>' +
                '<i class="ph ph-arrow-up-right ol-arrow"></i></a></section>' +
            '<section class="dt-section"><div class="zf-card tint forwho-card">' +
              '<h2 class="fw-title">這門課適合誰</h2><ul class="forwho-list">' + forWhoHtml + '</ul></div></section>' +
            relatedHtml +
            '<a class="back-link" href="/course"><i class="ph ph-arrow-left"></i>回課程列表</a>' +
          '</article>' +
          '<aside class="aside"><div class="enroll-card zf-card">' +
            '<span class="ec-label">報名這個課程</span>' +
            '<div class="ec-price-row"><span class="ec-price">' + priceLabel(c) + '</span>' +
            '<span class="ec-sessions">' + esc(c.sessionsLabel) + '</span></div>' +
            '<div class="ec-tags"><span class="zf-tag sage outline format-tag"><i class="ph ph-users-three"></i>' + esc(c.format) + '</span>' +
            '<span class="zf-tag rose">' + esc(c.level) + '</span></div>' +
            '<a class="zf-btn primary lg full ec-btn" href="' + esc(c.outline) + '" target="_blank" rel="noopener">前往報名<i class="ph ph-arrow-up-right"></i></a>' +
            '<p class="ec-note"><i class="ph ph-lock-simple"></i>報名與付款將於 SimplyBook 安全頁完成</p>' +
            '<a class="ec-secondary" href="' + esc(c.outline) + '" target="_blank" rel="noopener">看完整課綱</a></div>' +
            '<section class="reading-cta compact"><p class="rc-line cjk-title">還在猶豫？先占卜看看</p>' +
            '<div class="rc-actions"><a class="rc-btn" href="/">立即占卜</a></div></section>' +
          '</aside></div>';
      }

      function route(courses) {
        var params = new URLSearchParams(window.location.search);
        var cid = params.get('c');
        if (skel) skel.hidden = true;
        if (cid) {
          var c = courses.find(function (x) { return String(x.id) === String(cid); });
          if (c) { document.title = c.name + '｜找風問幸福 靈修課程'; renderDetail(c, courses); return; }
        }
        renderList(courses);
      }

      fetch(WORKER_API + '/sb-courses')
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var courses = ((d && d.courses) || []).filter(function (c) { return c.is_active !== false; }).map(merge);
          if (!courses.length) { fail(); return; }
          route(courses);
        })
        .catch(fail);
    })();
  </script>
</BaseLayout>
