---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCategoryBody from '../../../components/BlogCategoryBody.astro';

const PER_PAGE = 12;
const catOrder = ['感情挽回','桃花運','斬桃花','元辰宮','財運','塔羅','星座','命理','兩性關係','感情和合','開運招財','命理占卜','其他'];

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const byCat: Record<string, typeof posts> = {};
  for (const p of posts) {
    const c = p.data.category || '其他';
    (byCat[c] ??= []).push(p);
  }
  return Object.keys(byCat).map(cat => {
    const sorted = byCat[cat].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { params: { cat }, props: { cat, all: sorted, byCat } };
  });
}

const { cat, all, byCat } = Astro.props;
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const posts = all.slice(0, PER_PAGE);
const allCats = Object.keys(byCat)
  .map(name => ({ name, count: byCat[name].length }))
  .sort((a, b) => {
    const ai = catOrder.indexOf(a.name), bi = catOrder.indexOf(b.name);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  });

const pageTitle = `${cat}｜找風問幸福靈炁案例專欄`;
const pageDesc = `找風問幸福部落格「${cat}」分類共 ${all.length} 篇文章，由六位老師分享真實個案與靈性智慧。`;
---
<BaseLayout title={pageTitle} description={pageDesc} ogType="website">
  <BlogCategoryBody cat={cat} posts={posts} allCats={allCats} page={1} totalPages={totalPages} />
</BaseLayout>
