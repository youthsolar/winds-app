---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogCategoryBody from '../../../../components/BlogCategoryBody.astro';

export async function getStaticPaths() {
  const PER_PAGE = 12;
  const catOrder = ['感情挽回','桃花運','斬桃花','元辰宮','財運','塔羅','星座','命理','兩性關係','感情和合','開運招財','命理占卜','其他'];
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const byCat: Record<string, typeof posts> = {};
  for (const p of posts) {
    const c = p.data.category || '其他';
    (byCat[c] ??= []).push(p);
  }
  const allCats = Object.keys(byCat)
    .map(name => ({ name, count: byCat[name].length }))
    .sort((a, b) => {
      const ai = catOrder.indexOf(a.name), bi = catOrder.indexOf(b.name);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    });

  const paths: any[] = [];
  for (const cat of Object.keys(byCat)) {
    const sorted = byCat[cat].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    const totalPages = Math.ceil(sorted.length / PER_PAGE);
    for (let pg = 2; pg <= totalPages; pg++) {  // page 1 由 [cat].astro 處理
      paths.push({
        params: { cat, page: String(pg) },
        props: { cat, posts: sorted.slice((pg - 1) * PER_PAGE, pg * PER_PAGE), allCats, page: pg, totalPages, totalCount: sorted.length },
      });
    }
  }
  return paths;
}

const { cat, posts, allCats, page, totalPages, totalCount } = Astro.props;
const pageTitle = `${cat}（第 ${page} 頁）｜找風問幸福靈炁案例專欄`;
const pageDesc = `找風問幸福部落格「${cat}」分類共 ${totalCount} 篇文章，第 ${page} 頁。`;
---
<BaseLayout title={pageTitle} description={pageDesc} ogType="website">
  <BlogCategoryBody cat={cat} posts={posts} allCats={allCats} page={page} totalPages={totalPages} />
</BaseLayout>
