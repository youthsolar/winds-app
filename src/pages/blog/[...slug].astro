---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pickRecs } from '../../data/recommend';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const TEACHERS = ['風易揚', '芊蘭', '風賜靈', '伊紫蓮', '玄奇', '竹韻'];
  const teachers: Record<string, string | null> = {};
  for (const p of posts) {
    const body = p.body || '';
    let best: string | null = null;
    let bestCount = 0;
    for (const t of TEACHERS) {
      const count = (body.match(new RegExp(t, 'g')) || []).length;
      if (count > bestCount) { bestCount = count; best = t; }
    }
    teachers[p.id] = best;
  }
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts, teachers },
  }));
}

const { post, allPosts, teachers } = Astro.props;
const { Content, headings } = await render(post);
const recs = pickRecs(post.data.category);

// 目錄：取 h2（≥2 才顯示）
const toc = headings.filter((h: any) => h.depth === 2 && h.text?.trim());

// 相關文章：分類 + 共同標籤 + 同老師加權
const currentTeacher = teachers[post.id];
const currentTags = new Set(post.data.tags || []);
const related = allPosts
  .filter((p: any) => p.id !== post.id)
  .map((p: any) => {
    let score = 0;
    if (p.data.category === post.data.category) score += 3;
    for (const t of (p.data.tags || [])) if (currentTags.has(t)) score += 2;
    if (currentTeacher && teachers[p.id] === currentTeacher) score += 3;
    return { p, score };
  })
  .filter((x: any) => x.score > 0)
  .sort((a: any, b: any) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x: any) => x.p);

const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.seoTitle || post.data.title,
  "description": post.data.llmDescription || post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  // 署名為真人時輸出 Person（作者權威訊號）；沿用舊組織署名的文章維持 Organization
  "author": post.data.author === "風易揚老師"
    ? { "@type": "Person", "name": "風易揚老師", "url": "https://winds.tw/about/" }
    : { "@type": "Organization", "name": "找風問幸福", "url": "https://winds.tw" },
  "publisher": {
    "@type": "Organization", "name": "找風問幸福", "url": "https://winds.tw",
    "logo": { "@type": "ImageObject", "url": "https://winds.tw/assets/logo.png" }
  },
  "inLanguage": "zh-TW"
};

// GEO/AEO：FAQPage schema（僅在 frontmatter 有 faq 時輸出，內容與頁面可見 FAQ 區塊一致）
const faqs = post.data.faq || [];
const jsonLd = faqs.length > 0
  ? [articleLd, {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      })),
      "inLanguage": "zh-TW"
    }]
  : articleLd;
---

<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  articleAuthor={post.data.author}
  jsonLd={jsonLd}
>
  <main class="article">
    <nav class="breadcrumb" aria-label="麵包屑">
      <a href="/">首頁</a>
      <i class="ph ph-caret-right"></i>
      <a href="/blog/">案例專欄</a>
      {post.data.category && (<>
        <i class="ph ph-caret-right"></i>
        <a href={`/blog/category/${post.data.category}/`}>{post.data.category}</a>
      </>)}
    </nav>

    <header class="art-head">
      <h1 class="cjk-title">{post.data.title}</h1>
      <div class="byline">
        <span class="author"><i class="ph-fill ph-sparkle"></i>{post.data.author}</span>
        <span class="dot">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
      </div>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <a class="tag" href={`/blog/category/${post.data.category || '其他'}/`}>#{tag}</a>
          ))}
        </div>
      )}
    </header>

    {toc.length >= 2 && (
      <nav class="toc" aria-label="本文目錄">
        <div class="toc-label">本文重點</div>
        <ol>
          {toc.map((h: any, i: number) => (
            <li><a href={`#${h.slug}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body"><Content /></div>

    {faqs.length > 0 && (
      <section class="panel paper faq">
        <h2>常見問題</h2>
        <div class="faq-list">
          {faqs.map((f: any) => (
            <div class="faq-item">
              <h3 class="faq-q cjk-title">{f.q}</h3>
              <p class="faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="end-cta">
      <section class="reading-cta">
        <p class="rc-line cjk-title">想更深入了解你的狀況？先抽一張牌</p>
        <p class="rc-sub">不用先決定什麼。抽一張牌，看看現在的自己；或由老師一對一，親自為你解惑。</p>
        <div class="rc-btns">
          <a class="rc-btn primary" href="/">立即占卜</a>
          <a class="rc-btn secondary" href="/services/"><i class="ph ph-phone"></i>預約諮詢</a>
        </div>
      </section>
    </div>

    {related.length > 0 && (
      <section class="panel paper">
        <h2>延伸閱讀</h2>
        <div class="related-list">
          {related.map((p: any) => (
            <a class="related-item" href={`/blog/${p.id}/`}>
              <div class="ri-title cjk-title">{p.data.title}</div>
              <p class="ri-desc">{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {recs.length > 0 && (
      <section class="panel tint">
        <h2>為你推薦</h2>
        <p class="panel-sub">與這篇相關的法器與項目</p>
        <div class="rec-list">
          {recs.map((r: any) => (
            <a class="rec-card" href={r.url}>
              <span class="glyph">{r.glyph}</span>
              <span class="rec-info">
                <span class="rec-name">{r.name}</span>
                <span class="rec-price">NT$ {r.price.toLocaleString()}{r.source === 'simplybook' ? ' 起' : ''}</span>
              </span>
              <i class="ph ph-arrow-right"></i>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="bottom-cta">
      <section class="reading-cta">
        <p class="rc-line cjk-title">想知道你現在的量能狀態？</p>
        <div class="rc-btns"><a class="rc-btn primary" href="/">立即占卜</a></div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .article { max-width: var(--container-narrow); margin: 0 auto; padding: 44px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .article { padding: 28px 20px 48px; } }
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* breadcrumb */
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
  @media (max-width: 760px) { .breadcrumb { margin-bottom: 18px; } }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-press); }
  .breadcrumb .ph { font-size: 11px; color: var(--rose-200); }

  /* header */
  .art-head { padding-bottom: 26px; border-bottom: 1px solid var(--border-soft); }
  @media (max-width: 760px) { .art-head { padding-bottom: 20px; } }
  .art-head h1 { font-family: var(--font-serif); font-size: 37px; font-weight: 500; line-height: 1.32; letter-spacing: 0.01em; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .art-head h1 { font-size: 27px; } }
  .byline { display: flex; align-items: center; gap: 12px; margin-top: 18px; flex-wrap: wrap; }
  .byline .author { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-serif); font-size: 14.5px; font-weight: 500; color: var(--accent-press); white-space: nowrap; }
  .byline .author .ph-fill { font-size: 14px; }
  .byline .dot { color: var(--rose-200); }
  .byline time { font-family: var(--font-sans); font-size: 13.5px; color: var(--text-muted); white-space: nowrap; }
  .tags { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .tag { font-family: var(--font-sans); font-size: 12.5px; color: var(--rose-600); background: var(--rose-50); border-radius: var(--radius-pill); padding: 4px 12px; text-decoration: none; white-space: nowrap; }
  .tag:hover { background: var(--rose-100); }

  /* TOC */
  .toc { margin-top: 28px; background: var(--surface-sunken); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 18px 22px; }
  @media (max-width: 760px) { .toc { margin-top: 20px; padding: 16px 18px; } }
  .toc-label { font-family: var(--font-sans); font-size: 11.5px; letter-spacing: 0.02em; color: var(--text-muted); margin-bottom: 12px; }
  .toc ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .toc a { display: flex; gap: 10px; font-family: var(--font-serif); font-size: 15px; color: var(--ink-700); line-height: 1.5; text-decoration: none; }
  .toc a:hover { color: var(--accent-press); }
  .toc .n { font-family: var(--font-sans); font-size: 12px; font-weight: 600; color: var(--rose-400); flex: none; margin-top: 1px; }

  /* article body（語意 prose；欄寬 measure-prose 置中） */
  .article-body { max-width: var(--measure-prose); margin: 40px auto 0; }
  @media (max-width: 760px) { .article-body { max-width: none; margin-top: 28px; } }
  .article-body :global(h2) { font-family: var(--font-serif); font-size: 24px; font-weight: 500; line-height: 1.5; letter-spacing: 0.01em; color: var(--ink-900); margin: 1.8em 0 0.7em; scroll-margin-top: 80px; }
  .article-body :global(h2:first-child) { margin-top: 0; }
  .article-body :global(h3) { font-family: var(--font-serif); font-size: 19px; font-weight: 500; color: var(--ink-900); margin: 1.4em 0 0.5em; }
  .article-body :global(p) { font-family: var(--font-serif); font-weight: 300; font-size: 18px; line-height: 1.95; color: var(--ink-700); margin: 0 0 1.5em; word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }
  @media (max-width: 760px) { .article-body :global(h2) { font-size: 21px; } .article-body :global(p) { font-size: 16.5px; } }
  .article-body :global(a) { color: var(--rose-600); text-decoration: underline; text-decoration-color: var(--rose-300); text-underline-offset: 3px; }
  .article-body :global(a:hover) { color: var(--rose-500); }
  .article-body :global(strong) { color: var(--ink-900); font-weight: 600; }
  .article-body :global(blockquote) { margin: 1.5em 0; padding: 18px 24px; border-left: 3px solid var(--rose-300); background: var(--surface-tint); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .article-body :global(blockquote p) { margin: 0; font-weight: 400; font-size: 18px; line-height: 1.85; color: var(--ink-700); }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 1.5em; padding-left: 1.4em; display: flex; flex-direction: column; gap: 8px; }
  .article-body :global(li) { font-family: var(--font-serif); font-weight: 300; font-size: 18px; line-height: 1.9; color: var(--ink-700); }
  .article-body :global(li::marker) { color: var(--rose-400); }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-lg); margin: 1.2em 0; }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--border-soft); margin: 2em 0; }

  /* reading CTA（end + bottom 共用視覺） */
  .end-cta { margin-top: 48px; padding-top: 38px; border-top: 1px solid var(--border-soft); }
  .bottom-cta { margin-top: 56px; }
  @media (max-width: 760px) { .end-cta { margin-top: 36px; padding-top: 30px; } .bottom-cta { margin-top: 40px; } }
  .reading-cta { padding: 38px 32px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  @media (max-width: 760px) { .reading-cta { padding: 30px 22px; } }
  .rc-line { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .rc-line { font-size: 19px; } }
  .rc-sub { font-family: var(--font-serif); font-weight: 300; font-size: 15px; line-height: 1.8; color: var(--text-secondary); margin: 10px auto 0; max-width: 32em; text-wrap: pretty; }
  .rc-btns { margin-top: 20px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .rc-btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 30px; font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; border-radius: var(--radius-pill); text-decoration: none; transition: background var(--dur-fast) var(--ease-soft); }
  .rc-btn.primary { color: var(--text-on-accent); background: var(--accent); box-shadow: var(--shadow-sm); }
  .rc-btn.primary:hover { background: var(--accent-hover); text-decoration: none; }
  .rc-btn.secondary { color: var(--ink-900); background: var(--surface-card); border: 1px solid var(--border-strong); }
  .rc-btn.secondary:hover { background: var(--rice-100); text-decoration: none; }

  /* panels（延伸閱讀 / 為你推薦）*/
  .panel { border-radius: var(--radius-lg); padding: 28px 30px; }
  @media (max-width: 760px) { .panel { padding: 22px 20px; } }
  .panel.paper { margin-top: 48px; background: var(--surface-card); border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); }
  @media (max-width: 760px) { .panel.paper { margin-top: 36px; } }
  .panel.tint { margin-top: 24px; background: var(--surface-tint); border: 1px solid var(--rose-100); }
  @media (max-width: 760px) { .panel.tint { margin-top: 20px; } }
  .panel h2 { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--accent-press); margin: 0 0 8px; }
  @media (max-width: 760px) { .panel h2 { font-size: 20px; } }
  .panel-sub { font-family: var(--font-sans); font-size: 13px; color: var(--text-muted); margin: 0 0 14px; }

  .faq-list { display: flex; flex-direction: column; }
  .faq-item { padding: 14px 0; }
  .faq-item + .faq-item { border-top: 1px solid var(--border-soft); }
  .faq-q { font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--text-primary); margin: 0 0 6px; }
  .faq-a { font-size: 15px; line-height: 1.9; color: var(--text-secondary); margin: 0; }

  .related-list { display: flex; flex-direction: column; }
  .related-item { display: block; padding: 16px 0; text-decoration: none; }
  .related-item + .related-item { border-top: 1px solid var(--border-soft); }
  .ri-title { font-family: var(--font-serif); font-size: 16.5px; font-weight: 500; color: var(--ink-900); }
  .related-item:hover .ri-title { color: var(--accent-press); }
  .ri-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14px; line-height: 1.8; color: var(--text-secondary); margin: 6px 0 0; max-width: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .rec-list { display: flex; flex-direction: column; gap: 10px; }
  .rec-card { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--surface-card); border: 1px solid var(--rose-100); border-radius: var(--radius-md); text-decoration: none; color: inherit; transition: border-color var(--dur-fast) var(--ease-soft); }
  .rec-card:hover { border-color: var(--rose-300); text-decoration: none; }
  /* GlyphDisc：圓角方形（radius-md）· 底 paper #FFFDF8 · rose-100 框（對齊 DS GlyphDisc，非圓形非 rose 底） */
  .rec-card .glyph { flex: none; width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--surface-card); border: 1px solid var(--rose-100); display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 21px; line-height: 1; color: var(--accent-press); }
  .rec-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .rec-name { font-family: var(--font-serif); font-size: 16px; font-weight: 500; color: var(--ink-900); }
  .rec-price { font-family: var(--font-sans); font-size: 13px; color: var(--rose-600); }
  .rec-card .ph { flex: none; font-size: 16px; color: var(--rose-400); }
</style>
