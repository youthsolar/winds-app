---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Group by category
const categorized: Record<string, typeof allPosts> = {};
for (const p of allPosts) {
  const cat = p.data.category || '其他';
  if (!categorized[cat]) categorized[cat] = [];
  categorized[cat].push(p);
}

const categoryOrder = ['感情挽回','桃花運','斬桃花','元辰宮','財運','塔羅','星座','命理','兩性關係','感情和合','開運招財','命理占卜','其他'];
const sortedCats = Object.keys(categorized).sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});

const pageTitle = "找風問幸福｜靈炁命理部落格・感情挽回・桃花運・補財庫・元辰宮";
const pageDesc = "找風問幸福部落格：感情挽回、桃花運、補財庫、元辰宮修補、塔羅占卜等 340+ 篇靈炁命理文章，由風易揚、風賜靈、芊蘭、伊紫蓮、竹韻、玄奇六位老師分享真實個案。";

const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="website">
  <main class="blog-list">
    <header class="list-header">
      <span class="eyebrow"><span class="dot"></span>案例專欄</span>
      <h1 class="cjk-title">靈炁案例專欄</h1>
      <p class="subtitle">由老師分享的真實個案與靈性智慧</p>
      <p class="count">共 {allPosts.length} 篇文章</p>
    </header>

    <nav class="cat-nav" aria-label="文章分類">
      {sortedCats.map(cat => (
        <a href={`/blog/category/${cat}/`} class="cat-pill">
          {cat}<span class="cat-count">{categorized[cat].length}</span>
        </a>
      ))}
    </nav>

    <div class="groups">
      {sortedCats.map(cat => (
        <section class="cat-section">
          <div class="group-head">
            <h2 class="cjk-title">{cat}</h2>
            {categorized[cat].length > 4 && (
              <a class="group-more" href={`/blog/category/${cat}/`}>看完整 {categorized[cat].length} 篇 →</a>
            )}
          </div>
          <ul class="post-grid">
            {categorized[cat].slice(0, 4).map(post => (
              <li>
                <a class="art-card" href={`/blog/${post.id}/`}>
                  <h3 class="art-title cjk-title">{post.data.title}</h3>
                  <p class="art-desc">{post.data.description}</p>
                  <div class="art-meta">
                    <time>{fmtDate(post.data.pubDate)}</time>
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <section class="reading-cta">
      <p class="rc-line cjk-title">想知道你現在的量能狀態？</p>
      <a class="rc-btn" href="/">立即占卜</a>
    </section>
  </main>
</BaseLayout>

<style>
  /* 值逐項對齊 handoff mockup（blog-components.jsx / ui-kit.jsx PageHeader）*/
  .blog-list { max-width: var(--container); margin: 0 auto; padding: 60px 32px 72px; background: var(--surface-page); }
  @media (max-width: 760px) { .blog-list { padding: 36px 20px 48px; } }

  /* header — 左對齊（mockup PageHeader 預設 align=left） */
  .list-header { text-align: left; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.02em; color: var(--accent-press); }
  .eyebrow .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent); flex: none; }
  .list-header h1 { font-family: var(--font-serif); font-size: 42px; font-weight: 500; line-height: 1.2; color: var(--ink-900); margin: 14px 0 0; }
  .list-header .subtitle { font-family: var(--font-serif); font-weight: 300; font-size: 18px; line-height: 1.8; color: var(--text-secondary); margin: 16px 0 0; }
  .list-header .count { font-family: var(--font-sans); font-size: 13.5px; color: var(--text-muted); margin: 10px 0 0; }
  @media (max-width: 760px) { .list-header h1 { font-size: 30px; } .list-header .subtitle { font-size: 16px; } }

  /* 中文標題斷行紅線：連續書寫貪婪填滿，不用 balance/pretty */
  .cjk-title { word-break: normal; overflow-wrap: anywhere; text-wrap: auto; }

  /* category pills（暖卡容器；膠囊 serif 15.5 墨字） */
  .cat-nav { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin: 44px 0 0; padding: 26px 28px; background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); }
  @media (max-width: 760px) { .cat-nav { margin-top: 32px; padding: 20px 18px; } }
  .cat-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: var(--radius-pill); background: var(--rose-50); border: 1px solid var(--rose-100); color: var(--ink-700); font-family: var(--font-serif); font-size: 15.5px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: all var(--dur-fast) var(--ease-soft); }
  .cat-pill:hover { background: var(--accent); border-color: transparent; color: var(--text-on-accent); text-decoration: none; }
  .cat-pill .cat-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--surface-card); font-family: var(--font-sans); font-size: 11.5px; font-weight: 600; color: var(--ink-500); }
  .cat-pill:hover .cat-count { background: var(--rose-100); color: var(--rose-600); }

  /* groups */
  .groups { display: flex; flex-direction: column; gap: 68px; margin-top: 64px; }
  @media (max-width: 760px) { .groups { gap: 48px; margin-top: 44px; } }
  .group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 22px; padding-bottom: 12px; border-bottom: 1px solid var(--border-soft); }
  .group-head h2 { font-family: var(--font-serif); font-size: 25px; font-weight: 500; color: var(--accent-press); margin: 0; }
  @media (max-width: 760px) { .group-head { margin-bottom: 18px; } .group-head h2 { font-size: 22px; } }
  .group-more { font-family: var(--font-sans); font-size: 13.5px; color: var(--rose-500); text-decoration: none; white-space: nowrap; flex: none; }
  .group-more:hover { color: var(--rose-600); text-decoration: none; }

  /* article cards */
  .post-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: stretch; }
  @media (max-width: 760px) { .post-grid { grid-template-columns: 1fr; gap: 16px; } }
  .art-card { display: flex; flex-direction: column; height: 100%; padding: 24px 26px; background: var(--surface-card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; transition: transform var(--dur-base) var(--ease-soft), box-shadow var(--dur-base) var(--ease-soft); }
  @media (max-width: 760px) { .art-card { padding: 20px; } }
  .art-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); text-decoration: none; }
  .art-title { font-family: var(--font-serif); font-size: 19.5px; font-weight: 500; line-height: 1.45; letter-spacing: 0.01em; color: var(--ink-900); margin: 0; }
  @media (max-width: 760px) { .art-title { font-size: 18px; } }
  .art-card:hover .art-title { color: var(--accent-press); }
  .art-desc { font-family: var(--font-serif); font-weight: 300; font-size: 14.5px; line-height: 1.85; color: var(--text-secondary); margin: 11px 0 0; max-width: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .art-meta { margin-top: auto; padding-top: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .art-meta time { font-family: var(--font-sans); font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
  .art-meta .tag { font-family: var(--font-sans); font-size: 12.5px; color: var(--rose-500); white-space: nowrap; }

  /* reading CTA（FreeReadingCTA） */
  .reading-cta { margin-top: 72px; padding: 38px 32px; text-align: center; background: linear-gradient(180deg, var(--surface-tint), var(--rose-50)); border: 1px solid var(--rose-100); border-radius: var(--radius-xl); }
  @media (max-width: 760px) { .reading-cta { margin-top: 48px; padding: 30px 22px; } }
  .rc-line { font-family: var(--font-serif); font-size: 22px; font-weight: 500; color: var(--ink-900); margin: 0 0 20px; }
  @media (max-width: 760px) { .rc-line { font-size: 19px; } }
  .rc-btn { display: inline-block; padding: 15px 30px; font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-on-accent); background: var(--accent); border-radius: var(--radius-pill); text-decoration: none; box-shadow: var(--shadow-sm); transition: background var(--dur-fast) var(--ease-soft); }
  .rc-btn:hover { background: var(--accent-hover); text-decoration: none; }
</style>
