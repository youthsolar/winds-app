---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="登入 · 找風問幸福"
  description="用 Google 帳戶登入找風問幸福，回看你的占卜紀錄、預約與紫微命盤。"
  noindex={true}
>
  <div class="lg-wrap">
    <div class="lg-inner">
      <div class="lg-card">
        <h1 class="lg-h1">登入</h1>
        <p class="lg-sub">用 Google 帳戶登入，回看你的占卜紀錄、預約與紫微命盤。</p>
        <div id="lgGoogle" class="lg-gmount" aria-label="使用 Google 登入"></div>
        <p class="lg-hint" id="lgHint" hidden><span class="lg-spinner"></span>正在前往 Google…</p>
      </div>
      <p class="lg-terms">登入即表示你同意我們的<a href="/terms">使用條款</a>與<a href="/privacy">隱私權政策</a>。</p>
    </div>
  </div>

  <style>
    .lg-wrap{min-height:calc(100vh - 76px);display:flex;align-items:center;justify-content:center;padding:64px 32px;background:var(--surface-page);}
    .lg-inner{width:100%;max-width:420px;}
    /* DS Card：surface-card / border-soft / radius-lg；登入卡用 shadow-md + 置中 */
    .lg-card{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:40px 40px 34px;text-align:center;}
    .lg-h1{margin:0;font-family:var(--font-serif);font-size:29px;font-weight:500;color:var(--ink-900);letter-spacing:0.02em;}
    .lg-sub{margin:14px auto 0;max-width:22em;font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.7;color:var(--text-secondary);}
    .lg-gmount{margin-top:30px;display:flex;justify-content:center;min-height:44px;}
    .lg-hint{display:inline-flex;align-items:center;gap:8px;margin:16px 0 0;font-family:var(--font-sans);font-size:13px;color:var(--text-muted);}
    .lg-gbtn{width:100%;margin-top:32px;display:flex;align-items:center;justify-content:center;gap:12px;white-space:nowrap;padding:14px 20px;min-height:54px;cursor:pointer;font-family:var(--font-serif);font-size:17px;font-weight:500;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-pill);box-shadow:var(--shadow-xs);transition:background var(--dur-fast) var(--ease-soft);}
    .lg-gbtn:hover{background:var(--rice-100);}
    .lg-gbtn[disabled]{opacity:0.7;cursor:default;}
    .lg-gbtn-default,.lg-gbtn-loading{display:inline-flex;align-items:center;gap:12px;}
    .lg-spinner{display:inline-block;flex:none;width:18px;height:18px;border-radius:999px;border:2px solid var(--rose-200);border-top-color:var(--rose-500);animation:lgSpin 1.1s linear infinite;box-sizing:border-box;}
    @keyframes lgSpin{to{transform:rotate(360deg)}}
    /* GSI 渲染不出來時的外開引導（Threads/IG/FB 內建瀏覽器常見） */
    .lg-fb{text-align:center;}
    .lg-fb-t{font-family:var(--font-serif);font-size:16px;font-weight:500;color:var(--ink-900);}
    .lg-fb-d{margin:8px auto 14px;max-width:22em;font-family:var(--font-serif);font-weight:300;font-size:13.5px;line-height:1.75;color:var(--text-secondary);}
    .lg-fb-btn{display:inline-block;margin:0 4px;padding:11px 20px;cursor:pointer;font-family:var(--font-serif);font-size:14.5px;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-pill);text-decoration:none;}
    .lg-terms{text-align:center;margin:20px auto 0;font-family:var(--font-sans);font-size:12px;line-height:1.8;color:var(--text-muted);}
    .lg-terms a{color:var(--rose-500);text-decoration:none;}
    .lg-terms a:hover{text-decoration:underline;}
    @media (max-width:760px){
      .lg-wrap{min-height:calc(100vh - 64px);padding:40px 20px;}
      .lg-card{padding:30px 24px 28px;}
      .lg-h1{font-size:25px;}
      .lg-gbtn{margin-top:26px;}
    }
  </style>

  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  <script is:inline>
    (function () {
      // 與全站一致的 public Google client id（divination/history 也用這顆；client id 公開無風險）
      var CLIENT_ID = '35219881811-2rnl87e0qmb9vsuhuqnfooo0a0af5ggd.apps.googleusercontent.com';
      function ret() {
        try { return new URLSearchParams(location.search).get('return') || '/'; } catch (e) { return '/'; }
      }
      // 已登入直接回轉址目標
      try {
        var t = localStorage.getItem('winds_google_token');
        if (t) {
          var p = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
          if (p.exp && p.exp * 1000 > Date.now()) { location.replace(ret()); return; }
        }
      } catch (e) {}
      function onCredential(resp) {
        if (!resp || !resp.credential) return;
        try { localStorage.setItem('winds_google_token', resp.credential); } catch (e) {}
        var hint = document.getElementById('lgHint'); if (hint) hint.hidden = false;
        location.replace(ret());
      }
      function init() {
        if (!(window.google && google.accounts && google.accounts.id)) { setTimeout(init, 150); return; }
        google.accounts.id.initialize({ client_id: CLIENT_ID, callback: onCredential, auto_select: false, context: 'signin' });
        var mount = document.getElementById('lgGoogle');
        if (mount) {
          mount.innerHTML='';
          mount.removeAttribute('data-fb');
          google.accounts.id.renderButton(mount, { theme: (window.ZFTheme&&ZFTheme.isDark())?'filled_black':'outline', size: 'large', shape: 'pill', text: 'signin_with', logo_alignment: 'left', width: 280, locale: 'zh-TW' });
        }
        // One Tap 加碼（被 cooldown 抑制也沒關係）
        try { google.accounts.id.prompt(); } catch (e) {}
      }
      // GSI 在 App 內建瀏覽器（Threads/IG/FB）常常一顆按鈕都渲染不出來，
      // 而 init() 是無限重試、沒有逾時，畫面就永遠停在空卡片、使用者無從得知。
      // 這裡不猜根因，只看結果：時間到還是空的就換成外開引導。
      function fallback() {
        var mount = document.getElementById('lgGoogle');
        if (!mount || mount.childNodes.length) return;
        mount.setAttribute('data-fb', '1');
        mount.innerHTML =
          '<div class="lg-fb">' +
            '<p class="lg-fb-t">這個瀏覽器不支援 Google 登入</p>' +
            '<p class="lg-fb-d">請點右上角「⋯」選「在瀏覽器開啟」，用 Safari 或 Chrome 進來就可以登入了。</p>' +
            '<button type="button" class="lg-fb-btn" id="lgCopy">複製網址</button>' +
            (/Android/i.test(navigator.userAgent)
              ? '<a class="lg-fb-btn" href="intent://' + location.host + location.pathname + location.search + '#Intent;scheme=https;package=com.android.chrome;end">用 Chrome 開啟</a>'
              : '') +
          '</div>';
        var b = document.getElementById('lgCopy');
        if (b) b.addEventListener('click', function () { copyUrl(b); });
      }
      function copyUrl(btn) {
        var u = location.href;
        function done() { btn.textContent = '已複製 ✓'; }
        function legacy() {
          try {
            var t = document.createElement('textarea');
            t.value = u; t.style.position = 'fixed'; t.style.opacity = '0';
            document.body.appendChild(t); t.select(); document.execCommand('copy');
            document.body.removeChild(t); done();
          } catch (e) {}
        }
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(u).then(done, legacy); return;
          }
        } catch (e) {}
        legacy();
      }
      init();
      setTimeout(fallback, 3500);
      window.addEventListener('zf-theme-change', function () {
        var mount = document.getElementById('lgGoogle');
        if (mount && window.google && google.accounts && google.accounts.id) {
          mount.innerHTML = '';
          google.accounts.id.renderButton(mount, { theme: (window.ZFTheme&&ZFTheme.isDark())?'filled_black':'outline', size: 'large', shape: 'pill', text: 'signin_with', logo_alignment: 'left', width: 280, locale: 'zh-TW' });
        }
      });
    })();
  </script>
</BaseLayout>
