---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="登入 · 找風問幸福"
  description="用 LINE 或 Google 帳戶登入找風問幸福，回看你的占卜紀錄、預約與紫微命盤。"
  noindex={true}
>
  <div class="lg-wrap">
    <div class="lg-inner">
      <div class="lg-card">
        <h1 class="lg-h1">登入</h1>
        <p class="lg-sub">用 LINE 或 Google 帳戶登入，回看你的占卜紀錄、預約與紫微命盤。</p>
        <!-- DS line-login v1 ①：10/21 Jeffery 改全站 Google 在上、LINE 在下（原 LINE 在上），同寬、間距 12；LINE 用 md（40 高）跟 Google 官方鈕一樣高（10/17） -->
        <div class="lg-btns">
          <div id="lgGoogle" class="lg-gmount" aria-label="使用 Google 登入"></div>
          <a class="zf-line-btn md" id="lgLine" href="/auth/line-start?return=/account"><span class="ic"><img src="/assets/line-btn-base.png" alt="" width="32" height="32"></span><span class="tx">用 LINE 登入</span></a>
        </div>
        <p class="lg-open"><a class="zf-text-link" id="lgLiff" href="https://liff.line.me/2009168674-G2KqF3Jv"><i class="ph ph-arrow-square-out"></i>用 LINE 打開占卜</a></p>
        <p class="lg-hint" id="lgHint" hidden><span class="lg-spinner"></span>正在前往 Google…</p>
      </div>
      <p class="lg-terms">登入即表示你同意我們的<a href="/terms">使用條款</a>與<a href="/privacy">隱私權政策</a>。</p>
    </div>
  </div>

  <style>
    .lg-wrap{min-height:calc(100vh - 76px);display:flex;align-items:center;justify-content:center;padding:64px 32px;background:var(--surface-page);}
    .lg-inner{width:100%;max-width:460px;}
    /* DS Card：surface-card / border-soft / radius-lg；登入卡用 shadow-md + 置中 */
    .lg-card{background:var(--surface-card);border:1px solid var(--border-soft);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:40px 40px 34px;text-align:center;}
    .lg-h1{margin:0;font-family:var(--font-serif);font-size:29px;font-weight:500;color:var(--ink-900);letter-spacing:0.02em;}
    .lg-sub{margin:14px auto 0;max-width:22em;font-family:var(--font-serif);font-weight:300;font-size:15px;line-height:1.7;color:var(--text-secondary);}
    .lg-btns{margin-top:28px;display:flex;flex-direction:column;gap:12px;}
    .lg-gmount{display:flex;justify-content:center;min-height:44px;}
    .lg-open{margin:20px 0 0;display:flex;justify-content:center;}
    .lg-open[hidden]{display:none;}
    .lg-open .zf-text-link i{font-size:15px;}
    .lg-hint{display:inline-flex;align-items:center;gap:8px;margin:16px 0 0;font-family:var(--font-sans);font-size:13px;color:var(--text-muted);}
    .lg-gbtn{width:100%;margin-top:32px;display:flex;align-items:center;justify-content:center;gap:12px;white-space:nowrap;padding:14px 20px;min-height:54px;cursor:pointer;font-family:var(--font-serif);font-size:17px;font-weight:500;color:var(--ink-900);background:var(--surface-card);border:1px solid var(--border-strong);border-radius:var(--radius-pill);box-shadow:var(--shadow-xs);transition:background var(--dur-fast) var(--ease-soft);}
    .lg-gbtn:hover{background:var(--rice-100);}
    .lg-gbtn[disabled]{opacity:0.7;cursor:default;}
    .lg-gbtn-default,.lg-gbtn-loading{display:inline-flex;align-items:center;gap:12px;}
    .lg-spinner{display:inline-block;flex:none;width:18px;height:18px;border-radius:999px;border:2px solid var(--rose-200);border-top-color:var(--rose-500);animation:lgSpin 1.1s linear infinite;box-sizing:border-box;}
    @keyframes lgSpin{to{transform:rotate(360deg)}}
    /* GSI 渲染不出來時的外開引導（Threads/IG/FB 內建瀏覽器常見）；innerHTML 注入 → 要 :global */
    /* DS line-login v1 ①：Google 出不來時，Google 鈕的位置換成凹底說明框（小 G＋一句話＋複製網址／用瀏覽器打開） */
    :global(.lg-fb){width:100%;box-sizing:border-box;padding:14px 16px;border-radius:var(--radius-md);background:var(--surface-sunken);text-align:left;display:flex;flex-direction:column;gap:10px;}
    :global(.lg-fb-d){display:flex;gap:8px;margin:0;font-family:var(--font-sans);font-size:13.5px;line-height:1.7;color:var(--ink-700);word-break:normal;overflow-wrap:anywhere;}
    :global(.lg-fb-d svg){flex:none;margin-top:3px;}
    :global(.lg-fb-row){display:flex;gap:8px;flex-wrap:wrap;}
    :global(.lg-fb-row .zf-btn i){font-size:14px;}
    .lg-terms{text-align:center;margin:20px auto 0;font-family:var(--font-sans);font-size:12px;line-height:1.8;color:var(--text-muted);}
    .lg-terms a{color:var(--rose-500);text-decoration:none;}
    .lg-terms a:hover{text-decoration:underline;}
    @media (max-width:760px){
      .lg-wrap{min-height:calc(100vh - 64px);padding:40px 20px;}
      .lg-card{padding:30px 24px 28px;}
      .lg-h1{font-size:25px;}
      .lg-gbtn{margin-top:26px;}
      .lg-btns{margin-top:24px;}
    }
  </style>

  <script is:inline src="/assets/line-login.js"></script>
  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  <script is:inline>
    (function () {
      // 與全站一致的 public Google client id（divination/history 也用這顆；client id 公開無風險）
      var CLIENT_ID = '35219881811-2rnl87e0qmb9vsuhuqnfooo0a0af5ggd.apps.googleusercontent.com';
      function ret() {
        /* 2026-09-28（gpt-6-astra 體檢）：原本直接交給 location.replace()，return=javascript:… 會在本站執行、偷走登入憑證。
           只准回到本站的網址（同源、http/https），不合格一律回首頁。 */
        try {
          var u = new URL(new URLSearchParams(location.search).get('return') || '/', location.origin);
          if (u.origin !== location.origin || !/^https?:$/.test(u.protocol)) return '/';
          return u.href;   // 回傳驗證過的完整網址——只取 pathname 的話 https://winds.tw//evil.com 會變成 //evil.com 跳到外站（gpt-6-astra 複核）
        } catch (e) { return '/'; }
      }
      /* 2026-10-29 SSO（規格 §3.2；DS SSO-介面字-1028 A2）：/login?return=%2Fsso%2Fwp&sso=1＝從商城／預約／課程來的登入。
         副標換成回到原頁、藏「用 LINE 打開占卜」（點了會離開這次登入）；不靠 exp 判斷已登入——只有後端 whoami 回 200 才跳回，
         而且同一筆交易最多自動跳回 1 次（不然憑證被後端拒絕時會在兩頁之間繞圈） */
      var SSO = new URLSearchParams(location.search).get('sso') === '1';
      if (SSO) {
        var sub = document.querySelector('.lg-sub'); if (sub) sub.textContent = '登入後會回到剛才的頁面。';
        var lo = document.querySelector('.lg-open'); if (lo) lo.hidden = true;
        (function () {
          var tx = null; try { tx = JSON.parse(localStorage.getItem('winds_sso_s') || 'null'); } catch (e) {}
          if (!tx || !tx.s || !(Date.now() - tx.t <= 10 * 60 * 1000) || tx.lr) return;
          var cands = [];
          try { var g = localStorage.getItem('winds_google_token'); if (g) cands.push({ 'X-Google-Id-Token': g }); } catch (e) {}
          try { var l = localStorage.getItem('winds_line_token'); if (l) cands.push({ 'X-Line-Id-Token': l }); } catch (e) {}
          (function next(i) {
            if (i >= cands.length) return;
            fetch('https://api.winds.tw/wp-sso/whoami', { method: 'POST', headers: cands[i] }).then(function (r) {
              if (r.status !== 200) return next(i + 1);
              tx.lr = 1;
              try { localStorage.setItem('winds_sso_s', JSON.stringify(tx)); } catch (e) { return; }
              location.replace(ret());
            }, function () {});
          })(0);
        })();
      } else {
      // 已登入直接回轉址目標
      try {
        var t = localStorage.getItem('winds_google_token');
        if (t) {
          var p = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
          if (p.exp && p.exp * 1000 > Date.now()) { location.replace(ret()); return; }
        }
      } catch (e) {}
      if (window.WindsLine && WindsLine.session()) { location.replace(ret()); return; }
      }
      /* 2026-10-18（Astra 導流收單驗收 #1）：「到 LINE 裡打開」帶上這次從哪來（utm 兩欄），LINE 小幫手起卦時才對得到來源 */
      /* Astra 第二輪：本頁的來源是頁尾才記的，這裡先讀會拿到舊的 → 改成按下去那一刻（以及整頁載完）才讀 */
      (function () {
        var a = document.getElementById('lgLiff'); if (!a) return;
        var base = a.getAttribute('href');
        function fix() {
          var t = null, href = base;
          try { t = JSON.parse(sessionStorage.getItem('winds_this_touch') || 'null'); } catch (e) {}
          if (t && Date.now() - Date.parse(t.at) <= 864e5 && (t.source || t.content)) {
            var q = new URLSearchParams();
            if (t.source) q.set('utm_source', String(t.source).slice(0, 40));
            if (t.content) q.set('utm_content', String(t.content).slice(0, 80));
            href = base + '?' + q.toString();
          }
          a.setAttribute('href', href);
        }
        a.addEventListener('click', fix);
        window.addEventListener('load', fix);
        /* 2026-10-18（發片前走查 Astra 必改 #2）：要回到某一卦（return 帶 log_id）時，到 LINE 裡打開會變成重新選題、找不回原本那一卦 → 這時不顯示這個入口，用上面的「用 LINE 登入」回原卦 */
        try { if (new URL(ret()).searchParams.get('log_id')) a.parentNode.style.display = 'none'; } catch (e) {}
      })();
      /* LINE 登入只准回到白名單頁（/history、/bookings、/account、起卦頁帶 log_id），其他一律回會員中心 */
      (function () {
        var a = document.getElementById('lgLine');
        try { if (a && window.WindsLine) a.setAttribute('href', '/auth/line-start?return=' + encodeURIComponent(WindsLine.safeReturn((function (u) { return u.pathname + u.search; })(new URL(ret()))))); } catch (e) {}
      })();
      function onCredential(resp) {
        if (!resp || !resp.credential) return;
        var ok = false;
        try { localStorage.setItem('winds_google_token', resp.credential); ok = localStorage.getItem('winds_google_token') === resp.credential; } catch (e) {}
        var hint = document.getElementById('lgHint');
        /* 2026-10-18（發片前走查 Astra 必改 #3）：這個瀏覽器存不了登入資料（無痕、擋網站資料），跳回去還是沒登入、又被帶回來，一直繞圈 → 存不進就停在這裡講清楚 */
        if (!ok) { if (hint) { hint.textContent = '這個瀏覽器存不了登入資料。請改用 Safari 或 Chrome 打開，或用領取信裡的連結回到你的卦。'; hint.hidden = false; } return; }
        if (hint) hint.hidden = false;
        location.replace(ret());
      }
      /* 2026-09-27：原本 init() 每 150ms 無限重試，3.5 秒後就算已經換成外開引導也不會停；
         Google SDK 若很晚才載入（或永遠被擋），init() 會把引導清掉、換回一顆在這個瀏覽器按不動的
         Google 按鈕，副標也還是藏著＝畫面自相矛盾。改成：逾時就停止輪詢，且引導出來後不再蓋回去。 */
      /* 2026-10-01（廣告前全站掃描）：一般 Safari／Chrome 在慢網路（冷快取、約 5 Mbps 以下）Google 腳本要 5–6 秒才到，
         原本 3.5 秒就停止輪詢、換成「不支援」後永遠不再補按鈕，只能重新整理。改成：
         逾時後放慢成每秒一次、最多等到 60 秒；逾時引導（data-fb="timeout"）在 Google 腳本到了之後換回真按鈕並恢復副標，
         App 內建瀏覽器的引導（data-fb="inapp"）維持 9/27 的做法，不蓋回去（照 gift.astro 的「GSI 晚到換回真按鈕」）。 */
      /* Google 鈕跟 LINE 鈕同寬（Google 上限 400） */
      function gw() { var m = document.getElementById('lgGoogle'); return Math.max(200, Math.min(400, (m && m.clientWidth) || 280)); }
      var GSI_DEADLINE = Date.now() + 3500;   // 與下面 setTimeout(fallback, 3500) 同一個時間點
      var GSI_GIVEUP = Date.now() + 60000;
      function init() {
        if (!(window.google && google.accounts && google.accounts.id)) {
          if (Date.now() > GSI_GIVEUP) return;
          setTimeout(init, Date.now() > GSI_DEADLINE ? 1000 : 150); return;
        }
        if ((document.getElementById('lgGoogle') || {}).getAttribute && document.getElementById('lgGoogle').getAttribute('data-fb') === 'inapp') return;
        google.accounts.id.initialize({ client_id: CLIENT_ID, callback: onCredential, auto_select: false, context: 'signin' });
        var mount = document.getElementById('lgGoogle');
        if (mount) {
          mount.innerHTML='';
          mount.removeAttribute('data-fb');
          google.accounts.id.renderButton(mount, { theme: (window.ZFTheme&&ZFTheme.isDark())?'filled_black':'outline', size: 'large', shape: 'pill', text: 'signin_with', logo_alignment: 'left', width: gw(), locale: 'zh-TW' });
        }
        // One Tap 加碼（被 cooldown 抑制也沒關係）
        try { google.accounts.id.prompt(); } catch (e) {}
      }
      // GSI 在 App 內建瀏覽器（Threads/IG/FB）常常一顆按鈕都渲染不出來，
      // 而 init() 是無限重試、沒有逾時，畫面就永遠停在空卡片、使用者無從得知。
      // 這裡不猜根因，只看結果：時間到還是空的就換成外開引導。
      function fallback(force) {
        var mount = document.getElementById('lgGoogle');
        if (!mount) return;
        if (!force && mount.childNodes.length) return;   // 逾時路徑：只在掛載點還空的時候接手
        mount.setAttribute('data-fb', force ? 'inapp' : 'timeout');   // 分開兩種來源：只有 inapp 不准被 init() 蓋回按鈕
        /* 2026-10-16（DS line-login v1）：副標改成「用 LINE 或 Google」，LINE 鈕在這種瀏覽器照樣能用，副標不再藏 */
        var G = '<svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
        mount.innerHTML =
          '<div class="lg-fb">' +
            '<p class="lg-fb-d">' + G + '<span>' + (force
              ? '要用 Google 登入，請先用手機的瀏覽器打開這一頁。Instagram、Threads 裡打不開 Google 登入。'
              : '這個瀏覽器不支援 Google 登入。請點右上角「⋯」選「在瀏覽器開啟」，用 Safari 或 Chrome 進來就可以登入了。') + '</span></p>' +
            '<div class="lg-fb-row"><button type="button" class="zf-btn secondary sm" id="lgCopy"><i class="ph ph-copy"></i>複製網址</button>' +
            (/Android/i.test(navigator.userAgent)
              ? '<a class="zf-btn quiet sm" href="intent://' + location.host + location.pathname + location.search + '#Intent;scheme=https;package=com.android.chrome;end"><i class="ph ph-arrow-square-out"></i>用瀏覽器打開</a>'
              : '') +
          '</div></div>';
        var b = document.getElementById('lgCopy');
        if (b) b.addEventListener('click', function () { copyUrl(b); });
      }
      function copyUrl(btn) {
        var u = location.href;
        function done() { btn.textContent = '已複製'; }
        function legacy() {
          try {
            var t = document.createElement('textarea');
            t.value = u; t.style.position = 'fixed'; t.style.opacity = '0';
            document.body.appendChild(t); t.select(); document.execCommand('copy');
            document.body.removeChild(t); done();
          } catch (e) {}
        }
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(u).then(done, legacy); return;
          }
        } catch (e) {}
        legacy();
      }
      // App 內嵌瀏覽器：Google 直接封鎖 OAuth，按鈕就算渲染出來也登不進去 → 不掛 GSI，直接出引導
      if (window.ZFInApp && window.ZFInApp()) {
        fallback(true);
      } else {
        init();
        setTimeout(fallback, 3500);
      }
      window.addEventListener('zf-theme-change', function () {
        var mount = document.getElementById('lgGoogle');
        // 已換成外開引導（data-fb）就別重畫：這時 SDK 沒 initialize，畫出來的按鈕按了也沒用，還會把引導蓋掉
        if (mount && !mount.getAttribute('data-fb') && window.google && google.accounts && google.accounts.id) {
          mount.innerHTML = '';
          google.accounts.id.renderButton(mount, { theme: (window.ZFTheme&&ZFTheme.isDark())?'filled_black':'outline', size: 'large', shape: 'pill', text: 'signin_with', logo_alignment: 'left', width: gw(), locale: 'zh-TW' });
        }
      });
    })();
  </script>
</BaseLayout>
